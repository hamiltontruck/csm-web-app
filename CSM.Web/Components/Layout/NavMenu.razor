@inject CSM.Web.Services.INotificationApiService NotificationService
@inject CSM.Web.Services.IAuthService AuthService
@inject NavigationManager Navigation

<div class="sidebar">

    <!-- Header -->
    <div class="top-row">
        <div class="brand-wrap">
            <a class="navbar-brand" href="/dashboard" aria-label="CSM overview" @onclick="CloseMenu">CSM</a><span class="brand-rule" aria-hidden="true"></span>
        </div>
    </div>

    <button @ref="_menuToggle" type="button" class="navbar-toggler" aria-label="@(_menuOpen ? "Close navigation" : "Open navigation")"
            aria-expanded="@_menuOpen.ToString().ToLowerInvariant()" aria-controls="workspace-navigation" @onclick="ToggleMenu" @onkeydown="HandleMenuKey">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@(_menuOpen ? "M6 6l12 12M18 6L6 18" : "M4 6h16M4 12h16M4 18h16")" /></svg>
    </button>

    <!-- Scrollable Menu -->
    <div id="workspace-navigation" class="nav-scrollable @(_menuOpen ? "is-open" : "")" @onkeydown="HandleMenuKey">

        <nav aria-label="Workspace navigation">

            <div class="section-title">
                Construction Management
            </div>

            <!-- Dashboard -->
            <div class="nav-item">
                <NavLink class="nav-link" @onclick="CloseMenu"
                         href="/dashboard"
                         Match="NavLinkMatch.All">
                    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z" /></svg>
                    <span>Overview</span>
                </NavLink>
            </div>



            <!-- Project Tracking -->
            @if (_access.CanVisit("/project-tracking"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link" @onclick="CloseMenu"
                             href="/project-tracking"
                             Match="NavLinkMatch.All">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h18v16H3zM8 8v8M12 8v5M16 8v10" /></svg>
                        <span>Project Tracking</span>
                    </NavLink>
                </div>
            }

            <!-- Procurement -->
            @if (_access.CanVisit("/procurement"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link" @onclick="CloseMenu" href="/procurement">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7l9-4 9 4v10l-9 4-9-4zM3 7l9 4 9-4M12 11v10" /></svg>
                        <span>Procurement</span>
                    </NavLink>
                </div>
            }

            <!-- Inventory -->
            @if (_access.CanVisit("/inventory"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link" @onclick="CloseMenu" href="/inventory">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7l9-4 9 4v10l-9 4-9-4zM3 7l9 4 9-4M12 11v10" /></svg>
                        <span>Inventory</span>
                    </NavLink>
                </div>
            }

            <!-- Equipment -->
            @if (_access.CanVisit("/equipment"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link" @onclick="CloseMenu" href="/equipment">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h11v12H3zM14 9h4l3 4v4h-7M5 17v3h3v-3M16 17v3h3v-3" /></svg>
                        <span>Equipment</span>
                    </NavLink>
                </div>
            }

            <!-- Administration -->
            <hr class="my-2" />

            <div class="section-title">
                Administration
            </div>

            @if (_access.CanVisit("/companies"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link" @onclick="CloseMenu" href="/companies">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21V3h14v18M2 21h20M9 7h1M14 7h1M9 11h1M14 11h1M10 21v-6h4v6" /></svg>
                        <span>Companies</span>
                    </NavLink>
                </div>
            }

            @if (_access.CanVisit("/users"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link" @onclick="CloseMenu" href="/users">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M2 21v-3a6 6 0 0 1 12 0v3M16 4a4 4 0 0 1 0 8M17 15a5 5 0 0 1 5 5" /></svg>
                        <span>Users</span>
                    </NavLink>
                </div>
            }

            @if (_access.CanVisit("/roles"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link" @onclick="CloseMenu" href="/roles">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l8 4v6c0 5-8 10-8 10S4 17 4 12V6zM9 11h6v5H9zM10 11V9a2 2 0 0 1 4 0v2" /></svg>
                        <span>Role Permissions</span>
                    </NavLink>
                </div>
            }

            @if (_access.CanVisit("/users/audit"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link" @onclick="CloseMenu" href="/users/audit">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5v5h5M3 10a9 9 0 1 1 2 8M12 7v6l4 2" /></svg>
                        <span>User Audit</span>
                    </NavLink>
                </div>
            }

            @if (_access.CanVisit("/hr"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link" @onclick="CloseMenu" href="/hr">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3h16v18H4zM9 9a3 3 0 1 0 6 0 3 3 0 0 0-6 0M7 18a5 5 0 0 1 10 0" /></svg>
                        <span>HR Management</span>
                    </NavLink>
                </div>
            }

            @if (_access.CanVisit("/finance/sites"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link" @onclick="CloseMenu"
                             href="/finance/sites"
                             Match="NavLinkMatch.Prefix">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h17v15H3zM3 5V3h14M15 10h6v5h-6z" /></svg>
                        <span>Finance</span>
                    </NavLink>
                </div>
            }

            @if (_access.CanVisit("/compliance"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link" @onclick="CloseMenu" href="/compliance">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l8 4v6c0 5-8 10-8 10S4 17 4 12V6zM8 12l3 3 5-6" /></svg>
                        <span>Compliance</span>
                    </NavLink>
                </div>
            }

            @if (_access.CanVisit("/reports"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link" @onclick="CloseMenu" href="/reports">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21V11h4v10M10 21V7h4v14M16 21V3h4v18" /></svg>
                        <span>Reports</span>
                    </NavLink>
                </div>
            }

            @if (_access.CanVisit("/notifications"))
            {
                <div class="nav-item">
                    <NavLink class="nav-link" @onclick="CloseMenu" href="/notifications">
                        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 17h14l-2-3V9a5 5 0 0 0-10 0v5zM10 21h4" /></svg>
                        <span>Notifications</span>

                        @if (_unreadNotificationCount > 0)
                        {
                            <span class="badge bg-danger ms-2">
                                @_unreadNotificationCount
                            </span>
                        }
                    </NavLink>
                </div>
            }

            <div class="nav-item">
                <NavLink class="nav-link" @onclick="CloseMenu" href="/settings">
                    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3h6l1 4 4 1v7l-4 1-1 5H9l-1-5-4-1V8l4-1zM9 12a3 3 0 1 0 6 0 3 3 0 0 0-6 0" /></svg>
                    <span>Settings & Privacy</span>
                </NavLink>
            </div>

        </nav>

    <!-- Sign Out -->
    <div class="signout">
        <button class="nav-link btn btn-link w-100 text-start"
                type="button"
                @onclick="SignOutAsync">
            <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 3H3v18h7M8 12h13M16 7l5 5-5 5" /></svg>
            <span>Sign Out</span>
        </button>
    </div>
    <div class="workspace-caption">CSM Workspace</div>
    </div>
</div>

@code
{
    private Microsoft.AspNetCore.Components.ElementReference _menuToggle;
    private bool _menuOpen;
    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;
    private async Task HandleMenuKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
    {
        if (args.Key != "Escape" || !_menuOpen) return;
        CloseMenu();
        await _menuToggle.FocusAsync();
    }

    private int _unreadNotificationCount;
    private WorkspaceAccess _access = WorkspaceAccess.None;


    protected override async Task OnInitializedAsync()
    {
        try
        {
            _access = new(await AuthService.GetRolesAsync(), await AuthService.GetPermissionsAsync());

        }
        catch { _access = WorkspaceAccess.None; }
        if (_access.CanVisit("/notifications"))
        {
            try { _unreadNotificationCount = await NotificationService.GetUnreadCountAsync(); }
            catch { _unreadNotificationCount = 0; }
        }
    }

    private async Task SignOutAsync()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", true);
    }
}
