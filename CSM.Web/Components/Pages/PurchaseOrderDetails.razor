@page "/purchase-orders/{Id:guid}"
@rendermode InteractiveServer

@using CSM.Web.Models.Procurement
@using CSM.Web.Services

@inject IProcurementService ProcurementService
@inject NavigationManager Navigation

<PageTitle>Purchase Order Details</PageTitle>

@if (loading)
{
    <div class="container py-4">
        <h4>Loading...</h4>
    </div>
}
else if (order is null)
{
    <div class="container py-4">
        <div class="alert alert-warning">Purchase Order not found.</div>

        <button class="btn btn-secondary"
                @onclick="GoBackToPurchaseOrders">
            Back
        </button>
    </div>
}
else
{
    <div class="container py-4">

        <button type="button"
                class="btn btn-outline-secondary"
                @onclick="GoBackToPurchaseOrders">
            ← Back
        </button>

        <div class="d-flex justify-content-between align-items-center mb-3">

            <h1>@order.PurchaseOrderNumber</h1>

            @if (order.Status == "Draft")
            {
                <button class="btn btn-warning"
                        @onclick="SubmitForApproval">
                    Submit for Approval
                </button>
            }
            else if (order.Status == "PendingApproval")
            {
                <button class="btn btn-success"
                        @onclick="ApprovePurchaseOrder">
                    Approve
                </button>
            }
            else if (order.Status == "Approved")
            {
                <button class="btn btn-primary"
                        @onclick="SendToVendor">
                    Send to Vendor
                </button>
            }
            else
            {
                <span class="badge bg-success">@order.Status</span>
            }

        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <h5 class="mb-0">Order Information</h5>
            </div>

            <div class="card-body">
                <div class="row">

                  <div class="col-md-6 mb-3">
                      <div class="text-muted small">Supplier</div>
                      <div class="fw-semibold">@order.VendorName</div>
                  </div>

                    <div class="col-md-6 mb-3">
                        <div class="text-muted small">Order Date</div>
                        <div class="fw-semibold">
                            @order.OrderDate.ToString("dd MMM yyyy")
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="text-muted small">Total Amount</div>
                        <div class="fw-semibold">
                            ETB @order.TotalAmount.ToString("N2")
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="text-muted small">Remarks</div>
                        <div>@order.Notes</div>
                    </div>

                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0">Materials</h5>
            </div>

            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Material</th>
                            <th>Unit</th>
                            <th class="text-end">Ordered</th>
                            <th class="text-end">Received</th>
                            <th class="text-end">Remaining</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var line in order.Lines)
                        {
                            <tr>
                                <td>@line.MaterialName</td>
                                <td>@line.UnitOfMeasure</td>
                                <td class="text-end">@line.OrderedQuantity.ToString("N2")</td>

                                <td class="text-end text-success">
                                    @line.ReceivedQuantity.ToString("N2")
                                </td>

                                <td class="text-end fw-semibold text-warning">
                                    @((line.OrderedQuantity - line.ReceivedQuantity).ToString("N2"))
                                </td>

                                <td class="text-end">@line.UnitPrice.ToString("N2")</td>

                                <td class="text-end">@line.LineTotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>

    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private bool loading = true;
    private PurchaseOrderResponse? order;



    private async Task SendToVendor()
    {
        if (order is null)
            return;

        await ProcurementService.SendPurchaseOrderToVendorAsync(order.Id);

        order = await ProcurementService.GetPurchaseOrderAsync(order.Id);
    }

private async Task SubmitForApproval()
{
    if (order is null)
        return;

    await ProcurementService.SubmitPurchaseOrderForApprovalAsync(order.Id);

    order = await ProcurementService.GetPurchaseOrderAsync(order.Id);
}

private async Task ApprovePurchaseOrder()
{
    if (order is null)
        return;

    await ProcurementService.ApprovePurchaseOrderAsync(order.Id);

    order = await ProcurementService.GetPurchaseOrderAsync(order.Id);
}

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        order = await ProcurementService.GetPurchaseOrderAsync(Id);

        loading = false;

        await InvokeAsync(StateHasChanged);
    }

    private void GoBackToPurchaseOrders()
    {
        if (order == null || order.ConstructionSiteId == Guid.Empty)
        {
            Console.WriteLine("SiteId is missing.");
            return;
        }

        var url = $"/purchase-orders/site/{order.ConstructionSiteId}";
        Console.WriteLine($"Back URL: {url}");

        Navigation.NavigateTo(url);
    }


}