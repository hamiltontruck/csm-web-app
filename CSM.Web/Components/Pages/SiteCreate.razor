@page "/sites/create"
@implements IDisposable
@rendermode InteractiveServer

@using CSM.Web.Services
@using CSM.Web.Models.Sites

@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject IProjectService ProjectService
@inject NavigationManager Navigation
@inject IExecutiveDashboardService DashboardService
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage SessionStorage

<PageTitle>New Construction Site</PageTitle>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">New Construction Site</h2>

        <button class="btn btn-outline-secondary"
                @onclick="Back">
            Back
        </button>
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger" role="alert">@_error</div>
            }

            <div class="row g-3">
                @if (_canSelectCompany)
                {
                    <div class="col-12">
                        <label for="site-company" class="form-label">Company</label>
                        <select id="site-company" class="form-select" @bind="_companyId" disabled="@_saving">
                            <option value="">Select a company</option>
                            @foreach (var company in _companies)
                            {
                                <option value="@company.Id">@company.Name</option>
                            }
                        </select>
                    </div>
                }

                <div class="col-md-6">
                    <label class="form-label">Site Name</label>
                    <input class="form-control" @bind="Name"/>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Site Code</label>
                    <input class="form-control" @bind="SiteCode"/>
                </div>

                <div class="col-md-6">
                    <label class="form-label">City</label>
                    <input class="form-control" @bind="City"/>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Region</label>
                    <input class="form-control" @bind="Region"/>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Latitude</label>
                    <input type="number"
                           step="0.000001"
                           class="form-control"
                           @bind="Latitude" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Longitude</label>
                    <input type="number"
                           step="0.000001"
                           class="form-control"
                           @bind="Longitude" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Geofence (m)</label>
                    <input type="number"
                           class="form-control"
                           @bind="GeofenceRadiusMeters" />
                </div>

                <div class="col-12">
                    <label class="form-label">Description</label>
                    <textarea class="form-control"
                              rows="3"
                              @bind="Description">
                    </textarea>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Business Unit</label>

                    <select class="form-select" @bind="BusinessUnitId">
                        <option value="">-- None --</option>

                        @foreach (var unit in BusinessUnits)
                        {
                            <option value="@unit.Id">
                                @unit.Code - @unit.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label">Address</label>
                    <textarea class="form-control" rows="3" @bind="Address"></textarea>
                </div>

                <h5 class="mt-4 mb-3">GPS Location</h5>

                <div class="input-group mb-3">
                    <input class="form-control"
                           placeholder="Search Dire Dawa or address..."
                           @bind="SearchText" />

                    <button class="btn btn-outline-primary"
                            @onclick="SearchLocation">
                        Search
                    </button>
                </div>

                <div id="siteMap"
                     style="height:420px;border:1px solid #D6D6D6;border-radius:10px;">
                </div>

                <div class="row mt-3">

                    <div class="col-md-6">
                        <label class="form-label">Planned Start</label>
                        <InputDate class="form-control"
                                   @bind-Value="PlannedStartDate" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Planned Finish</label>
                        <InputDate class="form-control"
                                   @bind-Value="PlannedEndDate" />
                    </div>

                </div>

                <div class="row mt-3">

                    <div class="col-md-4">
                        <label class="form-label">Latitude</label>
                        <input class="form-control" readonly value="@Latitude" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Longitude</label>
                        <input class="form-control" readonly value="@Longitude" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Geofence Radius (m)</label>
                        <input class="form-control" type="number" @bind="GeofenceRadiusMeters" />
                    </div>

                </div>

            </div>

            <hr/>

            <div class="d-flex justify-content-end gap-2">

                <button class="btn btn-outline-secondary"
                        @onclick="Back">
                    Cancel
                </button>

                <button class="btn btn-primary" @onclick="Save" disabled="@(_saving || _initializing)">
                    @(_saving ? "Saving..." : "Save Site")
                </button>

            </div>

        </div>

    </div>

</div>

@code{
    private string Name = "";
    private string SiteCode = "";

    private string Address = "";
    private string City = "";
    private string Region = "";

    private decimal? Latitude = 9.5931M;
    private decimal? Longitude = 41.8661M;
    private decimal? GeofenceRadiusMeters = 100;

    private List<BusinessUnitModel> BusinessUnits = [];
    private Guid? BusinessUnitId;
    private string? Description;

    private DateOnly? PlannedStartDate;
    private DateOnly? PlannedEndDate;
    private string SearchText = "Dire Dawa";

    private DotNetObjectReference<SiteCreate>? mapReference;

    private Guid? _companyId;
    private bool _canSelectCompany;
    private bool _initializing = true;
    private bool _saving;
    private string? _error;
    private IReadOnlyList<CSM.Web.Models.Dashboard.DashboardCompany> _companies = [];

    private void setLatitude(decimal? value) => Latitude = value;
    private void setLongitude(decimal? value) => Longitude = value;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var roles = await SessionStorage.GetAsync<List<string>>("roles");
            _canSelectCompany = roles.Success && roles.Value?.Contains("SuperAdmin") == true;
            if (_canSelectCompany)
            {
                _companies = await DashboardService.GetCompaniesAsync();
                if (_companies.Count == 1)
                    _companyId = _companies[0].Id;
            }
            else
            {
                _companyId = await AuthService.GetCurrentCompanyIdAsync();
            }

            mapReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync(
                "siteMap.initialize", "siteMap",
                (double)Latitude!, (double)Longitude!, mapReference);
        }
        catch (Exception ex)
        {
            _error = $"Unable to initialize the site form. {ex.Message}";
        }
        finally
        {
            _initializing = false;
            StateHasChanged();
        }
    }

    private async Task SearchLocation()
    {
        await JS.InvokeVoidAsync(
            "siteMap.search",
            SearchText);
    }

    [JSInvokable]
    public void SetCoordinates(double latitude, double longitude)
    {
        Latitude = (decimal)latitude;
        Longitude = (decimal)longitude;

        StateHasChanged();
    }

    public void Dispose()
    {
        mapReference?.Dispose();
    }

    private void Back()
        => Navigation.NavigateTo("/project-tracking");

    private async Task Save()
    {
        if (_saving || _initializing)
            return;

        _error = null;
        if (string.IsNullOrWhiteSpace(SiteCode))
        {
            _error = "Site code is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(Name))
        {
            _error = "Site name is required.";
            return;
        }
        if (!_companyId.HasValue || _companyId == Guid.Empty)
        {
            _error = _canSelectCompany
                ? "Select a company before saving the site."
                : "Your account is not assigned to a company.";
            return;
        }

        _saving = true;
        try
        {
            var request = new CreateSiteRequest
            {
                CompanyId = _companyId.Value,
    
                Name = Name.Trim(),
                SiteCode = SiteCode.Trim(),
                Address = Address,
                City = City,
                Region = Region,
                Country = "Ethiopia",
    
                Latitude = Latitude,
                Longitude = Longitude,
                GeofenceRadiusMeters = GeofenceRadiusMeters,
    
                BusinessUnitId = BusinessUnitId,
                Description = Description,
    
                PlannedStartDate = PlannedStartDate,
                PlannedEndDate = PlannedEndDate
            };
    
            await ProjectService.CreateSiteAsync(request);
    
            Navigation.NavigateTo("/project-tracking", true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}