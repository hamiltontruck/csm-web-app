@page "/material-requests/{Id:guid}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.Procurement
@using CSM.Web.Services

@inject IProcurementService ProcurementService
@inject NavigationManager Navigation
@inject IAuthService AuthService

<PageTitle>Material Request Details</PageTitle>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="container pt-4">
        <div class="alert alert-danger" role="alert">@_error</div>
    </div>
}

@if (loading)
{
    <div class="container py-4">
        <h4>Loading...</h4>
    </div>
}
else if (request is null)
{
    <div class="container py-4">
        <div class="alert alert-warning">
            Material Request not found.
        </div>

        <button class="btn btn-secondary" @onclick="Back">
            Back
        </button>
    </div>
}
else
{
    <div class="container py-4">

        <button class="btn btn-outline-secondary mb-3"
                @onclick="Back">
            <i class="bi bi-arrow-left"></i> Back
        </button>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2>@request.RequestNumber</h2>
                <div class="text-muted">@request.SiteName</div>
            </div>

            <span id="request-status" class="badge bg-primary">@request.Status</span>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <h5 class="mb-0">Request Information</h5>
            </div>

            <div class="card-body">
                <div class="row">

                    <div class="col-md-6 mb-3">
                        <div class="text-muted small">Requested By</div>
                        <div class="fw-semibold">@request.RequestedByName</div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="text-muted small">Request Date</div>
                        <div class="fw-semibold">
                            @request.RequestDate.ToString("dd MMM yyyy")
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="text-muted small">Priority</div>
                        <div class="fw-semibold">@request.Priority</div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="text-muted small">Required By</div>
                        <div class="fw-semibold">
                            @(request.RequiredByDate?.ToString("dd MMM yyyy") ?? "-")
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="text-muted small">Purpose</div>
                        <div>@(string.IsNullOrWhiteSpace(request.Purpose) ? "-" : request.Purpose)</div>
                    </div>

                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0">Requested Materials</h5>
            </div>

            <div class="table-responsive">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Material</th>
                            <th>Unit</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Approved Qty</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>

                    <tbody>
                    @foreach (var line in request.Lines)
                    {
                        <tr>
                            <td>@line.MaterialName</td>
                            <td>@line.UnitOfMeasure</td>
                            <td class="text-end">@line.RequestedQuantity</td>
                            <td class="text-end">
                                @if (request.Status == "Submitted" && _canApprove)
                                {
                                    <input type="number" class="form-control" min="0" max="@line.RequestedQuantity"
                                           step="any" @bind="line.ApprovedQuantity" disabled="@_busy"
                                           aria-label="@($"Approved quantity for {line.MaterialName}")" />
                                }
                                else
                                {
                                    @line.ApprovedQuantity
                                }
                            </td>
                            <td>@line.Remarks</td>
                        </tr>
                    }
                    </tbody>

                </table>
            </div>
        </div>

        @if (request.Status == "Draft" && _canSubmit)
        {
            <div class="mt-3">
                <button id="submit-material-request" class="btn btn-primary" disabled="@_busy"
                        @onclick="Submit">Submit Request</button>
            </div>
        }
        @if (request.Status == "Submitted" && _canApprove)
        {
            <div class="mt-3">
                <label for="approval-remarks" class="form-label">Approval Remarks (optional)</label>
                <textarea id="approval-remarks" class="form-control mb-3" @bind="_approvalRemarks" disabled="@_busy"></textarea>
                <button id="approve-material-request" class="btn btn-success" disabled="@_busy"
                        @onclick="Approve">Approve Request</button>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool loading = true;
    private bool _busy;
    private bool _canSubmit;
    private bool _canApprove;
    private string? _error;
    private string? _approvalRemarks;
    private MaterialRequestResponse? request;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var permissions = await AuthService.GetPermissionsAsync();
            _canSubmit = permissions.Contains("Procurement_MaterialRequest_Submit");
            _canApprove = permissions.Contains("Procurement_MaterialRequest_Approve");
            request = await ProcurementService.GetMaterialRequestAsync(Id);
            PrepareApproval();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void PrepareApproval()
    {
        if (request?.Status != "Submitted") return;
        foreach (var line in request.Lines)
            line.ApprovedQuantity = line.RequestedQuantity;
    }

    private async Task Submit()
    {
        if (_busy || !_canSubmit || request?.Status != "Draft") return;
        _busy = true;
        _error = null;
        try
        {
            request = await ProcurementService.SubmitMaterialRequestAsync(Id);
            PrepareApproval();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Approve()
    {
        if (_busy || !_canApprove || request?.Status != "Submitted") return;
        _error = null;
        if (request.Lines.Any(x => x.ApprovedQuantity < 0))
        {
            _error = "Approved quantity cannot be negative.";
            return;
        }
        if (request.Lines.Any(x => x.ApprovedQuantity > x.RequestedQuantity))
        {
            _error = "Approved quantity cannot exceed requested quantity.";
            return;
        }
        if (!request.Lines.Any(x => x.ApprovedQuantity > 0))
        {
            _error = "At least one material must have an approved quantity.";
            return;
        }

        _busy = true;
        try
        {
            request = await ProcurementService.ApproveMaterialRequestAsync(Id, new ApproveMaterialRequestRequest
            {
                Remarks = _approvalRemarks,
                Lines = request.Lines.Select(x => new MaterialRequestApprovalLine
                {
                    MaterialRequestLineId = x.Id,
                    ApprovedQuantity = x.ApprovedQuantity
                }).ToList()
            });
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    void Back()
        => Navigation.NavigateTo("/material-requests");
}