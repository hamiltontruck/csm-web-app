@page "/equipment/fuel/edit/{SiteId:guid}/{FuelLogId:guid}"
@rendermode InteractiveServer

@using CSM.Web.Models.Equipment
@using CSM.Web.Models.Sites
@using CSM.Web.Services

@inject IEquipmentService EquipmentService
@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>Edit Fuel Entry</PageTitle>

<div class="container py-4">

    <div class="d-flex align-items-center mb-4">
        <button class="btn btn-outline-secondary me-3"
                @onclick="GoBack">
            ← Back
        </button>

        <div>
            <h2 class="mb-0">Edit Fuel Entry</h2>
            @if (!string.IsNullOrWhiteSpace(siteName))
            {
                <small class="text-muted">@siteName</small>
            }
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border"></div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else
    {
        <EditForm Model="request" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div class="card shadow-sm">
                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">Equipment</label>

                            <InputSelect class="form-select"
                                         @bind-Value="selectedEquipmentId">

                                @foreach (var item in equipment)
                                {
                                    <option value="@item.Id">
                                        @item.EquipmentCode - @item.Name
                                    </option>
                                }

                            </InputSelect>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Fuel Type</label>

                            <InputSelect class="form-select"
                                         @bind-Value="request.FuelType">
                                <option>Diesel</option>
                                <option>Petrol</option>
                            </InputSelect>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Fuel Date</label>
                            <InputDate class="form-control"
                                       @bind-Value="fuelDate" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Liters</label>
                            <InputNumber class="form-control"
                                         @bind-Value="request.Liters" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Unit Price</label>
                            <InputNumber class="form-control"
                                         @bind-Value="request.UnitPrice" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Meter Reading</label>
                            <InputNumber class="form-control"
                                         @bind-Value="request.MeterReading" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Supplier</label>
                            <InputText class="form-control"
                                       @bind-Value="request.SupplierName" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Invoice Number</label>
                            <InputText class="form-control"
                                       @bind-Value="request.InvoiceNumber" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Remarks</label>
                            <InputTextArea class="form-control"
                                           rows="3"
                                           @bind-Value="request.Remarks" />
                        </div>

                    </div>

                    <hr />

                    <div class="d-flex justify-content-end gap-2">

                        <button type="button"
                                class="btn btn-outline-secondary"
                                @onclick="GoBack">
                            Cancel
                        </button>

                        <button class="btn btn-primary"
                                type="submit"
                                disabled="@saving">
                            @(saving ? "Updating..." : "Update Fuel Entry")
                        </button>

                    </div>

                </div>
            </div>
        </EditForm>
    }

</div>

@code {

    [Parameter] public Guid SiteId { get; set; }
    [Parameter] public Guid FuelLogId { get; set; }

    private bool loading = true;
    private bool saving;
    private string? errorMessage;
    private string siteName = "";

    private Guid selectedEquipmentId;

    private DateTime fuelDate = DateTime.Today;

    private List<EquipmentResponse> equipment = [];

    private UpdateEquipmentFuelLogRequest request = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var sites = await ProjectService.GetSitesAsync();

            var site = sites.FirstOrDefault(x => x.Id == SiteId);

            if (site != null)
                siteName = site.Name;

            var assignments = await EquipmentService.GetAssignmentsAsync();

            var equipmentIds = assignments
                .Where(x =>
                    x.ConstructionSiteId == SiteId &&
                    x.ReleasedAtUtc == null)
                .Select(x => x.EquipmentId)
                .Distinct()
                .ToHashSet();

            equipment = (await EquipmentService.GetEquipmentAsync())
                .Where(x => equipmentIds.Contains(x.Id))
                .OrderBy(x => x.EquipmentCode)
                .ToList();

            var log = await EquipmentService.GetFuelLogByIdAsync(FuelLogId);

            if (log is not null)
            {
                fuelDate = log.RefueledAtUtc;

               selectedEquipmentId = log.EquipmentId;

               request = new UpdateEquipmentFuelLogRequest
               {
                   RefueledAtUtc = log.RefueledAtUtc,
                   Liters = log.Liters,
                   UnitPrice = log.UnitPrice,
                   MeterReading = log.MeterReading,
                   FuelType = log.FuelType,
                   SupplierName = log.SupplierName,
                   InvoiceNumber = log.InvoiceNumber,
                   Remarks = log.Remarks
               };
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        errorMessage = null;

        try
        {
            request.RefueledAtUtc = fuelDate;

            await EquipmentService.UpdateFuelLogAsync(
                FuelLogId,
                request);

            Navigation.NavigateTo(
                $"/equipment/fuel/site/{SiteId}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo(
            $"/equipment/fuel/site/{SiteId}");
    }
}