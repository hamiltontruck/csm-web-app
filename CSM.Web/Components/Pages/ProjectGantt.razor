@page "/projects/{Id:guid}/gantt"
@rendermode InteractiveServer

@using CSM.Web.Models.Projects
@using CSM.Web.Services

@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>Project Gantt Timeline</PageTitle>

@if (_loading)
{
    <div class="container mt-4">
        <h4>Loading Gantt Timeline...</h4>
    </div>
}
else if (!_tasks.Any())
{
    <div class="container mt-4">

        <button class="btn btn-outline-secondary mb-3"
                @onclick="Back">
            ← Back to Project
        </button>

        <div class="alert alert-info">
            No work tasks available for this project.
        </div>

    </div>
}
else
{
    <div class="container-fluid py-3">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <div>
                <h2 class="mb-0">Project Gantt Timeline</h2>

                <small class="text-muted">
                    @_start.ToString("dd MMM yyyy")
                    -
                    @_end.ToString("dd MMM yyyy")
                </small>
            </div>

            <button class="btn btn-outline-secondary"
                    @onclick="Back">
                ← Project
            </button>

        </div>

        <div class="gantt-wrapper">

            <table class="table align-middle mb-0 gantt-table">

                <thead>
                    <tr>

                        <th class="task-header">
                            Task
                        </th>

                        @for (int i = 0; i < _totalDays; i++)
                        {
                            var day = _start.AddDays(i);

                            <th class="day-header">
                                @day.Day
                            </th>
                        }

                    </tr>
                </thead>

                <tbody>

                    @foreach (var task in _tasks)
                    {
                        var start = task.PlannedStartDate!.Value
                            .ToDateTime(TimeOnly.MinValue);

                        var end = (task.PlannedEndDate ?? task.PlannedStartDate)!.Value
                            .ToDateTime(TimeOnly.MinValue);

                        <tr>

                            <td class="task-column">

                                <div class="fw-bold fs-6">
                                    @task.Title
                                </div>

                                <div class="d-flex gap-1 flex-wrap mt-2">
                                    <span class="badge bg-primary">
                                        @task.TaskNumber
                                    </span>

                                    <span class="badge @(task.Status == "Completed"
                                                            ? "bg-success"
                                                            : task.Status == "InProgress"
                                                                ? "bg-warning text-dark"
                                                                : task.Status == "Delayed"
                                                                    ? "bg-danger"
                                                                    : "bg-secondary")">
                                        @task.Status
                                    </span>
                                </div>

                                <small class="progress-text">
                                    Progress: @task.ProgressPercentage%
                                </small>

                            </td>

                            @for (int d = 0; d < _totalDays; d++)
                            {
                                var current = _start.AddDays(d);

                                bool active = current >= start && current <= end;

                                <td class="gantt-cell">

                                    @if (active)
                                    {
                                        <div class="gantt-bar"
                                             style="background:@BarColor(task.Status);"
                                             title="@($"{task.TaskNumber} - {task.Title} ({task.ProgressPercentage}%)")">
                                        </div>
                                    }

                                </td>
                            }

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="mt-3 d-flex gap-4 flex-wrap">

            <div>
                <span class="legend active"></span> Active
            </div>

            <div>
                <span class="legend completed"></span> Completed
            </div>

            <div>
                <span class="legend delayed"></span> Delayed
            </div>

            <div>
                <span class="legend planning"></span> Planning
            </div>

        </div>

    </div>
}

<style>
    .gantt-wrapper{
        overflow-x:auto;
        border:1px solid #dee2e6;
        border-radius:10px;
        background:#fff;
    }

    .gantt-table{
        table-layout:fixed;
        border-collapse:collapse;
        min-width:1500px;
        margin:0;
    }

    .task-header{
        width:280px;
        min-width:280px;
        position:sticky;
        left:0;
        z-index:3;
        background:#f8f9fa;
        padding:12px;
        text-align:left;
        border-right:1px solid #dee2e6;
        vertical-align:middle;
    }

    .task-column{
        width:280px;
        min-width:280px;
        position:sticky;
        left:0;
        background:#fff;
        z-index:2;
        padding:12px;
        vertical-align:top;
        border-right:1px solid #dee2e6;
    }

    .day-header{
        width:40px;
        min-width:40px;
        height:48px;
        text-align:center;
        font-size:12px;
        font-weight:600;
        background:#f8f9fa;
        border:1px solid #dee2e6;
        vertical-align:middle;
    }

    .gantt-cell{
        width:40px;
        min-width:40px;
        height:54px;
        padding:4px;
        border:1px solid #edf0f2;
        background:#fff;
    }

    .gantt-bar{
        width:100%;
        height:18px;
        border-radius:5px;
    }

    .progress-text{
        display:block;
        margin-top:6px;
        font-size:12px;
        color:#6c757d;
    }

    .legend{
        display:inline-block;
        width:16px;
        height:16px;
        border-radius:4px;
        margin-right:6px;
        vertical-align:middle;
    }

    .active{background:#198754;}
    .completed{background:#0d6efd;}
    .delayed{background:#dc3545;}
    .planning{background:#6c757d;}
</style>

@code {

    [Parameter]
    public Guid Id { get; set; }

    private List<WorkTask> _tasks = [];
    private bool _loading = true;
    private bool _loaded = false;

    private DateTime _start;
    private DateTime _end;
    private int _totalDays;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
            return;

        _loaded = true;

        _tasks = (await ProjectService.GetWorkTasksAsync(Id))
            .Where(t => t.PlannedStartDate.HasValue)
            .OrderBy(t => t.PlannedStartDate)
            .ToList();

        if (_tasks.Any())
        {
            _start = _tasks.Min(t => t.PlannedStartDate!.Value)
                .ToDateTime(TimeOnly.MinValue);

            _end = _tasks.Max(t =>
                (t.PlannedEndDate ?? t.PlannedStartDate)!.Value)
                .ToDateTime(TimeOnly.MinValue);

            _totalDays = (_end - _start).Days + 1;
        }

        _loading = false;
        StateHasChanged();
    }

    void Back()
    {
        Navigation.NavigateTo($"/projects/{Id}");
    }

    static string BarColor(string status) => status switch
    {
        "Active" => "#198754",
        "Completed" => "#0d6efd",
        "Delayed" => "#dc3545",
        "Planning" => "#6c757d",
        "InProgress" => "#FFC107",
        _ => "#6c757d"
    };
}