@page "/material-return-audit"
@rendermode InteractiveServer

@using CSM.Web.Models.Sites
@using CSM.Web.Services

@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>Material Return Audit</PageTitle>

@if (loading)
{
    <div class="container py-4">
        <h4>Loading construction sites...</h4>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="container py-4">
        <div class="alert alert-danger" role="alert">@errorMessage</div>
        @if (signInRequired)
        {
            <a id="material-return-audit-sites-sign-in" class="btn btn-primary" href="/login">Sign in</a>
        }
        else if (canRetry)
        {
            <button id="retry-material-return-audit-sites" class="btn btn-primary" @onclick="LoadAsync">Retry</button>
        }
        <button class="btn btn-outline-secondary ms-2" @onclick="GoBack">Back</button>
    </div>
}
else
{
    <div class="container py-4">

        <button class="btn btn-outline-secondary mb-3"
                @onclick="GoBack">
            <i class="bi bi-arrow-left"></i> Back
        </button>

        <h2>Material Return Audit</h2>

        <div class="text-muted mb-4">
            Select a construction site to review complete material return history.
        </div>

        @foreach (var site in sites)
        {
            <div class="card shadow-sm mb-3"
                 style="cursor:pointer"
                 @onclick="() => OpenSite(site.Id)">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <div class="fw-bold fs-5">
                            @site.SiteCode - @site.Name
                        </div>

                        <div class="text-muted">
                            Construction Site
                        </div>
                    </div>

                    <i class="bi bi-chevron-right fs-4"></i>

                </div>

            </div>
        }

    </div>
}

@code{
    private List<SiteResponse> sites = [];
    private bool loading = true;
    private bool loaded;

    private string? errorMessage;
    private bool canRetry = true;
    private bool signInRequired;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded) return;
        loaded = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        errorMessage = null;
        sites = [];
        canRetry = true;
        signInRequired = false;
        try
        {
            sites = await ProjectService.GetSitesAsync();
        }
        catch (HttpRequestException ex)
        {
            signInRequired = ex.StatusCode == System.Net.HttpStatusCode.Unauthorized;
            canRetry = ex.StatusCode is not (System.Net.HttpStatusCode.Unauthorized
                or System.Net.HttpStatusCode.Forbidden);
            errorMessage = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Your session is missing or has expired. Please sign in again.",
                System.Net.HttpStatusCode.Forbidden => "You do not have permission to view construction sites.",
                _ => "Unable to load construction sites. Please try again."
            };
        }
        catch (Exception)
        {
            errorMessage = "Unable to load construction sites. Please try again.";
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    void GoBack()
        => Navigation.NavigateTo("/stock-items");
}