@page "/purchase-orders/site/{SiteId:guid}"
@rendermode InteractiveServer

@using CSM.Web.Models.Procurement
@using CSM.Web.Services

@inject IProcurementService ProcurementService
@inject NavigationManager Navigation

<PageTitle>Purchase Orders</PageTitle>

@if (loading)
{
    <div class="container py-4">
        <h4>Loading purchase orders...</h4>
    </div>
}
else
{
    <div class="container py-4">

        <button class="btn btn-outline-secondary mb-3"
                @onclick="Back">
            <i class="bi bi-arrow-left"></i> Back
        </button>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2>Purchase Orders</h2>
                <div class="text-muted">Selected construction site</div>
            </div>

            <WorkspaceAction Route="/purchase-orders/create/{SiteId}">

                <button class="btn btn-primary"
                    @onclick="NewPurchaseOrder">
                + New Purchase Order
            </button>
            </WorkspaceAction>
        </div>

        @if (orders.Count == 0)
        {
            <div class="alert alert-info">
                No purchase orders found.
            </div>
        }
        else
        {
            @foreach (var po in orders)
            {
                <div class="card shadow-sm mb-3"
                     style="cursor:pointer"
                     @onclick="() => Open(po.Id)">

                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <h5>@po.PurchaseOrderNumber</h5>
                            <span class="badge bg-secondary">
                                @po.Status
                            </span>
                        </div>

                        <div class="text-muted">@po.VendorName</div>

                        <small>
                            @po.OrderDate.ToString("dd MMM yyyy")
                        </small>
                    </div>
                </div>
            }
        }

    </div>
}

@code {
    [Parameter]
    public Guid SiteId { get; set; }

    private bool loading = true;

    private List<PurchaseOrderResponse> orders = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var all = await ProcurementService.GetPurchaseOrdersAsync();

        orders = all
            .Where(x => x.ConstructionSiteId == SiteId)
            .OrderByDescending(x => x.OrderDate)
            .ToList();

        loading = false;

        await InvokeAsync(StateHasChanged);
    }

    void Open(Guid id)
        => Navigation.NavigateTo($"/purchase-orders/{id}");

    void NewPurchaseOrder()
        => Navigation.NavigateTo($"/purchase-orders/create/{SiteId}");

    void Back()
        => Navigation.NavigateTo("/purchase-orders");
}