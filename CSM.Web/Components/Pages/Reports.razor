@code {

    private ExecutiveDashboardResponse? _executive;
    private FinancialSummaryResponse? _financial;
    private AllFinancialSummaryResponse? _allFinancialSummary;

    private List<SiteResponse> _sites = [];

    private bool _canSelectCompany;
    private Guid? _selectedCompanyId;
    private IReadOnlyList<CSM.Web.Models.Dashboard.DashboardCompany> _companies = [];

    private string _scope = "Company";
    private string _selectedSiteId = string.Empty;

    private bool _loading = true;
    private string? _error;

    private bool CanReadCompanyFinance => Access.IsIn("SuperAdmin", "CompanyAdmin", "Accountant");
    private string CurrentScopeLabel
        => _scope == "Company"
            ? (CanReadCompanyFinance ? "Company-wide" : "Assigned sites")
            : _sites
                .FirstOrDefault(
                    x => x.Id.ToString() == _selectedSiteId)
                ?.Name
              ?? "Select a construction site";

    protected override async Task OnAccessLoadedAsync()
    {
        try
        {
            _canSelectCompany = Access.IsIn("SuperAdmin");
            if (_canSelectCompany)
            {
                _companies = await DashboardService.GetCompaniesAsync();
                return;
            }

            if (Access.Has("Sites_View")) await LoadSitesAsync();
            await LoadReportsAsync();
        }
        catch (Exception ex)
        {
            _error = "Unable to load reports for your current access. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CompanyChanged(ChangeEventArgs args)
    {
        _selectedCompanyId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null;
        _selectedSiteId = string.Empty;
        _scope = "Company";
        _executive = null;
        _financial = null;
        _allFinancialSummary = null;
        _error = null;
        if (!_selectedCompanyId.HasValue)
            return;
        if (Access.Has("Sites_View")) await LoadSitesAsync();
        await LoadReportsAsync();
    }

    private async Task LoadSitesAsync()
    {
        try
        {
            _sites =
                await ProjectService.GetSitesAsync();
            if (_selectedCompanyId.HasValue)
                _sites = _sites.Where(x => x.CompanyId == _selectedCompanyId.Value).ToList();
        }
        catch (Exception ex)
        {
            _error =
                $"Failed to load construction sites. {ex.Message}";
        }
    }

    private async Task ScopeChanged()
    {
        _error = null;

        if (_scope == "Company")
        {
            _selectedSiteId = string.Empty;
            await LoadReportsAsync();
        }
        else
        {
            _executive = null;
            _financial = null;
            _allFinancialSummary = null;
        }
    }

    private async Task SiteChanged()
    {
        _error = null;

        if (!Guid.TryParse(
                _selectedSiteId,
                out var siteId))
        {
            _executive = null;
            _financial = null;
            return;
        }

        await LoadSiteReportsAsync(siteId);
    }

    private async Task LoadReportsAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _executive = Access.Has("Reports_View")
                ? await ReportingService.GetExecutiveDashboardAsync(_selectedCompanyId) : null;

            _allFinancialSummary = Access.Has("Reports_FinancialSummary_View")
                ? await ReportingService.GetAllFinancialSummariesAsync(_selectedCompanyId) : null;
            _financial = Access.Has("Reports_FinancialSummary_View")
                ? (CanReadCompanyFinance ? await ReportingService.GetFinancialSummaryAsync(_selectedCompanyId) : _allFinancialSummary?.Total)
                : null;
        }
        catch (Exception ex)
        {
            _executive = null;
            _financial = null;
            _allFinancialSummary = null;
            _error = "Unable to load reports for your current access. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadSiteReportsAsync(
        Guid siteId)
    {
        _loading = true;
        _error = null;

        try
        {
            _executive = Access.Has("Reports_View")
                ? await ReportingService.GetSiteExecutiveDashboardAsync(siteId, _selectedCompanyId) : null;

            _financial = Access.Has("Reports_FinancialSummary_View")
                ? await ReportingService.GetSiteFinancialSummaryAsync(siteId, _selectedCompanyId) : null;
        }
        catch (Exception ex)
        {
            _executive = null;
            _financial = null;
            _allFinancialSummary = null;
            _error = "Unable to load reports for your current access. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }
}