                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 col-xl-4">
                                    <div class="card h-100 border">
                                        <div class="card-body">
                                            <div class="text-muted small">Outstanding Receivables</div>
                                            <div class="fs-5 fw-bold text-warning">
                                                @_allFinancialSummary.Company.OutstandingReceivables.ToString("N2")
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 col-xl-4">
                                    <div class="card h-100 border">
                                        <div class="card-body">
                                            <div class="text-muted small">Total Expenditure</div>
                                            <div class="fs-5 fw-bold text-danger">
                                                @_allFinancialSummary.Company.TotalExpenditure.ToString("N2")
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 col-xl-4">
                                    <div class="card h-100 border">
                                        <div class="card-body">
                                            <div class="text-muted small">Balance</div>
                                            <div class="fs-5 fw-bold text-success">
                                                @_allFinancialSummary.Company.Balance.ToString("N2")
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 col-xl-4">
                                    <div class="card h-100 border">
                                        <div class="card-body">
                                            <div class="text-muted small">Petty Cash Balance</div>
                                            <div class="fs-5 fw-bold">
                                                @_allFinancialSummary.Company.PettyCashBalance.ToString("N2")
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 col-xl-4">
                                    <div class="card h-100 border">
                                        <div class="card-body">
                                            <div class="text-muted small">Total Petty Cash Out</div>
                                            <div class="fs-5 fw-bold text-danger">
                                                @_allFinancialSummary.Company.TotalPettyCashOut.ToString("N2")
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 col-xl-4">
                                    <div class="card h-100 border">
                                        <div class="card-body">
                                            <div class="text-muted small">Active Petty Cash Accounts</div>
                                            <div class="fs-4 fw-bold">
                                                @_allFinancialSummary.Company.ActivePettyCashAccounts
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <hr class="my-4" />

                            }
                            <!-- Site Summaries -->
                            <h6 class="fw-bold mb-3">
                                Site Financial Summaries
                            </h6>

                            @if (_allFinancialSummary.Sites.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered table-hover align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Site</th>
                                                <th>Code</th>
                                                <th class="text-end">Budget</th>
                                                <th class="text-end">Expenses</th>
                                                <th class="text-end">Invoices</th>
                                                <th class="text-end">Receivables</th>
                                                <th class="text-end">Cash In</th>
                                                <th class="text-end">Total Expenditure</th>
                                                <th class="text-end">Balance</th>
                                                <th class="text-end">Petty Cash</th>
                                                <th class="text-end">Petty Cash Out</th>
                                                <th class="text-end">Accounts</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @foreach (var site in _allFinancialSummary.Sites)
                                            {
                                                <tr>
                                                    <td class="fw-semibold">
                                                        @site.SiteName
                                                    </td>

                                                    <td>
                                                        @site.SiteCode
                                                    </td>

                                                    <td class="text-end">
                                                        @site.Financial.TotalBudget.ToString("N2")
                                                    </td>

                                                    <td class="text-end">
                                                        @site.Financial.TotalExpenses.ToString("N2")
                                                    </td>

                                                    <td class="text-end">
                                                        @site.Financial.TotalInvoices.ToString("N2")
                                                    </td>
                                                    <td class="text-end">
                                                        @site.Financial.OutstandingReceivables.ToString("N2")
                                                    </td>

                                                    <td class="text-end text-success">
                                                        @site.Financial.TotalCompletedPayments.ToString("N2")
                                                    </td>

                                                    <td class="text-end text-danger">
                                                        @site.Financial.TotalExpenditure.ToString("N2")
                                                    </td>

                                                    <td class="text-end text-success">
                                                        @site.Financial.Balance.ToString("N2")
                                                    </td>

                                                    <td class="text-end">
                                                        @site.Financial.PettyCashBalance.ToString("N2")
                                                    </td>

                                                    <td class="text-end text-danger">
                                                        @site.Financial.TotalPettyCashOut.ToString("N2")
                                                    </td>

                                                    <td class="text-end">
                                                        @site.Financial.ActivePettyCashAccounts
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-muted">
                                    No site financial data available.
                                </div>
                            }

                            <hr class="my-4" />

                            <!-- Combined Total -->
                            <h6 class="fw-bold mb-3">
                                Combined @(CanReadCompanyFinance ? "Company + All Sites" : "Assigned Sites") Total
                            </h6>

                            <div class="row g-3">

                                <div class="col-md-6 col-xl-4">
                                    <div class="card h-100 border">
                                        <div class="card-body">
                                            <div class="text-muted small">
                                                Budget
                                            </div>
                                            <div class="fs-5 fw-bold">
                                                @_allFinancialSummary.Total.TotalBudget.ToString("N2")
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 col-xl-4">
                                    <div class="card h-100 border">
                                        <div class="card-body">
                                            <div class="text-muted small">Total Expenses</div>
                                            <div class="fs-5 fw-bold text-danger">
                                                @_allFinancialSummary.Total.TotalExpenses.ToString("N2")
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 col-xl-4">
                                    <div class="card h-100 border">
                                        <div class="card-body">
                                            <div class="text-muted small">
                                                Cash In
                                            </div>
                                            <div class="fs-5 fw-bold text-success">
                                                @_allFinancialSummary.Total.TotalCompletedPayments.ToString("N2")
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 col-xl-4">
                                    <div class="card h-100 border">
                                        <div class="card-body">
                                            <div class="text-muted small">
                                                Total Expenditure
