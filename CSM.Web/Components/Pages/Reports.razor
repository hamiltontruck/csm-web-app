                                <div class="fs-5 fw-bold text-danger">
                                    @_financial?.TotalExpenditure.ToString("N2")
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-xl-4">
                        <div class="card h-100 border">
                            <div class="card-body">
                                <div class="text-muted small">Balance</div>
                                <div class="fs-5 fw-bold text-success">
                                    @_financial?.Balance.ToString("N2")
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-xl-4">
                        <div class="card h-100 border">
                            <div class="card-body">
                                <div class="text-muted small">Petty Cash Balance</div>
                                <div class="fs-5 fw-bold">
                                    @_financial?.PettyCashBalance.ToString("N2")
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-xl-4">
                        <div class="card h-100 border">
                            <div class="card-body">
                                <div class="text-muted small">Total Petty Cash Out</div>
                                <div class="fs-5 fw-bold text-danger">
                                    @_financial?.TotalPettyCashOut.ToString("N2")
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-xl-4">
                        <div class="card h-100 border">
                            <div class="card-body">
                                <div class="text-muted small">Active Petty Cash Accounts</div>
                                <div class="fs-4 fw-bold">
                                    @_financial?.ActivePettyCashAccounts
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        }

                <!-- All Financial Summary -->
                @if (_scope == "Company" && _allFinancialSummary is not null)
                {
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-dark text-white">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h5 class="mb-0">
                                        <i class="bi bi-bar-chart-line me-2"></i>
                                        All Financial Summary
                                    </h5>
                                    <small>
                                        @(CanReadCompanyFinance ? "Company and all construction sites" : "Assigned construction sites")
                                    </small>
                                </div>

                                <span class="badge bg-light text-dark">
                                    @(CanReadCompanyFinance ? "Company + All Sites" : "Assigned Sites")
                                </span>
                            </div>
                        </div>

                        <div class="card-body">

                            @if (_allFinancialSummary.Company is not null)
                            {
                            <!-- Company Summary -->
                            <h6 class="fw-bold mb-3">
                                Company Summary
                            </h6>

                            <div class="row g-3 mb-4">

                                <div class="col-md-6 col-xl-4">
                                    <div class="card h-100 border">
                                        <div class="card-body">
                                            <div class="text-muted small">Budget</div>
                                            <div class="fs-5 fw-bold">
                                                @_allFinancialSummary.Company.TotalBudget.ToString("N2")
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 col-xl-4">
                                    <div class="card h-100 border">
                                        <div class="card-body">
                                            <div class="text-muted small">Total Expenses</div>
                                            <div class="fs-5 fw-bold text-danger">
                                                @_allFinancialSummary.Company.TotalExpenses.ToString("N2")
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 col-xl-4">
                                    <div class="card h-100 border">
                                        <div class="card-body">
                                            <div class="text-muted small">Cash In</div>
                                            <div class="fs-5 fw-bold text-success">
                                                @_allFinancialSummary.Company.TotalCompletedPayments.ToString("N2")
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 col-xl-4">
                                    <div class="card h-100 border">
                                        <div class="card-body">
                                            <div class="text-muted small">Invoices</div>
                                            <div class="fs-5 fw-bold">
