                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 col-xl-4">
                                    <div class="card h-100 border">
                                        <div class="card-body">
                                            <div class="text-muted small">
                                                Petty Cash Balance
                                            </div>
                                            <div class="fs-5 fw-bold">
                                                @_allFinancialSummary.Total.PettyCashBalance.ToString("N2")
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 col-xl-4">
