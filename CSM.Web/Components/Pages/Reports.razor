@inherits WorkspacePageBase
@page "/reports"

@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.Reporting
@using CSM.Web.Models.Sites
@using CSM.Web.Services

@inject IReportingService ReportingService
@inject IProjectService ProjectService
@inject IExecutiveDashboardService DashboardService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage SessionStorage

<PageTitle>Reports & Analytics</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Reports & Analytics</h2>
            <p class="text-muted mb-0">
                @(_scope == "Company"
                    ? (CanReadCompanyFinance ? "Company-wide management reports and financial analytics." : "Reports for your assigned sites.")
                    : $"{CurrentScopeLabel} management reports and financial analytics.")
            </p>
        </div>
    </div>

    @if (_canSelectCompany)
    {
        <div class="mb-3">
            <label for="reports-company" class="form-label">Company</label>
            <select id="reports-company" class="form-select" value="@_selectedCompanyId"
                    @onchange="CompanyChanged" disabled="@_loading">
                <option value="">Select a company</option>
                @foreach (var company in _companies)
                {
                    <option value="@company.Id">@company.Name</option>
                }
            </select>
        </div>
    }

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status"></div>
            <div class="mt-2">Loading reports...</div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">
            @_error
        </div>
    }
    else if (_canSelectCompany && !_selectedCompanyId.HasValue)
    {
        <div class="alert alert-info" role="status">
            @(_companies.Count == 0 ? "No companies are available." : "Select a company to view its reports.")
        </div>
    }
    else
    {
        <!-- Executive Summary -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">

                <div class="row g-3 align-items-end">

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Report Scope
                        </label>

                        <InputSelect class="form-select"
                                     @bind-Value="_scope"
                                     @bind-Value:after="ScopeChanged">
                            <option value="Company">@(CanReadCompanyFinance ? "Company" : "Assigned sites")</option>
                            <option value="Site">Site</option>
                        </InputSelect>
                    </div>

                    @if (_scope == "Site")
                    {
                        <div class="col-md-5">
                            <label class="form-label fw-semibold">
                                Construction Site
                            </label>

                            <InputSelect class="form-select"
                                         @bind-Value="_selectedSiteId"
                                         @bind-Value:after="SiteChanged">

                                <option value="">-- Select Site --</option>

                                @foreach (var site in _sites)
                                {
                                    <option value="@site.Id">
                                        @site.Name
                                        (@site.SiteCode)
                                    </option>
                                }

                            </InputSelect>
                        </div>
                    }

                    <div class="col-md-3">
                        <div class="text-muted small">
                            Current Scope
                        </div>

                        <div class="fw-semibold">
                            @CurrentScopeLabel
                        </div>
                    </div>

                </div>

            </div>
        </div>

        @if (_executive is not null)
        {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0">
                            <i class="bi bi-speedometer2 me-2"></i>
                            Executive Report
                        </h5>
                        <small>
                            @(_scope == "Company"
                                ? (CanReadCompanyFinance ? "Company-wide management overview" : "Assigned site management overview")
                                : $"{CurrentScopeLabel} management overview")
                        </small>
                    </div>

                    <span class="badge bg-light text-dark">
                        @CurrentScopeLabel
                    </span>
                </div>
            </div>

            <div class="card-body">

                @if (_financial is not null)
                {
                <div class="row g-3">

                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border">
                            <div class="card-body">
                                <div class="text-muted small">
                                    Budget
                                </div>
                                <div class="fs-5 fw-bold">
                                    @_financial?.TotalBudget.ToString("N2")
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border">
                            <div class="card-body">
                                <div class="text-muted small">
                                    Cash In
                                </div>
                                <div class="fs-5 fw-bold text-success">
                                    @_financial?.TotalCompletedPayments.ToString("N2")
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border">
                            <div class="card-body">
                                <div class="text-muted small">
                                    Total Expenditure
                                </div>
                                <div class="fs-5 fw-bold text-danger">
                                    @_financial?.TotalExpenditure.ToString("N2")
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border">
                            <div class="card-body">
                                <div class="text-muted small">
                                    Balance
                                </div>
                                <div class="fs-5 fw-bold text-success">
                                    @_financial?.Balance.ToString("N2")
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border">
                            <div class="card-body">
                                <div class="text-muted small">
                                    Petty Cash Balance
                                </div>
                                <div class="fs-5 fw-bold">
                                    @_financial?.PettyCashBalance.ToString("N2")
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border">
                            <div class="card-body">
                                <div class="text-muted small">
                                    Active Petty Cash Accounts
                                </div>
                                <div class="fs-4 fw-bold">
                                    @_financial?.ActivePettyCashAccounts
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <hr class="my-4" />
                }


                <div class="row g-4">

                    <div class="col-lg-6">
                        <h6 class="fw-bold mb-3">
                            Sites by Status
                        </h6>

                        @if (_executive?.SitesByStatus.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Status</th>
                                            <th class="text-end">Count</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in _executive.SitesByStatus)
                                        {
                                            <tr>
                                                <td>@item.Key</td>
                                                <td class="text-end">@item.Value</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">
                                No site status data available.
                            </div>
                        }
                    </div>

                    <div class="col-lg-6">
                        <h6 class="fw-bold mb-3">
                            Projects by Status
                        </h6>

                        @if (_executive?.ProjectsByStatus.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Status</th>
                                            <th class="text-end">Count</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in _executive.ProjectsByStatus)
                                        {
                                            <tr>
                                                <td>@item.Key</td>
                                                <td class="text-end">@item.Value</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">
                                No project status data available.
                            </div>
                        }
                    </div>

                </div>

            </div>
        </div>

        }

        @if (_financial is not null)
        {
