@page "/compliance/document-categories/create"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using System.Net
@using CSM.Web.Models.Compliance
@using CSM.Web.Services

@inject IComplianceService ComplianceService
@inject NavigationManager Navigation

<PageTitle>Create Document Category</PageTitle>

<div class="container-fluid py-3">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Create Document Category</h2>
            <p class="text-muted mb-0">
                Create a document category for the compliance and document management system.
            </p>
        </div>

        <button class="btn btn-secondary"
                @onclick="Back">
            Back
        </button>
    </div>

    @if (_loading)
    {
        <div class="alert alert-info">Loading document category form...</div>
    }
    else if (!_formReady)
    {
        <div class="alert alert-danger" role="alert">@_loadError</div>
        @if (_accessStatus == HttpStatusCode.Unauthorized)
        {
            <a id="category-create-sign-in" class="btn btn-primary" href="/login?returnUrl=%2Fcompliance%2Fdocument-categories%2Fcreate">Sign in</a>
        }
        else if (_accessStatus is not HttpStatusCode.Forbidden and not HttpStatusCode.NotFound)
        {
            <button id="retry-category-create" class="btn btn-outline-primary" @onclick="LoadAsync">Retry</button>
        }
    }
    else
    {
    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger">
            @_errorMessage
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label">Category Code</label>
                    <input class="form-control"
                           @bind="_request.CategoryCode"
                           maxlength="30"
                           placeholder="e.g. SAFETY" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Name</label>
                    <input class="form-control"
                           @bind="_request.Name"
                           maxlength="200"
                           placeholder="e.g. Safety Documents" />
                </div>

                <div class="col-12">
                    <label class="form-label">Description</label>
                    <textarea class="form-control"
                              @bind="_request.Description"
                              maxlength="1000"
                              rows="4"
                              placeholder="Enter category description"></textarea>
                </div>

                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               id="isActive"
                               @bind="_request.IsActive" />

                        <label class="form-check-label" for="isActive">
                            Active
                        </label>
                    </div>
                </div>

            </div>

            <div class="d-flex gap-2 mt-4">

                <WorkspaceAction Route="/compliance/document-categories">

                    <button class="btn btn-primary"
                        @onclick="Save"
                        disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save</span>
                    }
                </button>
            </WorkspaceAction>

                <button class="btn btn-secondary"
                        @onclick="Back"
                        disabled="@_saving">
                    Cancel
                </button>

            </div>

        </div>
    </div>

    }
</div>

@code {
    private readonly CreateDocumentCategoryRequest _request = new()
    {
        IsActive = true
    };

    private bool _saving;
    private bool _loading = true;
    private bool _formReady;
    private string? _loadError;
    private HttpStatusCode? _accessStatus;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _formReady = false;
        _loadError = null;
        _accessStatus = null;
        try
        {
            await ComplianceService.GetDocumentCategoriesAsync();
            _formReady = true;
        }
        catch (Exception ex)
        {
            _accessStatus = (ex as HttpRequestException)?.StatusCode;
            _loadError = _accessStatus switch
            {
                HttpStatusCode.Unauthorized => "Your session is missing or has expired. Please sign in again.",
                HttpStatusCode.Forbidden => "You do not have permission to create document categories.",
                _ => "Unable to load document category form. Please try again."
            };
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
    private string? _errorMessage;

    private async Task Save()
    {
        if (_saving || !_formReady) return;
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_request.CategoryCode))
        {
            _errorMessage = "Category Code is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_request.Name))
        {
            _errorMessage = "Name is required.";
            return;
        }

        try
        {
            _saving = true;

            await ComplianceService.CreateDocumentCategoryAsync(_request);

            Navigation.NavigateTo(
                "/compliance/document-categories");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void Back()
    {
        Navigation.NavigateTo(
            "/compliance/document-categories");
    }
}