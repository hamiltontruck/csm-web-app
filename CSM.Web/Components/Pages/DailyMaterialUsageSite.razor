@page "/daily-material-usage/site/{SiteId:guid}"
@rendermode InteractiveServer

@using CSM.Web.Models.Procurement
@using CSM.Web.Services

@inject IInventoryService InventoryService
@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>Site Daily Material Usage</PageTitle>

@if (loading)
{
    <div class="container py-4">
        <h4>Loading...</h4>
    </div>
}
else
{
    <div class="container py-4">

        <button class="btn btn-outline-secondary mb-3"
                @onclick="GoBack">
            <i class="bi bi-arrow-left"></i> Back
        </button>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">

            <div>
                <h2>@siteName</h2>
                <div class="text-muted">
                    Daily Material Usage
                </div>
            </div>

            @if (errorMessage is null)
            {
            <WorkspaceAction Route="/daily-material-usage/create/{SiteId}">
                <button class="btn btn-primary"
                    @onclick="NewUsage">
                <i class="bi bi-plus-lg"></i>
                New Usage
            </button>
            </WorkspaceAction>
            }

        </div>

        @if (errorMessage is not null)
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
            @if (canRetry) { <button id="retry-daily-usage-history" class="btn btn-outline-primary" @onclick="LoadAsync">Retry</button> }
        }
        else if (records.Count == 0)
        {
            <div class="alert alert-info">
                No daily usage records for this site.
            </div>
        }
        else
        {
            @foreach (var item in records)
            {
                <div class="card shadow-sm mb-3">
                    <div class="card-body">

                        <div class="d-flex justify-content-between">

                            <div>
                                <div class="fw-bold">
                                    @item.MaterialCode - @item.MaterialName
                                </div>

                                <small class="text-muted">
                                    @item.Date.ToString("dd MMM yyyy")
                                </small>
                            </div>

                            <div class="text-end">
                                <div class="fw-bold">
                                    @item.QuantityUsed @item.Unit
                                </div>

                                @if (item.RequiresSupervisorReview)
                                {
                                    <span class="badge bg-danger">
                                        Review
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        OK
                                    </span>
                                }
                            </div>

                        </div>

                        <hr />

                        <div class="row text-center">

                            <div class="col">
                                <small class="text-muted">Issued</small>
                                <div>@item.QuantityIssued</div>
                            </div>

                            <div class="col">
                                <small class="text-muted">Used</small>
                                <div>@item.QuantityUsed</div>
                            </div>

                            <div class="col">
                                <small class="text-muted">Returned</small>
                                <div>@item.QuantityReturned</div>
                            </div>

                            <div class="col">
                                <small class="text-muted">Variance</small>
                                <div>@item.QuantityVariance</div>
                            </div>

                        </div>

                    </div>
                </div>
            }
        }

    </div>
}

@code {
    [Parameter] public Guid SiteId { get; set; }
    private List<DailyMaterialUsageResponse> records = [];
    private bool loading = true, loadStarted, hasParameters, canRetry;
    private Guid parameterSite;
    private int version;
    private string siteName = "Construction Site";
    private string? errorMessage;
    protected override void OnParametersSet()
    {
        if (hasParameters && parameterSite == SiteId) return;
        hasParameters = true; parameterSite = SiteId; version++; loading = true; loadStarted = false;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (loadStarted) return;
        loadStarted = true;
        await LoadAsync();
    }
    private async Task LoadAsync()
    {
        var current = ++version; var siteId = SiteId;
        loading = true; errorMessage = null; records = []; canRetry = true;
        try
        {
            var sitesTask = ProjectService.GetSitesAsync();
            var recordsTask = InventoryService.GetDailyMaterialUsageAsync();
            await Task.WhenAll(sitesTask, recordsTask);
            if (current != version) return;
            var site = sitesTask.Result.FirstOrDefault(x => x.Id == siteId);
            if (site is null) throw new HttpRequestException("Site is unavailable.", null, System.Net.HttpStatusCode.Forbidden);
            siteName = site.Name;
            records = recordsTask.Result.Where(x => x.ConstructionSiteId == siteId).OrderByDescending(x => x.Date).ToList();
        }
        catch (Exception ex)
        {
            if (current != version) return;
            canRetry = ex is not HttpRequestException { StatusCode: System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden };
            errorMessage = ex is HttpRequestException http ? http.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Your session has expired. Please sign in again.",
                System.Net.HttpStatusCode.Forbidden => "You do not have permission to view daily material usage for this site.",
                _ => "Unable to load daily material usage. Please try again."
            } : "Unable to load daily material usage. Please try again.";
        }
        finally { if (current == version) { loading = false; await InvokeAsync(StateHasChanged); } }
    }
    private void GoBack() => Navigation.NavigateTo("/daily-material-usage");
    private void NewUsage() => Navigation.NavigateTo($"/daily-material-usage/create/{SiteId}");
}
