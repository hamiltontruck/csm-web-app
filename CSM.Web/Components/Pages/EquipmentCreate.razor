@page "/equipment/create"
@using CSM.Web.Models.Equipment
@using CSM.Web.Services
@inject IEquipmentService EquipmentService
@inject NavigationManager Navigation

<PageTitle>New Equipment</PageTitle>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">New Equipment</h3>

        <button class="btn btn-outline-secondary"
                @onclick="GoBack">
            Back
        </button>
    </div>

    @if (loading)
    {
        <p>Checking equipment access...</p>
    }
    else if (!canCreate)
    {
        <div class="alert alert-danger" role="alert">@accessError</div>
        @if (signInRequired)
        {
            <a id="equipment-create-sign-in" class="btn btn-primary" href="/login?returnUrl=%2Fequipment%2Fcreate">Sign in</a>
        }
        else if (canRetry)
        {
            <button id="retry-equipment-create-access" class="btn btn-primary" @onclick="CheckAccessAsync">Retry</button>
        }
    }
    else
    {
    <EditForm Model="model" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="card shadow-sm mb-3">
            <div class="card-header">
                <strong>Equipment Information</strong>
            </div>

            <div class="card-body">
                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label">Equipment Code</label>
                        <InputText class="form-control"
                                   @bind-Value="model.EquipmentCode" />
                    </div>

                    <div class="col-md-8">
                        <label class="form-label">Name</label>
                        <InputText class="form-control"
                                   @bind-Value="model.Name" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Category</label>
                        <InputText class="form-control"
                                   @bind-Value="model.Category" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Make</label>
                        <InputText class="form-control"
                                   @bind-Value="model.Make" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Model</label>
                        <InputText class="form-control"
                                   @bind-Value="model.Model" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Serial Number</label>
                        <InputText class="form-control"
                                   @bind-Value="model.SerialNumber" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Registration</label>
                        <InputText class="form-control"
                                   @bind-Value="model.RegistrationNumber" />
                    </div>

                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header">
                <strong>Ownership & Meter</strong>
            </div>

            <div class="card-body">
                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label">Ownership</label>
                        <InputSelect class="form-select"
                                     @bind-Value="model.OwnershipType">
                            <option>Owned</option>
                            <option>Rented</option>
                        </InputSelect>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Current Meter</label>
                        <InputNumber class="form-control"
                                     @bind-Value="model.CurrentMeterReading" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Meter Unit</label>
                        <InputSelect class="form-select"
                                     @bind-Value="model.MeterUnit">
                            <option>Hours</option>
                            <option>KM</option>
                        </InputSelect>
                    </div>

                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <strong>Cost Information</strong>
            </div>

            <div class="card-body">
                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Purchase Cost (ETB)</label>

                        <div class="input-group">
                            <span class="input-group-text">ETB</span>
                            <InputNumber class="form-control"
                                         @bind-Value="model.PurchaseCost" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Rental Rate</label>
                        <InputNumber class="form-control"
                                     @bind-Value="model.RentalRate" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Rental Start</label>
                        <InputDate class="form-control"
                                   @bind-Value="model.RentalStartDate" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Rental End</label>
                        <InputDate class="form-control"
                                   @bind-Value="model.RentalEndDate" />
                    </div>

                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-primary"
                    type="submit"
                    disabled="@saving">
                @(saving ? "Saving..." : "Create Equipment")
            </button>

            <button class="btn btn-outline-secondary"
                    type="button"
                    @onclick="GoBack">
                Cancel
            </button>
        </div>

    </EditForm>
    }

</div>

@code {
    private readonly CreateEquipmentRequest model = new();
    private bool saving;

    private bool loading = true;
    private bool canCreate;
    private bool canRetry = true;
    private bool signInRequired;
    private string? accessError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await CheckAccessAsync();
    }

    private async Task CheckAccessAsync()
    {
        loading = true;
        canCreate = false;
        canRetry = true;
        signInRequired = false;
        accessError = null;
        try
        {
            // GET and POST share the same controller role gate; the API is authoritative.
            _ = await EquipmentService.GetEquipmentAsync();
            canCreate = true;
        }
        catch (HttpRequestException ex)
        {
            signInRequired = ex.StatusCode == System.Net.HttpStatusCode.Unauthorized;
            canRetry = ex.StatusCode is not (System.Net.HttpStatusCode.Unauthorized
                or System.Net.HttpStatusCode.Forbidden);
            accessError = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Your session is missing or has expired. Please sign in again.",
                System.Net.HttpStatusCode.Forbidden => "You do not have permission to create equipment.",
                _ => "Unable to verify equipment access. Please try again."
            };
        }
        catch (Exception)
        {
            accessError = "Unable to verify equipment access. Please try again.";
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task Save()
    {
        if (saving || !canCreate) return;

        saving = true;

        var id = await EquipmentService.CreateEquipmentAsync(model);

        Navigation.NavigateTo($"/equipment/{id}");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/equipment");
    }
}