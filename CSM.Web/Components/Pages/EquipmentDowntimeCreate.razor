@page "/equipment/downtime/create/{SiteId:guid}"

@using CSM.Web.Models.Equipment
@using CSM.Web.Services

@inject IEquipmentService EquipmentService
@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>New Equipment Downtime</PageTitle>

<div class="container py-4">

    <div class="d-flex align-items-center mb-4">

        <button class="btn btn-outline-secondary me-3"
                @onclick="GoBack">
            ← Back
        </button>

        <h3 class="mb-0">
            New Equipment Downtime
        </h3>

    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border"></div>

            <div class="mt-2 text-muted">
                Loading...
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
        @if (signInRequired)
        {
            <a id="equipment-downtime-create-sign-in" class="btn btn-primary" href="@SignInUrl">Sign in</a>
        }
        else if (canRetry)
        {
            <button id="retry-equipment-downtime-create" class="btn btn-primary" @onclick="LoadFormAsync">Retry</button>
        }
    }
    else
    {
        <EditForm Model="model"
                  OnValidSubmit="CreateDowntime">

            <DataAnnotationsValidator />

            <div class="card shadow-sm">

                <div class="card-body">

                    <div class="mb-3">

                        <label class="form-label">
                            Construction Site
                        </label>

                        <input class="form-control"
                               value="@siteName"
                               disabled />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Equipment
                        </label>

                        <InputSelect class="form-select"
                                     @bind-Value="model.EquipmentId">

                            <option value="@Guid.Empty">
                                -- Select Equipment --
                            </option>

                            @foreach (var equipment in equipmentList)
                            {
                                <option value="@equipment.Id">
                                    @equipment.EquipmentCode -
                                    @equipment.Name
                                </option>
                            }

                        </InputSelect>

                        <ValidationMessage For="@(() => model.EquipmentId)" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Downtime Number
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="model.DowntimeNumber" />

                        <ValidationMessage For="@(() => model.DowntimeNumber)" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Start Date & Time
                        </label>

                        <InputDate class="form-control"
                                   Type="InputDateType.DateTimeLocal"
                                   @bind-Value="model.StartedAtUtc" />

                        <ValidationMessage For="@(() => model.StartedAtUtc)" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            End Date & Time
                        </label>

                        <InputDate class="form-control"
                                   Type="InputDateType.DateTimeLocal"
                                   @bind-Value="model.EndedAtUtc" />

                        <div class="form-text">
                            Leave blank to keep the downtime open.
                        </div>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Reason
                        </label>

                        <InputTextArea class="form-control"
                                       rows="4"
                                       @bind-Value="model.Reason" />

                        <ValidationMessage For="@(() => model.Reason)" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Resolution
                        </label>

                        <InputTextArea class="form-control"
                                       rows="4"
                                       @bind-Value="model.Resolution" />

                    </div>

                </div>

                <div class="card-footer d-flex justify-content-end gap-2">

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="GoBack">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Create Downtime
                    </button>

                </div>

            </div>

        </EditForm>
    }

</div>

@code {

    [Parameter]
    public Guid SiteId { get; set; }

    private CreateEquipmentDowntimeRequest model = new()
    {
        StartedAtUtc = DateTime.Now
    };

    private List<EquipmentResponse> equipmentList = [];

    private string siteName = string.Empty;

    private bool loading = true;

    private string? errorMessage;

    private bool canManage;
    private bool canRetry = true;
    private bool signInRequired;
    private string SignInUrl => "/login?returnUrl=" +
        Uri.EscapeDataString($"/equipment/downtime/create/{SiteId}");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadFormAsync();
    }

    private async Task LoadFormAsync()
    {
        loading = true;
        canManage = false;
        canRetry = true;
        signInRequired = false;
        errorMessage = null;
        equipmentList = [];
        siteName = string.Empty;
        try
        {
            // Check downtime access before loading creation options or displaying fields.
            _ = await EquipmentService.GetDowntimeAsync();
            var sites = await ProjectService.GetSitesAsync();
            var site = sites.FirstOrDefault(x => x.Id == SiteId);
            if (site is null)
            {
                errorMessage = "Construction site was not found.";
                canRetry = false;
                return;
            }
            siteName = site.Name;
            model.ConstructionSiteId = SiteId;
            equipmentList = await EquipmentService.GetEquipmentAsync();
            canManage = true;
        }
        catch (HttpRequestException ex)
        {
            signInRequired = ex.StatusCode == System.Net.HttpStatusCode.Unauthorized;
            canRetry = ex.StatusCode is not (System.Net.HttpStatusCode.Unauthorized
                or System.Net.HttpStatusCode.Forbidden);
            errorMessage = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Your session is missing or has expired. Please sign in again.",
                System.Net.HttpStatusCode.Forbidden => "You do not have permission to create equipment downtime.",
                _ => "Unable to load downtime form. Please try again."
            };
        }
        catch (Exception)
        {
            errorMessage = "Unable to load downtime form. Please try again.";
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task CreateDowntime()
    {
        if (!canManage) return;

        errorMessage = null;

        try
        {
            model.ConstructionSiteId = SiteId;

            await EquipmentService.CreateDowntimeAsync(model);

            Navigation.NavigateTo(
                $"/equipment/downtime/site/{SiteId}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;

            await InvokeAsync(StateHasChanged);
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo(
            $"/equipment/downtime/site/{SiteId}");
    }
}