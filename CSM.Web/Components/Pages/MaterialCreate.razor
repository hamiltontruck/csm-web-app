@page "/materials/create"
@rendermode InteractiveServer

@using CSM.Web.Models.Procurement
@using CSM.Web.Services

@inject IProcurementService ProcurementService
@inject NavigationManager Navigation
@inject IExecutiveDashboardService DashboardService
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage SessionStorage

<PageTitle>New Material</PageTitle>

<div class="container py-4" style="max-width:700px">

    <button class="btn btn-outline-secondary mb-3" @onclick="Cancel">
        ← Materials
    </button>

    <h3 class="mb-4">Create Material</h3>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    <EditForm Model="_model" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <ValidationSummary />

        @if (_canSelectCompany)
        {
            <div class="mb-3">
                <label for="material-company" class="form-label">Company</label>
                <select id="material-company" class="form-select" @bind="_model.CompanyId" disabled="@_saving">
                    <option value="">Select a company</option>
                    @foreach (var company in _companies)
                    {
                        <option value="@company.Id">@company.Name</option>
                    }
                </select>
            </div>
        }

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">

                <h4 class="mb-4">Create Material</h4>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="alert alert-danger">@_error</div>
                }

                <div class="mb-3">
                    <label class="form-label">Material Code</label>
                    <InputText class="form-control"
                               @bind-Value="_model.MaterialCode" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <InputText class="form-control"
                               @bind-Value="_model.Name" />
                </div>

                <div class="mb-4">
                    <label class="form-label">Description</label>
                    <InputTextArea class="form-control"
                                   rows="4"
                                   @bind-Value="_model.Description" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Category</label>
                       <InputSelect class="form-select" @bind-Value="_model.Category">
                           <option value="">Select...</option>
                           @foreach (var item in _categories)
                           {
                               <option value="@item.Value">@item.Name</option>
                           }
                       </InputSelect>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Unit</label>
                        <InputSelect class="form-select" @bind-Value="_model.UnitOfMeasure">
                            <option value="">Select...</option>
                            @foreach (var item in _units)
                            {
                                <option value="@item.Value">@item.Name</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Material Type</label>
                    <InputSelect class="form-select" @bind-Value="_selectedMaterialType">
                        @foreach (var item in _types)
                        {
                            <option value="@item.Value">@item.Name</option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label class="form-label">Default Cost Code</label>
                    <InputText class="form-control"
                               @bind-Value="_costCode"
                               placeholder="Optional" />
                </div>

                <div class="mb-4">
                    <label class="form-label">Standard Unit Cost</label>
                    <InputNumber class="form-control"
                                 @bind-Value="_model.StandardUnitCost" />
                </div>

                <div class="form-check form-switch mb-4">
                    <InputCheckbox class="form-check-input"
                                   @bind-Value="_model.IsActive" />
                    <label class="form-check-label ms-2">
                        Active Material
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary px-4" type="submit" disabled="@(_initializing || _saving)">
                        @(_saving ? "Saving..." : "Save Material")
                    </button>

                    <button class="btn btn-outline-secondary"
                            type="button"
                            @onclick="Cancel">
                        Cancel
                    </button>
                </div>

            </div>
        </div>
    </EditForm>

</div>

@code {
    private CreateMaterialRequest _model = new()
    {
        IsActive = true
    };

   private List<MaterialLookupDto> _categories = [];
   private List<MaterialLookupDto> _units = [];
   private List<MaterialLookupDto> _types = [];

    private bool _loaded;
    private bool _initializing = true;
    private bool _saving;
    private bool _canSelectCompany;
    private IReadOnlyList<CSM.Web.Models.Dashboard.DashboardCompany> _companies = [];
    private string? _error;
    private string? _costCode;
    private string _selectedMaterialType = "Bulk";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
            return;

        _loaded = true;

        try
        {
            var roles = await SessionStorage.GetAsync<List<string>>("roles");
            _canSelectCompany = roles.Success && roles.Value?.Contains("SuperAdmin") == true;
            if (!_canSelectCompany)
                _model.CompanyId = await AuthService.GetCurrentCompanyIdAsync();
            if (_canSelectCompany || !_model.CompanyId.HasValue || _model.CompanyId == Guid.Empty)
            {
                _companies = await DashboardService.GetCompaniesAsync();
                _canSelectCompany = true;
                if (_companies.Count == 1) _model.CompanyId = _companies[0].Id;
            }
            _categories = await ProcurementService.GetCategoriesAsync();
            _units = await ProcurementService.GetUnitsAsync();
            _types = await ProcurementService.GetMaterialTypesAsync();
        }
        catch (Exception ex)
        {
            _error = $"Unable to load material options. {ex.Message}";
        }
        finally
        {
            _initializing = false;
            StateHasChanged();
        }
    }

    private async Task Save()
    {
        if (_initializing || _saving) return;
        _error = null;
        if (!_model.CompanyId.HasValue || _model.CompanyId == Guid.Empty)
        {
            _error = "Select a company before creating a material.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_model.MaterialCode) || string.IsNullOrWhiteSpace(_model.Name) ||
            string.IsNullOrWhiteSpace(_model.Category) || string.IsNullOrWhiteSpace(_model.UnitOfMeasure))
        {
            _error = "Material code, name, category and unit are required.";
            return;
        }
        _model.MaterialType = Enum.TryParse<MaterialType>(
            _selectedMaterialType, true, out var type) ? type : MaterialType.Bulk;
        _saving = true;
        try
        {
            if (await ProcurementService.CreateMaterialAsync(_model))
                Navigation.NavigateTo("/materials", true);
            else
                _error = "Unable to create material.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/materials");
    }
}