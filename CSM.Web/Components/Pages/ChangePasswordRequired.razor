@page "/change-password-required"
@rendermode InteractiveServer

@using CSM.Web.Services
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage

@inject PasswordChangeService PasswordChanges
@inject IAuthService AuthService
@inject ProtectedSessionStorage SessionStorage
@inject NavigationManager Navigation
@inject ILogger<ChangePasswordRequired> Logger

<PageTitle>Change Password | CSM</PageTitle>

<main class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <section class="card shadow">
                <div class="card-body p-4">
                    <h1 class="h3">Change your password</h1>
                    <p class="text-muted">
                        You must choose a new password before continuing.
                        Your password must be exactly 6 digits.
                    </p>

                    <EditForm Model="_model" OnValidSubmit="ChangePasswordAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label for="currentPassword" class="form-label">
                                Current password
                            </label>
                            <InputText id="currentPassword"
                                       class="form-control"
                                       type="password"
                                       autocomplete="current-password"
                                       @bind-Value="_model.CurrentPassword"
                                       disabled="@_submitting" />
                        </div>

                        <div class="mb-3">
                            <label for="newPassword" class="form-label">
                                New 6-digit password
                            </label>
                            <InputText id="newPassword"
                                       class="form-control"
                                       type="password"
                                       inputmode="numeric"
                                       autocomplete="new-password"
                                       @bind-Value="_model.NewPassword"
                                       disabled="@_submitting" />
                        </div>

                        <div class="mb-3">
                            <label for="confirmNewPassword" class="form-label">
                                Confirm new password
                            </label>
                            <InputText id="confirmNewPassword"
                                       class="form-control"
                                       type="password"
                                       inputmode="numeric"
                                       autocomplete="new-password"
                                       @bind-Value="_model.ConfirmNewPassword"
                                       disabled="@_submitting" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_error))
                        {
                            <div class="alert alert-danger" role="alert">
                                @_error
                            </div>
                        }

                        <button class="btn btn-primary w-100"
                                type="submit"
                                disabled="@_submitting">
                            @(_submitting ? "Updating password..." : "Update password")
                        </button>
                    </EditForm>
                </div>
            </section>
        </div>
    </div>
</main>

@code {
    private readonly ChangePasswordForm _model = new();
    private bool _submitting;
    private string? _error;

    private async Task ChangePasswordAsync()
    {
        _submitting = true;
        _error = null;

        try
        {
            await PasswordChanges.ChangePasswordAsync(
                _model.CurrentPassword,
                _model.NewPassword,
                _model.ConfirmNewPassword);

            await AuthService.LogoutAsync();
            await SessionStorage.DeleteAsync("userName");
            await SessionStorage.DeleteAsync("email");
            await SessionStorage.DeleteAsync("roles");

            Navigation.NavigateTo("/login?passwordChanged=true", true);
        }
        catch (HttpRequestException ex)
        {
            Logger.LogInformation(
                "Required password change was rejected with status {StatusCode}.",
                ex.StatusCode);
            _error = "The password could not be changed. Check your current password and ensure the new password is exactly 6 digits and different from the current password.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Required password change failed.");
            _error = "Unable to change your password right now. Please try again.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed class ChangePasswordForm
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmNewPassword { get; set; } = string.Empty;
    }
}
