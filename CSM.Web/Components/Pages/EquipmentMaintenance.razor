@page "/equipment/maintenance/site/{SiteId:guid}"
@rendermode InteractiveServer

@using CSM.Web.Models.Equipment
@using CSM.Web.Models.Sites
@using CSM.Web.Services

@inject IEquipmentService EquipmentService
@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>Equipment Maintenance</PageTitle>

<div class="container py-4">

    <div class="d-flex align-items-center justify-content-between mb-4">

        <div class="d-flex align-items-center">

            <button class="btn btn-outline-secondary me-3"
                    @onclick="GoBack">
                ← Back
            </button>

            <div>
                <h2 class="mb-0">Equipment Maintenance</h2>

                @if (!string.IsNullOrWhiteSpace(siteName))
                {
                    <small class="text-muted">@siteName</small>
                }
            </div>

        </div>

        @if (canManage)
        {
            <button class="btn btn-primary" @onclick="NewMaintenance">+ New Maintenance</button>
        }

    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border"></div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
        @if (signInRequired)
        {
            <a id="equipment-maintenance-sign-in" class="btn btn-primary" href="/login">Sign in</a>
        }
        else if (canRetry)
        {
            <button id="retry-equipment-maintenance" class="btn btn-primary" @onclick="LoadDataAsync">Retry</button>
        }
    }
    else if (records.Count == 0)
    {
        <div class="alert alert-info">
            No maintenance records found for this site.
        </div>
    }
    else
    {
        @foreach (var item in records.OrderByDescending(x => x.ScheduledAtUtc))
        {
            <div class="card shadow-sm mb-3">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <h5 class="mb-1">
                                @item.EquipmentCode — @item.EquipmentName
                            </h5>

                            <div class="text-muted">
                                @item.MaintenanceType
                            </div>
                        </div>

                        <div>
                            @if (item.CompletedAtUtc.HasValue)
                            {
                                <span class="badge bg-success">
                                    Completed
                                </span>
                            }
                            else if (item.StartedAtUtc.HasValue)
                            {
                                <span class="badge bg-warning text-dark">
                                    In Progress
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Scheduled
                                </span>
                            }
                        </div>

                    </div>

                    <hr />

                    <div class="row">

                        <div class="col-md-3">
                            <small class="text-muted d-block">
                                Scheduled
                            </small>

                            @item.ScheduledAtUtc.ToString("dd/MM/yyyy")
                        </div>

                        <div class="col-md-3">
                            <small class="text-muted d-block">
                                Meter
                            </small>

                            @(item.MeterReading?.ToString("N0") ?? "-")
                        </div>

                        <div class="col-md-3">
                            <small class="text-muted d-block">
                                Cost
                            </small>

                            @($"{item.CurrencyCode} {(item.Cost ?? 0):N2}")
                        </div>

                        <div class="col-md-3">
                            <small class="text-muted d-block">
                                Provider
                            </small>

                            @(item.ServiceProvider ?? "-")
                        </div>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(item.Description))
                    {
                        <div class="mt-3">

                            <small class="text-muted d-block">
                                Description
                            </small>

                            @item.Description

                        </div>
                    }

                </div>

            </div>
        }
    }

</div>

@code {

    [Parameter]
    public Guid SiteId { get; set; }

    private string siteName = string.Empty;

    private List<EquipmentMaintenanceResponse> records = [];

    private bool loading = true;

    private string? errorMessage;

    private bool canManage;
    private bool canRetry = true;
    private bool signInRequired;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        loading = true;
        records = [];
        siteName = string.Empty;
        canManage = false;
        canRetry = true;
        signInRequired = false;
        errorMessage = null;
        try
        {
            var sites = await ProjectService.GetSitesAsync();
            siteName = sites.FirstOrDefault(x => x.Id == SiteId)?.Name ?? string.Empty;
            var maintenance = await EquipmentService.GetMaintenanceAsync();
            var assignments = await EquipmentService.GetAssignmentsAsync();
            var equipmentIds = assignments
                .Where(x => x.ConstructionSiteId == SiteId && x.ReleasedAtUtc == null)
                .Select(x => x.EquipmentId).Distinct().ToHashSet();
            records = maintenance.Where(x => equipmentIds.Contains(x.EquipmentId)).ToList();
            canManage = true;
        }
        catch (HttpRequestException ex)
        {
            signInRequired = ex.StatusCode == System.Net.HttpStatusCode.Unauthorized;
            canRetry = ex.StatusCode is not (System.Net.HttpStatusCode.Unauthorized
                or System.Net.HttpStatusCode.Forbidden);
            errorMessage = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Your session is missing or has expired. Please sign in again.",
                System.Net.HttpStatusCode.Forbidden => "You do not have permission to view equipment maintenance.",
                _ => "Unable to load equipment maintenance. Please try again."
            };
        }
        catch (Exception)
        {
            errorMessage = "Unable to load equipment maintenance. Please try again.";
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private void NewMaintenance()
    {
        if (canManage)
            Navigation.NavigateTo($"/equipment/maintenance/create/{SiteId}");
    }

    private void GoBack()
    {
        Navigation.NavigateTo(
            "/equipment/maintenance-sites");
    }

}