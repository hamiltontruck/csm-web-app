@page "/equipment/downtime/site/{SiteId:guid}"
@rendermode InteractiveServer

@using CSM.Web.Models.Equipment
@using CSM.Web.Models.Sites
@using CSM.Web.Services

@inject IEquipmentService EquipmentService
@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>Equipment Downtime</PageTitle>

<div class="container py-4">

    <div class="d-flex align-items-center justify-content-between mb-4">

        <div class="d-flex align-items-center">

            <button class="btn btn-outline-secondary me-3"
                    @onclick="GoBack">
                ← Back
            </button>

            <div>
                <h3 class="mb-0">
                    Equipment Downtime
                </h3>

                @if (!string.IsNullOrWhiteSpace(siteName))
                {
                    <small class="text-muted">
                        @siteName
                    </small>
                }
            </div>

        </div>

        @if (canManage)
        {
            <WorkspaceAction Route="/equipment/downtime/create/{SiteId}">
                <button class="btn btn-primary" @onclick="NewDowntime">+ New Downtime</button>
            </WorkspaceAction>
        }

    </div>

    @if (!loaded)
    {
        <div class="text-center py-5">
            <div class="spinner-border"></div>

            <div class="mt-2 text-muted">
                Loading equipment downtime...
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
        @if (signInRequired)
        {
            <a id="equipment-downtime-sign-in" class="btn btn-primary" href="/login">Sign in</a>
        }
        else if (canRetry)
        {
            <button id="retry-equipment-downtime" class="btn btn-primary" @onclick="LoadDataAsync">Retry</button>
        }
    }
    else if (downtimeRecords.Count == 0)
    {
        <div class="alert alert-info">
            No equipment downtime records found for this site.
        </div>
    }
    else
    {
        @foreach (var item in downtimeRecords)
        {
            <div class="card shadow-sm mb-3">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <h5 class="mb-1">
                                @item.DowntimeNumber
                            </h5>

                            <div>
                                <strong>
                                    @item.EquipmentCode
                                </strong>
                                —
                                @item.EquipmentName
                            </div>

                            @if (!string.IsNullOrWhiteSpace(item.ConstructionSiteName))
                            {
                                <div class="text-muted">
                                    @item.ConstructionSiteName
                                </div>
                            }

                        </div>

                        <div class="d-flex align-items-start gap-2">

                            @if (item.IsOpen)
                            {
                                <span class="badge bg-danger">
                                    Open
                                </span>

                                <button class="btn btn-sm btn-outline-success"
                                        @onclick="() => OpenCloseDialog(item)">
                                    Close
                                </button>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Closed
                                </span>
                            }

                        </div>

                    </div>

                    <hr />

                    <div class="row">

                        <div class="col-md-3">

                            <small class="text-muted d-block">
                                Started
                            </small>

                            @item.StartedAtUtc.ToString("dd/MM/yyyy HH:mm")

                        </div>

                        <div class="col-md-3">

                            <small class="text-muted d-block">
                                Ended
                            </small>

                            @(item.EndedAtUtc?.ToString("dd/MM/yyyy HH:mm") ?? "-")

                        </div>

                        <div class="col-md-3">

                            <small class="text-muted d-block">
                                Duration
                            </small>

                            @(item.DurationHours.HasValue
                                ? $"{item.DurationHours.Value:N2} hours"
                                : "-")

                        </div>

                        <div class="col-md-3">

                            <small class="text-muted d-block">
                                Created
                            </small>

                            @item.CreatedAtUtc.ToString("dd/MM/yyyy")

                        </div>

                    </div>

                    <div class="mt-3">

                        <small class="text-muted d-block">
                            Reason
                        </small>

                        <div>
                            @item.Reason
                        </div>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(item.Resolution))
                    {
                        <div class="mt-3">

                            <small class="text-muted d-block">
                                Resolution
                            </small>

                            <div>
                                @item.Resolution
                            </div>

                        </div>
                    }

                </div>

            </div>
        }
    }

</div>


@if (showCloseDialog && selectedDowntime is not null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5);">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Close Equipment Downtime
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CancelClose">
                    </button>

                </div>

                <div class="modal-body">

                    <div class="mb-3">

                        <label class="form-label">
                            Downtime Number
                        </label>

                        <input class="form-control"
                               value="@selectedDowntime.DowntimeNumber"
                               disabled />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Equipment
                        </label>

                        <input class="form-control"
                               value="@($"{selectedDowntime.EquipmentCode} - {selectedDowntime.EquipmentName}")"
                               disabled />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            End Date &amp; Time
                        </label>

                        <input type="datetime-local"
                               class="form-control"
                               @bind="closeEndedAtUtc" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Resolution
                        </label>

                        <textarea class="form-control"
                                  rows="3"
                                  @bind="closeResolution">
                        </textarea>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(closeErrorMessage))
                    {
                        <div class="alert alert-danger">
                            @closeErrorMessage
                        </div>
                    }

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CancelClose"
                            disabled="@closing">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-success"
                            @onclick="ConfirmClose"
                            disabled="@closing">

                        @if (closing)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Closing...</span>
                        }
                        else
                        {
                            <span>Close Downtime</span>
                        }

                    </button>

                </div>

            </div>

        </div>

    </div>
}


@code {

    [Parameter]
    public Guid SiteId { get; set; }

    private List<EquipmentDowntimeResponse> downtimeRecords = [];

    private string siteName = string.Empty;

    private bool loaded;

    private string? errorMessage;

    private bool showCloseDialog;

    private bool closing;

    private EquipmentDowntimeResponse? selectedDowntime;

    private DateTime closeEndedAtUtc;

    private string? closeResolution;

    private string? closeErrorMessage;


    private bool canManage;
    private bool canRetry = true;
    private bool signInRequired;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        loaded = false;
        downtimeRecords = [];
        siteName = string.Empty;
        showCloseDialog = false;
        selectedDowntime = null;
        canManage = false;
        canRetry = true;
        signInRequired = false;
        errorMessage = null;
        try
        {
            var sites = await ProjectService.GetSitesAsync();
            siteName = sites.FirstOrDefault(x => x.Id == SiteId)?.Name ?? string.Empty;
            var all = await EquipmentService.GetDowntimeAsync();
            downtimeRecords = all.Where(x => x.ConstructionSiteId == SiteId)
                .OrderByDescending(x => x.StartedAtUtc).ToList();
            canManage = true;
        }
        catch (HttpRequestException ex)
        {
            signInRequired = ex.StatusCode == System.Net.HttpStatusCode.Unauthorized;
            canRetry = ex.StatusCode is not (System.Net.HttpStatusCode.Unauthorized
                or System.Net.HttpStatusCode.Forbidden);
            errorMessage = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Your session is missing or has expired. Please sign in again.",
                System.Net.HttpStatusCode.Forbidden => "You do not have permission to view equipment downtime.",
                _ => "Unable to load equipment downtime. Please try again."
            };
        }
        catch (Exception)
        {
            errorMessage = "Unable to load equipment downtime. Please try again.";
        }
        finally
        {
            loaded = true;
            StateHasChanged();
        }
    }

    private void OpenCloseDialog(
        EquipmentDowntimeResponse item)
    {
        if (!canManage) return;
        selectedDowntime = item;

        closeEndedAtUtc = DateTime.Now;

        closeResolution = item.Resolution;

        closeErrorMessage = null;

        showCloseDialog = true;
    }


    private void CancelClose()
    {
        if (closing)
            return;

        showCloseDialog = false;

        selectedDowntime = null;

        closeErrorMessage = null;
    }


    private async Task ConfirmClose()
    {
        if (!canManage || selectedDowntime is null)
            return;

        closeErrorMessage = null;

        if (closeEndedAtUtc < selectedDowntime.StartedAtUtc)
        {
            closeErrorMessage =
                "End date and time cannot be earlier than the downtime start.";

            return;
        }

        closing = true;

        try
        {
            await EquipmentService.CloseDowntimeAsync(
                selectedDowntime.Id,
                new CloseEquipmentDowntimeRequest
                {
                    EndedAtUtc = closeEndedAtUtc,
                    Resolution = closeResolution
                });

            showCloseDialog = false;

            selectedDowntime = null;

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            closeErrorMessage = ex.Message;
        }
        finally
        {
            closing = false;
        }

        await InvokeAsync(StateHasChanged);
    }


    private void NewDowntime()
    {
        if (canManage)
            Navigation.NavigateTo($"/equipment/downtime/create/{SiteId}");
    }


    private void GoBack()
    {
        Navigation.NavigateTo(
            "/equipment/downtime-sites");
    }

}