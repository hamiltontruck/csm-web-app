@page "/stock-movements"
@rendermode InteractiveServer

@using CSM.Web.Models.Sites
@using CSM.Web.Services

@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>Stock Movements</PageTitle>

@if (loading)
{
    <div class="container py-4">
        <h4>Loading construction sites...</h4>
    </div>
}
else
{
    <div class="container py-4">

        <button class="btn btn-outline-secondary mb-3"
                @onclick="GoBack">
            <i class="bi bi-arrow-left"></i> Back
        </button>

        <h2>Stock Movements</h2>
        <div class="text-muted mb-4">
            Select a construction site.
        </div>

        @foreach (var site in sites)
        {
            <div class="card shadow-sm mb-3"
                 style="cursor:pointer"
                 @onclick="() => OpenSite(site.Id)">

                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-bold">@site.SiteCode - @site.Name</div>
                        <small class="text-muted">Construction Site</small>
                    </div>

                    <i class="bi bi-chevron-right fs-4"></i>
                </div>

            </div>
        }

    </div>
}

@code {
    private List<SiteResponse> sites = [];
    private bool loading = true;
    private bool loaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded)
            return;

        loaded = true;

        sites = await ProjectService.GetSitesAsync();

        loading = false;

        StateHasChanged();
    }

    void OpenSite(Guid siteId)
        => Navigation.NavigateTo($"/stock-movements/site/{siteId}");

    void GoBack()
        => Navigation.NavigateTo("/stock-items");
}