@inherits WorkspacePageBase
@page "/hr"
@rendermode InteractiveServer

@using CSM.Web.Services

@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject IContractorService ContractorService

<PageTitle>HR Management</PageTitle>
<WorkspaceAccessFeedback Loaded="AccessLoaded" Error="AccessError" />

<div class="container-fluid py-3">

    <h2>Human Resource Management</h2>

    <div class="row g-3 mt-3">

        @if (Access.CanVisit("/hr/employees"))
        {
<div class="col-lg-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6>Employees</h6>
                    <h2 title="Summary not available">—</h2>

                    <div class="d-grid gap-2 mt-2">
                        <button class="btn btn-primary"
                                @onclick="OpenCompanyEmployees">
                            Company
                        </button>

                        <button class="btn btn-outline-primary"
                                @onclick="OpenSiteEmployees">
                            Site
                        </button>
                    </div>
                </div>
            </div>
        </div>
        }

         @if (Access.CanVisit("/hr/contractors"))
        {
<div class="col-lg-3">
             <div class="card text-center shadow-sm">
                 <div class="card-body">
                     <h6>Contractors</h6>
                     <h2 id="hr-contractor-count">@(_contractorCount?.ToString() ?? "—")</h2>
                     @if (_loading)
                     {
                         <p role="status">Loading contractor summary...</p>
                     }
                     else if (!string.IsNullOrWhiteSpace(_summaryError))
                     {
                         <div class="alert alert-danger" role="alert">@_summaryError</div>
                         @if (_accessStatus == System.Net.HttpStatusCode.Unauthorized)
                         {
                             <a id="hr-sign-in" class="btn btn-primary" href="/login?returnUrl=%2Fhr">Sign in</a>
                         }
                         else if (_accessStatus != System.Net.HttpStatusCode.Forbidden)
                         {
                             <button id="retry-hr-summary" class="btn btn-outline-primary" @onclick="LoadSummaryAsync">Retry</button>
                         }
                     }

                     @if (!_loading && _contractorCount.HasValue)
                     {
                         <button class="btn btn-primary mt-2"
                                 @onclick="OpenContractors">
                             Manage Contractors
                         </button>
                     }
                 </div>
             </div>
         </div>
        }

        @if (Access.CanVisit("/hr/attendance"))
        {
<div class="col-lg-3">
            <div class="card text-center shadow-sm"
                 role="button"
                 @onclick='() => Navigation.NavigateTo("/hr/attendance")'>

                <div class="card-body">
                    <h6>Attendance</h6>
                    <h2 title="Summary not available">—</h2>
                    <button class="btn btn-primary mt-2"
                            @onclick="OpenAttendance">
                        Manage Attendances
                    </button>
                </div>

            </div>
        </div>
        }

        @if (Access.CanVisit("/hr/site-assignments"))
        {
<div class="col-lg-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6>Site Assignments</h6>
                    <h2 title="Summary not available">—</h2>

                    <button class="btn btn-primary mt-2"
                            @onclick="OpenSiteAssignments">
                        Manage Site Assignments
                    </button>
                </div>
            </div>
        </div>
        }

        @if (Access.CanVisit("/hr/shifts"))
        {
<div class="col-lg-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6>Shifts</h6>
                    <h2 title="Summary not available">—</h2>

                    <button class="btn btn-primary mt-2"
                            @onclick="OpenShifts">
                        Manage Shifts
                    </button>
                </div>
            </div>
        </div>
        }

        @if (Access.CanVisit("/hr/leave"))
        {
<div class="col-lg-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6>Leave</h6>
                    <h2 title="Summary not available">—</h2>

                    <button class="btn btn-primary mt-2"
                            @onclick="OpenLeave">
                        Manage Leave
                    </button>
                </div>
            </div>
        </div>
        }

        @if (Access.CanVisit("/hr/timesheets"))
        {
<div class="col-lg-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6>Timesheets</h6>
                    <h2 title="Summary not available">—</h2>
                    <button class="btn btn-primary mt-2"
                            @onclick="OpenTimesheets">
                        Manage Timesheets
                    </button>
                </div>
            </div>
        </div>
        }

        @if (Access.CanVisit("/hr/payroll"))
        {
<div class="col-lg-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6>Payroll</h6>
                    <h2 title="Summary not available">—</h2>

                    <button class="btn btn-primary mt-2"
                            @onclick="OpenPayroll">
                        Manage Payroll
                    </button>
                </div>
            </div>
        </div>
        }

    </div>

</div>

@code {
    private int? _contractorCount;
    private bool _loading = true;
    private string? _summaryError;
    private System.Net.HttpStatusCode? _accessStatus;

    protected override async Task OnAccessLoadedAsync()
    {
        if (Access.CanVisit("/hr/contractors")) await LoadSummaryAsync();
    }

    private async Task LoadSummaryAsync()
    {
        if (!Access.CanVisit("/hr/contractors")) return;
        _loading = true;
        _contractorCount = null;
        _summaryError = null;
        _accessStatus = null;
        try
        {
            var contractors = await ContractorService.GetContractorsAsync();
            _contractorCount = contractors.Count;
        }
        catch (HttpRequestException ex)
        {
            _accessStatus = ex.StatusCode;
            _summaryError = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Your session is missing or has expired. Please sign in again.",
                System.Net.HttpStatusCode.Forbidden => "You do not have permission to view contractor summaries.",
                _ => "Unable to load contractor summary. Please try again."
            };
        }
        catch (Exception)
        {
            _summaryError = "Unable to load contractor summary. Please try again.";
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OpenCompanyEmployees()
    {
        Navigation.NavigateTo("/hr/employees/company");
    }

    private void OpenSiteEmployees()
    {
        Navigation.NavigateTo("/hr/employees/site");
    }

    private void OpenContractors()
    {
        if (_loading || !_contractorCount.HasValue) return;
        Navigation.NavigateTo("/hr/contractors");
    }

    private void OpenAttendance()
        {
            Navigation.NavigateTo("/hr/attendance");
        }

    private void OpenSiteAssignments()
    {
        Navigation.NavigateTo("/hr/site-assignments");
    }

    private void OpenShifts()
    {
        Navigation.NavigateTo("/hr/shifts");
    }

    private void OpenLeave()
    {
        Navigation.NavigateTo("/hr/leave");
    }

    private void OpenTimesheets()
    {
        Navigation.NavigateTo("/hr/timesheets");
    }

    private void OpenPayroll()
    {
        Navigation.NavigateTo("/hr/payroll");
    }
}