@page "/hr/timesheets"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.HRM
@using CSM.Web.Services
@using System.Net
@inject IAuthService AuthService
@inject ITimesheetService TimesheetService
@inject NavigationManager Navigation

<PageTitle>Timesheets</PageTitle>

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3>Timesheets</h3>
            <p class="text-muted mb-0">
                Manage employee timesheets and approval status.
            </p>
        </div>

        <div>
            <button class="btn btn-secondary me-2"
                    @onclick="GoBack">
                Back
            </button>

            @if (_canManage)
            {
                <WorkspaceAction Route="/hr/timesheets/create">
                    <button class="btn btn-primary" @onclick="CreateTimesheet">Create Timesheet</button>
            </WorkspaceAction>
            }
        </div>
    </div>

    @if (_loading)
    {
        <div class="text-muted">Loading timesheets...</div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
        @if (_accessStatus == HttpStatusCode.Unauthorized)
        {
            <a id="timesheet-list-sign-in" class="btn btn-primary" href="/login?returnUrl=%2Fhr%2Ftimesheets">Sign in</a>
        }
        else if (_accessStatus != HttpStatusCode.Forbidden)
        {
            <button id="retry-timesheet-list" class="btn btn-outline-primary" @onclick="LoadTimesheetsAsync">Retry</button>
        }
    }
    else if (_timesheets.Count == 0)
    {
        <div class="alert alert-info">
            No timesheets found.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">

                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Period</th>
                                <th>Regular Hours</th>
                                <th>Overtime Hours</th>
                                <th>Total Hours</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var timesheet in _timesheets)
                            {
                                <tr>
                                    <td>
                                        <strong>@timesheet.EmployeeName</strong>
                                        <div class="small text-muted">
                                            @timesheet.EmployeeNumber
                                        </div>
                                    </td>

                                    <td>
                                        @timesheet.PeriodStartDate.ToString("yyyy-MM-dd")
                                        -
                                        @timesheet.PeriodEndDate.ToString("yyyy-MM-dd")
                                    </td>

                                    <td>@timesheet.RegularHours.ToString("0.##")</td>

                                    <td>@timesheet.OvertimeHours.ToString("0.##")</td>

                                    <td>@timesheet.TotalHours.ToString("0.##")</td>

                                    <td>
                                        <span class="badge @GetStatusClass(timesheet.Status)">
                                            @timesheet.Status
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <WorkspaceAction Route="/hr/timesheets/edit/{timesheetId}">
                                            <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => OpenTimesheet(timesheet.Id)">
                                            Open
                                        </button>
            </WorkspaceAction>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

            </div>
        </div>
    }

</div>

@code {
    private List<TimesheetResponse> _timesheets = [];
    private bool _loading = true;
    private bool _canManage;
    private string? _error;
    private HttpStatusCode? _accessStatus;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadTimesheetsAsync();
    }

    private async Task LoadTimesheetsAsync()
    {
        _loading = true;
        _error = null;
        _accessStatus = null;
        _canManage = false;
        _timesheets = [];
        try
        {
            var result = await TimesheetService.GetAllAsync();
            var roles = await AuthService.GetRolesAsync();
            _timesheets = result.ToList();
            _canManage = TimesheetAccess.CanManage(roles);
        }
        catch (Exception ex)
        {
            _accessStatus = (ex as HttpRequestException)?.StatusCode;
            _error = _accessStatus switch
            {
                HttpStatusCode.Unauthorized => "Your session is missing or has expired. Please sign in again.",
                HttpStatusCode.Forbidden => "You do not have permission to view timesheets.",
                _ => "Unable to load timesheets. Please try again."
            };
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CreateTimesheet()
    {
        if (_canManage) Navigation.NavigateTo("/hr/timesheets/create");
    }

    private void OpenTimesheet(Guid timesheetId)
    {
        Navigation.NavigateTo($"/hr/timesheets/edit/{timesheetId}");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/hr");
    }

    private static string GetStatusClass(string status)
    {
        return status switch
        {
            "Draft" => "bg-secondary",
            "Submitted" => "bg-warning text-dark",
            "Approved" => "bg-success",
            "Rejected" => "bg-danger",
            "Cancelled" => "bg-dark",
            _ => "bg-secondary"
        };
    }
}