@page "/hr/timesheets"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.HRM
@using CSM.Web.Services
@inject ITimesheetService TimesheetService
@inject NavigationManager Navigation

<PageTitle>Timesheets</PageTitle>

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3>Timesheets</h3>
            <p class="text-muted mb-0">
                Manage employee timesheets and approval status.
            </p>
        </div>

        <div>
            <button class="btn btn-secondary me-2"
                    @onclick="GoBack">
                Back
            </button>

            <button class="btn btn-primary"
                    @onclick="CreateTimesheet">
                Create Timesheet
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">
            @_error
        </div>
    }

    @if (_loading)
    {
        <div class="text-muted">
            Loading timesheets...
        </div>
    }
    else if (_timesheets.Count == 0)
    {
        <div class="alert alert-info">
            No timesheets found.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">

                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Period</th>
                                <th>Regular Hours</th>
                                <th>Overtime Hours</th>
                                <th>Total Hours</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var timesheet in _timesheets)
                            {
                                <tr>
                                    <td>
                                        <strong>@timesheet.EmployeeName</strong>
                                        <div class="small text-muted">
                                            @timesheet.EmployeeNumber
                                        </div>
                                    </td>

                                    <td>
                                        @timesheet.PeriodStartDate.ToString("yyyy-MM-dd")
                                        -
                                        @timesheet.PeriodEndDate.ToString("yyyy-MM-dd")
                                    </td>

                                    <td>@timesheet.RegularHours.ToString("0.##")</td>

                                    <td>@timesheet.OvertimeHours.ToString("0.##")</td>

                                    <td>@timesheet.TotalHours.ToString("0.##")</td>

                                    <td>
                                        <span class="badge @GetStatusClass(timesheet.Status)">
                                            @timesheet.Status
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => OpenTimesheet(timesheet.Id)">
                                            Open
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

            </div>
        </div>
    }

</div>

@code {
    private List<TimesheetResponse> _timesheets = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadTimesheetsAsync();
    }

    private async Task LoadTimesheetsAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var result = await TimesheetService.GetAllAsync();

            _timesheets = result.ToList();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load timesheets: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void CreateTimesheet()
    {
        Navigation.NavigateTo("/hr/timesheets/create");
    }

    private void OpenTimesheet(Guid timesheetId)
    {
        Navigation.NavigateTo($"/hr/timesheets/edit/{timesheetId}");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/hr");
    }

    private static string GetStatusClass(string status)
    {
        return status switch
        {
            "Draft" => "bg-secondary",
            "Submitted" => "bg-warning text-dark",
            "Approved" => "bg-success",
            "Rejected" => "bg-danger",
            "Cancelled" => "bg-dark",
            _ => "bg-secondary"
        };
    }
}