@page "/hr/payroll/create"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.HRM
@using CSM.Web.Services

@using System.Net
@inject IAuthService AuthService
@inject IPayrollService PayrollService
@inject IEmployeeService EmployeeService
@inject NavigationManager Navigation

<PageTitle>Create Payroll</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">Create Payroll</h3>
            <p class="text-muted mb-0">
                Create a payroll record for an employee.
            </p>
        </div>

        <button class="btn btn-outline-secondary"
                @onclick="Back">
            <i class="bi bi-arrow-left me-1"></i>
            Back
        </button>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger" role="alert">
                    @_error
                </div>
            }

            @if (_loadingEmployees)
            {
                <div class="text-center py-4">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading employees...</span>
                    </div>
                </div>
            }
            else if (!_canManage)
            {
                @if (_accessStatus == HttpStatusCode.Unauthorized)
                {
                    <a id="payroll-create-sign-in" class="btn btn-primary" href="/login?returnUrl=%2Fhr%2Fpayroll%2Fcreate">Sign in</a>
                }
                else if (_accessStatus != HttpStatusCode.Forbidden)
                {
                    <button id="retry-payroll-create" class="btn btn-outline-primary" @onclick="LoadEmployees">Retry</button>
                }
            }
            else
            {
                <EditForm Model="_model" OnValidSubmit="SaveAsync">
                    <DataAnnotationsValidator />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Employee</label>

                            <InputSelect class="form-select"
                                         @bind-Value="_model.EmployeeId">
                                <option value="@Guid.Empty">
                                    -- Select Employee --
                                </option>

                                @foreach (var employee in _employees)
                                {
                                    <option value="@employee.Id">
                                        @employee.EmployeeNumber -
                                        @employee.FirstName
                                        @employee.MiddleName
                                        @employee.LastName
                                    </option>
                                }
                            </InputSelect>

                            <ValidationMessage For="@(() => _model.EmployeeId)" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Period Start</label>

                            <InputDate class="form-control"
                                       @bind-Value="_model.PeriodStart" />

                            <ValidationMessage For="@(() => _model.PeriodStart)" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Period End</label>

                            <InputDate class="form-control"
                                       @bind-Value="_model.PeriodEnd" />

                            <ValidationMessage For="@(() => _model.PeriodEnd)" />
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="submit"
                                class="btn btn-primary"
                                disabled="@_saving">
                            @if (_saving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"
                                      role="status"></span>
                                <span>Creating...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-lg me-1"></i>
                                <span>Create Payroll</span>
                            }
                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary ms-2"
                                @onclick="Back"
                                disabled="@_saving">
                            Cancel
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    private readonly CreatePayrollRequest _model = new()
    {
        PeriodStart = new DateOnly(
            DateTime.Today.Year,
            DateTime.Today.Month,
            1),

        PeriodEnd = new DateOnly(
            DateTime.Today.Year,
            DateTime.Today.Month,
            DateTime.DaysInMonth(
                DateTime.Today.Year,
                DateTime.Today.Month))
    };

    private List<EmployeeResponse> _employees = [];
    private bool _loadingEmployees = true;
    private bool _canManage;
    private HttpStatusCode? _accessStatus;
    private bool _saving;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadEmployees();
    }

    private async Task LoadEmployees()
    {
        _loadingEmployees = true;
        _error = null;
        _accessStatus = null;
        _canManage = false;
        _employees = [];
        var loadingEmployees = false;
        try
        {
            await PayrollService.GetAllAsync();
            var roles = await AuthService.GetRolesAsync();
            if (!roles.Any(role => role is "SuperAdmin" or "CompanyAdmin" or "HrOfficer" or "HROfficer"))
            {
                _accessStatus = HttpStatusCode.Forbidden;
                _error = "You do not have permission to create payroll.";
                return;
            }
            loadingEmployees = true;
            var employees = await EmployeeService.GetEmployeesAsync(status: "Active");
            _employees = employees.ToList();
            _canManage = true;
        }
        catch (Exception ex)
        {
            _accessStatus = (ex as HttpRequestException)?.StatusCode;
            _error = _accessStatus switch
            {
                HttpStatusCode.Unauthorized => "Your session is missing or has expired. Please sign in again.",
                HttpStatusCode.Forbidden => loadingEmployees
                    ? "Employee choices are not available with your current permissions."
                    : "You do not have permission to create payroll.",
                _ => "Unable to load payroll form. Please try again."
            };
        }
        finally
        {
            _loadingEmployees = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveAsync()
    {
        if (_saving || !_canManage) return;
        _saving = true;
        _error = null;

        try
        {
            var created =
                await PayrollService.CreateAsync(_model);

            Navigation.NavigateTo(
                $"/hr/payroll/edit/{created.Id}");
        }
        catch (Exception ex)
        {
            _error =
                $"Failed to create payroll: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private void Back()
    {
        Navigation.NavigateTo("/hr/payroll");
    }
}