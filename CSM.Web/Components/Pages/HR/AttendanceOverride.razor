@page "/hr/attendance/override/{AttendanceId:guid}"
@rendermode InteractiveServer

@using CSM.Web.Models.HRM
@using CSM.Web.Services

@inject IAttendanceService AttendanceService
@inject NavigationManager Navigation

<PageTitle>Attendance Override</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Attendance Override</h2>
            <div class="text-muted">
                Correct an attendance record
            </div>
        </div>

        <button class="btn btn-outline-secondary"
                @onclick="Back">
            Back
        </button>
    </div>

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-3">Loading attendance...</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body">

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="alert alert-danger">
                        @_error
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_success))
                {
                    <div class="alert alert-success">
                        @_success
                    </div>
                }

                @if (_attendance is not null)
                {
                    <div class="row g-3 mb-4">

                        <div class="col-md-6">
                            <label class="form-label">Employee</label>
                            <div class="form-control bg-light">
                                @_attendance.EmployeeName
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Employee Number</label>
                            <div class="form-control bg-light">
                                @_attendance.EmployeeNumber
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Construction Site</label>
                            <div class="form-control bg-light">
                                @_attendance.SiteName
                            </div>
                        </div>

                    </div>

                    <hr />

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">
                                Check-In Time
                            </label>

                            <input type="datetime-local"
                                   class="form-control"
                                   @bind="_checkInLocal" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Check-Out Time
                            </label>

                            <input type="datetime-local"
                                   class="form-control"
                                   @bind="_checkOutLocal" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Status
                            </label>

                            <select class="form-select"
                                    @bind="_status">

                                <option value="">
                                    -- Select Status --
                                </option>

                                <option value="Present">
                                    Present
                                </option>

                                <option value="Absent">
                                    Absent
                                </option>

                                <option value="Late">
                                    Late
                                </option>

                                <option value="EarlyDeparture">
                                    Early Departure
                                </option>

                                <option value="Leave">
                                    Leave
                                </option>

                                <option value="Holiday">
                                    Holiday
                                </option>

                                <option value="Weekend">
                                    Weekend
                                </option>

                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Reason <span class="text-danger">*</span>
                            </label>

                            <input class="form-control"
                                   @bind="_reason" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">
                                Remarks
                            </label>

                            <textarea class="form-control"
                                      rows="3"
                                      @bind="_remarks"></textarea>
                        </div>

                    </div>

                    <div class="mt-4 d-flex gap-2">

                        <button class="btn btn-warning"
                                disabled="@_saving"
                                @onclick="OverrideAttendance">

                            @if (_saving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>Save Override</span>
                            }

                        </button>

                        <button class="btn btn-outline-secondary"
                                disabled="@_saving"
                                @onclick="Back">
                            Cancel
                        </button>

                    </div>
                }
            </div>
        </div>
    }

</div>

@code {

    [Parameter]
    public Guid AttendanceId { get; set; }

    private AttendanceResponse? _attendance;

    private DateTime? _checkInLocal;
    private DateTime? _checkOutLocal;

    private string _status = string.Empty;
    private string _reason = string.Empty;
    private string? _remarks;

    private bool _loading = true;
    private bool _saving;

    private string? _error;
    private string? _success;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _attendance =
                await AttendanceService.GetAttendanceAsync(
                    AttendanceId);

            _checkInLocal =
                _attendance.CheckInAtUtc?.ToLocalTime();

            _checkOutLocal =
                _attendance.CheckOutAtUtc?.ToLocalTime();

            _status = _attendance.Status;
            _remarks = _attendance.Remarks;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OverrideAttendance()
    {
        _error = null;
        _success = null;

        if (_attendance is null)
        {
            _error = "Attendance record could not be loaded.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_status))
        {
            _error = "Please select an attendance status.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_reason))
        {
            _error = "Please provide a reason for the override.";
            return;
        }

        try
        {
            _saving = true;

            var request = new OverrideAttendanceRequest
            {
                CheckInAtUtc =
                    _checkInLocal?.ToUniversalTime(),

                CheckOutAtUtc =
                    _checkOutLocal?.ToUniversalTime(),

                Status = _status,

                Reason = _reason.Trim(),

                Remarks = _remarks
            };

            await AttendanceService.OverrideAsync(
                AttendanceId,
                request);

            _success =
                "Attendance override saved successfully.";

            await Task.Delay(700);

            Navigation.NavigateTo("/hr/attendance");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void Back()
    {
        Navigation.NavigateTo("/hr/attendance");
    }
}