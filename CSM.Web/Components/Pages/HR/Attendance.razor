@page "/hr/attendance"
@rendermode InteractiveServer

@using CSM.Web.Models.HRM
@using CSM.Web.Services
@using CSM.Web.Services.HRM

@inject IAuthService AuthService
@inject IAttendanceService AttendanceService
@inject NavigationManager Navigation

<PageTitle>Attendance</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Attendance</h2>
            <div class="text-muted">
                Employee attendance records
            </div>
        </div>

        <div>
            <button class="btn btn-outline-secondary me-2"
                    @onclick='() => Navigation.NavigateTo("/hr")'>
                Back
            </button>

            @if (_canManage)
            {
            <button class="btn btn-primary"
                    @onclick="OpenCheckIn">
                <span class="me-1">+</span>
                Check In
            </button>
            }
        </div>
    </div>

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-3">Loading attendance...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
        @if (_accessStatus == System.Net.HttpStatusCode.Unauthorized)
        {
            <a id="attendance-list-sign-in" class="btn btn-primary" href="@($"/login?returnUrl={Uri.EscapeDataString("/hr/attendance")}")">Sign in</a>
        }
        else if (_accessStatus != System.Net.HttpStatusCode.Forbidden)
        {
            <button id="retry-attendance-list" class="btn btn-outline-primary" @onclick="LoadAsync">Retry</button>
        }

    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">
                        Attendance Records
                    </h5>

                    <span class="badge bg-secondary">
                        @_attendance.Count records
                    </span>
                </div>

                @if (_attendance.Count == 0)
                {
                    <div class="text-muted py-4 text-center">
                        No attendance records found.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    <th>Site</th>
                                    <th>Date</th>
                                    <th>Check In</th>
                                    <th>Check Out</th>
                                    <th>Status</th>
                                    <th>Source</th>
                                    <th>Hours</th>
                                    <th>Approval</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in _attendance)
                                {
                                    <tr>
                                        <td>
                                            <strong>@item.EmployeeName</strong>
                                            <div class="small text-muted">
                                                @item.EmployeeNumber
                                            </div>
                                        </td>

                                        <td>
                                            @item.SiteName
                                        </td>

                                        <td>
                                            @item.AttendanceDate.ToString("yyyy-MM-dd")
                                        </td>

                                        <td>
                                            @(item.CheckInAtUtc?.ToLocalTime()
                                                .ToString("yyyy-MM-dd HH:mm") ?? "-")
                                        </td>

                                        <td>
                                            @(item.CheckOutAtUtc?.ToLocalTime()
                                                .ToString("yyyy-MM-dd HH:mm") ?? "-")
                                        </td>

                                        <td>
                                            <span class="badge bg-secondary">
                                                @item.Status
                                            </span>
                                        </td>

                                        <td>
                                            @item.Source
                                        </td>

                                        <td>
                                            @item.RegularHours.ToString("0.##")
                                            <span class="text-muted">h</span>

                                            @if (item.OvertimeHours > 0)
                                            {
                                                <div class="small text-muted">
                                                    OT:
                                                    @item.OvertimeHours.ToString("0.##")h
                                                </div>
                                            }
                                        </td>

                                        <td>
                                            @if (item.IsApproved)
                                            {
                                                <span class="badge bg-success">
                                                    Approved
                                                </span>
                                            }
                                            else if (item.RequiresApproval)
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    Pending
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    Not Required
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            @if (item.CheckInAtUtc.HasValue &&
                                                 !item.CheckOutAtUtc.HasValue)
                                            {
                                                <button class="btn btn-sm btn-outline-primary me-1"
                                                        @onclick='() => Navigation.NavigateTo($"/hr/attendance/check-out/{item.Id}")'>
                                                    Check Out
                                                </button>
                                            }

                                            @if (_canReview && !item.IsApproved)
                                            {
                                                <button class="btn btn-sm btn-outline-warning me-1"
                                                        @onclick='() => Navigation.NavigateTo($"/hr/attendance/override/{item.Id}")'>
                                                    Override
                                                </button>
                                            }

                                            @if (_canReview && item.RequiresApproval && !item.IsApproved &&
                                                 item.CheckOutAtUtc.HasValue)
                                            {
                                                <button class="btn btn-sm btn-outline-success"
                                                        @onclick='() => ApproveAttendance(item.Id)'>
                                                    Approve
                                                </button>
                                            }
                                            else if (item.IsApproved)
                                            {
                                                <span class="text-success small">
                                                    Approved
                                                </span>
                                            }
                                            else if (item.CheckOutAtUtc.HasValue)
                                            {
                                                <span class="text-muted small">
                                                    Completed
                                                </span>
                                            }
                                        </td>

                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

</div>

@code {
    private List<AttendanceResponse> _attendance = [];
    private bool _loading = true;
    private bool _canManage;
    private bool _canReview;
    private bool _approving;
    private string? _error;
    private System.Net.HttpStatusCode? _accessStatus;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _canManage = false;
        _canReview = false;
        _error = null;
        _accessStatus = null;
        _attendance = [];
        try
        {
            _attendance = (await AttendanceService.GetAttendancesAsync()).ToList();
            _canReview = AttendanceAccess.CanReview(await AuthService.GetRolesAsync());
            _canManage = true;
        }
        catch (Exception ex)
        {
            SetFailure(ex, "You do not have permission to view attendance records.",
                "Unable to load attendance records. Please try again.");
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SetFailure(Exception ex, string forbidden, string fallback)
    {
        _canManage = false;
        _canReview = false;
        _attendance = [];
        _accessStatus = (ex as HttpRequestException)?.StatusCode;
        _error = _accessStatus switch
        {
            System.Net.HttpStatusCode.Unauthorized => "Your session is missing or has expired. Please sign in again.",
            System.Net.HttpStatusCode.Forbidden => forbidden,
            _ => fallback
        };
    }

    private async Task ApproveAttendance(Guid attendanceId)
    {
        if (!_canManage || !_canReview || _approving) return;
        _approving = true;
        _error = null;
        _accessStatus = null;
        try
        {
            await AttendanceService.ApproveAsync(attendanceId, new ApproveAttendanceRequest());
            await LoadAsync();
        }
        catch (Exception ex)
        {
            SetFailure(ex, "You do not have permission to approve attendance.",
                "Unable to approve attendance. Please try again.");
        }
        finally
        {
            _approving = false;
        }
    }

    private void OpenCheckIn()
    {
        if (_canManage) Navigation.NavigateTo("/hr/attendance/check-in");
    }
}
