@page "/hr/attendance/check-out/{AttendanceId:guid}"
@rendermode InteractiveServer

@using CSM.Web.Models.HRM
@using CSM.Web.Services

@inject IAttendanceService AttendanceService
@inject NavigationManager Navigation

<PageTitle>Attendance Check-Out</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Attendance Check-Out</h2>
            <div class="text-muted">
                Record employee check-out
            </div>
        </div>

        <button class="btn btn-outline-secondary"
                @onclick="Back">
            Back
        </button>
    </div>

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-3">Loading attendance...</p>
        </div>
    }
    else if (!_canManage)
    {
        <div class="alert alert-danger" role="alert">@_loadError</div>
        @if (_accessStatus == System.Net.HttpStatusCode.Unauthorized)
        {
            <a id="attendance-check-out-sign-in" class="btn btn-primary" href="@($"/login?returnUrl={Uri.EscapeDataString($"/hr/attendance/check-out/{AttendanceId}")}")">Sign in</a>
        }
        else if (_accessStatus != System.Net.HttpStatusCode.Forbidden)
        {
            <button id="retry-attendance-check-out" class="btn btn-outline-primary" @onclick="LoadAsync">Retry</button>
        }
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body">

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="alert alert-danger">
                        @_error
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_success))
                {
                    <div class="alert alert-success">
                        @_success
                    </div>
                }

                @if (_attendance is not null)
                {
                    <div class="row g-3 mb-4">

                        <div class="col-md-6">
                            <label class="form-label">Employee</label>
                            <div class="form-control bg-light">
                                @_attendance.EmployeeName
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Employee Number</label>
                            <div class="form-control bg-light">
                                @_attendance.EmployeeNumber
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Construction Site</label>
                            <div class="form-control bg-light">
                                @_attendance.SiteName
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Check-In</label>
                            <div class="form-control bg-light">
                                @(_attendance.CheckInAtUtc?.ToLocalTime()
                                    .ToString("yyyy-MM-dd HH:mm") ?? "-")
                            </div>
                        </div>

                    </div>

                    <hr />

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">
                                Check-Out Time
                            </label>

                            <input type="datetime-local"
                                   class="form-control"
                                   @bind="_checkOutLocal" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">
                                Remarks
                            </label>

                            <textarea class="form-control"
                                      rows="3"
                                      @bind="_remarks"></textarea>
                        </div>

                    </div>

                    <div class="mt-4 d-flex gap-2">

                        <WorkspaceAction Route="/hr/attendance">

                            <button class="btn btn-primary"
                                disabled="@_saving"
                                @onclick="CheckOut">

                            @if (_saving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>Check Out</span>
                            }

                        </button>
            </WorkspaceAction>

                        <button class="btn btn-outline-secondary"
                                disabled="@_saving"
                                @onclick="Back">
                            Cancel
                        </button>

                    </div>
                }
            </div>
        </div>
    }

</div>

@code {

    [Parameter]
    public Guid AttendanceId { get; set; }

    private AttendanceResponse? _attendance;

    private DateTime _checkOutLocal = DateTime.Now;

    private string? _remarks;

    private bool _loading = true;
    private bool _canManage;
    private string? _loadError;
    private System.Net.HttpStatusCode? _accessStatus;
    private bool _saving;

    private string? _error;
    private string? _success;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _canManage = false;
        _loadError = null;
        _accessStatus = null;
        _error = null;
        _attendance = null;
        try
        {
            _attendance =
                await AttendanceService.GetAttendanceAsync(
                    AttendanceId);

            if (_attendance.CheckOutAtUtc.HasValue)
            {
                _error = "This attendance record has already been checked out.";
            }
            _canManage = true;
        }
        catch (Exception ex)
        {
            _accessStatus = (ex as HttpRequestException)?.StatusCode;
            _loadError = _accessStatus switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Your session is missing or has expired. Please sign in again.",
                System.Net.HttpStatusCode.Forbidden => "You do not have permission to record attendance check-outs.",
                _ => "Unable to load attendance form. Please try again."
            };
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CheckOut()
    {
        if (!_canManage || _saving) return;
        _error = null;
        _success = null;

        if (_attendance is null)
        {
            _error = "Attendance record could not be loaded.";
            return;
        }

        if (_attendance.CheckOutAtUtc.HasValue)
        {
            _error = "This attendance record has already been checked out.";
            return;
        }

        try
        {
            _saving = true;

            var request = new CheckOutRequest
            {
                CheckOutAtUtc = _checkOutLocal.ToUniversalTime(),
                Latitude = null,
                Longitude = null,
                AccuracyMeters = null,
                Remarks = _remarks
            };

            await AttendanceService.CheckOutAsync(
                AttendanceId,
                request);

            _success =
                "Attendance check-out recorded successfully.";

            await Task.Delay(700);

            Navigation.NavigateTo("/hr/attendance");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void Back()
    {
        Navigation.NavigateTo("/hr/attendance");
    }
}