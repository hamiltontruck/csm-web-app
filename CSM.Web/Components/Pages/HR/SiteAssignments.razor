@page "/hr/site-assignments"
@rendermode InteractiveServer

@using CSM.Web.Models.HRM
@using CSM.Web.Services.HRM
@inject ISiteAssignmentService SiteAssignmentService
@inject NavigationManager Navigation

<PageTitle>Site Assignments</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3>Site Assignments</h3>
            <p class="text-muted mb-0">
                Manage employee assignments to construction sites.
            </p>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-secondary"
                    @onclick="GoBack">
                Back to HR
            </button>

            <button class="btn btn-primary"
                    @onclick="CreateAssignment">
                Add Assignment
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="alert alert-info">
            Loading site assignments...
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }
    else if (assignments.Count == 0)
    {
        <div class="alert alert-secondary">
            No site assignments found.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Employee No.</th>
                                <th>Site</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Role</th>
                                <th>Primary</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var assignment in assignments)
                            {
                                <tr>
                                    <td>@assignment.EmployeeName</td>
                                    <td>@assignment.EmployeeNumber</td>
                                    <td>@assignment.SiteName</td>
                                    <td>@assignment.StartDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @(assignment.EndDate?.ToString("yyyy-MM-dd") ?? "-")
                                    </td>
                                    <td>@(assignment.RoleAtSite ?? "-")</td>
                                    <td>
                                        @if (assignment.IsPrimaryAssignment)
                                        {
                                            <span class="badge bg-primary">Primary</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No</span>
                                        }
                                    </td>
                                    <td>
                                        @if (assignment.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => EditAssignment(assignment.Id)">
                                            Edit
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<SiteAssignmentResponse> assignments = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAssignmentsAsync();
    }

    private async Task LoadAssignmentsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var result = await SiteAssignmentService.GetAllAsync();
            assignments = result.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/hr");
    }

    private void CreateAssignment()
    {
        Navigation.NavigateTo("/hr/site-assignments/create");
    }

    private void EditAssignment(Guid assignmentId)
    {
        Navigation.NavigateTo($"/hr/site-assignments/edit/{assignmentId}");
    }
}