@page "/hr/contractors"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.HRM
@using CSM.Web.Services

@inject IContractorService ContractorService
@inject NavigationManager Navigation

<PageTitle>Contractors</PageTitle>

<div class="container-fluid py-3">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">Contractors</h2>
            <p class="text-muted mb-0">
                Manage company contractors.
            </p>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary"
                    @onclick="BackToHr">
                <i class="bi bi-arrow-left"></i>
                Back to HR
            </button>

            <button class="btn btn-outline-secondary"
                    @onclick="LoadContractorsAsync"
                    disabled="@_loading">
                <i class="bi bi-arrow-clockwise"></i>
                Refresh
            </button>

            <button class="btn btn-primary"
                    @onclick="CreateContractor">
                <i class="bi bi-plus-lg"></i>
                Add Contractor
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger">
            @_errorMessage
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <div class="row align-items-center">
                <div class="col-md-4">
                    <strong>Contractor List</strong>
                </div>

                <div class="col-md-3 ms-auto">
                    <select class="form-select"
                            @bind="_statusFilter"
                            @bind:after="LoadContractorsAsync">
                        <option value="">All Contractors</option>
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="card-body p-0">

            @if (_loading)
            {
                <div class="p-4 text-center">
                    <div class="spinner-border"
                         role="status">
                    </div>

                    <div class="mt-2 text-muted">
                        Loading contractors...
                    </div>
                </div>
            }
            else if (_contractors.Count == 0)
            {
                <div class="p-4 text-center text-muted">
                    No contractors found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Code</th>
                                <th>Name</th>
                                <th>Contact Person</th>
                                <th>Phone</th>
                                <th>Email</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var contractor in _contractors)
                            {
                                <tr>
                                    <td>
                                        <strong>
                                            @contractor.ContractorCode
                                        </strong>
                                    </td>

                                    <td>
                                        @contractor.Name
                                    </td>

                                    <td>
                                        @(contractor.ContactPerson ?? "-")
                                    </td>

                                    <td>
                                        @(contractor.PhoneNumber ?? "-")
                                    </td>

                                    <td>
                                        @(contractor.Email ?? "-")
                                    </td>

                                    <td>
                                        @if (contractor.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">

                                            <button class="btn btn-sm btn-primary"
                                                    @onclick="() => ViewContractor(contractor.Id)">
                                                View
                                            </button>

                                            <button class="btn btn-sm btn-outline-secondary"
                                                    @onclick="() => EditContractor(contractor.Id)">
                                                Edit
                                            </button>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>

@code {
    private List<ContractorResponse> _contractors = [];
    private bool _loading = true;
    private string? _errorMessage;
    private string _statusFilter = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadContractorsAsync();
    }

    private async Task LoadContractorsAsync()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            bool? isActive = _statusFilter switch
            {
                "true" => true,
                "false" => false,
                _ => null
            };

            var contractors =
                await ContractorService.GetContractorsAsync(isActive);

            _contractors = contractors.ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            _contractors = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private void BackToHr()
    {
        Navigation.NavigateTo("/hr");
    }

    private void CreateContractor()
    {
        Navigation.NavigateTo("/hr/contractors/create");
    }

    private void ViewContractor(Guid contractorId)
    {
        Navigation.NavigateTo(
            $"/hr/contractors/details/{contractorId}");
    }

    private void EditContractor(Guid contractorId)
    {
        Navigation.NavigateTo(
            $"/hr/contractors/edit/{contractorId}");
    }
}