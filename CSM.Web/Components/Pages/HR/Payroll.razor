@page "/hr/payroll"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.HRM
@using CSM.Web.Services

@using System.Net
@inject IAuthService AuthService
@inject IPayrollService PayrollService
@inject NavigationManager Navigation

<PageTitle>Payroll</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">Payroll</h3>
            <p class="text-muted mb-0">
                Manage employee payroll records and payment processing.
            </p>
        </div>

        <div>
            <button class="btn btn-outline-secondary me-2"
                    @onclick="Back">
                <i class="bi bi-arrow-left me-1"></i>
                Back
            </button>

            @if (_canManage)
            {
                <WorkspaceAction Route="/hr/payroll/create">
                    <button class="btn btn-primary" @onclick="CreatePayroll">Create Payroll</button>
            </WorkspaceAction>
            }
        </div>
    </div>

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
        @if (_accessStatus == HttpStatusCode.Unauthorized)
        {
            <a id="payroll-list-sign-in" class="btn btn-primary" href="/login?returnUrl=%2Fhr%2Fpayroll">Sign in</a>
        }
        else if (_accessStatus != HttpStatusCode.Forbidden)
        {
            <button id="retry-payroll-list" class="btn btn-outline-primary" @onclick="LoadPayroll">Retry</button>
        }
    }
    else if (_payroll.Count == 0)
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="alert alert-info mb-0">
                    No payroll records have been created yet.
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Period</th>
                                <th>Gross Pay</th>
                                <th>Deductions</th>
                                <th>Net Pay</th>
                                <th>Currency</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var payroll in _payroll)
                            {
                                <tr>
                                    <td>
                                        <strong>@payroll.EmployeeNumber</strong>
                                        <div class="text-muted small">
                                            @payroll.EmployeeName
                                        </div>
                                    </td>

                                    <td>
                                        @payroll.PeriodStart.ToString("yyyy-MM-dd")
                                        <span class="text-muted">to</span>
                                        @payroll.PeriodEnd.ToString("yyyy-MM-dd")
                                    </td>

                                    <td>
                                        @payroll.GrossPay.ToString("N2")
                                    </td>

                                    <td>
                                        @payroll.TotalDeductions.ToString("N2")
                                    </td>

                                    <td>
                                        <strong>
                                            @payroll.NetPay.ToString("N2")
                                        </strong>
                                    </td>

                                    <td>
                                        @payroll.CurrencyCode
                                    </td>

                                    <td>
                                        <span class="@GetStatusClass(payroll.Status)">
                                            @payroll.Status
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <WorkspaceAction Route="/hr/payroll/edit/{payrollId}">
                                            <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => OpenPayroll(payroll.Id)">
                                            <i class="bi bi-eye me-1"></i>
                                            Open
                                        </button>
            </WorkspaceAction>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<PayrollResponse> _payroll = [];
    private bool _loading = true;
    private bool _canManage;
    private HttpStatusCode? _accessStatus;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadPayroll();
    }

    private async Task LoadPayroll()
    {
        _loading = true;
        _error = null;
        _accessStatus = null;
        _canManage = false;
        _payroll = [];

        try
        {
            var payroll = await PayrollService.GetAllAsync();

            var roles = await AuthService.GetRolesAsync();
            _payroll = payroll.ToList();
            _canManage = roles.Any(role => role is "SuperAdmin" or "CompanyAdmin" or "HrOfficer" or "HROfficer");
        }
        catch (Exception ex)
        {
            _accessStatus = (ex as HttpRequestException)?.StatusCode;
            _error = _accessStatus switch
            {
                HttpStatusCode.Unauthorized => "Your session is missing or has expired. Please sign in again.",
                HttpStatusCode.Forbidden => "You do not have permission to view payroll.",
                _ => "Unable to load payroll. Please try again."
            };
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CreatePayroll()
    {
        if (_canManage) Navigation.NavigateTo("/hr/payroll/create");
    }

    private void OpenPayroll(Guid payrollId)
    {
        Navigation.NavigateTo($"/hr/payroll/edit/{payrollId}");
    }

    private void Back()
    {
        Navigation.NavigateTo("/hr");
    }

    private static string GetStatusClass(string status)
    {
        return status switch
        {
            "Draft" =>
                "badge bg-secondary",

            "Calculated" =>
                "badge bg-info text-dark",

            "Approved" =>
                "badge bg-success",

            "Paid" =>
                "badge bg-primary",

            "Cancelled" =>
                "badge bg-danger",

            _ =>
                "badge bg-secondary"
        };
    }
}