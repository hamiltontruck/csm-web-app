@page "/hr/contractors/create"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.HRM
@using CSM.Web.Services

@inject IContractorService ContractorService
@inject NavigationManager Navigation

<PageTitle>Create Contractor</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Create Contractor</h2>
            <p class="text-muted mb-0">
                Add a new company contractor.
            </p>
        </div>

        <button class="btn btn-outline-secondary"
                @onclick="BackToContractors">
            <i class="bi bi-arrow-left"></i>
            Back to Contractors
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger">
            @_errorMessage
        </div>
    }

    @if (_loading)
    {
        <p role="status">Loading contractor form...</p>
    }
    else if (!_canSubmit)
    {
        <div class="alert alert-danger" role="alert">@_loadError</div>
        @if (_accessStatus == System.Net.HttpStatusCode.Unauthorized)
        {
            <a href="/login">Sign in</a>
        }
        else
        {
            <button id="retry-contractor-create" class="btn btn-outline-primary" @onclick="LoadCompanyOptionsAsync">Retry</button>
        }
    }
    else
    {
    <div class="card shadow-sm">
        <div class="card-body">
            <CSM.Web.Components.CompanySelector Options="_companyOptions" @bind-Value="_request.CompanyId" Id="contractor-company" Disabled="_saving" />

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label">
                        Contractor Code
                    </label>

                    <input class="form-control"
                           @bind="_request.ContractorCode" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">
                        Name
                    </label>

                    <input class="form-control"
                           @bind="_request.Name" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">
                        Contact Person
                    </label>

                    <input class="form-control"
                           @bind="_request.ContactPerson" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">
                        Phone Number
                    </label>

                    <input class="form-control"
                           @bind="_request.PhoneNumber" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">
                        Email
                    </label>

                    <input type="email"
                           class="form-control"
                           @bind="_request.Email" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">
                        Tax Identification Number
                    </label>

                    <input class="form-control"
                           @bind="_request.TaxIdentificationNumber" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">
                        Registration Number
                    </label>

                    <input class="form-control"
                           @bind="_request.RegistrationNumber" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">
                        Status
                    </label>

                    <select class="form-select"
                            @bind="_status">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label">
                        Address
                    </label>

                    <textarea class="form-control"
                              rows="3"
                              @bind="_request.Address">
                    </textarea>
                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">

                <button class="btn btn-outline-secondary"
                        @onclick="BackToContractors"
                        disabled="@_saving">
                    Cancel
                </button>

                <button class="btn btn-primary"
                        @onclick="SaveAsync"
                        disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="bi bi-save me-1"></i>
                        <span>Save Contractor</span>
                    }
                </button>

            </div>

        </div>
    </div>

    }
</div>

@code {
    private readonly CreateContractorRequest _request =
        new();

    private CSM.Web.Models.Common.CompanySelectionOptions _companyOptions = new();
    private bool _loading = true;
    private bool _canSubmit;
    private string? _loadError;
    private System.Net.HttpStatusCode? _accessStatus;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadCompanyOptionsAsync();
    }

    private async Task LoadCompanyOptionsAsync()
    {
        _loading = true;
        _canSubmit = false;
        _loadError = null;
        _accessStatus = null;
        try
        {
            _companyOptions = await ContractorService.GetContractorCompanyOptionsAsync();
            _request.CompanyId = _companyOptions.CompanyId;
            _canSubmit = true;
        }
        catch (Exception ex)
        {
            _accessStatus = (ex as HttpRequestException)?.StatusCode;
            _loadError = _accessStatus switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Your session is missing or has expired. Please sign in again.",
                System.Net.HttpStatusCode.Forbidden => "You do not have permission to create contractors.",
                _ => "Unable to load contractor form. Please try again."
            };
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool _saving;
    private string? _errorMessage;
    private string _status = "true";

    private async Task SaveAsync()
    {
        if (_saving || !_canSubmit) return;
        _errorMessage = null;
        if (_companyOptions.CanSelectCompany && !_request.CompanyId.HasValue)
        {
            _errorMessage = "Please select a company.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_request.ContractorCode))
        {
            _errorMessage = "Contractor Code is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_request.Name))
        {
            _errorMessage = "Contractor Name is required.";
            return;
        }

        _saving = true;

        try
        {
            _request.IsActive =
                string.Equals(
                    _status,
                    "true",
                    StringComparison.OrdinalIgnoreCase);

            await ContractorService.CreateContractorAsync(_request);

            Navigation.NavigateTo("/hr/contractors");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void BackToContractors()
    {
        Navigation.NavigateTo("/hr/contractors");
    }
}