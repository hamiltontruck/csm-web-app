@page "/hr/leave"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.HRM
@using CSM.Web.Services

@using System.Net
@inject IAuthService AuthService
@inject ILeaveService LeaveService
@inject NavigationManager Navigation

<PageTitle>Leave Management</PageTitle>

<div class="container-fluid py-3">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Leave Management</h2>
            <p class="text-muted mb-0">
                Manage employee leave requests.
            </p>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-secondary"
                    @onclick="GoBack">
                Back
            </button>

            @if (_canSubmit)
            {
                <button class="btn btn-primary" @onclick="CreateLeave">Add Leave</button>
            }
        </div>
    </div>

    @if (_loading)
    {
        <div class="alert alert-info">
            Loading leave requests...
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
        @if (_accessStatus == HttpStatusCode.Unauthorized)
        {
            <a id="leave-list-sign-in" class="btn btn-primary" href="/login?returnUrl=%2Fhr%2Fleave">Sign in</a>
        }
        else if (_accessStatus != HttpStatusCode.Forbidden)
        {
            <button id="retry-leave-list" class="btn btn-outline-primary" @onclick="LoadAsync">Retry</button>
        }
    }
    else if (_leaves.Count == 0)
    {
        <div class="alert alert-secondary">
            No leave requests found.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">

                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Leave Type</th>
                                <th>Start</th>
                                <th>End</th>
                                <th>Days</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var leave in _leaves)
                            {
                                <tr>
                                    <td>
                                        <strong>@leave.EmployeeName</strong>
                                        <br />
                                        <small class="text-muted">
                                            @leave.EmployeeNumber
                                        </small>
                                    </td>

                                    <td>@leave.LeaveType</td>

                                    <td>
                                        @leave.StartDate.ToString("yyyy-MM-dd")
                                    </td>

                                    <td>
                                        @leave.EndDate.ToString("yyyy-MM-dd")
                                    </td>

                                    <td>@leave.NumberOfDays</td>

                                    <td>
                                        <span class="badge @GetStatusClass(leave.Status)">
                                            @leave.Status
                                        </span>
                                    </td>

                                    <td>
                                        @if (_canReview && string.Equals(
                                            leave.Status,
                                            "Pending",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <button class="btn btn-sm btn-success me-1"
                                                    disabled="@_mutating" @onclick="() => ApproveLeave(leave.Id)">
                                                Approve
                                            </button>

                                            <button class="btn btn-sm btn-danger me-1"
                                                    disabled="@_mutating" @onclick="() => RejectLeave(leave.Id)">
                                                Reject
                                            </button>
                                        }

                                        @if (_canReview && !string.Equals(
                                            leave.Status,
                                            "Cancelled",
                                            StringComparison.OrdinalIgnoreCase) &&
                                            !string.Equals(
                                            leave.Status,
                                            "Rejected",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <button class="btn btn-sm btn-outline-danger"
                                                    disabled="@_mutating" @onclick="() => CancelLeave(leave.Id)">
                                                Cancel
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

            </div>
        </div>
    }

</div>

@code {
    private List<LeaveResponse> _leaves = [];
    private bool _loading = true;
    private bool _canSubmit;
    private bool _canReview;
    private bool _mutating;
    private string? _error;
    private HttpStatusCode? _accessStatus;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _accessStatus = null;
        _canSubmit = _canReview = false;
        _leaves = [];
        try
        {
            var result = await LeaveService.GetAllAsync();
            var permissions = await AuthService.GetPermissionsAsync();
            _leaves = result.ToList();
            _canSubmit = permissions.Contains("HRM_Leave_Submit");
            _canReview = permissions.Contains("HRM_Leave_Approve");
        }
        catch (Exception ex)
        {
            SetFailure(ex, "You do not have permission to view leave requests.",
                "Unable to load leave requests. Please try again.");
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SetFailure(Exception ex, string forbidden, string fallback)
    {
        _leaves = [];
        _canSubmit = _canReview = false;
        _accessStatus = (ex as HttpRequestException)?.StatusCode;
        _error = _accessStatus switch
        {
            HttpStatusCode.Unauthorized => "Your session is missing or has expired. Please sign in again.",
            HttpStatusCode.Forbidden => forbidden,
            _ => fallback
        };
    }

    private void CreateLeave()
    {
        if (_canSubmit) Navigation.NavigateTo("/hr/leave/create");
    }

    private void GoBack() => Navigation.NavigateTo("/hr");

    private Task ApproveLeave(Guid id) => RunActionAsync(
        () => LeaveService.ReviewAsync(id, new ReviewLeaveRequest { Status = "Approved", Remarks = null }));

    private Task RejectLeave(Guid id) => RunActionAsync(
        () => LeaveService.ReviewAsync(id, new ReviewLeaveRequest { Status = "Rejected", Remarks = null }));

    private Task CancelLeave(Guid id) => RunActionAsync(
        () => LeaveService.CancelAsync(id, new CancelLeaveRequest { Remarks = null }));

    private async Task RunActionAsync(Func<Task> action)
    {
        if (!_canReview || _mutating) return;
        _mutating = true;
        _error = null;
        _accessStatus = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            SetFailure(ex, "You do not have permission to review or cancel leave requests.",
                "Unable to update leave request. Please try again.");
        }
        finally
        {
            _mutating = false;
        }
    }

    private static string GetStatusClass(string status)
    {
        return status.ToLowerInvariant() switch
        {
            "approved" => "bg-success",
            "rejected" => "bg-danger",
            "cancelled" => "bg-secondary",
            "pending" => "bg-warning text-dark",
            _ => "bg-secondary"
        };
    }
}