@page "/hr/site-assignments/create"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.HRM
@using CSM.Web.Models.Sites
@using CSM.Web.Services
@using CSM.Web.Services.HRM

@inject ISiteAssignmentService SiteAssignmentService
@inject IEmployeeService EmployeeService
@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>Create Site Assignment</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Create Site Assignment</h2>
            <p class="text-muted mb-0">
                Assign an employee to a construction site.
            </p>
        </div>

        <button class="btn btn-outline-secondary"
                @onclick="Back">
            Back
        </button>
    </div>

    @if (_loading)
    {
        <div class="alert alert-info">
            Loading employees and construction sites...
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="alert alert-danger">
                        @_errorMessage
                    </div>
                }

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Employee</label>

                        <select class="form-select"
                                @bind="_employeeId">
                            <option value="">-- Select Employee --</option>

                            @foreach (var employee in _employees)
                            {
                                <option value="@employee.Id">
                                    @employee.EmployeeNumber -
                                    @employee.FirstName @employee.LastName
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Construction Site</label>

                        <select class="form-select"
                                @bind="_constructionSiteId">
                            <option value="">-- Select Site --</option>

                            @foreach (var site in _sites)
                            {
                                <option value="@site.Id">
                                    @site.SiteCode - @site.Name
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Start Date</label>

                        <input type="date"
                               class="form-control"
                               @bind="_startDate" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">End Date</label>

                        <input type="date"
                               class="form-control"
                               @bind="_endDate" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Role at Site</label>

                        <input type="text"
                               class="form-control"
                               maxlength="150"
                               @bind="_roleAtSite"
                               placeholder="e.g. Senior Site Engineer" />
                    </div>

                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="primaryAssignment"
                                   @bind="_isPrimaryAssignment" />

                            <label class="form-check-label"
                                   for="primaryAssignment">
                                Primary Assignment
                            </label>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Remarks</label>

                        <textarea class="form-control"
                                  rows="3"
                                  @bind="_remarks"></textarea>
                    </div>

                </div>

                <div class="d-flex gap-2 mt-4">

                    <button class="btn btn-primary"
                            @onclick="Save"
                            disabled="@_saving">
                        @if (_saving)
                        {
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Save Assignment</span>
                        }
                    </button>

                    <button class="btn btn-outline-secondary"
                            @onclick="Back"
                            disabled="@_saving">
                        Cancel
                    </button>

                </div>

            </div>
        </div>
    }
</div>

@code {

    private List<EmployeeResponse> _employees = [];
    private List<SiteResponse> _sites = [];

    private Guid? _employeeId;
    private Guid? _constructionSiteId;

    private DateOnly _startDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? _endDate;

    private string? _roleAtSite;
    private bool _isPrimaryAssignment;
    private string? _remarks;

    private bool _loading = true;
    private bool _saving;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _employees = (await EmployeeService.GetEmployeesAsync("Active"))
                .ToList();

            _sites = (await ProjectService.GetSitesForAssignmentAsync())
                .Where(x => x.IsActive)
                .ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Save()
    {
        _errorMessage = null;

        if (!_employeeId.HasValue)
        {
            _errorMessage = "Please select an employee.";
            return;
        }

        if (!_constructionSiteId.HasValue)
        {
            _errorMessage = "Please select a construction site.";
            return;
        }

        if (_endDate.HasValue && _endDate.Value < _startDate)
        {
            _errorMessage = "End Date cannot be earlier than Start Date.";
            return;
        }

        _saving = true;

        try
        {
            var request = new CreateSiteAssignmentRequest
            {
                EmployeeId = _employeeId.Value,
                ConstructionSiteId = _constructionSiteId.Value,
                StartDate = _startDate,
                EndDate = _endDate,
                RoleAtSite = string.IsNullOrWhiteSpace(_roleAtSite)
                    ? null
                    : _roleAtSite.Trim(),
                IsPrimaryAssignment = _isPrimaryAssignment,
                Remarks = string.IsNullOrWhiteSpace(_remarks)
                    ? null
                    : _remarks.Trim()
            };

            var result =
                await SiteAssignmentService.CreateAsync(request);

            if (result is null)
            {
                _errorMessage = "Failed to create the site assignment.";
                return;
            }

            Navigation.NavigateTo("/hr/site-assignments");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void Back()
    {
        Navigation.NavigateTo("/hr/site-assignments");
    }
}