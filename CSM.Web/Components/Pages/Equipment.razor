@inherits WorkspacePageBase
@page "/equipment"
@inject NavigationManager Navigation

<PageTitle>Equipment</PageTitle>
<WorkspaceAccessFeedback Loaded="AccessLoaded" Error="@AccessError" />

<div class="container py-4">

    <div class="d-flex align-items-center mb-4">

        <button class="btn btn-outline-secondary me-3"
                @onclick="GoBack">
            ← Back
        </button>

        <h2 class="mb-0">
            Equipment Management
        </h2>

    </div>

    <div class="row g-4">

        @if (Access.CanVisit("/equipment/list"))
        {
<div class="col-md-6">
            <div class="card shadow-sm h-100"
                 style="cursor:pointer"
                 @onclick='() => Navigation.NavigateTo("/equipment/list")'>

                <div class="card-body">
                    <h4>Equipment</h4>
                    <p class="text-muted mb-0">
                        Register and manage equipment assets.
                    </p>
                </div>

            </div>
        </div>
        }

        @if (Access.CanVisit("/equipment/sites"))
        {
<div class="col-md-6">
            <div class="card shadow-sm h-100"
                 style="cursor:pointer"
                 @onclick='() => Navigation.NavigateTo("/equipment/sites")'>

                <div class="card-body">
                    <h4>Assignments</h4>
                    <p class="text-muted mb-0">
                        Assign equipment to construction sites.
                    </p>
                </div>

            </div>
        </div>
        }

        @if (Access.CanVisit("/equipment/downtime-sites"))
        {
<div class="col-md-6">
            <div class="card shadow-sm h-100"
                 style="cursor:pointer"
                 @onclick='() => Navigation.NavigateTo("/equipment/downtime-sites")'>

                <div class="card-body">
                    <h4>Downtime</h4>
                    <p class="text-muted mb-0">
                        Track equipment downtime and resolutions.
                    </p>
                </div>

            </div>
        </div>
        }

        @if (Access.CanVisit("/equipment/maintenance-sites"))
        {
<div class="col-md-6">
            <div class="card shadow-sm h-100"
                 style="cursor:pointer"
                 @onclick='() => Navigation.NavigateTo("/equipment/maintenance-sites")'>

                <div class="card-body">

                    <h4>Maintenance</h4>

                    <p class="text-muted mb-0">
                        Manage preventive and corrective maintenance
                    </p>

                </div>

            </div>
        </div>
        }

        @if (Access.CanVisit("/equipment/fuel-sites"))
        {
<div class="col-md-6">
            <div class="card shadow-sm h-100"
                 style="cursor:pointer"
                 @onclick='() => Navigation.NavigateTo("/equipment/fuel-sites")'>

                <div class="card-body">

                    <h4>Fuel Consumption</h4>

                    <p class="text-muted mb-0">
                        Record fuel usage by construction site
                    </p>

                </div>

            </div>
        </div>
        }

       @if (Access.CanVisit("/equipment/hourmeter-sites"))
        {
<div class="col-md-6">
           <div class="card shadow-sm h-100"
                style="cursor:pointer"
                @onclick='() => Navigation.NavigateTo("/equipment/hourmeter-sites")'>

               <div class="card-body">

                   <h4>Hour Meter</h4>

                   <p class="text-muted mb-0">
                       Record equipment operating hours by construction site
                   </p>

               </div>

           </div>
       </div>
        }

        @if (Access.CanVisit("/equipment/utilization-sites"))
        {
<div class="col-md-6">
            <div class="card shadow-sm h-100"
                 style="cursor:pointer"
                 @onclick='() => Navigation.NavigateTo("/equipment/utilization-sites")'>

                <div class="card-body">
                    <h4>Utilization</h4>
                    <p class="text-muted mb-0">
                        View equipment hours, fuel usage, downtime, and maintenance cost.
                    </p>
                </div>

            </div>
        </div>
        }
    @if (Access.CanVisit("/equipment/timesheet-sites"))
        {
<div class="col-md-6">
        <div class="card shadow-sm h-100"
             style="cursor:pointer"
             @onclick='() => Navigation.NavigateTo("/equipment/timesheet-sites")'>

            <div class="card-body">

                <h4>Daily Timesheets</h4>

                <p class="text-muted mb-0">
                    Record daily equipment shifts by construction site
                </p>

            </div>

        </div>
    </div>
        }

    </div>

</div>

@code {

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }

}