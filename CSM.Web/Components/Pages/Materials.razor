@page "/materials"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.Procurement
@using CSM.Web.Services

@inject IProcurementService ProcurementService
@inject NavigationManager Navigation

<button class="btn btn-outline-secondary mb-3"
        @onclick="GoBack">
    <i class="bi bi-arrow-left"></i> Back
</button>

<PageTitle>Materials</PageTitle>

@if (_loading)
{
    <div class="container py-4">
        <h4>Loading materials...</h4>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="container py-4">
        <div class="alert alert-danger">
            @_error
        </div>
    </div>
}
else
{
    <div class="container-fluid py-4">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2>Materials</h2>
                <div class="text-muted">Material Master Catalogue</div>
            </div>

            <WorkspaceAction Route="/materials/create">

                <button class="btn btn-primary" @onclick="NewMaterial">
                + New Material
            </button>
            </WorkspaceAction>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-0">

                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Unit</th>
                            <th>Type</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var material in _materials)
                        {
                            <tr style="cursor:pointer"
                                @onclick='() => Edit(material.Id)'>
                                <td>@material.MaterialCode</td>
                                <td>@material.Name</td>
                                <td>@material.Category</td>
                                <td>@material.UnitOfMeasure</td>
                                <td>@material.MaterialTypeName</td>
                                <td>
                                    <span class="badge @(material.IsActive ? "bg-success" : "bg-secondary")">
                                        @(material.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>

    </div>
}

@code {
    private List<MaterialResponse> _materials = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _materials = await ProcurementService.GetMaterialsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    void NewMaterial()
        => Navigation.NavigateTo("/materials/create");

    void Edit(Guid id)
        => Navigation.NavigateTo($"/materials/{id}/edit");

    void GoBack()
        => Navigation.NavigateTo("/procurement");
}