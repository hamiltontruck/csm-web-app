<div class="settings-footer">
    <div class="settings-footer-note @(HasUnsavedChanges ? "settings-unsaved" : string.Empty)"
         aria-live="polite">
        @if (_isLoading)
        {
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>Loading preferences...</span>
        }
        else if (!_preferencesLoaded)
        {
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
            <span>Preferences are unavailable until they load successfully.</span>
            <button type="button"
                    class="btn btn-sm btn-outline-primary"
                    @onclick="LoadPreferencesAsync"
                    disabled="@_isLoading">
                Retry
            </button>
        }
        else if (HasUnsavedChanges)
        {
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
            <span>You have unsaved changes.</span>
        }
        else
        {
            <i class="bi bi-check-circle" aria-hidden="true"></i>
            <span>All preferences are saved.</span>
        }
    </div>

    <button type="button"
            class="btn btn-outline-secondary"
            @onclick="DiscardPreferenceChangesAsync"
            disabled="@(_isLoading || _isSaving || !HasUnsavedChanges)">
        Discard changes
    </button>

    <button type="button"
            class="btn btn-outline-secondary"
            @onclick="ResetPreferencesAsync"
            disabled="@(_isLoading || _isSaving || !_preferencesLoaded)">
        Restore defaults
    </button>

    <button type="button"
            class="btn btn-primary settings-save-button"
            @onclick="SavePreferencesAsync"
            disabled="@(_isSaving || _isLoading || !_preferencesLoaded || !HasUnsavedChanges)">
        <i class="bi bi-check2-circle me-2"></i>
        @(_isSaving ? "Saving..." : "Save preferences")
    </button>
</div>


