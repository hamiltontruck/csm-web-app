@page "/sites/{SiteId:guid}/projects"
@rendermode InteractiveServer

@using CSM.Web.Models.Projects
@using CSM.Web.Services

@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>Projects</PageTitle>

@if (_loading)
{
    <p class="m-4">Loading projects...</p>
}
else
{
    <div class="container-fluid py-4">

        <div class="d-flex justify-content-between align-items-start mb-4">

            <div>
               <WorkspaceAction Route="/sites/{SiteId}">
                   <button class="btn btn-outline-secondary mb-3"
                       @onclick='() => Navigation.NavigateTo($"/sites/{SiteId}")'>
                   ← Back to Site
               </button>
            </WorkspaceAction>

                <h2 class="mb-1">Site Projects</h2>
                <p class="text-muted mb-0">
                    Manage all projects assigned to this construction site
                </p>
            </div>

            <WorkspaceAction Route="/projects/create/{SiteId}">

                <button class="btn btn-primary"
                    @onclick='() => Navigation.NavigateTo($"/projects/create/{SiteId}")'>
                + New Project
            </button>
            </WorkspaceAction>

        </div>

        <div class="row g-3 mb-4">

            <div class="col-md-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div class="text-muted">Total Projects</div>
                        <h2>@_projects.Count</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div class="text-muted">Active</div>
                        <h2>@_projects.Count(x => x.Status == "Active")</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div class="text-muted">Planning</div>
                        <h2>@_projects.Count(x => x.Status == "Planning")</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div class="text-muted">Completed</div>
                        <h2>@_projects.Count(x => x.Status == "Completed")</h2>
                    </div>
                </div>
            </div>

        </div>

        <div class="card shadow-sm border-0">

            <div class="card-header bg-white">
                <strong>Project List</strong>
            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Code</th>
                            <th>Project Name</th>
                            <th>Status</th>
                            <th class="text-end">Progress</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (_projects.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    No projects assigned to this site.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var project in _projects.OrderBy(x => x.Name))
                            {
                                <tr style="cursor:pointer"
                                    @onclick='() => Navigation.NavigateTo($"/projects/{project.Id}")'>

                                    <td>
                                        <strong>@project.Code</strong>
                                    </td>

                                    <td>@project.Name</td>

                                    <td>

                                        @if (project.Status == "Active")
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else if (project.Status == "Planning")
                                        {
                                            <span class="badge bg-dark">Planning</span>
                                        }
                                        else if (project.Status == "Completed")
                                        {
                                            <span class="badge bg-primary">Completed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @project.Status
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">
                                        <strong>@project.ProgressPercentage.ToString("0")%</strong>
                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
}

@code {
    [Parameter]
    public Guid SiteId { get; set; }

    private bool _loading = true;
    private bool _loaded;

    private List<ProjectSummary> _projects = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
            return;

        _loaded = true;

        var allProjects = await ProjectService.GetProjectsAsync();

        _projects = allProjects
            .Where(x => x.ConstructionSiteId == SiteId)
            .OrderBy(x => x.Name)
            .ToList();

        _loading = false;

        StateHasChanged();
    }

    void OpenProject(Guid id)
    {
        Navigation.NavigateTo($"/projects/{id}");
    }

    void NewProject()
    {
        Navigation.NavigateTo($"/projects/create/{SiteId}");
    }
}