@page "/stock-balance/site/{SiteId:guid}"
@rendermode InteractiveServer

@using CSM.Web.Models.Procurement
@using CSM.Web.Models.Sites
@using CSM.Web.Services

@inject IInventoryService InventoryService
@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>Site Stock Balance</PageTitle>

<div class="container py-4">

    <button class="btn btn-outline-secondary mb-3"
            @onclick="GoBack">
        <i class="bi bi-arrow-left"></i> Back
    </button>

    <h2>@siteName</h2>
    <div class="text-muted mb-4">Current Stock Balance</div>

    @if (loading)
    {
        <p>Loading stock balance...</p>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
        @if (signInRequired)
        {
            <a id="stock-site-sign-in" class="btn btn-primary" href="/login">Sign in</a>
        }
        else if (canRetry)
        {
            <button id="retry-stock-balances" class="btn btn-primary" @onclick="LoadAsync">Retry</button>
        }
    }
    else if (balances.Count == 0)
    {
        <div class="alert alert-info">
            No stock available for this site.
        </div>
    }
    else
    {
        @foreach (var item in balances)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold">
                                @item.MaterialCode - @item.MaterialName
                            </div>
                            <small class="text-muted">@item.UnitOfMeasure</small>
                        </div>

                        <div class="text-end">
                            <div class="fs-5 fw-bold text-primary">
                                @item.QuantityOnHand
                            </div>
                            <small class="text-muted">On Hand</small>
                        </div>
                    </div>

                    <hr />

                    <div class="row text-center">
                        <div class="col">
                            <small class="text-muted">Available</small>
                            <div class="fw-bold">@item.AvailableQuantity</div>
                        </div>

                        <div class="col">
                            <small class="text-muted">Reserved</small>
                            <div class="fw-bold">@item.QuantityReserved</div>
                        </div>


                    </div>

                </div>
            </div>
        }
    }

</div>

@code {
    [Parameter]
    public Guid SiteId { get; set; }

    private List<StockBalanceResponse> balances = [];
    private string siteName = "Construction Site";
    private bool loading = true;
    private Guid? loadedSiteId;
    private bool canRetry = true;
    private bool signInRequired;

    private string? errorMessage;

    protected override void OnParametersSet()
    {
        if (loadedSiteId == SiteId) return;
        balances = [];
        siteName = "Construction Site";
        errorMessage = null;
        loading = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (loadedSiteId == SiteId) return;
        loadedSiteId = SiteId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var requestedSiteId = SiteId;
        loading = true;
        errorMessage = null;
        balances = [];
        siteName = "Construction Site";
        canRetry = true;
        signInRequired = false;
        try
        {
            var sites = await ProjectService.GetSitesAsync();
            if (requestedSiteId != SiteId) return;
            var site = sites.FirstOrDefault(x => x.Id == requestedSiteId);
            if (site is null)
            {
                errorMessage = "This site is unavailable or you do not have permission to view its stock.";
                canRetry = false;
                return;
            }

            siteName = site.Name;
            var result = await InventoryService.GetStockBySiteAsync(requestedSiteId);
            if (requestedSiteId != SiteId) return;
            balances = result;
        }
        catch (HttpRequestException ex)
        {
            if (requestedSiteId != SiteId) return;
            signInRequired = ex.StatusCode == System.Net.HttpStatusCode.Unauthorized;
            canRetry = ex.StatusCode is not (System.Net.HttpStatusCode.Unauthorized
                or System.Net.HttpStatusCode.Forbidden or System.Net.HttpStatusCode.NotFound);
            errorMessage = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Your session is missing or has expired. Please sign in again.",
                System.Net.HttpStatusCode.Forbidden => "You do not have permission to view stock for this site.",
                System.Net.HttpStatusCode.NotFound => "This site is unavailable or you do not have permission to view its stock.",
                _ => "Unable to load stock balances. Please try again."
            };
        }
        catch (Exception)
        {
            if (requestedSiteId != SiteId) return;
            errorMessage = "Unable to load stock balances. Please try again.";
        }
        finally
        {
            if (requestedSiteId == SiteId)
            {
                loading = false;
                StateHasChanged();
            }
        }
    }

    void GoBack()
        => Navigation.NavigateTo("/stock-balance");
}