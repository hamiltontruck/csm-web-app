@page "/stock-balance/site/{SiteId:guid}"
@rendermode InteractiveServer

@using CSM.Web.Models.Procurement
@using CSM.Web.Models.Sites
@using CSM.Web.Services

@inject IInventoryService InventoryService
@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>Site Stock Balance</PageTitle>

<div class="container py-4">

    <button class="btn btn-outline-secondary mb-3"
            @onclick="GoBack">
        <i class="bi bi-arrow-left"></i> Back
    </button>

    <h2>@siteName</h2>
    <div class="text-muted mb-4">Current Stock Balance</div>

    @if (loading)
    {
        <p>Loading stock balance...</p>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
        <button id="retry-stock-balances" class="btn btn-primary" @onclick="LoadAsync">Retry</button>
    }
    else if (balances.Count == 0)
    {
        <div class="alert alert-info">
            No stock available for this site.
        </div>
    }
    else
    {
        @foreach (var item in balances)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold">
                                @item.MaterialCode - @item.MaterialName
                            </div>
                            <small class="text-muted">@item.UnitOfMeasure</small>
                        </div>

                        <div class="text-end">
                            <div class="fs-5 fw-bold text-primary">
                                @item.QuantityOnHand
                            </div>
                            <small class="text-muted">On Hand</small>
                        </div>
                    </div>

                    <hr />

                    <div class="row text-center">
                        <div class="col">
                            <small class="text-muted">Available</small>
                            <div class="fw-bold">@item.AvailableQuantity</div>
                        </div>

                        <div class="col">
                            <small class="text-muted">Reserved</small>
                            <div class="fw-bold">@item.QuantityReserved</div>
                        </div>


                    </div>

                </div>
            </div>
        }
    }

</div>

@code {
    [Parameter]
    public Guid SiteId { get; set; }

    private List<StockBalanceResponse> balances = [];
    private string siteName = "";
    private bool loading = true;
    private bool loaded;

    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded) return;
        loaded = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        errorMessage = null;
        try
        {
            balances = await InventoryService.GetStockBySiteAsync(SiteId);
            var sites = await ProjectService.GetSitesAsync();
            siteName = sites.FirstOrDefault(x => x.Id == SiteId)?.Name ?? "Construction Site";
        }
        catch (Exception)
        {
            errorMessage = "Unable to load stock balances. Please try again.";
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    void GoBack()
        => Navigation.NavigateTo("/stock-balance");
}