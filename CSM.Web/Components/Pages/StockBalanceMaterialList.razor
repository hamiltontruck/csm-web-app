@page "/stock-balance/{ConstructionSiteId:guid}"
@rendermode InteractiveServer

@using CSM.Web.Models.Procurement
@using CSM.Web.Services

@inject IInventoryService InventoryService
@inject NavigationManager Navigation

<PageTitle>Stock Balance</PageTitle>

@if (loading)
{
    <div class="container py-4">
        <p>Loading...</p>
    </div>
}
else
{
    <div class="container py-4">

        <button class="btn btn-outline-secondary mb-3" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i> Back
        </button>

        <h2>Materials</h2>
        <p class="text-muted">@siteName</p>

        @foreach (var item in balances)
        {
            <div class="card shadow-sm mb-3"
                 style="cursor:pointer"
                 @onclick="@(() => OpenDetail(item.MaterialId))">

                <div class="card-body d-flex align-items-center">

                    <div class="me-3">
                        <i class="bi bi-box-seam fs-2 text-primary"></i>
                    </div>

                    <div class="flex-grow-1">
                        <h5 class="mb-1">@item.MaterialName</h5>
                        <div class="text-muted">@item.MaterialCode</div>
                    </div>

                    <div class="text-end me-3">
                        <div class="fw-bold">@item.QuantityOnHand</div>
                        <small>@item.UnitOfMeasure</small>
                    </div>

                    <i class="bi bi-chevron-right"></i>

                </div>
            </div>
        }

    </div>
}

@code {
    [Parameter]
    public Guid ConstructionSiteId { get; set; }

    private List<StockBalanceResponse> balances = [];
    private bool loading = true;
    private string siteName = "";

    protected override async Task OnInitializedAsync()
    {
        balances = await InventoryService.GetStockBalancesAsync(
            constructionSiteId: ConstructionSiteId);

        siteName = balances.FirstOrDefault()?.SiteName ?? "Construction Site";

        loading = false;
    }

    void GoBack()
    {
        Navigation.NavigateTo("/stock-balance");
    }

    void OpenDetail(Guid materialId)
    {
        Navigation.NavigateTo(
            $"/stock-balance/{ConstructionSiteId}/{materialId}");
    }
}