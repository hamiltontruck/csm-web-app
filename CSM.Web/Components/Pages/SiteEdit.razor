@page "/sites/edit/{SiteId:guid}"
@rendermode InteractiveServer
@implements IDisposable

@using Microsoft.JSInterop
@using CSM.Web.Models.Sites
@using CSM.Web.Services

@inject IProjectService ProjectService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Edit Construction Site</PageTitle>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <button class="btn btn-outline-secondary"
                @onclick='() => Navigation.NavigateTo($"/sites/{SiteId}")'>
            <span class="bi bi-arrow-left me-1"></span>
            Back
        </button>

        <h3 class="mb-0">Edit Construction Site</h3>

    </div>

    @if (loading)
    {
        <div class="alert alert-info">Loading site...</div>
    }
    else
    {
        <EditForm Model="site" OnValidSubmit="Save">

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label">Site Name</label>
                    <InputText class="form-control" @bind-Value="site.Name" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Site Code</label>
                    <InputText class="form-control" @bind-Value="site.SiteCode" disabled />
                </div>

                <div class="col-12">
                    <label class="form-label">Address</label>
                    <InputText class="form-control" @bind-Value="site.Address" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">City</label>
                    <InputText class="form-control" @bind-Value="site.City" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Region</label>
                    <InputText class="form-control" @bind-Value="site.Region" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Country</label>
                    <InputText class="form-control" @bind-Value="site.Country" />
                </div>

            </div>

            <hr class="my-4"/>

            <h5>GPS Location</h5>

            <div class="input-group mb-3">
                <input class="form-control"
                       placeholder="Search Dire Dawa or address..."
                       @bind="SearchText"/>

                <button type="button"
                        class="btn btn-outline-primary"
                        @onclick="SearchLocation">
                    Search
                </button>
            </div>

            <div id="siteMap"
                 style="height:420px;border:1px solid #ddd;border-radius:10px;">
            </div>

            <div class="row mt-3">

                <div class="col-md-4">
                    <label class="form-label">Latitude</label>
                    <input class="form-control"
                           readonly
                           value="@site.Latitude"/>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Longitude</label>
                    <input class="form-control"
                           readonly
                           value="@site.Longitude"/>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Geofence (m)</label>
                    <InputNumber class="form-control"
                                 @bind-Value="site.GeofenceRadiusMeters"/>
                </div>

            </div>

            <hr class="my-4"/>

            <div class="row">

                <div class="col-md-6">
                    <label class="form-label">Planned Start</label>
                    <InputDate class="form-control"
                               @bind-Value="site.PlannedStartDate"/>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Planned Finish</label>
                    <InputDate class="form-control"
                               @bind-Value="site.PlannedEndDate"/>
                </div>

            </div>

            <div class="mt-4 d-flex justify-content-end gap-2">

                <button type="button"
                        class="btn btn-outline-secondary"
                        @onclick='() => Navigation.NavigateTo($"/sites/{SiteId}")'>
                    Cancel
                </button>

                <button type="submit"
                        class="btn btn-primary">
                    Save Changes
                </button>

            </div>

        </EditForm>
    }

</div>

@code {

    [Parameter]
    public Guid SiteId { get; set; }

    private SiteResponse site = default!;
    private bool loading = true;

    private string SearchText = "Dire Dawa";

    private DotNetObjectReference<SiteEdit>? mapRef;

    private bool mapInitialized;

    protected override async Task OnInitializedAsync()
    {
        site = await ProjectService.GetSiteAsync(SiteId);
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (loading || mapInitialized)
            return;

        mapInitialized = true;

        mapRef = DotNetObjectReference.Create(this);

        await JS.InvokeVoidAsync(
            "siteMap.initialize",
            "siteMap",
            (double)(site.Latitude ?? 9.5931m),
            (double)(site.Longitude ?? 41.8661m),
            mapRef);
    }

    private async Task Save()
    {
        var request = new UpdateSiteRequest
        {
            Name = site.Name,
            Description = site.Description,
            BusinessUnitId = site.BusinessUnitId,
            Address = site.Address,
            City = site.City,
            Region = site.Region,
            Country = site.Country,
            Latitude = site.Latitude,
            Longitude = site.Longitude,
            GeofenceRadiusMeters = site.GeofenceRadiusMeters,
            PlannedStartDate = site.PlannedStartDate,
            PlannedEndDate = site.PlannedEndDate
        };

        await ProjectService.UpdateSiteAsync(SiteId, request);

        Navigation.NavigateTo($"/sites/{SiteId}", true);
    }

    private async Task SearchLocation()
    {
        await JS.InvokeVoidAsync("siteMap.search", SearchText);
    }

    [JSInvokable]
    public void SetCoordinates(double lat, double lng)
    {
        site.Latitude = (decimal)lat;
        site.Longitude = (decimal)lng;

        StateHasChanged();
    }

    public void Dispose()
    {
        mapRef?.Dispose();
    }
}