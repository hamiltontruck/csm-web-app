@page "/projects"
@rendermode InteractiveServer

@using CSM.Web.Services
@using CSM.Web.Models.Projects

@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>Projects</PageTitle>

@if (_loading)
{
    <div class="container py-5 text-center">
            <div class="spinner-border text-primary"></div>
            <p class="mt-3">Loading projects...</p>
    </div>
}
else
{
    <div class="container-fluid py-4">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <WorkspaceAction Route="/project-tracking">
                    <button class="btn btn-outline-secondary mb-3"
                        @onclick='() => Navigation.NavigateTo("/project-tracking")'>
                    ← Project Tracking
                </button>
            </WorkspaceAction>

                <h2 class="mb-1">Projects</h2>
                <p class="text-muted mb-0">
                    @_projects.Count project(s)
                </p>
            </div>

            <WorkspaceAction Route="/projects/create">
                <button class="btn btn-primary"
                    @onclick='() => Navigation.NavigateTo("/projects/create")'>
                + New Project
            </button>
            </WorkspaceAction>

        </div>

        <div class="row g-3 mb-4">

            <div class="col-md-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div class="text-muted">Total</div>
                        <h2>@_projects.Count</h2>>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div class="text-muted">Active</div>
                        <h2>@_projects.Count(x => x.Status == "Active")</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div class="text-muted">Planning</div>
                        <h2>@_projects.Count(x => x.Status == "Planning")</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div class="text-muted">Completed</div>
                        <h2>@_projects.Count(x => x.Status == "Completed")</h2>
                    </div>
                </div>
            </div>

        </div>

        <div class="card shadow-sm border-0">

            <div class="table-responsive">

                <table class="table table-hover mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Code</th>
                            <th>Project</th>
                            <th>Construction Site</th>
                            <th>Status</th>
                            <th class="text-end">Progress</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var project in _projects.OrderBy(x => x.Name))
                        {
                            <tr style="cursor:pointer"
                                @onclick='() => Navigation.NavigateTo($"/projects/{project.Id}")'>

                                <td>@project.Code</td>
                                <td>@project.Name</td>
                                <td>@project.ConstructionSiteName</td>

                                <td>

                                    @if (project.Status == "Active")
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else if (project.Status == "Planning")
                                    {
                                        <span class="badge bg-dark">Planning</span>
                                    }
                                    else if (project.Status == "Completed")
                                    {
                                        <span class="badge bg-primary">Completed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @project.Status
                                        </span>
                                    }

                                </td>

                                <td class="text-end">
                                    @project.ProgressPercentage.ToString("0")%
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
}

@code{

    private bool _loading = true;
    private bool _loaded;

    private List<ProjectSummary> _projects = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
            return;

        _loaded = true;

        _projects = await ProjectService.GetProjectsAsync();

        _loading = false;

        StateHasChanged();
    }

}