@page "/stock-returns/create/{SiteId:guid}"
@rendermode InteractiveServer

@using CSM.Web.Models.Procurement
@using CSM.Web.Services

@inject IInventoryService InventoryService
@inject NavigationManager Navigation

<PageTitle>New Stock Return</PageTitle>

<div class="container py-4">

    <button class="btn btn-outline-secondary mb-3"
            @onclick="GoBack">
        <i class="bi bi-arrow-left"></i> Back
    </button>

    <h2 class="mb-4">New Stock Return</h2>

    <div class="card shadow-sm">
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger mb-3" role="alert">
                @errorMessage
            </div>
        }

        <div class="row g-3">

            <div class="col-12">
                <label class="form-label">Original Stock Issue</label>

                <select class="form-select" @onchange="IssueChanged">
                    <option value="">-- Select Issue --</option>

                    @foreach (var issue in issueMovements)
                    {
                        <option value="@issue.Id">
                            @(string.IsNullOrWhiteSpace(issue.ReferenceNumber) ? issue.Id.ToString() : issue.ReferenceNumber)
                            | @issue.MovementDateUtc.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)
                            | @issue.MaterialCode - @issue.MaterialName
                            (@issue.Quantity @issue.UnitOfMeasure)
                        </option>
                    }
                </select>
            </div>

            @if (selectedIssue is not null)
            {
                <div class="col-12">
                    <div class="alert alert-light border">

                        <div><strong>Reference:</strong> @selectedIssue.ReferenceNumber</div>
                        <div><strong>Material:</strong> @selectedIssue.MaterialCode - @selectedIssue.MaterialName</div>
                        <div><strong>Issued Quantity:</strong> @selectedIssue.Quantity @selectedIssue.UnitOfMeasure</div>
                        <div><strong>Stock After Issue:</strong> @selectedIssue.StockBalanceAfter @selectedIssue.UnitOfMeasure</div>

                    </div>
                </div>
            }

            <div class="col-md-6">
                <label class="form-label">Return Date</label>
                <input type="date"
                       class="form-control"
                       @bind="model.ReturnDate" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Return Quantity</label>
                <input type="number"
                       step="0.01"
                       class="form-control"
                       @bind="model.Quantity" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Reference Number</label>
                <input class="form-control"
                       @bind="model.ReferenceNumber" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Returned By</label>
                <input class="form-control"
                       @bind="model.ReturnedBy" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Reason</label>
                <input class="form-control"
                       @bind="model.Reason" />
            </div>

            <div class="col-12">
                <label class="form-label">Remarks</label>
                <textarea class="form-control"
                          rows="3"
                          @bind="model.Remarks"></textarea>
            </div>

        </div>

        <hr />

        <div class="d-flex justify-content-end gap-2">

            <button class="btn btn-outline-secondary"
                    @onclick="GoBack">
                Cancel
            </button>

            <button class="btn btn-primary"
                    @onclick="SaveReturn"
                    disabled="@saving">
                @(saving ? "Saving..." : "Save Return")
            </button>

        </div>
    </div>

</div>

@code{
    [Parameter]
    public Guid SiteId { get; set; }

    private List<StockMovementResponse> issueMovements = [];

    private bool loaded;
    private bool saving;
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded)
            return;

        loaded = true;

        issueMovements =
            (await InventoryService.GetStockMovementsAsync())
            .Where(x =>
                x.MovementType == "Issue" &&
                x.ConstructionSiteId == SiteId)
            .OrderByDescending(x => x.MovementDateUtc)
            .ToList();

        StateHasChanged();
    }

    void GoBack()
        => Navigation.NavigateTo($"/stock-returns/site/{SiteId}");

    private StockMovementResponse? selectedIssue;

    private ReturnModel model = new();

    public class ReturnModel
    {
        public Guid? OriginalIssueMovementId { get; set; }

        public DateTime ReturnDate { get; set; } = DateTime.Today;

        public decimal Quantity { get; set; }

        public string ReferenceNumber { get; set; } = "";

        public string ReturnedBy { get; set; } = "";

        public string Reason { get; set; } = "";

        public string Remarks { get; set; } = "";
    }

    private void IssueChanged(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var id))
            return;

        model.OriginalIssueMovementId = id;

        selectedIssue = issueMovements
            .FirstOrDefault(x => x.Id == id);
    }
private async Task SaveReturn()
{
    if (saving) return;

    errorMessage = null;

    if (model.OriginalIssueMovementId == null)
    {
        errorMessage = "Please select an original stock issue.";
        return;
    }

    if (model.Quantity <= 0)
    {
        errorMessage = "Return quantity must be greater than zero.";
        return;
    }

    saving = true;
    try
    {
        var success = await InventoryService.CreateStockReturnAsync(
            new CreateStockReturnRequest
            {
                OriginalIssueMovementId = model.OriginalIssueMovementId.Value,
                Quantity = model.Quantity,
                ReturnDateUtc = model.ReturnDate,
                ReferenceNumber = model.ReferenceNumber,
                ReturnedBy = model.ReturnedBy,
                Reason = model.Reason,
                Remarks = model.Remarks
            });
        if (success)
            Navigation.NavigateTo($"/stock-returns/site/{SiteId}");
        else
            errorMessage = "Unable to create stock return.";
    }
    catch (HttpRequestException ex)
    {
        errorMessage = ex.StatusCode.HasValue
            ? ex.Message
            : "Unable to reach the inventory service. Please try again.";
    }
    catch (TaskCanceledException)
    {
        errorMessage = "The inventory request timed out. Check the saved records before trying again.";
    }
    catch (Exception)
    {
        errorMessage = "Unable to save the stock return. Please check the saved records before trying again.";
    }
    finally
    {
        saving = false;
    }
}
}
