@page "/users/edit/{Id:guid}"


@using Microsoft.AspNetCore.Authorization
@using CSM.Web.Models.Users
@using CSM.Web.Models.Sites
@using CSM.Web.Services

@inject UserWebService UserService
@inject IProjectService ProjectService
@inject RoleWebService RoleService
@inject NavigationManager Navigation

<PageTitle>Edit User</PageTitle>

<h3 class="mb-4">Edit User</h3>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <div class="mt-2">Loading user...</div>
    </div>
}
else if (userLoaded)
{
    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <fieldset disabled="@saving">

        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <strong>Basic Information</strong>
            </div>

            <div class="card-body">
                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">First Name</label>
                        <InputText class="form-control"
                                   @bind-Value="model.FirstName" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Last Name</label>
                        <InputText class="form-control"
                                   @bind-Value="model.LastName" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Phone Number</label>
                        <InputText class="form-control"
                                   @bind-Value="model.PhoneNumber" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Job Title</label>
                        <InputText class="form-control"
                                   @bind-Value="model.JobTitle" />
                    </div>

                    <div class="col-md-4">
                        <div class="form-check mt-4">
                            <InputCheckbox class="form-check-input"
                                           @bind-Value="model.IsActive" />
                            <label class="form-check-label">
                                Active User
                            </label>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <strong>Roles</strong>
            </div>

            <div class="card-body">
                <div class="row">

                    @foreach (var role in Roles)
                    {
                        <div class="col-md-4 mb-2">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       checked="@selectedRoles.Contains(role)"
                                       @onchange="e => ToggleRole(role, e.Value)" />

                                <label class="form-check-label">
                                    @role
                                </label>
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <strong>Construction Site Access</strong>
            </div>

            <div class="card-body">

                @if (Sites.Count == 0)
                {
                    <p class="text-muted">No active sites are available for this user's company.</p>
                }

                @foreach (var site in Sites)
                {
                    <div class="form-check mb-2">
                        <input class="form-check-input"
                               type="checkbox"
                               checked="@model.SiteIds.Contains(site.Id)"
                               @onchange="e => ToggleSite(site.Id, e.Value)" />

                        <label class="form-check-label">
                            @site.Name
                        </label>
                    </div>
                }

                <hr />

                <label class="form-label">Default Site</label>

                <InputSelect class="form-select"
                             @bind-Value="model.DefaultSiteId">

                    <option value="">-- Select Default Site --</option>

                    @foreach (var site in SelectedSites)
                    {
                        <option value="@site.Id">
                            @site.Name
                        </option>
                    }

                </InputSelect>

            </div>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-primary"
                    type="submit"
                    disabled="@saving">

                @if (saving)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <span>Save Changes</span>
                }

            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="Back"
                    disabled="@saving">
                Cancel
            </button>
        </div>

        </fieldset>
    </EditForm>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private UpdateUserModel model = new();

    private List<SiteResponse> Sites = [];

    private bool loading = true;

    private bool saving;
    private bool userLoaded;

    private string? errorMessage;

    private string[] Roles = [];
    private HashSet<string> selectedRoles = new(StringComparer.OrdinalIgnoreCase);

    private IEnumerable<SiteResponse> SelectedSites =>
        Sites.Where(x => model.SiteIds.Contains(x.Id));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var user = await UserService.GetByIdAsync(Id);
            if (user is null)
            {
                errorMessage = "User was not found.";
                return;
            }
            var availableRoles = await RoleService.GetRolesAsync();
            var availableSites = await ProjectService.GetSitesAsync();
            Sites = availableSites.Where(x => x.CompanyId == user.CompanyId && x.IsActive).ToList();
            model.EmployeeId = user.EmployeeId;
            model.FirstName = user.FirstName;
            model.LastName = user.LastName;
            model.PhoneNumber = user.PhoneNumber;
            model.JobTitle = user.JobTitle;
            model.IsActive = user.IsActive;
            model.SiteIds = user.SiteAccesses.Where(id => Sites.Any(site => site.Id == id)).Distinct().ToList();
            model.DefaultSiteId = user.DefaultSiteId.HasValue && model.SiteIds.Contains(user.DefaultSiteId.Value)
                ? user.DefaultSiteId : null;
            selectedRoles = new(user.Roles, StringComparer.OrdinalIgnoreCase);
            Roles = availableRoles.Select(x => x.Name).Concat(user.Roles)
                .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToArray();
            userLoaded = true;
        }
        catch (HttpRequestException ex)
        {
            errorMessage = LoadError(ex);
        }
        catch (Exception)
        {
            errorMessage = "Unable to load the user and assignment options. Please try again.";
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private static string LoadError(HttpRequestException ex) => ex.StatusCode switch
    {
        System.Net.HttpStatusCode.Unauthorized => "Your session has expired. Please sign in again.",
        System.Net.HttpStatusCode.Forbidden => "You do not have permission to edit this user.",
        _ => "Unable to load the user and assignment options. Please try again."
    };

    private void ToggleRole(string role, object? value)
    {
        var isChecked = value as bool? ?? false;

        if (isChecked)
        {
            if (!selectedRoles.Contains(role))
                selectedRoles.Add(role);
        }
        else
        {
            selectedRoles.Remove(role);
        }
    }

    private void ToggleSite(Guid siteId, object? value)
    {
        var isChecked = value as bool? ?? false;

        if (isChecked)
        {
            if (!model.SiteIds.Contains(siteId))
                model.SiteIds.Add(siteId);
        }
        else
        {
            model.SiteIds.Remove(siteId);

            if (model.DefaultSiteId == siteId)
                model.DefaultSiteId = null;
        }
    }

    private async Task SaveAsync()
    {
        if (saving || !userLoaded) return;
        errorMessage = null;
        if (selectedRoles.Count == 0)
        {
            errorMessage = "At least one role is required.";
            return;
        }
        if (model.DefaultSiteId.HasValue && !model.SiteIds.Contains(model.DefaultSiteId.Value))
        {
            errorMessage = "The default site must be one of the assigned sites.";
            return;
        }
        saving = true;

        try
        {
            await UserService.UpdateAsync(Id, model);

            await UserService.SetRolesAsync(Id, selectedRoles.ToList());

            await UserService.SetSitesAsync(
                Id,
                model.DefaultSiteId,
                model.SiteIds.Distinct().ToList());

            Navigation.NavigateTo("/users");
        }
        catch (HttpRequestException ex)
        {
            errorMessage = ex.StatusCode.HasValue ? ex.Message : "Unable to reach the user service. Please try again.";
        }
        catch (Exception)
        {
            errorMessage = "Unable to save user changes. Check the user before trying again.";
        }
        finally
        {
            saving = false;
        }
    }

    private void Back()
    {
        Navigation.NavigateTo("/users");
    }
}