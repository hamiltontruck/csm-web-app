@page "/projects/{Id:guid}/edit"
@rendermode InteractiveServer

@using CSM.Web.Models.Projects
@using CSM.Web.Services

@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>Edit Project</PageTitle>

@if (_loading)
{
    <div class="container py-5 text-center">
        <div class="spinner-border text-primary"></div>
        <p class="mt-3">Loading project...</p>
    </div>
}
else if (_project is null)
{
    <div class="container py-4">
        <div class="alert alert-danger">
            Project not found.
        </div>
    </div>
}
else
{
    <div class="container py-4">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <button class="btn btn-outline-secondary mb-3"
                        @onclick="Cancel">
                    ← Project Details
                </button>

                <h2 class="mb-0">Edit Project</h2>
                <small class="text-muted">@_project.Code</small>
            </div>

            <button class="btn btn-success"
                    @onclick="Save">
                Save Changes
            </button>

        </div>

        <div class="card shadow-sm border-0">

            <div class="card-header bg-white">
                <strong>General Information</strong>
            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Project Name</label>
                        <InputText class="form-control"
                                   @bind-Value="_project.Name"/>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Project Code</label>
                        <InputText class="form-control"
                                   @bind-Value="_project.Code"
                                   disabled/>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Status</label>
                        <input class="form-control" value="@_project.Status" disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Progress</label>
                        <input class="form-control"
                               value="@($"{_project.ProgressPercentage}%")"
                               disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Planned Start</label>

                        <InputDate class="form-control"
                                   @bind-Value="_project.PlannedStartDate"/>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Planned End</label>

                        <InputDate class="form-control"
                                   @bind-Value="_project.PlannedEndDate"/>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Description</label>

                        <InputTextArea class="form-control"
                                       rows="5"
                                       @bind-Value="_project.Description"/>
                    </div>

                </div>

            </div>

            <div class="card-footer bg-white d-flex justify-content-end gap-2">

                <button class="btn btn-outline-secondary"
                        @onclick="Cancel">
                    Cancel
                </button>

                <button class="btn btn-primary"
                        @onclick="Save">
                    Save
                </button>

            </div>

        </div>

    </div>
}

@code {

    [Parameter]
    public Guid Id { get; set; }

    private ProjectDetail? _project;

    private bool _loading = true;
    private bool _loaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
            return;

        _loaded = true;

        _project = await ProjectService.GetProjectAsync(Id);

        _loading = false;

        StateHasChanged();
    }

    private void Cancel()
    {
        Navigation.NavigateTo($"/projects/{Id}");
    }

    private async Task Save()
    {
        if (_project is null)
            return;

        var request = new UpdateProjectRequest
        {
            Name = _project.Name,
            Description = _project.Description,
            Status = _project.Status,
            ProgressPercentage = _project.ProgressPercentage,
            PlannedStartDate = _project.PlannedStartDate,
            PlannedEndDate = _project.PlannedEndDate
        };

        var success = await ProjectService.UpdateProjectAsync(Id, request);

        if (success)
        {
            Navigation.NavigateTo($"/projects/{Id}", true);
        }
    }

}