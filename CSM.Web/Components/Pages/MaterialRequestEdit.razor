
@page "/material-requests/edit/{Id:guid}"
@rendermode InteractiveServer

@using CSM.Web.Models.Procurement
@using CSM.Web.Models.Sites
@using CSM.Web.Services
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage

@inject IProcurementService ProcurementService
@inject IHttpClientFactory HttpClientFactory
@inject ProtectedSessionStorage SessionStorage
@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>Edit Material Request</PageTitle>

<div class="container py-4">
    <button class="btn btn-outline-secondary mb-3" @onclick="Cancel">
        Back
    </button>

    <h3 class="mb-4">Edit Material Request</h3>

    @if (loading)
    {
        <p>Loading material request...</p>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else if (request is not null)
    {
        <EditForm Model="request" OnValidSubmit="Save"
                  FormName="MaterialRequestEditForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Site</label>
                            <InputSelect class="form-select"
                                         @bind-Value="request.ConstructionSiteId">
                                @foreach (var site in sites)
                                {
                                    <option value="@site.Id">@site.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Request Number</label>
                            <InputText class="form-control"
                                       @bind-Value="request.RequestNumber" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Request Date</label>
                            <InputDate class="form-control"
                                       @bind-Value="request.RequestDate" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Required By</label>
                            <InputDate class="form-control"
                                       @bind-Value="request.RequiredByDate" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Priority</label>
                            <InputSelect class="form-select"
                                         @bind-Value="request.Priority">
                                <option value="Low">Low</option>
                                <option value="Normal">Normal</option>
                                <option value="High">High</option>
                                <option value="Urgent">Urgent</option>
                            </InputSelect>
                        </div>

                        @if (editableLines.Count > 0)
                        {
                            <div class="col-md-6">
                                <label class="form-label">Material</label>
                                <InputSelect class="form-select"
                                             @bind-Value="editableLines[0].MaterialId">
                                    <option value="">-- Select Material --</option>
                                    @foreach (var material in materials)
                                    {
                                        <option value="@material.Id">
                                            @material.Name
                                        </option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Unit</label>
                                <input class="form-control"
                                       value="@SelectedMaterialUnit"
                                       readonly />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Quantity</label>
                                <InputNumber class="form-control"
                                             @bind-Value="editableLines[0].RequestedQuantity" />
                            </div>

                            <div class="col-12">
                                <label class="form-label">Line Remarks</label>
                                <InputText class="form-control"
                                           @bind-Value="editableLines[0].Remarks" />
                            </div>
                        }

                        <div class="col-12">
                            <label class="form-label">Purpose</label>
                            <InputTextArea class="form-control" rows="3"
                                           @bind-Value="request.Purpose" />
                        </div>
                    </div>
                </div>

                <div class="card-footer text-end">
                    <button type="button" class="btn btn-secondary me-2"
                            @onclick="Cancel">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-primary"
                            disabled="@saving">
                        @(saving ? "Saving..." : "Save Changes")
                    </button>
                </div>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool loading = true;
    private bool saving;
    private string? errorMessage;

    private MaterialRequestResponse? original;
    private UpdateMaterialRequestRequest? request;

    private List<SiteResponse> sites = [];
    private List<MaterialResponse> materials = [];

    private List<MaterialRequestLineInput> editableLines = [];

    private string SelectedMaterialUnit =>
        materials.FirstOrDefault(m =>
            m.Id == (editableLines.FirstOrDefault()?.MaterialId ?? Guid.Empty))
            ?.UnitOfMeasure ?? string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await ProcurementService.GetMaterialRequestAsync(Id);

            if (result is null)
            {
                errorMessage = "Material request not found.";
                return;
            }

            original = result;

            sites = await ProjectService.GetSitesAsync();
            materials = await ProcurementService.GetMaterialsAsync();

            editableLines = result.Lines.Select(line =>
                new MaterialRequestLineInput
                {
                    MaterialId = line.MaterialId,
                    RequestedQuantity = line.RequestedQuantity,
                    Remarks = line.Remarks
                }).ToList();

            if (editableLines.Count == 0)
            {
                editableLines.Add(new MaterialRequestLineInput());
            }

            request = new UpdateMaterialRequestRequest
            {
                ConstructionSiteId = result.ConstructionSiteId,
                ProjectId = result.ProjectId,
                RequestNumber = result.RequestNumber,
                RequestDate = result.RequestDate,
                RequiredByDate = result.RequiredByDate,
                Purpose = result.Purpose,
                Priority = result.Priority,
                Lines = editableLines
            };
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task Save()
    {
        if (request is null)
            return;

        saving = true;
        errorMessage = null;

        try
        {
            request = new UpdateMaterialRequestRequest
            {
                ConstructionSiteId = request.ConstructionSiteId,
                ProjectId = request.ProjectId,
                RequestNumber = request.RequestNumber,
                RequestDate = request.RequestDate,
                RequiredByDate = request.RequiredByDate,
                Purpose = request.Purpose,
                Priority = request.Priority,
                Lines = editableLines.ToList()
            };

            var token = await SessionStorage.GetAsync<string>("jwt");
            if (!token.Success || string.IsNullOrWhiteSpace(token.Value))
            {
                throw new InvalidOperationException(
                    "Your session has expired. Please sign in again.");
            }

            using var client = HttpClientFactory.CreateClient("CSM.Api");
            client.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token.Value);

            using var response = await client.PutAsJsonAsync(
                $"materialrequests/{Id}",
                request);
            response.EnsureSuccessStatusCode();
            Navigation.NavigateTo($"/material-requests/{Id}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private void Cancel() =>
        Navigation.NavigateTo($"/material-requests/{Id}");
}
