@page "/purchase-orders/create/{SiteId:guid}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.Procurement
@using CSM.Web.Services
@using Microsoft.AspNetCore.Components.Web

@inject IProcurementService ProcurementService
@inject NavigationManager Navigation

<PageTitle>@(IsEditing ? "Edit Purchase Order" : "New Purchase Order")</PageTitle>

@if (!_loaded)
{
    <div class="container py-4">
        <h4>Loading...</h4>
    </div>
}
else
{
    <div class="container py-4">

        <button class="btn btn-outline-secondary mb-3"
                disabled="@saving" @onclick="Cancel">
            <i class="bi bi-arrow-left"></i> Back
        </button>

        <h2 class="mb-4">@(IsEditing ? "Edit Purchase Order" : "New Purchase Order")</h2>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        @if (!_canSave && _retryLoad)
        {
            <button id="retry-purchase-order-form" class="btn btn-primary" @onclick="LoadFormAsync">Retry</button>
        }
        @if (_canSave)
        {
        <EditForm Model="@request"
                  OnValidSubmit="@Save"
                  FormName="@(IsEditing ? "PurchaseOrderEditForm" : "PurchaseOrderCreateForm")">
            <fieldset disabled="@saving">
            <DataAnnotationsValidator />
            <ValidationSummary />



            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">PO Number</label>
                            <input type="text" class="form-control"
                                   @bind="request.PurchaseOrderNumber" @bind:event="oninput"
                                   @onchange="@(e => request.PurchaseOrderNumber = e.Value?.ToString() ?? string.Empty)" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Order Date</label>
                            <InputDate class="form-control"
                                       @bind-Value="request.OrderDate"/>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Supplier</label>

                            <InputSelect class="form-select"
                                         @bind-Value="request.VendorId">
                                <option value="@Guid.Empty">-- Select Supplier --</option>

                                @foreach (var s in suppliers)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Remarks</label>

                            <textarea class="form-control" rows="3"
                                      @bind="request.Remarks" @bind:event="oninput"
                                      @onchange="@(e => request.Remarks = e.Value?.ToString())"></textarea>
                        </div>

                    </div>

                </div>
            </div>

            <div class="card shadow-sm">

                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Materials</h5>

                    <button type="button"
                            class="btn btn-sm btn-primary"
                            @onclick="AddLine">
                        + Add Item
                    </button>
                </div>

                <div class="card-body">

                    @foreach (var line in request.Lines)
                    {
                        <div @key="line" class="border rounded p-3 mb-3">

                            <div class="row g-3">

                                <div class="col-md-4">
                                    <label class="form-label">Material</label>

                                    <InputSelect class="form-select"
                                                 @bind-Value="line.MaterialId">
                                        <option value="">Select Material</option>

                                        @foreach (var m in materials)
                                        {
                                            <option value="@m.Id">@m.Name</option>
                                        }
                                    </InputSelect>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label">Quantity</label>

                                    <PurchaseOrderDecimalInput class="form-control"
                                                               DisplayName="Quantity"
                                                               @bind-Value="line.OrderedQuantity" />
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Unit Price (@request.CurrencyCode)</label>

                                    <PurchaseOrderDecimalInput class="form-control"
                                                               DisplayName="Unit Price"
                                                               @bind-Value="line.UnitPrice" />
                                </div>

                                <div class="col-12 text-end">
                                    <button type="button"
                                            class="btn btn-outline-danger"
                                            @onclick="() => RemoveLine(line)">
                                        Remove
                                    </button>
                                </div>

                            </div>

                        </div>
                    }

                </div>

                <div class="card-footer text-end">

                    <button type="submit"
                            class="btn btn-success"
                            disabled="@saving">
                        @(saving ? "Saving..." : IsEditing ? "Save Changes" : "Save Purchase Order")
                    </button>

                </div>

            </div>

            </fieldset>
        </EditForm>
        }

    </div>
}

@code {
    [Parameter] public Guid SiteId { get; set; }
    [Parameter] public Guid? PurchaseOrderId { get; set; }
    private bool IsEditing => PurchaseOrderId.HasValue;
    private bool _loaded, _loadStarted, _hasParameters, _canSave, _retryLoad, saving;
    private int _loadVersion;
    private (Guid?, Guid) _parameterKey;
    private string? errorMessage;
    private List<MaterialResponse> materials = [];
    private List<SupplierResponse> suppliers = [];
    private UpdatePurchaseOrderRequest request = new() { OrderDate = DateOnly.FromDateTime(DateTime.Today) };

    protected override void OnParametersSet()
    {
        var key = (PurchaseOrderId, SiteId);
        if (_hasParameters && _parameterKey == key) return;
        _hasParameters = true;
        _parameterKey = key;
        _loadVersion++;
        _loaded = _loadStarted = _canSave = _retryLoad = saving = false;
        errorMessage = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loadStarted) return;
        _loadStarted = true;
        await LoadFormAsync();
    }

    private async Task LoadFormAsync()
    {
        var version = ++_loadVersion;
        var editingId = PurchaseOrderId;
        _loaded = _canSave = _retryLoad = false;
        errorMessage = null;
        try
        {
            var model = new UpdatePurchaseOrderRequest { ConstructionSiteId = SiteId, OrderDate = DateOnly.FromDateTime(DateTime.Today) };
            Guid? companyId = null;
            if (editingId.HasValue)
            {
                var order = await ProcurementService.GetPurchaseOrderAsync(editingId.Value);
                if (version != _loadVersion) return;
                if (order is null || order.Id != editingId)
                {
                    errorMessage = "Purchase order not found.";
                    return;
                }
                if (order.Status != "Draft")
                {
                    errorMessage = "Only Draft purchase orders can be edited.";
                    return;
                }
                companyId = order.CompanyId;
                model = new()
                {
                    ConstructionSiteId = order.ConstructionSiteId, ProjectId = order.ProjectId,
                    VendorId = order.VendorId, MaterialRequestId = order.MaterialRequestId,
                    PurchaseOrderNumber = order.PurchaseOrderNumber, OrderDate = order.OrderDate,
                    ExpectedDeliveryDate = order.ExpectedDeliveryDate, CurrencyCode = order.CurrencyCode,
                    ExchangeRate = order.ExchangeRate, DiscountAmount = order.DiscountAmount,
                    DeliveryAddress = order.DeliveryAddress, PaymentTerms = order.PaymentTerms, Remarks = order.Notes,
                    Lines = order.Lines.Select(line => new PurchaseOrderLineRequest
                    {
                        MaterialId = line.MaterialId, CostCodeId = line.CostCodeId,
                        OrderedQuantity = line.OrderedQuantity, UnitPrice = line.UnitPrice, TaxAmount = line.TaxAmount
                    }).ToList()
                };
            }
            var materialTask = ProcurementService.GetMaterialsAsync();
            var supplierTask = ProcurementService.GetVendorsAsync();
            await Task.WhenAll(materialTask, supplierTask);
            if (version != _loadVersion) return;
            materials = companyId.HasValue ? materialTask.Result.Where(x => x.CompanyId == companyId).ToList() : materialTask.Result;
            suppliers = companyId.HasValue ? supplierTask.Result.Where(x => x.CompanyId == companyId).ToList() : supplierTask.Result;
            if (!editingId.HasValue && model.Lines.Count == 0) model.Lines.Add(new());
            request = model;
            _canSave = true;
        }
        catch (HttpRequestException ex)
        {
            if (version == _loadVersion) { errorMessage = SafeError(ex, "Unable to load purchase order form. Please try again."); _retryLoad = true; }
        }
        catch (Exception)
        {
            if (version == _loadVersion) { errorMessage = "Unable to load purchase order form. Please try again."; _retryLoad = true; }
        }
        finally
        {
            if (version == _loadVersion) { _loaded = true; await InvokeAsync(StateHasChanged); }
        }
    }

    private static string SafeError(HttpRequestException ex, string fallback) => ex.StatusCode switch
    {
        System.Net.HttpStatusCode.Unauthorized => "Your session has expired. Please sign in again.",
        System.Net.HttpStatusCode.Forbidden => "You do not have permission to manage this purchase order.",
        _ => fallback
    };
    private void AddLine() => request.Lines.Add(new PurchaseOrderLineRequest());
    private void RemoveLine(PurchaseOrderLineRequest line) => request.Lines.Remove(line);

    private async Task Save()
    {
        if (saving || !_loaded || !_canSave) return;
        var version = _loadVersion;
        var id = PurchaseOrderId;
        var model = request;
        saving = true;
        errorMessage = null;
        try
        {
            if (id.HasValue) await ProcurementService.UpdatePurchaseOrderAsync(id.Value, model);
            else await ProcurementService.CreatePurchaseOrderAsync(model);
            if (version != _loadVersion) return;
            Navigation.NavigateTo(id.HasValue ? $"/purchase-orders/{id}" : $"/purchase-orders/site/{model.ConstructionSiteId}");
        }
        catch (PurchaseOrderValidationException ex)
        {
            if (version == _loadVersion) errorMessage = ex.Message;
        }
        catch (HttpRequestException ex)
        {
            if (version == _loadVersion) errorMessage = SafeError(ex, "Unable to save purchase order. Please try again.");
        }
        catch (Exception)
        {
            if (version == _loadVersion) errorMessage = "Unable to save purchase order. Please try again.";
        }
        finally { if (version == _loadVersion) saving = false; }
    }
    private void Cancel() => Navigation.NavigateTo(IsEditing ? $"/purchase-orders/{PurchaseOrderId}" : $"/purchase-orders/site/{SiteId}");
}
