@page "/material-requests/create"
@page "/material-requests/create/{SiteId:guid}"
@rendermode InteractiveServer

@using CSM.Web.Models.Procurement
@using CSM.Web.Models.Sites
@using CSM.Web.Services

@inject IProcurementService ProcurementService
@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>New Material Request</PageTitle>
@if (!_loaded)
{
    <div class="container py-4">
        <h4>Loading...</h4>
    </div>
    return;
}

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger">@_error</div>
}
<div class="container py-4">

    <button class="btn btn-outline-secondary mb-3" @onclick="Cancel">
        <i class="bi bi-arrow-left"></i> Back
    </button>


    <h3 class="mb-4">New Material Request</h3>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }
    <EditForm Model="request"
              OnValidSubmit="Save"
              FormName="MaterialRequestCreateForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="card shadow-sm">
            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Site</label>
                        <InputSelect class="form-select"
                                     @bind-Value="request.ConstructionSiteId">
                            <option value="">-- Select Site --</option>

                            @foreach (var site in sites)
                            {
                                <option value="@site.Id">@site.Name</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Request Number</label>
                        <InputText class="form-control"
                                   @bind-Value="request.RequestNumber"
                                   placeholder="MR-2026-001" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Request Date</label>
                        <InputDate class="form-control"
                                   @bind-Value="request.RequestDate" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Material</label>
                        <InputSelect class="form-select"
                                     @bind-Value="request.Lines[0].MaterialId">
                            <option value="">-- Select Material --</option>

                            @foreach (var material in materials)
                            {
                                <option value="@material.Id">@material.Name</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Quantity</label>
                        <InputNumber class="form-control"
                                     @bind-Value="request.Lines[0].RequestedQuantity" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Remarks</label>
                        <InputTextArea class="form-control"
                                       rows="3"
                                       @bind-Value="request.Purpose" />
                    </div>

                </div>

            </div>

            <div class="card-footer text-end">

                <button type="button"
                        class="btn btn-secondary me-2"
                        @onclick="Cancel">
                    Cancel
                </button>

                <button type="submit"
                        class="btn btn-success"
                        disabled="@saving">
                    @(saving ? "Saving..." : "Save Request")
                </button>

            </div>
        </div>

    </EditForm>

</div>

@code {

    [Parameter]
    public Guid? SiteId { get; set; }

    protected override void OnParametersSet()
    {
        if (SiteId.HasValue)
            request.ConstructionSiteId = SiteId.Value;
    }

    private bool saving;
    private bool _loaded;
    private string? _error;
    private string? errorMessage;


    private List<SiteResponse> sites = [];
    private List<MaterialResponse> materials = [];

    private CreateMaterialRequestRequest request = new()
    {
        RequestDate = DateOnly.FromDateTime(DateTime.Today),
        Priority = "Normal"
    };



    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
            return;

        _loaded = true;

        try
        {
            sites = await ProjectService.GetSitesAsync();
            materials = await ProcurementService.GetMaterialsAsync();

            if (request.Lines.Count == 0)
                request.Lines.Add(new MaterialRequestLineRequest());
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task Save()
    {
        if (string.IsNullOrWhiteSpace(request.RequestNumber))
        {
            _error = "Request Number is required.";
            return;
        }

        saving = true;

        try
        {
            await ProcurementService.CreateMaterialRequestAsync(request);

            Navigation.NavigateTo("/material-requests", forceLoad: true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    void Cancel()
    {
        Navigation.NavigateTo("/material-requests");
    }
}