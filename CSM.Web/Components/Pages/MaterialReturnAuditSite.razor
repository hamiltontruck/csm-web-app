@page "/material-return-audit/site/{SiteId:guid}"
@rendermode InteractiveServer

@using CSM.Web.Models.Procurement
@using CSM.Web.Services

@inject IInventoryService InventoryService
@inject NavigationManager Navigation

<PageTitle>Material Return Audit</PageTitle>

@if (loading)
{
    <div class="container py-4">
        <h4>Loading audit history...</h4>
    </div>
}
else
{
    <div class="container py-4">

        <button class="btn btn-outline-secondary mb-3"
                @onclick="GoBack">
            <i class="bi bi-arrow-left"></i> Back
        </button>

        <h2>@siteName</h2>

        <div class="text-muted mb-4">
            Material Return Audit History
        </div>

        @if (audits.Count == 0)
        {
            <div class="alert alert-info">
                No material return history found.
            </div>
        }
        else
        {
            @foreach (var item in audits)
            {
                <div class="card shadow-sm mb-3">
                    <div class="card-body">

                        <div class="d-flex justify-content-between">

                            <div>
                                <div class="fw-bold">
                                    @item.MaterialCode - @item.MaterialName
                                </div>

                                <small class="text-muted">
                                    @item.ReturnDateUtc.ToString("dd MMM yyyy")
                                </small>
                            </div>

                            <div class="text-end">
                                <div class="fw-bold">
                                    @item.ReferenceNumber
                                </div>

                                <span class="badge bg-success">
                                    Returned
                                </span>
                            </div>

                        </div>

                        <hr />

                        <div class="row text-center mb-3">

                            <div class="col">
                                <small class="text-muted">Issued</small>
                                <div class="fw-bold">@item.OriginalIssuedQuantity</div>
                            </div>

                            <div class="col">
                                <small class="text-muted">Returned</small>
                                <div class="fw-bold">@item.ReturnedQuantity</div>
                            </div>

                            <div class="col">
                                <small class="text-muted">Remaining</small>
                                <div class="fw-bold">@item.RemainingReturnableQuantity</div>
                            </div>

                        </div>

                        <table class="table table-sm mb-0">
                            <tr>
                                <td><strong>Returned By</strong></td>
                                <td>@item.ReturnedBy</td>
                            </tr>
                            <tr>
                                <td><strong>Reason</strong></td>
                                <td>@item.Reason</td>
                            </tr>
                            <tr>
                                <td><strong>Remarks</strong></td>
                                <td>@item.Remarks</td>
                            </tr>
                        </table>

                    </div>
                </div>
            }
        }

    </div>
}

@code{
    [Parameter]
    public Guid SiteId { get; set; }

    private List<StockReturnResponse> audits = [];
    private bool loading = true;
    private string siteName = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var all = await InventoryService.GetStockReturnsAsync();

        audits = all
            .Where(x => x.ConstructionSiteId == SiteId)
            .OrderByDescending(x => x.ReturnDateUtc)
            .ToList();

        siteName = audits.FirstOrDefault()?.SiteName ?? "Construction Site";

        loading = false;

        StateHasChanged();
    }

    void GoBack()
        => Navigation.NavigateTo("/material-return-audit");
}