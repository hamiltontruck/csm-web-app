@page "/material-return-audit/site/{SiteId:guid}"
@rendermode InteractiveServer

@using CSM.Web.Models.Procurement
@using CSM.Web.Services

@inject IInventoryService InventoryService
@inject NavigationManager Navigation

<PageTitle>Material Return Audit</PageTitle>

@if (loading)
{
    <div class="container py-4">
        <h4>Loading audit history...</h4>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="container py-4">
        <div class="alert alert-danger" role="alert">@errorMessage</div>
        @if (signInRequired)
        {
            <a id="material-return-audit-sign-in" class="btn btn-primary" href="/login">Sign in</a>
        }
        else if (canRetry)
        {
            <button id="retry-material-return-audit" class="btn btn-primary" @onclick="LoadAsync">Retry</button>
        }
        <button class="btn btn-outline-secondary ms-2" @onclick="GoBack">Back</button>
    </div>
}
else
{
    <div class="container py-4">

        <button class="btn btn-outline-secondary mb-3"
                @onclick="GoBack">
            <i class="bi bi-arrow-left"></i> Back
        </button>

        <h2>@siteName</h2>

        <div class="text-muted mb-4">
            Material Return Audit History
        </div>

        @if (audits.Count == 0)
        {
            <div class="alert alert-info">
                No material return history found.
            </div>
        }
        else
        {
            @foreach (var item in audits)
            {
                <div class="card shadow-sm mb-3">
                    <div class="card-body">

                        <div class="d-flex justify-content-between">

                            <div>
                                <div class="fw-bold">
                                    @item.MaterialCode - @item.MaterialName
                                </div>

                                <small class="text-muted">
                                    @item.ReturnDateUtc.ToString("dd MMM yyyy")
                                </small>
                            </div>

                            <div class="text-end">
                                <div class="fw-bold">
                                    @item.ReferenceNumber
                                </div>

                                <span class="badge bg-success">
                                    Returned
                                </span>
                            </div>

                        </div>

                        <hr />

                        <div class="row text-center mb-3">

                            <div class="col">
                                <small class="text-muted">Issued</small>
                                <div class="fw-bold">@item.OriginalIssuedQuantity</div>
                            </div>

                            <div class="col">
                                <small class="text-muted">Returned</small>
                                <div class="fw-bold">@item.ReturnedQuantity</div>
                            </div>

                            <div class="col">
                                <small class="text-muted">Remaining</small>
                                <div class="fw-bold">@item.RemainingReturnableQuantity</div>
                            </div>

                        </div>

                        <table class="table table-sm mb-0">
                            <tr>
                                <td><strong>Returned By</strong></td>
                                <td>@item.ReturnedBy</td>
                            </tr>
                            <tr>
                                <td><strong>Reason</strong></td>
                                <td>@item.Reason</td>
                            </tr>
                            <tr>
                                <td><strong>Remarks</strong></td>
                                <td>@item.Remarks</td>
                            </tr>
                        </table>

                    </div>
                </div>
            }
        }

    </div>
}

@code{
    [Parameter]
    public Guid SiteId { get; set; }

    private List<StockReturnResponse> audits = [];
    private bool loading = true;
    private string siteName = "";

    private string? errorMessage;
    private bool canRetry = true;
    private bool signInRequired;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        errorMessage = null;
        audits = [];
        siteName = "";
        canRetry = true;
        signInRequired = false;
        try
        {
            var all = await InventoryService.GetStockReturnsAsync();
            audits = all.Where(x => x.ConstructionSiteId == SiteId)
                .OrderByDescending(x => x.ReturnDateUtc).ToList();
            siteName = audits.FirstOrDefault()?.SiteName ?? "Construction Site";
        }
        catch (HttpRequestException ex)
        {
            signInRequired = ex.StatusCode == System.Net.HttpStatusCode.Unauthorized;
            canRetry = ex.StatusCode is not (System.Net.HttpStatusCode.Unauthorized
                or System.Net.HttpStatusCode.Forbidden);
            errorMessage = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Your session is missing or has expired. Please sign in again.",
                System.Net.HttpStatusCode.Forbidden => "You do not have permission to view material return audit history.",
                _ => "Unable to load material return audit history. Please try again."
            };
        }
        catch (Exception)
        {
            errorMessage = "Unable to load material return audit history. Please try again.";
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    void GoBack()
        => Navigation.NavigateTo("/material-return-audit");
}