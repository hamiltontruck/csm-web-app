@page "/stock-adjustments/create"
@page "/stock-adjustments/create/{SiteId:guid}"
@rendermode InteractiveServer

@using CSM.Web.Models.Sites
@using CSM.Web.Models.Procurement
@using CSM.Web.Services

@inject IProjectService ProjectService
@inject IInventoryService InventoryService
@inject NavigationManager Navigation

<PageTitle>New Stock Adjustment</PageTitle>

<div class="container py-4">

    <button class="btn btn-outline-secondary mb-3" @onclick="GoBack">
        <i class="bi bi-arrow-left"></i> Back
    </button>

    <h2 class="mb-4">New Stock Adjustment</h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label">Construction Site</label>

                    <select class="form-select" @onchange="SiteChanged">
                        <option value="">-- Select Site --</option>

                        @foreach (var site in sites)
                        {
                            <option value="@site.Id">
                                @site.SiteCode - @site.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Adjustment Date</label>

                    <input type="date"
                           class="form-control"
                           @bind="model.AdjustmentDate" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Material</label>

                    <select class="form-select" @bind="model.MaterialId">
                        <option value="">-- Select Material --</option>

                        @foreach (var item in materials)
                        {
                            <option value="@item.MaterialId">
                                @item.MaterialCode - @item.MaterialName
                                (@item.QuantityOnHand @item.UnitOfMeasure)
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Adjustment Type</label>

                    <select class="form-select" @bind="model.Increase">
                        <option value="true">Increase</option>
                        <option value="false">Decrease</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Quantity</label>

                    <input type="number"
                           step="0.01"
                           class="form-control"
                           @bind="model.Quantity" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Unit Cost</label>
                    <input type="number" step="0.01"
                           class="form-control"
                           @bind="model.UnitCost" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Adjustment Number</label>
                    <input class="form-control"
                           @bind="model.AdjustmentNumber" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Approved By</label>
                    <input class="form-control"
                           @bind="model.ApprovedBy" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Reason</label>

                    <select class="form-select" @bind="model.Reason">
                        <option>Physical Count</option>
                        <option>Damage</option>
                        <option>Loss</option>
                        <option>Found</option>
                        <option>Count Correction</option>
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label">Remarks</label>

                    <textarea class="form-control"
                              rows="3"
                              @bind="model.Remarks"></textarea>
                </div>

            </div>

            <hr />
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger mt-3">
                    @errorMessage
                </div>
            }

            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-outline-secondary"
                        @onclick="GoBack">
                    Cancel
                </button>

                <button class="btn btn-primary"
                        @onclick="SaveAdjustment"
                        disabled="@saving">
                    @(saving ? "Saving..." : "Save Adjustment")
                </button>
            </div>

        </div>
    </div>

</div>

@code {
    [Parameter]
    public Guid? SiteId { get; set; }
    private AdjustmentModel model = new();

    private List<SiteResponse> sites = [];
    private List<StockBalanceResponse> materials = [];

    private bool loaded;
    private bool saving;
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded)
            return;

        loaded = true;

        sites = await ProjectService.GetSitesAsync();

        if (SiteId.HasValue)
            model.SiteId = SiteId.Value;

        StateHasChanged();
    }

    private async Task SiteChanged(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var siteId))
        {
            materials.Clear();
            model.SiteId = null;
            return;
        }

        model.SiteId = siteId;

        materials = await InventoryService.GetStockBySiteAsync(siteId);

        StateHasChanged();
    }

    void GoBack()
        => Navigation.NavigateTo("/stock-adjustments");

    public class AdjustmentModel
    {
        public Guid? SiteId { get; set; }
        public Guid? MaterialId { get; set; }

        public DateTime AdjustmentDate { get; set; } = DateTime.Today;

        public bool Increase { get; set; } = true;

        public decimal Quantity { get; set; }
        public decimal? UnitCost { get; set; }

        public string AdjustmentNumber { get; set; } = "";
        public string Reason { get; set; } = "";
        public string ApprovedBy { get; set; } = "";
        public string Remarks { get; set; } = "";
    }

private async Task SaveAdjustment()
{
    errorMessage = null;

    if (model.SiteId == null ||
        model.MaterialId == null)
    {
        errorMessage = "Please select a site and material.";
        return;
    }

    if (model.Quantity <= 0)
    {
        errorMessage = "Quantity must be greater than zero.";
        return;
    }

    saving = true;

    var success = await InventoryService.CreateStockAdjustmentAsync(
        new StockAdjustmentCreateRequest
        {
            ConstructionSiteId = model.SiteId!.Value,
            MaterialId = model.MaterialId!.Value,
            Increase = model.Increase,
            Quantity = model.Quantity,
            UnitCost = model.UnitCost,
            AdjustmentDateUtc = model.AdjustmentDate.ToUniversalTime(),
            AdjustmentNumber = model.AdjustmentNumber,
            Reason = model.Reason,
            ApprovedBy = string.IsNullOrWhiteSpace(model.ApprovedBy) ? null : model.ApprovedBy,
            Remarks = string.IsNullOrWhiteSpace(model.Remarks) ? null : model.Remarks
        });

    saving = false;

    if (success)
    {
        Navigation.NavigateTo(
            $"/stock-adjustments/site/{model.SiteId}");
    }
    else
    {
        errorMessage = "Unable to create stock adjustment.";
    }
}
}