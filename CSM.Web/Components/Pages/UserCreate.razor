@page "/users/create"

@using CSM.Web.Models.Users
@using CSM.Web.Models.Sites
@using CSM.Web.Services

@inject IProjectService ProjectService
@inject IAuthService AuthService
@inject UserWebService UserService
@inject NavigationManager Navigation

<h3 class="mb-4">Create User</h3>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

<EditForm Model="model" OnValidSubmit="SaveAsync">

    <DataAnnotationsValidator/>

    <ValidationSummary/>

    <div class="row g-3">

        <div class="col-md-6">
            <label>Email</label>
            <InputText class="form-control"
                       @bind-Value="model.Email"/>
        </div>

        <div class="col-md-6">
            <label>Temporary Password</label>
            <InputText class="form-control"
                       @bind-Value="model.TemporaryPassword"/>
        </div>

        <div class="col-md-6">
            <label>First Name</label>
            <InputText class="form-control"
                       @bind-Value="model.FirstName"/>
        </div>

        <div class="col-md-6">
            <label>Last Name</label>
            <InputText class="form-control"
                       @bind-Value="model.LastName"/>
        </div>

        <div class="col-md-6">
            <label>Phone</label>
            <InputText class="form-control"
                       @bind-Value="model.PhoneNumber"/>
        </div>

        <div class="col-md-6">
            <label>Job Title</label>
            <InputText class="form-control"
                       @bind-Value="model.JobTitle"/>
        </div>

    </div>

    <hr/>

    <h5>Roles</h5>

    @foreach (var role in Roles)
    {
        <div class="form-check">
            <input class="form-check-input"
                   type="checkbox"
                   checked="@model.Roles.Contains(role)"
                   @onchange="e => ToggleRole(role, e.Value)"/>

            <label class="form-check-label">@role</label>
        </div>
    }

    <hr/>

    <h5>Construction Site Access</h5>

    @foreach (var site in Sites)
    {
        <div class="form-check">
            <input class="form-check-input"
                   type="checkbox"
                   checked="@model.SiteIds.Contains(site.Id)"
                   @onchange="e => ToggleSite(site.Id, e.Value)" />

            <label class="form-check-label">
                @site.Name
            </label>
        </div>
    }

    <div class="mt-3">
        <label>Default Site</label>

        <InputSelect class="form-select"
                     @bind-Value="model.DefaultSiteId">

            <option value="">-- Select Default Site --</option>

            @foreach (var site in SelectedSites)
            {
                <option value="@site.Id">
                    @site.Name
                </option>
            }

        </InputSelect>
    </div>

    <div class="mt-4">
        <button class="btn btn-primary"
                disabled="@saving">
            Create User
        </button>

        <button type="button"
                class="btn btn-secondary ms-2"
                @onclick="Back">
            Cancel
        </button>
    </div>

</EditForm>

@code {
    private readonly CreateUserModel model = new();

    private bool saving;

    private string? errorMessage;

    private List<SiteResponse> Sites = [];

    private readonly string[] Roles =
    {
        // Official roles
        "Administrator",
        "ProjectManager",
        "SiteEngineer",
        "Storekeeper",
        "ProcurementOfficer",
        "FinanceOfficer",
        "HrOfficer",
        "EquipmentManager",
        "SafetyOfficer",

        // Legacy roles retained for compatibility
        "CompanyAdmin",
        "SiteManager",
        "Supervisor",
        "Accountant",
        "HROfficer",
        "Employee"
    };

    private IEnumerable<SiteResponse> SelectedSites =>
        Sites.Where(x => model.SiteIds.Contains(x.Id));

    protected override async Task OnInitializedAsync()
    {
        Sites = await ProjectService.GetSitesAsync();
    }

    private void ToggleRole(string role, object? value)
    {
        var isChecked = value as bool? ?? false;

        if (isChecked)
        {
            if (!model.Roles.Contains(role))
                model.Roles.Add(role);
        }
        else
        {
            model.Roles.Remove(role);
        }
    }

    private void ToggleSite(Guid siteId, object? value)
    {
        var isChecked = value as bool? ?? false;

        if (isChecked)
        {
            if (!model.SiteIds.Contains(siteId))
                model.SiteIds.Add(siteId);
        }
        else
        {
            model.SiteIds.Remove(siteId);

            if (model.DefaultSiteId == siteId)
                model.DefaultSiteId = null;
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        errorMessage = null;

        try
        {
            var companyId = await AuthService.GetCurrentCompanyIdAsync();

            if (!companyId.HasValue)
            {
                errorMessage =
                    "The current user is not assigned to a company.";
                return;
            }

            model.CompanyId = companyId.Value;

            await UserService.CreateAsync(model);
            Navigation.NavigateTo("/users");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private void Back()
    {
        Navigation.NavigateTo("/users");
    }
}