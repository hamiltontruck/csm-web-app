@page "/users/create"

@using CSM.Web.Models.Users
@using CSM.Web.Models.Sites
@using CSM.Web.Services

@inject IProjectService ProjectService
@inject IAuthService AuthService
@inject IExecutiveDashboardService DashboardService
@inject UserWebService UserService
@inject NavigationManager Navigation

<h3 class="mb-4">Create User</h3>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

<EditForm Model="model" OnValidSubmit="SaveAsync">

    <DataAnnotationsValidator/>

    <ValidationSummary/>

    @if (canSelectCompany)
    {
        <div class="mb-3">
            <label for="user-company">Company</label>
            <select id="user-company" class="form-select" value="@model.CompanyId"
                    @onchange="CompanyChanged" disabled="@(saving || initializing)">
                <option value="">-- Select Company --</option>
                @foreach (var company in companies)
                {
                    <option value="@company.Id">@company.Name</option>
                }
            </select>
        </div>
    }

    <div class="row g-3">

        <div class="col-md-6">
            <label>Email</label>
            <InputText class="form-control"
                       @bind-Value="model.Email"/>
        </div>

        <div class="col-md-6">
            <label>Temporary Password</label>
            <InputText type="password" autocomplete="new-password" class="form-control"
                       @bind-Value="model.TemporaryPassword"/>
            <small class="text-muted">At least 12 characters with uppercase, lowercase, a number, and a special character.</small>
        </div>

        <div class="col-md-6">
            <label>First Name</label>
            <InputText class="form-control"
                       @bind-Value="model.FirstName"/>
        </div>

        <div class="col-md-6">
            <label>Last Name</label>
            <InputText class="form-control"
                       @bind-Value="model.LastName"/>
        </div>

        <div class="col-md-6">
            <label>Phone</label>
            <InputText class="form-control"
                       @bind-Value="model.PhoneNumber"/>
        </div>

        <div class="col-md-6">
            <label>Job Title</label>
            <InputText class="form-control"
                       @bind-Value="model.JobTitle"/>
        </div>

    </div>

    <hr/>

    <h5>Roles</h5>

    @foreach (var role in Roles)
    {
        <div class="form-check">
            <input class="form-check-input"
                   type="checkbox"
                   checked="@model.Roles.Contains(role)"
                   @onchange="e => ToggleRole(role, e.Value)"/>

            <label class="form-check-label">@role</label>
        </div>
    }

    <hr/>

    <h5>Construction Site Access</h5>

    @foreach (var site in CompanySites)
    {
        <div class="form-check">
            <input class="form-check-input"
                   type="checkbox"
                   checked="@model.SiteIds.Contains(site.Id)"
                   @onchange="e => ToggleSite(site.Id, e.Value)" />

            <label class="form-check-label">
                @site.Name
            </label>
        </div>
    }

    <div class="mt-3">
        <label>Default Site</label>

        <InputSelect class="form-select"
                     @bind-Value="model.DefaultSiteId">

            <option value="">-- Select Default Site --</option>

            @foreach (var site in SelectedSites)
            {
                <option value="@site.Id">
                    @site.Name
                </option>
            }

        </InputSelect>
    </div>

    <div class="mt-4">
        <button class="btn btn-primary"
                disabled="@(saving || initializing)">
            Create User
        </button>

        <button type="button"
                class="btn btn-secondary ms-2"
                @onclick="Back">
            Cancel
        </button>
    </div>

</EditForm>

@code {
    private readonly CreateUserModel model = new();

    private bool saving;
    private bool initializing = true;
    private bool canSelectCompany;
    private IReadOnlyList<CSM.Web.Models.Dashboard.DashboardCompany> companies = [];

    private IEnumerable<SiteResponse> CompanySites =>
        Sites.Where(x => x.CompanyId == model.CompanyId && x.IsActive);

    private string? errorMessage;

    private List<SiteResponse> Sites = [];

    private readonly string[] Roles =
    {
        // Official roles
        "Administrator",
        "ProjectManager",
        "SiteEngineer",
        "Storekeeper",
        "ProcurementOfficer",
        "FinanceOfficer",
        "HrOfficer",
        "EquipmentManager",
        "SafetyOfficer",

        // Legacy roles retained for compatibility
        "CompanyAdmin",
        "SiteManager",
        "Supervisor",
        "Accountant",
        "HROfficer",
        "Employee"
    };

    private IEnumerable<SiteResponse> SelectedSites =>
        CompanySites.Where(x => model.SiteIds.Contains(x.Id));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            model.CompanyId = await AuthService.GetCurrentCompanyIdAsync();
            canSelectCompany = !model.CompanyId.HasValue || model.CompanyId == Guid.Empty;
            if (canSelectCompany)
            {
                companies = await DashboardService.GetCompaniesAsync();
                if (companies.Count == 1) model.CompanyId = companies[0].Id;
            }
            Sites = await ProjectService.GetSitesAsync();
        }
        catch (Exception)
        {
            errorMessage = "Unable to load user options. Refresh the page and sign in again if needed.";
        }
        finally
        {
            initializing = false;
            StateHasChanged();
        }
    }

    private void CompanyChanged(ChangeEventArgs e)
    {
        model.CompanyId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        model.SiteIds.Clear();
        model.DefaultSiteId = null;
    }

    private void ToggleRole(string role, object? value)
    {
        var isChecked = value as bool? ?? false;

        if (isChecked)
        {
            if (!model.Roles.Contains(role))
                model.Roles.Add(role);
        }
        else
        {
            model.Roles.Remove(role);
        }
    }

    private void ToggleSite(Guid siteId, object? value)
    {
        var isChecked = value as bool? ?? false;

        if (isChecked)
        {
            if (!model.SiteIds.Contains(siteId))
                model.SiteIds.Add(siteId);
        }
        else
        {
            model.SiteIds.Remove(siteId);

            if (model.DefaultSiteId == siteId)
                model.DefaultSiteId = null;
        }
    }

    private async Task SaveAsync()
    {
        if (saving || initializing) return;
        saving = true;
        errorMessage = null;

        try
        {
            if (!model.CompanyId.HasValue || model.CompanyId == Guid.Empty)
            {
                errorMessage = "Select a company before creating a user.";
                return;
            }

            await UserService.CreateAsync(model);
            Navigation.NavigateTo("/users");
        }
        catch (HttpRequestException ex)
        {
            errorMessage = ex.StatusCode.HasValue ? ex.Message : "Unable to reach the user service. Please try again.";
        }
        catch (Exception)
        {
            errorMessage = "Unable to create user. Check the user list before trying again.";
        }
        finally
        {
            saving = false;
        }
    }

    private void Back()
    {
        Navigation.NavigateTo("/users");
    }
}