@page "/login"
@rendermode InteractiveServer
@layout LoginLayout

@using CSM.Web.Models.Auth
@using CSM.Web.Services
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage

@inject IAuthService AuthService
@inject ProtectedSessionStorage SessionStorage
@inject NavigationManager Navigation
@inject ILogger<Login> Logger

<PageTitle>Sign in | CSM</PageTitle>

<main class="csm-login-shell">
    <section class="csm-login-visual" aria-label="Hamilton Construction Site Management">
        <div class="csm-login-visual-glow" aria-hidden="true"></div>
        <header class="csm-login-brand-row">
            <div class="csm-brand">
                <span class="csm-brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="csm-brand-name">HAMILTON<span>BUSINESS GROUP</span></span>
            </div>
            <span class="csm-secure-label"><i aria-hidden="true"></i> SECURE WORKSPACE</span>
        </header>

        <div class="csm-login-story">
            <p class="csm-eyebrow"><span></span> CONSTRUCTION SITE MANAGEMENT</p>
            <h1>Every site.<br /><em>One clear plan.</em></h1>
            <p class="csm-story-copy">
                Keep project progress, teams, equipment, and costs moving in the same direction.
            </p>
            <div class="csm-project-card" aria-hidden="true">
                <div class="csm-project-card-label">BUILT FOR THE FIELD</div>
                <svg class="csm-project-art" viewBox="0 0 560 230" role="presentation">
                    <defs>
                        <linearGradient id="csm-sky" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0" stop-color="#d6e6ce"></stop>
                            <stop offset="1" stop-color="#829b7b"></stop>
                        </linearGradient>
                        <linearGradient id="csm-building" x1="0" y1="0" x2="1" y2="0">
                            <stop offset="0" stop-color="#899780"></stop>
                            <stop offset=".5" stop-color="#d5d5bb"></stop>
                            <stop offset="1" stop-color="#9aa48d"></stop>
                        </linearGradient>
                    </defs>
                    <rect width="560" height="230" fill="url(#csm-sky)"></rect>
                    <circle cx="448" cy="48" r="24" fill="#f1f0c7" opacity=".78"></circle>
                    <g stroke="#edf3e6" stroke-opacity=".27" stroke-width="1">
                        <path d="M0 48h560M0 96h560M0 144h560M0 192h560"></path>
                        <path d="M70 0v230M140 0v230M210 0v230M280 0v230M350 0v230M420 0v230M490 0v230"></path>
                    </g>
                    <path d="M0 176 98 155l86 14 111-25 98 20 85-24 82 17v73H0z" fill="#50684e" opacity=".72"></path>
                    <path d="M117 93 293 79v120H117z" fill="url(#csm-building)"></path>
                    <path d="m293 79 108 24v96H293z" fill="#9aa58e"></path>
                    <path d="M136 108h139M136 132h139M136 156h139M136 180h139" stroke="#788574" stroke-width="5" opacity=".7"></path>
                    <path d="M310 105h70M310 128h70M310 151h70M310 174h70" stroke="#788574" stroke-width="5" opacity=".65"></path>
                    <path d="M84 20v182m0-174 280 0m-34 0v72m-246-72 24 20m-12-20 21 18" fill="none" stroke="#263e32" stroke-width="3"></path>
                    <path d="M357 20h20v54" fill="none" stroke="#263e32" stroke-width="2"></path>
                    <circle cx="84" cy="20" r="5" fill="#d4e2c1"></circle>
                    <path d="M0 202h560" stroke="#243a2d" stroke-width="3"></path>
                    <path d="M0 209h560" stroke="#d2d8bb" stroke-opacity=".34" stroke-width="1"></path>
                </svg>
                <div class="csm-project-card-footer">
                    <span>Projects <i></i> People <i></i> Resources</span>
                    <span class="csm-project-arrow" aria-hidden="true">↗</span>
                </div>
            </div>
        </div>

        <footer class="csm-visual-footer">
            <span>PLAN CLEARLY. BUILD BETTER.</span>
            <span>© 2026 HAMILTON BUSINESS GROUP</span>
        </footer>
    </section>

    <section class="csm-login-panel" aria-labelledby="csm-login-title">
        <header class="csm-login-panel-head">
            <span class="csm-panel-label">TEAM ACCESS</span>
            <span class="csm-help-text">Need help? Contact your administrator.</span>
        </header>

        <div class="csm-login-form-wrap">
            <div class="csm-login-heading">
                <span class="csm-login-icon" aria-hidden="true">H</span>
                <p class="csm-form-eyebrow">YOUR WORKSPACE, READY</p>
                <h2 id="csm-login-title">Welcome back</h2>
                <p>Sign in to continue to your workspace.</p>
            </div>

            <EditForm Model="_model" OnValidSubmit="LoginAsync" class="csm-login-form">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="csm-form-field">
                    <label for="csm-email">Work email</label>
                    <div class="csm-input-frame">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="3.5" y="5.5" width="17" height="13" rx="2"></rect>
                            <path d="m4.5 7 7.5 5.5L19.5 7"></path>
                        </svg>
                        <InputText id="csm-email" class="csm-input" type="email"
                                   autocomplete="username" placeholder="you@company.com"
                                   required @bind-Value="_model.Email" />
                    </div>
                </div>

                <div class="csm-form-field">
                    <label for="csm-password">Password</label>
                    <div class="csm-input-frame">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="4.5" y="10" width="15" height="10" rx="2"></rect>
                            <path d="M8 10V7.5a4 4 0 0 1 8 0V10"></path>
                            <path d="M12 14v2.5"></path>
                        </svg>
                        <InputText id="csm-password" class="csm-input"
                                   type="@(_showPassword ? "text" : "password")"
                                   autocomplete="current-password"
                                   placeholder="Enter your password" required
                                   @bind-Value="_model.Password" />
                        <button type="button" class="csm-show-password"
                                @onclick="TogglePassword"
                                aria-label="@(_showPassword ? "Hide password" : "Show password")">
                            @(_showPassword ? "Hide" : "Show")
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="csm-login-error" role="alert">@_error</div>
                }

                <button class="csm-submit-button" type="submit" disabled="@_loading">
                    <span>@(_loading ? "Signing in..." : "Sign in")</span>
                    @if (!_loading)
                    {
                        <span class="csm-submit-arrow" aria-hidden="true">→</span>
                    }
                    else
                    {
                        <span class="csm-submit-spinner" aria-hidden="true"></span>
                    }
                </button>

                <p class="csm-security-note"><span aria-hidden="true">▣</span> Secure access for your project team.</p>
            </EditForm>
        </div>

        <footer class="csm-login-panel-footer">
            <span>HAMILTON BUSINESS GROUP</span>
            <span>CONSTRUCTION SITE MANAGEMENT</span>
        </footer>
    </section>
</main>

@code {
    private readonly LoginRequest _model = new();

    private bool _loading;
    private bool _showPassword;
    private string? _error;

    private void TogglePassword() => _showPassword = !_showPassword;

    private async Task LoginAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var result = await AuthService.LoginAsync(_model);

            if (result is null)
            {
                _error = "Invalid email or password.";
                return;
            }

            await SessionStorage.SetAsync("jwt", result.AccessToken);
            await SessionStorage.SetAsync("refreshToken", result.RefreshToken);
            await SessionStorage.SetAsync("userName", result.FullName);
            await SessionStorage.SetAsync("email", result.Email);
            await SessionStorage.SetAsync("roles", result.Roles);

            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers
                .ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
            // Accept only supported local equipment recovery routes.
            var destination = "/dashboard";
            if (query.TryGetValue("returnUrl", out var returnUrl))
            {
                var requested = returnUrl.ToString();
                const string hourCreatePrefix = "/equipment/hourmeter/create/";
                const string hourSitePrefix = "/equipment/hourmeter/site/";
                const string assignmentPrefix = "/equipment/assignments/create/";
                const string downtimePrefix = "/equipment/downtime/create/";
                const string fuelCreatePrefix = "/equipment/fuel/create/";
                const string fuelEditPrefix = "/equipment/fuel/edit/";
                const string fuelSitePrefix = "/equipment/fuel/site/";
                const string maintenancePrefix = "/equipment/maintenance/create/";
                if (requested is "/equipment/create" or "/hr" or "/hr/employees" or "/hr/employees/company" or "/hr/employees/site" or "/hr/employees/create" or "/hr/attendance" or "/hr/attendance/check-in" or "/hr/site-assignments" or "/hr/site-assignments/create" or "/hr/shifts" or "/hr/shifts/create" or "/hr/leave" or "/hr/leave/create")
                    destination = requested;
                else if (requested.StartsWith("/hr/shifts/edit/", StringComparison.Ordinal) &&
                    Guid.TryParse(requested["/hr/shifts/edit/".Length..], out var shiftId))
                    destination = $"/hr/shifts/edit/{shiftId:D}";
                else if (requested.StartsWith("/hr/site-assignments/edit/", StringComparison.Ordinal) &&
                    Guid.TryParse(requested["/hr/site-assignments/edit/".Length..], out var hrAssignmentId))
                    destination = $"/hr/site-assignments/edit/{hrAssignmentId:D}";
                else if (requested.StartsWith("/hr/attendance/", StringComparison.Ordinal))
                {
                    var parts = requested["/hr/attendance/".Length..].Split('/');
                    if (parts.Length == 2 && parts[0] is "check-out" or "override" &&
                        Guid.TryParse(parts[1], out var attendanceId))
                        destination = $"/hr/attendance/{parts[0]}/{attendanceId:D}";
                }
                else if (requested.StartsWith("/hr/employees/site/", StringComparison.Ordinal) &&
                    Guid.TryParse(requested["/hr/employees/site/".Length..], out var employeeSiteId))
                    destination = $"/hr/employees/site/{employeeSiteId:D}";
                else if (requested.StartsWith("/equipment/timesheet/", StringComparison.Ordinal))
                {
                    var parts = requested["/equipment/timesheet/".Length..].Split('/');
                    if (parts.Length == 2 && parts[0] is "create" or "site" or "report" or "edit" &&
                        Guid.TryParse(parts[1], out var timesheetRouteId))
                        destination = $"/equipment/timesheet/{parts[0]}/{timesheetRouteId:D}";
                }
                else if (requested.StartsWith(hourCreatePrefix, StringComparison.Ordinal) &&
                    Guid.TryParse(requested[hourCreatePrefix.Length..], out var hourCreateSiteId))
                    destination = hourCreatePrefix + hourCreateSiteId.ToString("D");
                else if (requested.StartsWith(hourSitePrefix, StringComparison.Ordinal) &&
                    Guid.TryParse(requested[hourSitePrefix.Length..], out var hourSiteId))
                    destination = hourSitePrefix + hourSiteId.ToString("D");
                else if (requested.StartsWith(assignmentPrefix, StringComparison.Ordinal) &&
                    Guid.TryParse(requested[assignmentPrefix.Length..], out var siteId))
                    destination = assignmentPrefix + siteId.ToString("D");
                else if (requested.StartsWith(downtimePrefix, StringComparison.Ordinal) &&
                    Guid.TryParse(requested[downtimePrefix.Length..], out var downtimeSiteId))
                    destination = downtimePrefix + downtimeSiteId.ToString("D");
                else if (requested.StartsWith(maintenancePrefix, StringComparison.Ordinal) &&
                    Guid.TryParse(requested[maintenancePrefix.Length..], out var maintenanceSiteId))
                    destination = maintenancePrefix + maintenanceSiteId.ToString("D");
                else if (requested.StartsWith(fuelCreatePrefix, StringComparison.Ordinal) &&
                    Guid.TryParse(requested[fuelCreatePrefix.Length..], out var fuelCreateSiteId))
                    destination = fuelCreatePrefix + fuelCreateSiteId.ToString("D");
                else if (requested.StartsWith(fuelSitePrefix, StringComparison.Ordinal) &&
                    Guid.TryParse(requested[fuelSitePrefix.Length..], out var fuelSiteId))
                    destination = fuelSitePrefix + fuelSiteId.ToString("D");
                else if (requested.StartsWith(fuelEditPrefix, StringComparison.Ordinal))
                {
                    var parts = requested[fuelEditPrefix.Length..].Split('/');
                    if (parts.Length == 2 && Guid.TryParse(parts[0], out var editSiteId) && Guid.TryParse(parts[1], out var fuelLogId))
                        destination = $"{fuelEditPrefix}{editSiteId:D}/{fuelLogId:D}";
                }
            }
            Navigation.NavigateTo(destination, true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Login failed");
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
