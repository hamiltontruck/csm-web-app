@page "/sites-management"
@rendermode InteractiveServer

@using CSM.Web.Models.Sites
@using CSM.Web.Services

@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>Construction Sites</PageTitle>

@if (_loading)
{
    <div class="container py-4">
        <h4>Loading construction sites...</h4>
    </div>
}
else
{
    <div class="container-fluid py-4">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-0">Construction Sites</h2>
                <small class="text-muted">
                    Manage all company construction sites
                </small>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary"
                        @onclick="Back">
                    <span class="bi bi-arrow-left me-1"></span>
                    Back
                </button>

                <WorkspaceAction Route="/sites/create">
                    <button class="btn btn-primary"
                        @onclick="NewSite">
                    <span class="bi bi-plus-lg me-1"></span>
                    New Site
                </button>
            </WorkspaceAction>
            </div>
        </div>

        <!-- Statistics -->
        <div class="row g-3 mb-4">

            <div class="col-md-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div class="text-muted">Total Sites</div>
                        <h2>@_sites.Count</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div class="text-muted">Active</div>
                        <h2>@_sites.Count(x => x.Status == "Active")</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div class="text-muted">Planning</div>
                        <h2>@_sites.Count(x => x.Status == "Planning")</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div class="text-muted">Completed</div>
                        <h2>@_sites.Count(x => x.Status == "Completed")</h2>
                    </div>
                </div>
            </div>

        </div>

        <!-- Search + Filter -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3">

                    <div class="col-md-5">
                        <input class="form-control"
                               placeholder="Search by site name or code..."
                               @bind="_search"/>
                    </div>

                    <div class="col-md-3">
                        <select class="form-select"
                                @bind="_statusFilter">
                            <option value="">All Status</option>
                            <option>Planning</option>
                            <option>Active</option>
                            <option>Completed</option>
                        </select>
                    </div>

                </div>
            </div>
        </div>

       <!-- Company Finance -->
       <div class="card border-0 shadow-sm mb-4">
           <div class="card-body">

               <div class="d-flex align-items-center mb-3">
                   <i class="bi bi-building fs-3 text-primary me-3"></i>

                   <div>
                       <h3 class="mb-0">Company Finance</h3>
                       <div class="text-muted">
                           Company-wide financial records
                       </div>
                   </div>
               </div>

               <div class="row g-3">

                   <div class="col-md-3">
                       <WorkspaceAction Route="/finance/company/cost-codes">
                           <button class="btn btn-outline-primary w-100 py-3"
                               @onclick="OpenCompanyCostCodes">
                           <i class="bi bi-diagram-3 d-block fs-3 mb-2"></i>
                           Cost Codes
                       </button>
            </WorkspaceAction>
                   </div>

                   <div class="col-md-3">
                       <WorkspaceAction Route="/finance/company/vendors">
                           <button class="btn btn-outline-primary w-100 py-3"
                               @onclick="OpenCompanyVendors">
                           <i class="bi bi-people d-block fs-3 mb-2"></i>
                           Vendors
                       </button>
            </WorkspaceAction>
                   </div>

                   <div class="col-md-3">
                       <WorkspaceAction Route="/finance/company/invoices">
                           <button class="btn btn-outline-primary w-100 py-3"
                               @onclick="OpenCompanyInvoices">
                           <i class="bi bi-receipt d-block fs-3 mb-2"></i>
                           Invoices
                       </button>
            </WorkspaceAction>
                   </div>

                   <div class="col-md-3">
                       <WorkspaceAction Route="/finance/company/payments">
                           <button class="btn btn-outline-primary w-100 py-3"
                               @onclick="OpenCompanyPayments">
                           <i class="bi bi-wallet2 d-block fs-3 mb-2"></i>
                           Payments
                       </button>
            </WorkspaceAction>
                   </div>

               </div>
           </div>
       </div>

        <!-- Site Cards -->
        <div class="row g-4">

            @foreach (var site in FilteredSites)
            {
                <div class="col-lg-4 col-md-6">

                    <div class="card shadow-sm h-100 border-0">

                        <div class="card-body">

                            <div class="d-flex justify-content-between">

                                <div>
                                    <h4 class="mb-1">@site.Name</h4>
                                    <div class="text-muted">@site.SiteCode</div>
                                </div>

                                <div class="site-status">

                                    @if (site.Status == "Active")
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else if (site.Status == "Planning")
                                    {
                                        <span class="badge bg-dark">Planning</span>
                                    }
                                    else if (site.Status == "OnHold")
                                    {
                                        <span class="badge bg-warning text-dark">On Hold</span>
                                    }
                                    else if (site.Status == "Completed")
                                    {
                                        <span class="badge bg-primary">Completed</span>
                                    }
                                    else if (site.Status == "Closed")
                                    {
                                        <span class="badge bg-secondary">Closed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark">@site.Status</span>
                                    }

                                </div>

                            </div>

                            <hr/>

                            <div><strong>City:</strong> @site.City</div>
                            <div><strong>Region:</strong> @site.Region</div>
                            <div><strong>Country:</strong> @site.Country</div>

                            <div class="mt-3">
                                <strong>Start:</strong>
                                @(site.PlannedStartDate?.ToString("dd MMM yyyy") ?? "-")
                            </div>

                        </div>

                        <div class="card-footer bg-white border-0">

                            <div class="d-flex gap-2">

                                <WorkspaceAction Route="/sites/{id}">
                                    <button class="btn btn-sm btn-primary flex-fill"
                                        @onclick="() => ViewSite(site.Id)">
                                    View
                                </button>
            </WorkspaceAction>

                                <WorkspaceAction Route="/sites/edit/{site.Id}">
                                    <button class="btn btn-outline-secondary w-100"
                                        @onclick='() => Navigation.NavigateTo($"/sites/edit/{site.Id}")'>
                                    Edit
                                </button>
            </WorkspaceAction>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>
}

@code {
    private List<SiteResponse> _sites = [];
    private bool _loading = true;
    private bool _loaded;

    private string _search = "";
    private string _statusFilter = "";

    private IEnumerable<SiteResponse> FilteredSites =>
        _sites.Where(site =>
            (string.IsNullOrWhiteSpace(_search) ||
             site.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             site.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
            &&
            (string.IsNullOrWhiteSpace(_statusFilter) ||
             site.Status == _statusFilter));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
            return;

        _loaded = true;

        _sites = await ProjectService.GetSitesAsync();

        _loading = false;

        StateHasChanged();
    }

    void OpenSite(Guid siteId)
    {
        Navigation.NavigateTo($"/sites/{siteId}");
    }

    static string Badge(string status) => status switch
    {
        "Active" => "badge bg-success",
        "Completed" => "badge bg-primary",
        "Planned" => "badge bg-secondary",
        "OnHold" => "badge bg-warning text-dark",
        _ => "badge bg-dark"
    };

    private void Back()
    {
        Navigation.NavigateTo("/");
    }

    private void NewSite()
    {
        Navigation.NavigateTo("/sites/create");
    }

    private void ViewSite(Guid id)
    {
        Navigation.NavigateTo($"/sites/{id}");
    }

    private void EditSite(Guid id)
    {
        Navigation.NavigateTo($"/sites/edit/{id}");
    }

    private string StatusBadge(string status)
    {
        return status switch
        {
            "Planning" => "badge bg-dark",
            "Active" => "badge bg-success",
            "OnHold" => "badge bg-warning text-dark",
            "Completed" => "badge bg-primary",
            "Closed" => "badge bg-secondary",
            _ => "badge bg-light text-dark"
        };
    }

    private void OpenCompanyCostCodes()
    {
        Navigation.NavigateTo("/finance/company/cost-codes");
    }

    private void OpenCompanyVendors()
    {
        Navigation.NavigateTo("/finance/company/vendors");
    }

    private void OpenCompanyInvoices()
    {
        Navigation.NavigateTo("/finance/company/invoices");
    }

    private void OpenCompanyPayments()
    {
        Navigation.NavigateTo("/finance/company/payments");
    }
}