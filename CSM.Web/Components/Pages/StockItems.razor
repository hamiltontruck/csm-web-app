@inherits WorkspacePageBase
@page "/stock-items"
@page "/inventory"
@rendermode InteractiveServer

@inject NavigationManager Navigation

<button class="btn btn-outline-secondary mb-3"
        @onclick="GoBack">
    <i class="bi bi-arrow-left"></i> Back
</button>

<PageTitle>Inventory</PageTitle>
<WorkspaceAccessFeedback Loaded="AccessLoaded" Error="AccessError" />

<div class="container py-4">

    <h2 class="mb-1">Inventory</h2>

    <p class="text-muted mb-4">
        Manage stock movements, issues, returns, transfers, and adjustments.
    </p>

    <div class="row g-4">

        @if (Access.CanVisit("/stock-balance"))
        {
<div class="col-lg-6">
            <div class="card shadow-sm h-100 inventory-card" @onclick='() => Go("/stock-balance")'>
                <div class="card-body d-flex align-items-center">
                    <div class="icon-box bg-primary-subtle text-primary">
                        <i class="bi bi-box-seam fs-3"></i>
                    </div>

                    <div class="ms-3 flex-grow-1">
                        <h4 class="mb-1">Stock Balance</h4>
                        <div class="text-muted">
                            View current stock balance by site and material.
                        </div>
                    </div>

                    <i class="bi bi-chevron-right fs-4"></i>
                </div>
            </div>
        </div>
        }

        @if (Access.CanVisit("/stock-movements"))
        {
<div class="col-lg-6">
            <div class="card shadow-sm h-100 inventory-card" @onclick='() => Go("/stock-movements")'>
                <div class="card-body d-flex align-items-center">
                    <div class="icon-box bg-success-subtle text-success">
                        <i class="bi bi-arrow-left-right fs-3"></i>
                    </div>

                    <div class="ms-3 flex-grow-1">
                        <h4 class="mb-1">Stock Movements</h4>
                        <div class="text-muted">
                            Review stock movement history and transactions.
                        </div>
                    </div>

                    <i class="bi bi-chevron-right fs-4"></i>
                </div>
            </div>
        </div>
        }

        @if (Access.CanVisit("/stock-issues"))
        {
<div class="col-lg-6">
            <div class="card shadow-sm h-100 inventory-card" @onclick='() => Go("/stock-issues")'>
                <div class="card-body d-flex align-items-center">
                    <div class="icon-box bg-warning-subtle text-warning">
                        <i class="bi bi-box-arrow-up fs-3"></i>
                    </div>

                    <div class="ms-3 flex-grow-1">
                        <h4 class="mb-1">Stock Issues</h4>
                        <div class="text-muted">
                            Issue materials to construction sites or projects.
                        </div>
                    </div>

                    <i class="bi bi-chevron-right fs-4"></i>
                </div>
            </div>
        </div>
        }

        @if (Access.CanVisit("/daily-material-usage"))
        {
<div class="col-lg-6">
            <div class="card shadow-sm h-100 inventory-card" @onclick='() => Go("/daily-material-usage")'>
                <div class="card-body d-flex align-items-center">
                    <div class="icon-box bg-info-subtle text-info">
                        <i class="bi bi-clipboard-check fs-3"></i>
                    </div>

                    <div class="ms-3 flex-grow-1">
                        <h4 class="mb-1">Daily Material Usage</h4>
                        <div class="text-muted">
                            Record daily material usage and variance.
                        </div>
                    </div>

                    <i class="bi bi-chevron-right fs-4"></i>
                </div>
            </div>
        </div>
        }

        @if (Access.CanVisit("/material-return-audit"))
        {
<div class="col-lg-6">
            <div class="card shadow-sm h-100 inventory-card" @onclick='() => Go("/material-return-audit")'>
                <div class="card-body d-flex align-items-center">
                    <div class="icon-box bg-secondary-subtle text-secondary">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>

                    <div class="ms-3 flex-grow-1">
                        <h4 class="mb-1">Material Return Audit</h4>
                        <div class="text-muted">
                            Review returned materials and audit history.
                        </div>
                    </div>

                    <i class="bi bi-chevron-right fs-4"></i>
                </div>
            </div>
        </div>
        }

        @if (Access.CanVisit("/stock-returns"))
        {
<div class="col-lg-6">
            <div class="card shadow-sm h-100 inventory-card" @onclick='() => Go("/stock-returns")'>
                <div class="card-body d-flex align-items-center">
                    <div class="icon-box bg-primary-subtle text-primary">
                        <i class="bi bi-arrow-return-left fs-3"></i>
                    </div>

                    <div class="ms-3 flex-grow-1">
                        <h4 class="mb-1">Stock Returns</h4>
                        <div class="text-muted">
                            Record materials returned back into stock.
                        </div>
                    </div>

                    <i class="bi bi-chevron-right fs-4"></i>
                </div>
            </div>
        </div>
        }

        @if (Access.CanVisit("/stock-transfers"))
        {
<div class="col-lg-6">
            <div class="card shadow-sm h-100 inventory-card" @onclick='() => Go("/stock-transfers")'>
                <div class="card-body d-flex align-items-center">
                    <div class="icon-box bg-success-subtle text-success">
                        <i class="bi bi-arrow-left-right fs-3"></i>
                    </div>

                    <div class="ms-3 flex-grow-1">
                        <h4 class="mb-1">Stock Transfers</h4>
                        <div class="text-muted">
                            Transfer materials between sites or stock locations.
                        </div>
                    </div>

                    <i class="bi bi-chevron-right fs-4"></i>
                </div>
            </div>
        </div>
        }

        @if (Access.CanVisit("/stock-adjustments"))
        {
<div class="col-lg-6">
            <div class="card shadow-sm h-100 inventory-card" @onclick='() => Go("/stock-adjustments")'>
                <div class="card-body d-flex align-items-center">
                    <div class="icon-box bg-danger-subtle text-danger">
                        <i class="bi bi-sliders fs-3"></i>
                    </div>

                    <div class="ms-3 flex-grow-1">
                        <h4 class="mb-1">Stock Adjustments</h4>
                        <div class="text-muted">
                            Correct stock quantities and adjustment reasons.
                        </div>
                    </div>

                    <i class="bi bi-chevron-right fs-4"></i>
                </div>
            </div>
        </div>
        }

    </div>

</div>

@code{
    void Go(string url) => Navigation.NavigateTo(url);

    void GoBack()
        => Navigation.NavigateTo("/procurement");
}