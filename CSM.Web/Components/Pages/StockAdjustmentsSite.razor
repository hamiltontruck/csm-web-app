@page "/stock-adjustments/site/{SiteId:guid}"
@rendermode InteractiveServer

@using CSM.Web.Models.Procurement
@using CSM.Web.Models.Sites
@using CSM.Web.Services

@inject IAuthService AuthService
@inject IInventoryService InventoryService
@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>Site Stock Adjustments</PageTitle>

<div class="container py-4">

    <button class="btn btn-outline-secondary mb-3"
            @onclick="GoBack">
        <i class="bi bi-arrow-left"></i> Back
    </button>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>@siteName</h2>
            <div class="text-muted">Stock Adjustments</div>
        </div>

        @if (!loading && string.IsNullOrWhiteSpace(errorMessage) && canCreate)
        {
            <button class="btn btn-primary" @onclick="NewAdjustment">New Adjustment</button>
        }
    </div>

    @if (loading)
    {
        <p>Loading adjustments...</p>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
        @if (signInRequired)
        {
            <a id="stock-adjustments-sign-in" class="btn btn-primary" href="/login">Sign in</a>
        }
        else if (canRetry)
        {
            <button id="retry-stock-adjustments" class="btn btn-primary" @onclick="LoadAsync">Retry</button>
        }
    }
    else if (adjustments.Count == 0)
    {
        <div class="alert alert-info">
            No stock adjustments recorded for this site.
        </div>
    }
    else
    {
        @foreach (var item in adjustments)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-body">

                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="fw-bold">
                                @item.MaterialCode - @item.MaterialName
                            </div>

                            <small class="text-muted">
                                @item.AdjustmentDateUtc.ToString("dd MMM yyyy")
                            </small>
                        </div>

                        <div class="text-end">
                            <div class="fw-bold">
                                @item.Quantity @item.UnitOfMeasure
                            </div>

                            <span class="badge bg-secondary">
                                @item.Reason
                            </span>
                        </div>
                    </div>

                    <hr />

                    <div class="row text-center">
                        <div class="col">
                            <small class="text-muted">Before</small>
                            <div class="fw-bold">@item.QuantityBefore</div>
                        </div>

                        <div class="col">
                            <small class="text-muted">After</small>
                            <div class="fw-bold">@item.QuantityAfter</div>
                        </div>
                    </div>

                </div>
            </div>
        }
    }

</div>

@code{
    [Parameter]
    public Guid SiteId { get; set; }

    private List<StockAdjustmentResponse> adjustments = [];
    private string siteName = "";
    private bool loading = true;
    private bool loaded;

    private string? errorMessage;
    private bool canRetry = true;
    private bool signInRequired;
    private bool canCreate;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded) return;
        loaded = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        errorMessage = null;
        adjustments = [];
        siteName = "";
        canRetry = true;
        signInRequired = false;
        canCreate = false;
        try
        {
            var permissions = await AuthService.GetPermissionsAsync();
            canCreate = permissions.Contains("Procurement_Inventory_Adjust");
            var all = await InventoryService.GetStockAdjustmentsAsync();
            adjustments = all.Where(x => x.ConstructionSiteId == SiteId)
                .OrderByDescending(x => x.AdjustmentDateUtc).ToList();
            var sites = await ProjectService.GetSitesAsync();
            siteName = sites.FirstOrDefault(x => x.Id == SiteId)?.Name ?? "Construction Site";
        }
        catch (HttpRequestException ex)
        {
            signInRequired = ex.StatusCode == System.Net.HttpStatusCode.Unauthorized;
            canRetry = ex.StatusCode is not (System.Net.HttpStatusCode.Unauthorized
                or System.Net.HttpStatusCode.Forbidden);
            errorMessage = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Your session is missing or has expired. Please sign in again.",
                System.Net.HttpStatusCode.Forbidden => "You do not have permission to view stock adjustments.",
                _ => "Unable to load stock adjustments. Please try again."
            };
        }
        catch (Exception)
        {
            errorMessage = "Unable to load stock adjustments. Please try again.";
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    void GoBack()
        => Navigation.NavigateTo("/stock-adjustments");

    void NewAdjustment()
    {
        if (!loading && string.IsNullOrWhiteSpace(errorMessage) && canCreate)
            Navigation.NavigateTo($"/stock-adjustments/create/{SiteId}");
    }
}