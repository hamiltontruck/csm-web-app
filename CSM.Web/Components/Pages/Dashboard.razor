@page "/dashboard"
@rendermode InteractiveServer

@using CSM.Web.Models.Dashboard
@using CSM.Web.Services

@inject IExecutiveDashboardService DashboardService
@inject ProtectedSessionStorage SessionStorage
@inject NavigationManager Navigation
@inject ILogger<Dashboard> Logger

<PageTitle>Executive Dashboard | HBG CSM</PageTitle>

<div class="dashboard-shell">
@if (_canSelectCompany)
{
    <div class="dashboard-company">
        <label for="dashboard-company" class="dashboard-company-label">Workspace</label>
        <select id="dashboard-company" class="form-select" value="@_selectedCompanyId"
                @onchange="SelectCompanyAsync" disabled="@_loading">
            <option value="">Select a company</option>
            @foreach (var company in _companies)
            {
                <option value="@company.Id">@company.Name</option>
            }
        </select>
    </div>
}

@if (_loading)
{
    <section class="dashboard-loading" aria-live="polite">
        <div class="dashboard-skeleton dashboard-skeleton-title"></div>
        <div class="dashboard-skeleton-grid">
            @for (var i = 0; i < 4; i++) { <div class="dashboard-skeleton dashboard-skeleton-card"></div> }
        </div>
        <p>Preparing your project overview…</p>
    </section>
}
else if (_dashboard is null)
{
    <section class="dashboard-empty" role="alert">
        <div class="dashboard-empty-icon">!</div>
        <p class="dashboard-eyebrow">Dashboard unavailable</p>
        <h1>We couldn’t load your workspace</h1>
        <p class="dashboard-empty-copy">@_errorMessage</p>
        <div class="dashboard-actions">
            <button class="dashboard-button dashboard-button-primary" @onclick="RetryAsync">Try again</button>
            <a class="dashboard-button dashboard-button-secondary" href="/login">Sign in</a>
        </div>
    </section>
}
else
{
    <main class="executive-dashboard">
        <header class="dashboard-header">
            <div>
                <p class="dashboard-eyebrow"><span class="status-dot"></span> OPERATIONS OVERVIEW</p>
                <h1>Good to see you, @_userName</h1>
                <p class="dashboard-subtitle">Here’s the latest across your construction portfolio.</p>
            </div>
            <div class="dashboard-header-meta">
                <span class="dashboard-date">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</span>
                <span class="dashboard-live"><span class="status-dot"></span> Live workspace</span>
            </div>
        </header>

        <section class="metric-grid" aria-label="Portfolio metrics">
            <article class="metric-card metric-card-primary">
                <div class="metric-top"><span class="metric-icon">▦</span><span class="metric-kicker">IN PROGRESS</span></div>
                <div class="metric-value">@_dashboard.ActiveProjects</div>
                <div class="metric-label">Active projects</div>
                <div class="metric-foot"><span class="metric-mini-bar"><i style="width:72%"></i></span><span>Across your portfolio</span></div>
            </article>
            <article class="metric-card">
                <div class="metric-top"><span class="metric-icon metric-icon-green">✓</span><span class="metric-kicker">DELIVERED</span></div>
                <div class="metric-value">@_dashboard.CompletedProjects</div>
                <div class="metric-label">Completed projects</div>
                <div class="metric-foot"><span class="metric-positive">●</span><span>Successfully handed over</span></div>
            </article>
            <article class="metric-card">
                <div class="metric-top"><span class="metric-icon metric-icon-blue">♙</span><span class="metric-kicker">YOUR PEOPLE</span></div>
                <div class="metric-value">@_dashboard.TotalEmployees</div>
                <div class="metric-label">Team members</div>
                <div class="metric-foot"><span class="metric-foot-avatars"><b>H</b><b>B</b><b>G</b></span><span>Across all active sites</span></div>
            </article>
            <article class="metric-card metric-card-alert">
                <div class="metric-top"><span class="metric-icon metric-icon-amber">↗</span><span class="metric-kicker">NEEDS ATTENTION</span></div>
                <div class="metric-value">@_dashboard.OpenDelays</div>
                <div class="metric-label">Open project delays</div>
                <div class="metric-foot"><span class="metric-attention">Review required</span></div>
            </article>
        </section>

        <section class="dashboard-content-grid">
            <article class="dashboard-panel budget-panel">
                <div class="panel-heading">
                    <div><p class="panel-overline">FINANCIAL HEALTH</p><h2>Budget overview</h2></div>
                    <span class="panel-chip">Portfolio</span>
                </div>
                <div class="budget-total">
                    <div><span class="budget-caption">Total approved budget</span><strong>@Money(_dashboard.TotalBudget)</strong></div>
                    <div class="budget-spend"><span class="budget-caption">Expenses to date</span><strong>@Money(_dashboard.TotalExpenses)</strong></div>
                </div>
                <div class="budget-progress-label"><span>Budget utilization</span><strong>@_dashboard.BudgetUtilization.ToString("0.0")%</strong></div>
                <div class="budget-progress" role="progressbar" aria-label="Budget utilization" aria-valuenow="@_dashboard.BudgetUtilization" aria-valuemin="0" aria-valuemax="100">
                    <span style="width:@($"{Math.Clamp(_dashboard.BudgetUtilization, 0, 100)}%")"></span>
                </div>
                <div class="budget-foot"><span>Remaining budget</span><strong>@Money(_dashboard.TotalBudget - _dashboard.TotalExpenses)</strong></div>
                <div class="budget-note">
                    <span class="budget-note-mark">↗</span>
                    <span>Actual spend is <strong>@Money(_dashboard.TotalExpenses)</strong> of <strong>@Money(_dashboard.TotalBudget)</strong> approved.</span>
                </div>
            </article>

            <article class="dashboard-panel operations-panel">
                <div class="panel-heading">
                    <div><p class="panel-overline">SITE OPERATIONS</p><h2>Daily pulse</h2></div>
                    <span class="pulse-indicator"><i></i> Today</span>
                </div>
                <div class="operation-row">
                    <span class="operation-symbol operation-symbol-red">!</span>
                    <div class="operation-copy"><strong>Safety incidents</strong><span>Open items requiring follow-up</span></div>
                    <span class="operation-count operation-count-red">@_dashboard.OpenSafetyIncidents</span>
                </div>
                <div class="operation-row">
                    <span class="operation-symbol operation-symbol-amber">⌁</span>
                    <div class="operation-copy"><strong>Low stock items</strong><span>Materials below reorder level</span></div>
                    <span class="operation-count operation-count-amber">@_dashboard.LowStockItems</span>
                </div>
                <div class="operations-note">
                    <span class="operations-note-icon">✦</span>
                    <div><strong>Keep your sites moving</strong><p>Review open items with your site leads to keep work on schedule.</p></div>
                </div>
                <div class="data-updated"><span class="status-dot"></span> Updated @_dashboard.GeneratedAtUtc.ToLocalTime().ToString("dd MMM, HH:mm")</div>
            </article>
        </section>
        <footer class="dashboard-footer"><span>Hamilton Business Group <span class="footer-separator">/</span> Construction Site Management</span><span>CSM • Executive view</span></footer>
    </main>
}
</div>

@code {
    private ExecutiveDashboard? _dashboard;
    private bool _loading = true;
    private bool _initialized;
    private bool _canSelectCompany;
    private Guid? _selectedCompanyId;
    private IReadOnlyList<DashboardCompany> _companies = [];
    private string _userName = "";
    private string _errorMessage = "Unable to load dashboard data.";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        _loading = true;
        _dashboard = null;
        try
        {
            var token = await SessionStorage.GetAsync<string>("jwt");
            if (!token.Success || string.IsNullOrWhiteSpace(token.Value))
            {
                Navigation.NavigateTo("/login", true);
                return;
            }

            var name = await SessionStorage.GetAsync<string>("userName");
            _userName = name.Success ? name.Value ?? "" : "";
            if (!_initialized)
            {
                var roles = await SessionStorage.GetAsync<List<string>>("roles");
                _canSelectCompany = roles.Success && roles.Value?.Contains("SuperAdmin") == true;
                if (_canSelectCompany) _companies = await DashboardService.GetCompaniesAsync();
                _initialized = true;
            }

            if (_canSelectCompany && !_selectedCompanyId.HasValue)
            {
                _errorMessage = _companies.Count == 0
                    ? "No companies are available. Create a company before opening its dashboard."
                    : "Select a company to view its dashboard.";
                return;
            }

            _dashboard = await DashboardService.GetDashboardAsync(_selectedCompanyId);
            _errorMessage = "No dashboard data was returned.";
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Dashboard API request failed with status {StatusCode}", ex.StatusCode);
            _errorMessage = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Your session has expired. Please sign in again.",
                System.Net.HttpStatusCode.Forbidden => "A company must be assigned or selected to view this dashboard.",
                System.Net.HttpStatusCode.NotFound => "The selected company was not found. Please choose another company.",
                System.Net.HttpStatusCode.InternalServerError => "A server error prevented the dashboard from loading. Please try again.",
                _ => "Unable to contact the dashboard API. Please try again."
            };
        }
        catch (TaskCanceledException ex)
        {
            Logger.LogWarning(ex, "Dashboard request timed out");
            _errorMessage = "The dashboard request timed out. Please try again.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the executive dashboard");
            _errorMessage = "Unable to load the dashboard. Please try again.";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task RetryAsync()
    {
        _initialized = false;
        await LoadDashboardAsync();
    }

    private async Task SelectCompanyAsync(ChangeEventArgs args)
    {
        _selectedCompanyId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null;
        await LoadDashboardAsync();
    }

    private static string Money(decimal value) => $"ETB {value:N0}";
}