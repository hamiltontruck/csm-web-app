@page "/dashboard"
@rendermode InteractiveServer
@using CSM.Web.Models.Dashboard
@using CSM.Web.Services
@inject IExecutiveDashboardService DashboardService
@inject ProtectedSessionStorage SessionStorage
@inject NavigationManager Navigation
@inject ILogger<Dashboard> Logger
@inject IAuthService AuthService

<PageTitle>Dashboard | HBG CSM</PageTitle>
<div class="dashboard-shell">
@if (_canSelectCompany)
{
    <div class="dashboard-company">
        <label for="dashboard-company" class="dashboard-company-label">Workspace</label>
        <select id="dashboard-company" class="form-select" value="@_selectedCompanyId" @onchange="SelectCompanyAsync" disabled="@_loading">
            <option value="">Select a company</option>
            @foreach (var company in _companies) { <option value="@company.Id">@company.Name</option> }
        </select>
    </div>
}
@if (_loading)
{
    <section class="dashboard-loading" aria-live="polite">
        <div class="dashboard-skeleton dashboard-skeleton-title"></div>
        <div class="dashboard-skeleton-grid">
            @for (var i = 0; i < 4; i++) { <div class="dashboard-skeleton dashboard-skeleton-card"></div> }
        </div>
        <p>Preparing your dashboard…</p>
    </section>
}
else if (_dashboard is null)
{
    <section class="dashboard-empty" role="alert">
        <div class="dashboard-empty-icon">!</div>
        <p class="dashboard-eyebrow">Dashboard unavailable</p>
        <h1>We couldn’t load your workspace</h1>
        <p class="dashboard-empty-copy">@_errorMessage</p>
        <div class="dashboard-actions">
            <button class="dashboard-button dashboard-button-primary" @onclick="RetryAsync">Try again</button>
            <a class="dashboard-button dashboard-button-secondary" href="/login">Sign in</a>
        </div>
    </section>
}
else
{
    <div class="executive-dashboard">
        <header class="dashboard-header">
            <div><h1>Dashboard</h1><p class="dashboard-subtitle">Your permitted company and site activity</p></div>
            <div class="dashboard-header-meta"><span class="dashboard-date">@_dashboard.Today.ToString("dddd, dd MMMM yyyy")</span></div>
        </header>
        @if (Metrics().Any())
        {
            <section class="metric-grid" aria-label="Authorized activity">
                @foreach (var metric in Metrics())
                {
                    <article class="metric-card">
                        <div class="metric-label">@metric.Label</div><div class="metric-value">@metric.Value</div>
                        @if (_access.CanVisit(metric.Route))
                        { <div class="metric-foot"><a href="@metric.Route">View details →</a></div> }
                    </article>
                }
            </section>
        }
        @if (_dashboard.TotalBudget.HasValue || _dashboard.TotalExpenses.HasValue)
        {
            <section class="dashboard-panel budget-panel" aria-label="Authorized financial activity">
                <div class="panel-heading"><div><p class="panel-overline">FINANCE</p><h2>Budget overview</h2></div><span class="panel-chip">@_dashboard.CurrencyCode</span></div>
                <div class="budget-total">
                    @if (_dashboard.TotalBudget is decimal budget)
                    { <div><span class="budget-caption">Total budget</span><strong>@Money(budget)</strong></div> }
                    @if (_dashboard.TotalExpenses is decimal expenses)
                    { <div class="budget-spend"><span class="budget-caption">Expenses to date</span><strong>@Money(expenses)</strong></div> }
                </div>
                @if (_dashboard.BudgetUtilization is decimal utilization)
                {
                    <div class="budget-progress-label"><span>Budget utilization</span><strong>@utilization.ToString("0.0")%</strong></div>
                    <div class="budget-progress" role="progressbar" aria-label="Budget utilization" aria-valuenow="@Math.Clamp(utilization, 0, 100)" aria-valuemin="0" aria-valuemax="100">
                        <span style="width:@($"{Math.Clamp(utilization, 0, 100)}%")"></span>
                    </div>
                    <div class="budget-foot"><span>Remaining budget</span><strong>@Money(_dashboard.TotalBudget!.Value - _dashboard.TotalExpenses!.Value)</strong></div>
                }
            </section>
        }
        @if (!Metrics().Any() && !_dashboard.TotalBudget.HasValue && !_dashboard.TotalExpenses.HasValue)
        {
            <p>No dashboard summaries are available with your current access.</p>
            <WorkspaceOverview Access="_access" />
        }
        <footer class="dashboard-footer"><span>CSM Workspace</span><span>Updated @_dashboard.GeneratedAtUtc.ToLocalTime().ToString("dd MMM, HH:mm")</span></footer>
    </div>
}
</div>

@code {
    private WorkspaceAccess _access = WorkspaceAccess.None;
    private ExecutiveDashboard? _dashboard;
    private bool _loading = true;
    private bool _initialized;
    private bool _canSelectCompany;
    private Guid? _selectedCompanyId;
    private IReadOnlyList<DashboardCompany> _companies = [];
    private string _userName = "";
    private string _errorMessage = "Unable to load dashboard data.";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        _loading = true;
        _dashboard = null;
        try
        {
            var token = await SessionStorage.GetAsync<string>("jwt");
            if (!token.Success || string.IsNullOrWhiteSpace(token.Value))
            {
                Navigation.NavigateTo("/login", true);
                return;
            }

            _access = new(await AuthService.GetRolesAsync(), await AuthService.GetPermissionsAsync());


            var name = await SessionStorage.GetAsync<string>("userName");
            _userName = name.Success ? name.Value ?? "" : "";
            if (!_initialized)
            {
                var roles = await SessionStorage.GetAsync<List<string>>("roles");
                _canSelectCompany = roles.Success && roles.Value?.Contains("SuperAdmin") == true;
                if (_canSelectCompany) _companies = await DashboardService.GetCompaniesAsync();
                _initialized = true;
            }

            if (_canSelectCompany && !_selectedCompanyId.HasValue)
            {
                _errorMessage = _companies.Count == 0
                    ? "No companies are available. Create a company before opening its dashboard."
                    : "Select a company to view its dashboard.";
                return;
            }

            _dashboard = await DashboardService.GetDashboardAsync(_selectedCompanyId);
            _errorMessage = "No dashboard data was returned.";
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Dashboard API request failed with status {StatusCode}", ex.StatusCode);
            _errorMessage = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Your session has expired. Please sign in again.",
                System.Net.HttpStatusCode.Forbidden => "A company must be assigned or selected to view this dashboard.",
                System.Net.HttpStatusCode.NotFound => "The selected company was not found. Please choose another company.",
                System.Net.HttpStatusCode.InternalServerError => "A server error prevented the dashboard from loading. Please try again.",
                _ => "Unable to contact the dashboard API. Please try again."
            };
        }
        catch (TaskCanceledException ex)
        {
            Logger.LogWarning(ex, "Dashboard request timed out");
            _errorMessage = "The dashboard request timed out. Please try again.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the dashboard");
            _errorMessage = "Unable to load the dashboard. Please try again.";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task RetryAsync()
    {
        _initialized = false;
        await LoadDashboardAsync();
    }

    private async Task SelectCompanyAsync(ChangeEventArgs args)
    {
        _selectedCompanyId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null;
        await LoadDashboardAsync();
    }

    private string Money(decimal value) => $"{_dashboard?.CurrencyCode ?? "ETB"} {value:N2}";
    private IEnumerable<(string Label, string Value, string Route)> Metrics()
    {
        if (_dashboard is null) yield break;
        if (_dashboard.ActiveProjects is int active) yield return ("Active projects", active.ToString(), "/projects");
        if (_dashboard.CompletedProjects is int completed) yield return ("Completed projects", completed.ToString(), "/projects");
        if (_dashboard.ProjectProgress is decimal progress) yield return ("Project progress", $"{progress:0.##}%", "/projects");
        if (_dashboard.OpenDelays is int delays) yield return ("Open project delays", delays.ToString(), "/projects");
        if (_dashboard.TotalEmployees is int employees) yield return ("Team members", employees.ToString(), "/hr/employees");
        if (_dashboard.LowStockItems is int stock) yield return ("Low stock items", stock.ToString(), "/stock-balance");
        if (_dashboard.OpenSafetyIncidents is int safety) yield return ("Open safety incidents", safety.ToString(), "/compliance");
        if (_dashboard.AttendanceToday is int attendance) yield return ($"Attendance · {_dashboard.Today:dd MMM}", attendance.ToString(), "/hr/attendance");
        if (_dashboard.PendingAttendance is int pending) yield return ("Attendance awaiting approval", pending.ToString(), "/hr/attendance");
        if (_dashboard.PendingLeave is int leave) yield return ("Pending leave requests", leave.ToString(), "/hr/leave");
        if (_dashboard.SubmittedTimesheets is int sheets) yield return ("Submitted timesheets", sheets.ToString(), "/hr/timesheets");
    }
}