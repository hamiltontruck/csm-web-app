@page "/dashboard"
@rendermode InteractiveServer

@using CSM.Web.Models.Dashboard
@using CSM.Web.Services

@inject IExecutiveDashboardService DashboardService
@inject ProtectedSessionStorage SessionStorage
@inject NavigationManager Navigation
@inject ILogger<Dashboard> Logger

<PageTitle>Executive Dashboard</PageTitle>

@if (_canSelectCompany)
{
    <div class="container-fluid pt-4">
        <label for="dashboard-company" class="form-label">Company</label>
        <select id="dashboard-company" class="form-select" value="@_selectedCompanyId"
                @onchange="SelectCompanyAsync" disabled="@_loading">
            <option value="">Select a company</option>
            @foreach (var company in _companies)
            {
                <option value="@company.Id">@company.Name</option>
            }
        </select>
    </div>
}

@if (_loading)
{
    <div class="container mt-5">
        <h4>Loading Executive Dashboard...</h4>
    </div>
}
else if (_dashboard is null)
{
    <div class="container mt-5">
        <div class="alert alert-danger" role="alert">
            @_errorMessage
        </div>
        <button class="btn btn-outline-primary" @onclick="RetryAsync">Try again</button>
        <a class="btn btn-link" href="/login">Sign in</a>
    </div>
}
else
{
    <div class="container-fluid py-4">

        <div class="mb-4">
            <h2>Hamilton Business Group</h2>
            <div class="text-muted">
                Construction Site Management
            </div>
            <div class="text-success fw-semibold mt-2">
                Welcome, @_userName
            </div>
        </div>

        <div class="row g-3">

            <div class="col-xl-3 col-md-6">
                <div class="card shadow-sm">
                    <div class="card-body text-center">
                        <div class="text-muted">Active Projects</div>
                        <h2>@_dashboard.ActiveProjects</h2>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card shadow-sm">
                    <div class="card-body text-center">
                        <div class="text-muted">Completed</div>
                        <h2>@_dashboard.CompletedProjects</h2>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card shadow-sm">
                    <div class="card-body text-center">
                        <div class="text-muted">Employees</div>
                        <h2>@_dashboard.TotalEmployees</h2>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card shadow-sm">
                    <div class="card-body text-center">
                        <div class="text-muted">Open Delays</div>
                        <h2>@_dashboard.OpenDelays</h2>
                    </div>
                </div>
            </div>

        </div>

        <div class="row mt-4 g-4">

            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">

                        <h5>Financial Summary</h5>

                        <hr />

                        <div class="d-flex justify-content-between mb-2">
                            <span>Total Budget</span>
                            <strong>@Money(_dashboard.TotalBudget)</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Total Expenses</span>
                            <strong>@Money(_dashboard.TotalExpenses)</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span>Budget Utilization</span>
                            <strong>@_dashboard.BudgetUtilization.ToString("0.00")%</strong>
                        </div>

                        <div class="progress" style="height:10px;">
                            <div class="progress-bar bg-success"
                                 role="progressbar"
                                 style="width:@($"{_dashboard.BudgetUtilization}%")">
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">

                        <h5>Operations</h5>

                        <hr />

                        <div class="d-flex justify-content-between mb-3">
                            <span>Open Safety Incidents</span>
                            <span class="badge bg-danger">
                                @_dashboard.OpenSafetyIncidents
                            </span>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span>Low Stock Items</span>
                            <span class="badge bg-warning text-dark">
                                @_dashboard.LowStockItems
                            </span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <span>Generated</span>
                            <small>
                                @_dashboard.GeneratedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                            </small>
                        </div>

                    </div>
                </div>
            </div>

        </div>

    </div>
}

@code {

    private ExecutiveDashboard? _dashboard;

    private bool _loading = true;
    private bool _initialized;
    private bool _canSelectCompany;
    private Guid? _selectedCompanyId;
    private IReadOnlyList<DashboardCompany> _companies = [];

    private string _userName = "";
    private string _errorMessage = "Unable to load dashboard data.";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        _loading = true;
        _dashboard = null;
        try
        {
            var token = await SessionStorage.GetAsync<string>("jwt");
            if (!token.Success || string.IsNullOrWhiteSpace(token.Value))
            {
                Navigation.NavigateTo("/login", true);
                return;
            }

            var name = await SessionStorage.GetAsync<string>("userName");
            _userName = name.Success ? name.Value ?? "" : "";
            if (!_initialized)
            {
                var roles = await SessionStorage.GetAsync<List<string>>("roles");
                _canSelectCompany = roles.Success && roles.Value?.Contains("SuperAdmin") == true;
                if (_canSelectCompany)
                    _companies = await DashboardService.GetCompaniesAsync();
                _initialized = true;
            }

            if (_canSelectCompany && !_selectedCompanyId.HasValue)
            {
                _errorMessage = _companies.Count == 0
                    ? "No companies are available. Create a company before opening its dashboard."
                    : "Select a company to view its dashboard.";
                return;
            }

            _dashboard = await DashboardService.GetDashboardAsync(_selectedCompanyId);
            _errorMessage = "No dashboard data was returned.";
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Dashboard API request failed with status {StatusCode}", ex.StatusCode);
            _errorMessage = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized =>
                    "Your session has expired. Please sign in again.",
                System.Net.HttpStatusCode.Forbidden =>
                    "A company must be assigned or selected to view this dashboard.",
                System.Net.HttpStatusCode.NotFound =>
                    "The selected company was not found. Please choose another company.",
                System.Net.HttpStatusCode.InternalServerError =>
                    "A server error prevented the dashboard from loading. Please try again.",
                _ => "Unable to contact the dashboard API. Please try again."
            };
        }
        catch (TaskCanceledException ex)
        {
            Logger.LogWarning(ex, "Dashboard request timed out");
            _errorMessage = "The dashboard request timed out. Please try again.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the executive dashboard");
            _errorMessage = "Unable to load the dashboard. Please try again.";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task RetryAsync()
    {
        _initialized = false;
        await LoadDashboardAsync();
    }

    private async Task SelectCompanyAsync(ChangeEventArgs args)
    {
        _selectedCompanyId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null;
        await LoadDashboardAsync();
    }

    private static string Money(decimal value)
        => $"ETB {value:N0}";
}