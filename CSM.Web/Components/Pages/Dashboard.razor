@page "/dashboard"
@rendermode InteractiveServer

@using CSM.Web.Models.Dashboard
@using CSM.Web.Services

@inject IExecutiveDashboardService DashboardService
@inject ProtectedSessionStorage SessionStorage
@inject NavigationManager Navigation

<PageTitle>Executive Dashboard</PageTitle>

@if (_loading)
{
    <div class="container mt-5">
        <h4>Loading Executive Dashboard...</h4>
    </div>
}
else if (_dashboard is null)
{
    <div class="container mt-5">
        <div class="alert alert-danger">
            Unable to load dashboard data.
        </div>
    </div>
}
else
{
    <div class="container-fluid py-4">

        <div class="mb-4">
            <h2>Hamilton Business Group</h2>
            <div class="text-muted">
                Construction Site Management
            </div>
            <div class="text-success fw-semibold mt-2">
                Welcome, @_userName
            </div>
        </div>

        <div class="row g-3">

            <div class="col-xl-3 col-md-6">
                <div class="card shadow-sm">
                    <div class="card-body text-center">
                        <div class="text-muted">Active Projects</div>
                        <h2>@_dashboard.ActiveProjects</h2>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card shadow-sm">
                    <div class="card-body text-center">
                        <div class="text-muted">Completed</div>
                        <h2>@_dashboard.CompletedProjects</h2>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card shadow-sm">
                    <div class="card-body text-center">
                        <div class="text-muted">Employees</div>
                        <h2>@_dashboard.TotalEmployees</h2>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card shadow-sm">
                    <div class="card-body text-center">
                        <div class="text-muted">Open Delays</div>
                        <h2>@_dashboard.OpenDelays</h2>
                    </div>
                </div>
            </div>

        </div>

        <div class="row mt-4 g-4">

            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">

                        <h5>Financial Summary</h5>

                        <hr />

                        <div class="d-flex justify-content-between mb-2">
                            <span>Total Budget</span>
                            <strong>@Money(_dashboard.TotalBudget)</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Total Expenses</span>
                            <strong>@Money(_dashboard.TotalExpenses)</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span>Budget Utilization</span>
                            <strong>@_dashboard.BudgetUtilization.ToString("0.00")%</strong>
                        </div>

                        <div class="progress" style="height:10px;">
                            <div class="progress-bar bg-success"
                                 role="progressbar"
                                 style="width:@($"{_dashboard.BudgetUtilization}%")">
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">

                        <h5>Operations</h5>

                        <hr />

                        <div class="d-flex justify-content-between mb-3">
                            <span>Open Safety Incidents</span>
                            <span class="badge bg-danger">
                                @_dashboard.OpenSafetyIncidents
                            </span>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span>Low Stock Items</span>
                            <span class="badge bg-warning text-dark">
                                @_dashboard.LowStockItems
                            </span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <span>Generated</span>
                            <small>
                                @_dashboard.GeneratedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                            </small>
                        </div>

                    </div>
                </div>
            </div>

        </div>

    </div>
}

@code {

    private ExecutiveDashboard? _dashboard;

    private bool _loading = true;

    private string _userName = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var token = await SessionStorage.GetAsync<string>("jwt");

        if (!token.Success || string.IsNullOrWhiteSpace(token.Value))
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        var name = await SessionStorage.GetAsync<string>("userName");
        _userName = name.Success ? name.Value ?? "" : "";

        _dashboard = await DashboardService.GetDashboardAsync();

        _loading = false;

        StateHasChanged();
    }

    private static string Money(decimal value)
        => $"ETB {value:N0}";
}