@page "/vendors/create"
@rendermode InteractiveServer

@using CSM.Web.Models.Procurement
@using CSM.Web.Services

@inject IVendorService VendorService
@inject NavigationManager Navigation
@inject IExecutiveDashboardService DashboardService
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage SessionStorage

<PageTitle>New Vendor</PageTitle>

<div class="container py-4">

    <button class="btn btn-outline-secondary mb-3"
            @onclick="GoBack">
        <i class="bi bi-arrow-left"></i> Back
    </button>

    <h2 class="mb-4">New Vendor</h2>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            @if (_canSelectCompany)
            {
                <div class="mb-3">
                    <label for="vendor-company" class="form-label">Company</label>
                    <select id="vendor-company" class="form-select" @bind="model.CompanyId" disabled="@(saving || _initializing)">
                        <option value="">Select a company</option>
                        @foreach (var company in _companies)
                        {
                            <option value="@company.Id">@company.Name</option>
                        }
                    </select>
                </div>
            }

            <div class="row g-3">

                <div class="col-md-4">
                    <label class="form-label">Vendor Code</label>
                    <input class="form-control"
                           @bind="model.VendorCode"
                           @bind:event="oninput" />
                </div>

                <div class="col-md-8">
                    <label class="form-label">Vendor Name</label>
                    <input class="form-control"
                           @bind="model.Name"
                           @bind:event="oninput" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Contact Person</label>
                    <input class="form-control" @bind="model.ContactPerson" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Phone Number</label>
                    <input class="form-control" @bind="model.PhoneNumber" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Email</label>
                    <input class="form-control" @bind="model.Email" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Tax Number</label>
                    <input class="form-control" @bind="model.TaxIdentificationNumber" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Bank Name</label>
                    <input class="form-control" @bind="model.BankName" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Bank Account</label>
                    <input class="form-control" @bind="model.BankAccountNumber" />
                </div>

                <div class="col-12">
                    <label class="form-label">Address</label>
                    <textarea class="form-control"
                              rows="3"
                              @bind="model.Address"></textarea>
                </div>

                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               @bind="model.IsActive" />

                        <label class="form-check-label">
                            Active Vendor
                        </label>
                    </div>
                </div>

            </div>

            <hr />

            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-secondary"
                        @onclick="GoBack">
                    Cancel
                </button>

                <WorkspaceAction Route="/vendors">

                    <button class="btn btn-primary"
                        @onclick="Save"
                        disabled="@(saving || _initializing)">
                    @(saving ? "Saving..." : "Save Vendor")
                </button>
            </WorkspaceAction>
            </div>

        </div>
    </div>

</div>

@code{
    private CreateVendorRequest model = new()
    {
        IsActive = true
    };

    private bool saving;
    private string? errorMessage;

    private bool _loaded;
    private bool _initializing = true;
    private bool _canSelectCompany;
    private IReadOnlyList<CSM.Web.Models.Dashboard.DashboardCompany> _companies = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
            return;

        _loaded = true;

        try
        {
            var roles = await SessionStorage.GetAsync<List<string>>("roles");
            _canSelectCompany = roles.Success && roles.Value?.Contains("SuperAdmin") == true;
            if (!_canSelectCompany)
                model.CompanyId = await AuthService.GetCurrentCompanyIdAsync();
            if (_canSelectCompany || !model.CompanyId.HasValue || model.CompanyId == Guid.Empty)
            {
                _companies = await DashboardService.GetCompaniesAsync();
                _canSelectCompany = true;
                if (_companies.Count == 1) model.CompanyId = _companies[0].Id;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load vendor options. {ex.Message}";
        }
        finally
        {
            _initializing = false;
            StateHasChanged();
        }
    }


    async Task Save()
    {
        if (_initializing || saving) return;
        errorMessage = null;
        if (!model.CompanyId.HasValue || model.CompanyId == Guid.Empty)
        {
            errorMessage = "Select a company before creating a vendor.";
            return;
        }

        if (string.IsNullOrWhiteSpace(model.VendorCode))
        {
            errorMessage = "Vendor Code is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(model.Name))
        {
            errorMessage = "Vendor Name is required.";
            return;
        }

        saving = true;
        try
        {
            if (await VendorService.CreateVendorAsync(model))
                Navigation.NavigateTo("/vendors");
            else
                errorMessage = "Unable to save vendor.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    void GoBack()
        => Navigation.NavigateTo("/vendors");
}