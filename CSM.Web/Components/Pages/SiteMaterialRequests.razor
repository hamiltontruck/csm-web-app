@page "/material-requests/site/{SiteId:guid}"
@rendermode InteractiveServer

@using CSM.Web.Models.Procurement
@using CSM.Web.Models.Sites
@using CSM.Web.Services

@inject IProcurementService ProcurementService
@inject NavigationManager Navigation

<PageTitle>Site Material Requests</PageTitle>

@if (loading)
{
    <div class="container py-4">
        <h4>Loading...</h4>
    </div>
}
else
{
    <div class="container py-4">

        <button class="btn btn-outline-secondary mb-3"
                @onclick="Back">
            <i class="bi bi-arrow-left"></i> Back
        </button>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2>Material Requests</h2>
                <div class="text-muted">
                    Requests for selected site
                </div>
            </div>

            <button class="btn btn-primary"
                    @onclick="NewRequest">
                + New Request
            </button>
        </div>

        @if (requests.Count == 0)
        {
            <div class="alert alert-info">
                No material requests found for this site.
            </div>
        }
        else
        {
            @foreach (var item in requests)
            {
                <div class="card shadow-sm mb-3"
                     style="cursor:pointer"
                     @onclick="() => Open(item.Id)">

                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <h5 class="mb-1">@item.RequestNumber</h5>
                            <span class="badge bg-secondary">
                                @item.Status
                            </span>
                        </div>

                        <div class="text-muted">@item.SiteName</div>
                        <small>@item.RequestDate.ToString("dd MMM yyyy")</small>
                    </div>
                </div>
            }
        }

    </div>
}

@code {
    [Parameter]
    public Guid SiteId { get; set; }

    private bool loading = true;
    private List<MaterialRequestResponse> requests = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var all = await ProcurementService.GetMaterialRequestsAsync();

        requests = all
            .Where(x => x.ConstructionSiteId == SiteId)
            .OrderByDescending(x => x.RequestDate)
            .ToList();

        loading = false;
        StateHasChanged();
    }

    void Open(Guid id)
        => Navigation.NavigateTo($"/material-requests/{id}");

    void NewRequest()
        => Navigation.NavigateTo($"/material-requests/create/{SiteId}");

    void Back()
        => Navigation.NavigateTo("/material-requests");
}