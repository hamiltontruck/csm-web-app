@page "/finance/payments"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.Finance
@using CSM.Web.Services

@inject IFinanceService FinanceService
@inject NavigationManager Navigation

<PageTitle>Payments</PageTitle>

@if (_loading)
{
    <div class="container py-5 text-center">
        <div class="spinner-border text-primary"></div>
        <p class="mt-3">Loading payments...</p>
    </div>
}
else
{
    <div class="container-fluid py-4">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1">Payments</h2>
                <div class="text-muted">
                    Finance Payment Register
                </div>
            </div>

            <button class="btn btn-primary"
                    @onclick="CreatePayment">
                + Record Payment
            </button>
        </div>

        <div class="card shadow-sm border-0">
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Payment No.</th>
                            <th>Date</th>
                            <th>Method</th>
                            <th>Currency</th>
                            <th class="text-end">Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (_payments.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    No payments found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in _payments)
                            {
                                <tr style="cursor:pointer"
                                    @onclick="() => Open(item.Id)">

                                    <td class="fw-semibold">@item.PaymentNumber</td>

                                    <td>@item.PaymentDate.ToString("dd MMM yyyy")</td>

                                    <td>@item.PaymentMethod</td>

                                    <td>@item.CurrencyCode</td>

                                    <td class="text-end fw-semibold">
                                        @item.Amount.ToString("N2")
                                    </td>

                                    <td>
                                        @switch (item.Status)
                                        {
                                            case "Pending":
                                                <span class="badge bg-warning text-dark">Pending</span>
                                                break;
                                            case "Completed":
                                                <span class="badge bg-success">Completed</span>
                                                break;
                                            case "Failed":
                                                <span class="badge bg-danger">Failed</span>
                                                break;
                                            case "Cancelled":
                                                <span class="badge bg-secondary">Cancelled</span>
                                                break;
                                        }
                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>
        </div>

    </div>
}

@code {

    private readonly List<PaymentResponse> _payments = new();

    private bool _loading = true;
    private bool _loaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
            return;

        _loaded = true;

        var items = await FinanceService.GetPaymentsAsync();

        _payments.Clear();
        _payments.AddRange(items);

        _loading = false;

        StateHasChanged();
    }

    private void Open(Guid id)
    {
        Navigation.NavigateTo($"/finance/payments/{id}");
    }

    private void CreatePayment()
    {
        Navigation.NavigateTo("/finance/payments/create");
    }

}