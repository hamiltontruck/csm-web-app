@page "/finance/petty-cash/account/{AccountId:guid}/transactions/create"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.Finance
@using CSM.Web.Services

@inject IFinanceService FinanceService
@inject NavigationManager Navigation

<PageTitle>New Petty Cash Transaction</PageTitle>

<div class="container-fluid py-4">

    <button class="btn btn-outline-secondary mb-3"
            disabled="@_saving"
            @onclick="Back">
        <i class="bi bi-arrow-left"></i> Back
    </button>

    <div class="card shadow-sm">
        <div class="card-header">
            <h4 class="mb-0">New Petty Cash Transaction</h4>
        </div>

        <div class="card-body">

            @if (_loading)
            {
                <p>Loading account...</p>
            }
            else if (_account is null)
            {
                <div class="alert alert-danger" role="alert">
                    @(_error ?? "Petty cash account not found.")
                </div>
            }
            else
            {
                <div class="alert alert-light border mb-4">
                    <strong>Account:</strong>
                    @_account.AccountCode - @_account.AccountName
                    <br />
                    <strong>Current Balance:</strong>
                    @_account.CurrentBalance.ToString("N2")
                </div>

                <EditForm Model="_form"
                          OnValidSubmit="Submit">

                    <DataAnnotationsValidator />

                    @if (_settlementError is not null) { <p class="text-muted" role="status">@_settlementError</p> }
                    @if (_form.TransactionType == "CashOut" && (_expenseChoices.Count > 0 || ExpenseId.HasValue))
                    {
                        <div class="mb-3">
                            <label class="form-label">Expense to settle (optional)</label>
                            <select class="form-select" @bind="_form.ExpenseId" @bind:after="ExpenseChanged" disabled="@(ExpenseId.HasValue || _saving)">
                                <option value="">-- Unlinked Cash Out --</option>
                                @foreach (var expense in _expenseChoices) { <option value="@expense.Id">@expense.ExpenseNumber — ETB @expense.OutstandingAmount.ToString("N2") outstanding</option> }
                            </select>
                        </div>
                    }
                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">
                                Transaction Type
                            </label>

                            <select class="form-select"
                                    @bind="_form.TransactionType" @bind:after="TypeChanged" disabled="@(ExpenseId.HasValue || _saving)">
                                <option value="CashOut">
                                    Cash Out
                                </option>
                                <option value="CashIn">
                                    Cash In
                                </option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Reference Number
                            </label>

                            <InputText class="form-control"
                                       @bind-Value="_form.ReferenceNumber"
                                       @oninput="e => _form.ReferenceNumber = e.Value?.ToString() ?? string.Empty" />

                            <ValidationMessage
                                For="@(() => _form.ReferenceNumber)" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Amount
                            </label>

                            <InputNumber class="form-control"
                                         @bind-Value="_form.Amount" />

                            <ValidationMessage
                                For="@(() => _form.Amount)" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Cost Code
                            </label>

                            <select class="form-select"
                                    @bind="_form.CostCodeId" disabled="@_form.ExpenseId.HasValue">

                                <option value="">
                                    -- No Cost Code --
                                </option>

                                @foreach (var costCode in _costCodes)
                                {
                                    <option value="@costCode.Id">
                                        @costCode.Code - @costCode.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label">
                                Description
                            </label>

                            <InputText class="form-control"
                                       @bind-Value="_form.Description"
                                       @oninput="e => _form.Description = e.Value?.ToString() ?? string.Empty" />

                            <ValidationMessage
                                For="@(() => _form.Description)" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">
                                Remarks
                            </label>

                            <InputTextArea class="form-control"
                                           rows="3"
                                           @bind-Value="_form.Remarks"
                                       @oninput="e => _form.Remarks = e.Value?.ToString() ?? string.Empty" />
                        </div>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <div class="alert alert-danger mt-3">
                            @_error
                        </div>
                    }

                    <div class="mt-4">

                        <button type="submit"
                                class="btn btn-primary"
                                disabled="@(_saving || !_expenseReady)">
                            @if (_saving)
                            {
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>
                                    <i class="bi bi-check-lg"></i>
                                    Save Transaction
                                </span>
                            }
                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary ms-2"
                                @onclick="Back"
                                disabled="@_saving">
                            Cancel
                        </button>

                    </div>

                </EditForm>
            }

        </div>
    </div>
</div>

@code {
    [Parameter]
    public Guid AccountId { get; set; }
    [Parameter, SupplyParameterFromQuery] public Guid? ExpenseId { get; set; }
    [CascadingParameter] private WorkspaceAccess Access { get; set; } = WorkspaceAccess.None;
    private IReadOnlyList<ExpenseSettlementOption> _expenseChoices = [];
    private string? _settlementError;
    private Guid? _requestedExpenseId;
    private bool _expenseReady;

    private PettyCashAccountResponse? _account;

    private IReadOnlyList<PettyCashCostCodeOption> _costCodes = Array.Empty<PettyCashCostCodeOption>();

    private PettyCashTransactionForm _form = new();

    private bool _loading = true;
    private bool _saving;
    private string? _error;

    private Guid? _requestedAccountId, _loadedAccountId;
    private int _loadVersion;

    protected override void OnParametersSet()
    {
        if (_requestedAccountId != AccountId || _requestedExpenseId != ExpenseId)
        {
            _loading = true;
            _expenseReady = false; _expenseChoices = []; _settlementError = null;
            _account = null;
            _loadedAccountId = null;
            _error = null;
            _saving = false;
            _loadVersion++;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_requestedAccountId == AccountId && _requestedExpenseId == ExpenseId) return;
        var id = AccountId;
        _requestedAccountId = id;
        var expenseId = ExpenseId; _requestedExpenseId = expenseId;
        var version = ++_loadVersion;
        try
        {
            var account = await FinanceService.GetPettyCashAccountAsync(id);
            var codes = await FinanceService.GetPettyCashCostCodeOptionsAsync(id);
            if (id != AccountId || version != _loadVersion) return;
            if (account is null) throw new InvalidOperationException("Petty cash account not found.");
            _account = account;
            _costCodes = codes;
            _form = new PettyCashTransactionForm { PettyCashAccountId = account.Id };
            _loadedAccountId = id;
            _expenseReady = !expenseId.HasValue;
            if (Access.Has("Finance_Expense_View"))
            {
                try
                {
                    var choices = await FinanceService.GetExpenseSettlementChoicesAsync("petty-cash", account.ConstructionSiteId, id);
                    if (id != AccountId || version != _loadVersion) return;
                    _expenseChoices = choices;
                    if (expenseId.HasValue)
                    {
                        _form.ExpenseId = choices.Any(x => x.Id == expenseId) ? expenseId : null;
                        ExpenseChanged();
                        _expenseReady = _form.ExpenseId == expenseId;
                        if (!_expenseReady) _settlementError = "This expense is not available for this cash account. Refresh or open the correct account.";
                    }
                }
                catch { if (version == _loadVersion) _settlementError = "Expense options are currently unavailable. Refresh to check your access."; }
            }
            else if (expenseId.HasValue) _settlementError = "Expense viewing permission is required to settle this expense.";
        }
        catch (Exception ex)
        {
            if (id == AccountId && version == _loadVersion) _error = ex.Message;
        }
        finally
        {
            if (id == AccountId && version == _loadVersion)
            {
                _loading = false;
                StateHasChanged();
            }
        }
    }

    private async Task Submit()
    {
        if (_loading || _loadedAccountId != AccountId || _account is null || _saving || !_expenseReady) return;
        if ((_form.ExpenseId.HasValue && !_expenseChoices.Any(x => x.Id == _form.ExpenseId)) ||
            (ExpenseId.HasValue && _form.ExpenseId != ExpenseId)) { _error = "Expense selection is stale. Refresh before posting."; return; }
        var id = AccountId;
        var version = _loadVersion;
        _saving = true;
        _error = null;

        try
        {
            var request = new CreatePettyCashTransactionRequest(
                _form.PettyCashAccountId,
                _form.TransactionType,
                _form.ReferenceNumber,
                _form.Amount,
                _form.Description,
                _form.Remarks,
                _form.CostCodeId) { ExpenseId = _form.ExpenseId };

            await FinanceService
                .CreatePettyCashTransactionAsync(request);

            if (id == AccountId && version == _loadVersion)
                Navigation.NavigateTo($"/finance/petty-cash/account/{request.PettyCashAccountId}/transactions");
        }
        catch (Exception ex)
        {
            if (id == AccountId && version == _loadVersion) _error = ex.Message;
        }
        finally
        {
            if (id == AccountId && version == _loadVersion) _saving = false;
        }
    }

    private void TypeChanged()
    {
        if (_form.TransactionType != "CashOut") { _form.ExpenseId = null; _expenseReady = !ExpenseId.HasValue; }
    }
    private void ExpenseChanged()
    {
        var expense = _expenseChoices.FirstOrDefault(x => x.Id == _form.ExpenseId);
        _form.CostCodeId = expense?.CostCodeId;
        _form.Amount = expense?.OutstandingAmount ?? 0m;
        if (expense is not null) _form.TransactionType = "CashOut";
        _expenseReady = !ExpenseId.HasValue || expense?.Id == ExpenseId;
    }

    private void Back()
    {
        Navigation.NavigateTo(
            $"/finance/petty-cash/account/{AccountId}/transactions");
    }

    private sealed class PettyCashTransactionForm
    {
        public Guid? ExpenseId { get; set; }
        public Guid PettyCashAccountId { get; set; }

        public string TransactionType { get; set; } = "CashOut";

        public string ReferenceNumber { get; set; } = string.Empty;

        public decimal Amount { get; set; }

        public string Description { get; set; } = string.Empty;

        public string? Remarks { get; set; }

        public Guid? CostCodeId { get; set; }
    }
}