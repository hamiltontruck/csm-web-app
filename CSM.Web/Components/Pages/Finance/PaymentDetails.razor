@page "/finance/payments/{Id:guid}"
@page "/finance/sites/{SiteId:guid}/payments/{Id:guid}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.Finance
@using CSM.Web.Services

@inject IFinanceService FinanceService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Payment Details</PageTitle>

@if (_loading)
{
    <div class="container py-5 text-center">
        <div class="spinner-border text-primary"></div>
        <p class="mt-3">Loading payment...</p>
    </div>
}
else if (_payment is null)
{
    <div class="container py-4">
        <div class="alert alert-danger">
            @(_error ?? "Payment not found.")
        </div>
    </div>
}
else
{
    <div class="container py-4">

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }
        <button disabled="@_saving" class="btn btn-outline-secondary mb-3"
                @onclick="Back">
            ← Payments
        </button>

        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
            <div>
                <h2>@_payment.PaymentNumber</h2>
                <div class="text-muted">
                    @_payment.PaymentDate.ToString("dd MMM yyyy")
                </div>
            </div>

            @switch (_payment.Status)
            {
                case "Pending":
                    <span class="badge bg-info text-dark fs-6">Recorded</span>
                    break;

                case "Completed":
                    <span class="badge bg-success fs-6">Completed</span>
                    break;

                case "Reversed":
                    <span class="badge bg-dark fs-6">Reversed</span>
                    break;

                case "Failed":
                    <span class="badge bg-danger fs-6">Failed</span>
                    break;

                case "Cancelled":
                    <span class="badge bg-secondary fs-6">Cancelled</span>
                    break;
            }
        </div>

        <div class="d-flex flex-wrap gap-2 mb-4">

            @if (_payment.Status == "Pending")
            {
                <button disabled="@_saving" class="btn btn-success" @onclick="CompletePayment">
                    Complete Payment
                </button>
            }

            @if (_payment.Status == "Completed")
            {
                <button disabled="@_saving" class="btn btn-outline-danger"
                        @onclick="ReversePayment">
                    Reverse Payment
                </button>
            }

            <WorkspaceAction Route="/finance/sites/{SiteId.Value}/payments/{Id}/edit">
                <button disabled="@_saving" class="btn btn-primary"
                    @onclick="EditPayment">
                Edit Payment
            </button>
            </WorkspaceAction>

            @if (_payment.Status == "Pending")
            {
                <WorkspaceAction Route="/finance/sites/{SiteId.Value}/payments">
                    <WorkspaceAction Route="@($"/finance/sites/{_payment.ConstructionSiteId}/payments")" Permission="Finance_Payment_Manage" Roles="SuperAdmin,CompanyAdmin,Accountant,FinanceOfficer">
<button disabled="@_saving" class="btn btn-outline-danger"
                        @onclick="DeletePayment">
                    Delete Payment
                </button>
</WorkspaceAction>
            </WorkspaceAction>
            }

            <button disabled="@_saving" class="btn btn-outline-dark"
                    @onclick="PrintReceipt">
                <i class="bi bi-printer"></i> Print Receipt
            </button>

        </div>

        <div class="row g-3">

            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted small">Amount</div>
                        <h3>@_payment.CurrencyCode @_payment.Amount.ToString("N2")</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted small">Direction</div>
                        <h5>@_payment.Direction</h5>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted small">Method</div>
                        <h5>@_payment.PaymentMethod</h5>
                    </div>
                </div>
            </div>

        </div>

        <div class="card shadow-sm mt-4">
            <div class="card-header fw-bold">
                Payment Information
            </div>

            <div class="card-body">

                <div class="row mb-3">
                    <div class="col-md-3 fw-semibold">Reference</div>
                    <div class="col-md-9">@_payment.ReferenceNumber</div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3 fw-semibold">Exchange Rate</div>
                    <div class="col-md-9">@_payment.ExchangeRate</div>
                </div>

                <div class="row">
                    <div class="col-md-3 fw-semibold">Notes</div>
                    <div class="col-md-9">@_payment.Notes</div>
                </div>

            </div>
        </div>

    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    [Parameter] public Guid? SiteId { get; set; }

    private PaymentResponse? _payment;

    private bool _loading = true;
    private bool _loaded, _saving;
    private string? _error;
    private Guid? _contextId, _contextSite;
    private long _loadVersion;

    protected override void OnParametersSet()
    {
        if (_contextId == Id && _contextSite == SiteId) return;
        _contextId = Id; _contextSite = SiteId;
        _loadVersion++;
        _loaded = _saving = false;
        _loading = true;
        _error = null;
        _payment = null;
    }

    private bool IsCurrent(Guid requestId, long version) => Id == requestId && _loadVersion == version;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loaded) return;
        _loaded = true;
        var requestId = Id;
        var version = _loadVersion;
        try
        {
            var payment = await FinanceService.GetPaymentAsync(requestId);
            if (IsCurrent(requestId, version)) _payment = payment;
        }
        catch { if (IsCurrent(requestId, version)) _error = "Unable to load this payment. Refresh and try again."; }
        finally { if (IsCurrent(requestId, version)) { _loading = false; StateHasChanged(); } }
    }

    private Task CompletePayment() => UpdatePaymentAsync(id => FinanceService.ChangePaymentStatusAsync(id, 2));
    private Task ReversePayment() => UpdatePaymentAsync(id => FinanceService.ReversePaymentAsync(id));

    private async Task UpdatePaymentAsync(Func<Guid, Task> update)
    {
        if (_loading || _saving || _payment?.Id != Id) return;
        var requestId = Id; var version = _loadVersion;
        _saving = true; _error = null;
        try
        {
            await update(requestId);
            var payment = await FinanceService.GetPaymentAsync(requestId);
            if (IsCurrent(requestId, version)) _payment = payment;
        }
        catch { if (IsCurrent(requestId, version)) _error = "Unable to update this payment. Refresh and try again."; }
        finally { if (IsCurrent(requestId, version)) _saving = false; }
    }

    private void EditPayment()
    {
        if (SiteId.HasValue)
            Navigation.NavigateTo(
                $"/finance/sites/{SiteId.Value}/payments/{Id}/edit");
        else
            Navigation.NavigateTo(
                $"/finance/payments/{Id}/edit");
    }

    private async Task DeletePayment()
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Delete this recorded payment?");

        if (!confirmed)
            return;

        await FinanceService.DeletePaymentAsync(Id);

        if (SiteId.HasValue)
            Navigation.NavigateTo($"/finance/sites/{SiteId.Value}/payments");
        else
            Navigation.NavigateTo("/finance/company/payments");
    }

    private async Task PrintReceipt()
    {
        var pdf = await FinanceService.DownloadPaymentReceiptPdfAsync(Id);

        await JS.InvokeVoidAsync(
            "downloadPdf",
            $"Receipt-{_payment?.PaymentNumber ?? "Receipt"}.pdf",
            Convert.ToBase64String(pdf));
    }

    private void Back()
    {
        if (SiteId.HasValue)
            Navigation.NavigateTo($"/finance/sites/{SiteId.Value}/payments");
        else
            Navigation.NavigateTo("/finance/company/payments");
    }
}