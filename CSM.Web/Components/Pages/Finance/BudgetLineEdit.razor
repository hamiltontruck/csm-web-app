@page "/finance/sites/{SiteId:guid}/budgets/{BudgetId:guid}/lines/{BudgetLineId:guid}/edit"
@page "/finance/company/budgets/{BudgetId:guid}/lines/{BudgetLineId:guid}/edit"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.Finance
@using CSM.Web.Services

@inject IFinanceService FinanceService
@inject NavigationManager Navigation

<PageTitle>Edit Budget Line</PageTitle>

<h3 class="mb-4">Edit Budget Line</h3>

@if (_loading)
{
    <p>Loading budget line...</p>
}
else
{
    <EditForm Model="_model" OnValidSubmit="Save">

        <DataAnnotationsValidator />
        <ValidationSummary />

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger">
                @_error
            </div>
        }

        <div class="row g-3">

            <div class="col-md-6">
                <label class="form-label">Cost Code</label>

                <InputSelect class="form-select"
                             @bind-Value="_model.CostCodeId">

                    <option value="@Guid.Empty">
                        -- Select Cost Code --
                    </option>

                    @foreach (var costCode in _costCodes)
                    {
                        <option value="@costCode.Id">
                            @costCode.Code - @costCode.Name
                        </option>
                    }
                </InputSelect>
            </div>

            <div class="col-md-6">
                <label class="form-label">Description</label>

                <InputText class="form-control"
                           @bind-Value="_model.Description" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Budgeted Amount</label>

                <InputNumber TValue="decimal"
                             class="form-control"
                             @bind-Value="_model.BudgetedAmount" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Revised Amount</label>

                <InputNumber TValue="decimal"
                             class="form-control"
                             @bind-Value="_model.RevisedAmount" />
            </div>

        </div>

        <div class="mt-4 d-flex gap-2">

            <button class="btn btn-primary"
                    type="submit">
                Save Changes
            </button>

            <button class="btn btn-outline-secondary"
                    type="button"
                    @onclick="Back">
                Cancel
            </button>

        </div>

    </EditForm>
}

@code {

    [Parameter] public Guid? SiteId { get; set; }

    [Parameter] public Guid BudgetId { get; set; }

    [Parameter] public Guid BudgetLineId { get; set; }

    private readonly UpdateBudgetLineRequest _model = new();

    private List<CostCodeResponse> _costCodes = new();

    private bool _loading = true;

    private string? _error;

    private bool _loaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
            return;

        _loaded = true;

        try
        {
            var line =
                await FinanceService.GetBudgetLineAsync(
                    BudgetLineId);

            _model.CostCodeId = line.CostCodeId;
            _model.Description = line.Description;
            _model.BudgetedAmount = line.BudgetedAmount;
            _model.RevisedAmount = line.RevisedAmount;

            _costCodes =
                (await FinanceService.GetActiveCostCodesAsync())
                .ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }

        StateHasChanged();
    }

    private async Task Save()
    {
        try
        {
            _error = null;

            await FinanceService.UpdateBudgetLineAsync(
                BudgetLineId,
                _model);

            if (SiteId.HasValue)
            {
                Navigation.NavigateTo(
                    $"/finance/sites/{SiteId.Value}/budgets/{BudgetId}");
            }
            else
            {
                Navigation.NavigateTo(
                    $"/finance/company/budgets/{BudgetId}");
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void Back()
    {
        if (SiteId.HasValue)
        {
            Navigation.NavigateTo(
                $"/finance/sites/{SiteId.Value}/budgets/{BudgetId}");
        }
        else
        {
            Navigation.NavigateTo(
                $"/finance/company/budgets/{BudgetId}");
        }
    }
}