@page "/finance/company/cost-codes/{Id:guid}/edit"
@rendermode InteractiveServer

@using System.Text.Json
@using CSM.Web.Models.Finance
@using CSM.Web.Services

@inject IFinanceService FinanceService
@inject IOfflineSyncService OfflineSyncService
@inject NavigationManager Navigation

<PageTitle>Edit Cost Code</PageTitle>

<div class="container py-4">

    <button class="btn btn-outline-secondary mb-3"
            @onclick="Back">
        ← Cost Codes
    </button>

    <h2 class="mb-4">Edit Cost Code</h2>

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="Save">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <div class="mb-3">
                        <label class="form-label">Code</label>
                        <InputText class="form-control"
                                   Value="_code"
                                   ValueExpression="@(() => _code)"
                                   disabled />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <InputText class="form-control"
                                   @bind-Value="_model.Name" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Parent</label>

                        <InputSelect class="form-select"
                                     @bind-Value="_model.ParentCostCodeId">

                            <option value="">None</option>

                            @foreach (var item in _parents.Where(x => x.Id != Id))
                            {
                                <option value="@item.Id">
                                    @item.Code - @item.Name
                                </option>
                            }

                        </InputSelect>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>

                        <InputTextArea class="form-control"
                                       @bind-Value="_model.Description" />
                    </div>

                </div>
            </div>

            <div class="mt-3 d-flex gap-2">

                <button class="btn btn-primary"
                        type="submit">
                    Update
                </button>

                <button class="btn btn-secondary"
                        type="button"
                        @onclick="Back">
                    Cancel
                </button>

            </div>

        </EditForm>
    }

</div>

@code {

    [Parameter]
    public Guid Id { get; set; }

    private bool _loading = true;

    private string _code = "";

    private UpdateCostCodeResponse _model = new();

    private List<CostCodeResponse> _parents = [];

    protected override async Task OnInitializedAsync()
    {
        var costCode = await FinanceService.GetCostCodeAsync(Id);

        if (costCode is null)
        {
            Navigation.NavigateTo("/finance/company/cost-codes");
            return;
        }

        _code = costCode.Code;

        _model = new UpdateCostCodeResponse
        {
            Name = costCode.Name,
            Description = costCode.Description,
            ParentCostCodeId = costCode.ParentCostCodeId
        };

        _parents = (await FinanceService.GetActiveCostCodesAsync()).ToList();

        _loading = false;
    }

    private async Task Save()
    {
        var isOnline =
            await OfflineSyncService.IsOnlineAsync();

        if (isOnline)
        {
            await FinanceService.UpdateCostCodeAsync(
                Id,
                _model);
        }
        else
        {
            var operation =
                new CSM.Web.Models.OfflineSync.OfflineSyncOperation
                {
                    OperationType =
                        CSM.Web.Models.OfflineSync.OfflineSyncOperationType.Update,

                    EntityType = "CostCode",

                    EntityId = Id.ToString(),

                    PayloadJson =
                        JsonSerializer.Serialize(_model)
                };

            await OfflineSyncService.QueueAsync(operation);
        }

        Navigation.NavigateTo(
            "/finance/company/cost-codes");
    }

    private void Back()
    {
        Navigation.NavigateTo("/finance/company/cost-codes");
    }

}