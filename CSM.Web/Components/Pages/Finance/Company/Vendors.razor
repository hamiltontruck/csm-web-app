@page "/finance/company/vendors"
@rendermode InteractiveServer

@using CSM.Web.Models.Procurement
@using CSM.Web.Services

@inject IVendorService VendorService
@inject NavigationManager Navigation

<PageTitle>Company Vendors</PageTitle>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <button class="btn btn-outline-secondary mb-2"
                    @onclick="Back">
                ← Finance
            </button>

            <h2 class="mb-0">Company Vendors</h2>

            <div class="text-muted">
                Shared supplier master for all projects
            </div>
        </div>

        
            <button class="btn btn-primary"
                @onclick="CreateVendor">
            <i class="bi bi-plus-lg"></i>
            New Vendor
        </button>
    </div>

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else if (_vendors.Count == 0)
    {
        <div class="alert alert-info">
            No vendors found.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">

                <table class="table table-hover mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Vendor</th>
                            <th>Contact</th>
                            <th>Phone</th>
                            <th>Status</th>
                            <th width="150"></th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var vendor in _vendors)
                        {
                            <tr>

                                <td>
                                    <strong>@vendor.Name</strong><br/>
                                    <small class="text-muted">@vendor.Email</small>
                                </td>

                                <td>@vendor.ContactPerson</td>

                                <td>@vendor.PhoneNumber</td>

                                <td>
                                    @if (vendor.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>

                                <td>
                                    <WorkspaceAction Route="/vendors/{id}">
                                        <button class="btn btn-sm btn-outline-primary"
                                            @onclick="() => EditVendor(vendor.Id)">
                                        Edit
                                    </button>
            </WorkspaceAction>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>
    }

</div>

@code {

    private bool _loading = true;

    private List<VendorResponse> _vendors = [];

    protected override async Task OnInitializedAsync()
    {
        _vendors = (await VendorService.GetVendorsAsync()).ToList();

        _loading = false;
    }

    private void Back()
    {
        Navigation.NavigateTo("/finance/sites");
    }

    private void CreateVendor()
    {
        Navigation.NavigateTo("/vendors/create");
    }

    private void EditVendor(Guid id)
    {
        Navigation.NavigateTo($"/vendors/{id}");
    }

}
