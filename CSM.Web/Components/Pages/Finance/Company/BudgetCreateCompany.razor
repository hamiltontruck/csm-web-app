@page "/finance/company/budgets/create"
@rendermode InteractiveServer

@using CSM.Web.Models.Finance
@using CSM.Web.Services

@inject IFinanceService FinanceService
@inject NavigationManager Navigation

<PageTitle>New Company Budget</PageTitle>

<h3 class="mb-4">New Company Budget</h3>

<EditForm Model="_model" OnValidSubmit="Save">
    <DataAnnotationsValidator />

    <div class="row g-3">

        <div class="col-md-4">
            <label class="form-label">Budget No</label>

            <InputText class="form-control"
                       @bind-Value="_model.BudgetNumber" />
        </div>

        <div class="col-md-8">
            <label class="form-label">Budget Name</label>

            <InputText class="form-control"
                       @bind-Value="_model.Name" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Currency</label>

            <InputText class="form-control"
                       @bind-Value="_model.CurrencyCode" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Total Budget</label>

            <InputNumber class="form-control"
                         @bind-Value="_model.TotalAmount" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Effective From</label>

            <InputDate class="form-control"
                       @bind-Value="_model.EffectiveFrom" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Effective To</label>

            <InputDate class="form-control"
                       @bind-Value="_model.EffectiveTo" />
        </div>

        <div class="col-12">
            <label class="form-label">Description</label>

            <InputTextArea class="form-control"
                           @bind-Value="_model.Description" />
        </div>

    </div>

    <div class="mt-4 d-flex gap-2">

        <button class="btn btn-primary"
                type="submit">
            Create Budget
        </button>

        <button class="btn btn-outline-secondary"
                type="button"
                @onclick="Back">
            Cancel
        </button>

    </div>
</EditForm>

@code {
    private readonly CreateBudgetModel _model = new();

    protected override void OnInitialized()
    {
        // Company-level budget:
        // no construction site
        // no project
        _model.ConstructionSiteId = null;
        _model.ProjectId = null;
    }

    private async Task Save()
    {
        await FinanceService.CreateBudgetAsync(_model);

        Navigation.NavigateTo(
            "/finance/company/budgets");
    }

    private void Back()
    {
        Navigation.NavigateTo(
            "/finance/company/budgets");
    }
}