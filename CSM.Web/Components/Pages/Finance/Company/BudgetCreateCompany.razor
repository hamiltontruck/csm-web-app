@page "/finance/company/budgets/create"
@rendermode InteractiveServer

@using CSM.Web.Models.Finance
@using CSM.Web.Services

@inject IFinanceService FinanceService
@inject NavigationManager Navigation
@inject IExecutiveDashboardService DashboardService
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage SessionStorage

<PageTitle>New Company Budget</PageTitle>

<h3 class="mb-4">New Company Budget</h3>

<EditForm Model="_model" OnValidSubmit="Save">
    <DataAnnotationsValidator />
    <ValidationSummary />

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    @if (_canSelectCompany)
    {
        <div class="mb-3">
            <label for="budget-company" class="form-label">Company</label>
            <select id="budget-company" class="form-select" @bind="_model.CompanyId" disabled="@_saving">
                <option value="">Select a company</option>
                @foreach (var company in _companies)
                {
                    <option value="@company.Id">@company.Name</option>
                }
            </select>
        </div>
    }

    <div class="row g-3">

        <div class="col-md-4">
            <label class="form-label">Budget No</label>

            <InputText class="form-control"
                       @bind-Value="_model.BudgetNumber" />
        </div>

        <div class="col-md-8">
            <label class="form-label">Budget Name</label>

            <InputText class="form-control"
                       @bind-Value="_model.Name" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Currency</label>

            <InputText class="form-control"
                       @bind-Value="_model.CurrencyCode" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Total Budget</label>

            <InputNumber class="form-control"
                         @bind-Value="_model.TotalAmount" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Effective From</label>

            <InputDate class="form-control"
                       @bind-Value="_model.EffectiveFrom" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Effective To</label>

            <InputDate class="form-control"
                       @bind-Value="_model.EffectiveTo" />
        </div>

        <div class="col-12">
            <label class="form-label">Description</label>

            <InputTextArea class="form-control"
                           @bind-Value="_model.Description" />
        </div>

    </div>

    <div class="mt-4 d-flex gap-2">

        <button class="btn btn-primary"
                type="submit" disabled="@(_initializing || _saving)">
            @(_saving ? "Creating..." : "Create Budget")
        </button>

        <button class="btn btn-outline-secondary"
                type="button"
                @onclick="Back">
            Cancel
        </button>

    </div>
</EditForm>

@code {
    private readonly CreateBudgetModel _model = new();
    private bool _initializing = true;
    private bool _saving;
    private bool _canSelectCompany;
    private string? _error;
    private IReadOnlyList<CSM.Web.Models.Dashboard.DashboardCompany> _companies = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var roles = await SessionStorage.GetAsync<List<string>>("roles");
            _canSelectCompany = roles.Success && roles.Value?.Contains("SuperAdmin") == true;
            if (!_canSelectCompany)
                _model.CompanyId = await AuthService.GetCurrentCompanyIdAsync();

            // A companyless account still needs the server-authorized company lookup
            // when optional browser role metadata is missing.
            if (_canSelectCompany || !_model.CompanyId.HasValue || _model.CompanyId == Guid.Empty)
            {
                _companies = await DashboardService.GetCompaniesAsync();
                _canSelectCompany = true;
                if (_companies.Count == 1) _model.CompanyId = _companies[0].Id;
            }

        }
        catch (Exception ex)
        {
            _error = $"Unable to load budget company. {ex.Message}";
        }
        finally
        {
            _initializing = false;
            StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        // Company-level budget:
        // no construction site
        // no project
        _model.ConstructionSiteId = null;
        _model.ProjectId = null;
    }

    private async Task Save()
    {
        if (_initializing || _saving) return;
        _error = null;
        if (!_model.CompanyId.HasValue || _model.CompanyId == Guid.Empty)
        {
            _error = "Select a company before creating a budget.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_model.BudgetNumber) || string.IsNullOrWhiteSpace(_model.Name))
        {
            _error = "Budget number and budget name are required.";
            return;
        }

        _saving = true;
        try
        {
            await FinanceService.CreateBudgetAsync(_model);
            Navigation.NavigateTo("/finance/company/budgets");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void Back()
    {
        Navigation.NavigateTo(
            "/finance/company/budgets");
    }
}