@page "/finance/company/invoices"
@rendermode InteractiveServer

@using CSM.Web.Models.Common
@using CSM.Web.Models.Finance
@using CSM.Web.Services

@inject IFinanceService FinanceService
@inject NavigationManager Navigation

<PageTitle>Company Invoices</PageTitle>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <button class="btn btn-outline-secondary mb-2"
                    @onclick="Back">
                ← Finance
            </button>

            <h2 class="mb-0">Company Invoices</h2>

            <div class="text-muted">
                Non-site invoices (Head Office)
            </div>
        </div>

        <WorkspaceAction Route="/finance/company/invoices/create">
            <button class="btn btn-primary"
                @onclick="CreateInvoice">
            <i class="bi bi-plus-lg"></i>
            New Invoice
        </button>
            </WorkspaceAction>

    </div>

<CompanySelector Options="_companyOptions" Value="_companyId" ValueChanged="CompanyChanged" Id="company-finance-selection" />
@if (!string.IsNullOrWhiteSpace(_error)) { <div class="alert alert-danger" role="alert">@_error</div> }
@if (!_companyId.HasValue && !_loading) { <p>Select a company to view its records.</p> }

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else if (_items.Count == 0)
    {
        <div class="alert alert-info">
            No company invoices found.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">

            <div class="table-responsive">

                <table class="table table-hover mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Invoice</th>
                            <th>Vendor</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var invoice in _items)
                        {
                            <tr role="button"
                                @onclick="() => Open(invoice.Id)">

                                <td>
                                    <strong>@invoice.InvoiceNumber</strong>
                                </td>

                                <td>@invoice.VendorName</td>

                                <td>
                                    @invoice.InvoiceDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @invoice.Status
                                    </span>
                                </td>

                                <td class="text-end">
                                    @invoice.CurrencyCode
                                    @invoice.TotalAmount.ToString("N2")
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>

@code {

    private CompanySelectionOptions _companyOptions = new();
    private Guid? _companyId;
    private string? _error;
    private int _contextVersion;
    private bool _loading = true;

    private List<InvoiceResponse> _items = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _companyOptions = await FinanceService.GetInvoiceCompanyOptionsAsync();
            await CompanyChanged(_companyOptions.CompanyId);
        }
        catch (Exception ex) { _error = ex.Message; _loading = false; }
    }

    private void RecordPayment(Guid invoiceId)
    {
        Navigation.NavigateTo($"/finance/payments/create?invoiceId={invoiceId}");
    }

    private async Task CompanyChanged(Guid? companyId)
    {
        var version = ++_contextVersion;
        _companyId = companyId;
        _items = [];
        _error = null;
        _loading = companyId.HasValue;
        if (!companyId.HasValue) return;
        try
        {
            var items = await FinanceService.GetCompanyInvoicesAsync(companyId);
            if (version == _contextVersion) _items = items;
        }
        catch (Exception ex) { if (version == _contextVersion) _error = ex.Message; }
        finally { if (version == _contextVersion) _loading = false; }
    }

    private void Back()
    {
        Navigation.NavigateTo("/finance/sites");
    }

    private void Open(Guid id)
    {
        Navigation.NavigateTo($"/finance/invoices/{id}");
    }

    private void CreateInvoice()
    {
        Navigation.NavigateTo("/finance/company/invoices/create");
    }

}