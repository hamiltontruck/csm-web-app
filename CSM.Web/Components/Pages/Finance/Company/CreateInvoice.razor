@page "/finance/company/invoices/create"
@rendermode InteractiveServer

@using CSM.Web.Models.Finance
@using CSM.Web.Models.Procurement
@using CSM.Web.Services

@inject IFinanceService FinanceService
@inject IVendorService VendorService
@inject NavigationManager Navigation

<PageTitle>New Company Invoice</PageTitle>

<div class="container py-4">

    <button class="btn btn-outline-secondary mb-3"
            @onclick="Back">
        ← Company Invoices
    </button>

    <h2 class="mb-4">New Company Invoice</h2>

    <EditForm Model="_model" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="card shadow-sm border-0">
            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Invoice Number</label>

                        <InputText class="form-control"
                                   @bind-Value="_model.InvoiceNumber" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Vendor</label>

                        <InputSelect class="form-select"
                                     @bind-Value="_model.VendorId">

                            <option value="">Select Vendor</option>

                            @foreach (var vendor in _vendors)
                            {
                                <option value="@vendor.Id">
                                    @vendor.Name
                                </option>
                            }

                        </InputSelect>
                    </div>



                    <div class="col-md-6">
                        <label class="form-label">Invoice Date</label>

                        <InputDate class="form-control"
                                   @bind-Value="_model.InvoiceDate" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Due Date</label>

                        <InputDate class="form-control"
                                   @bind-Value="_model.DueDate" />
                    </div>

                    <div class="row g-3 mt-1">

                        <div class="col-md-6">
                            <label class="form-label">Currency</label>

                            <InputSelect class="form-select"
                                         @bind-Value="_model.CurrencyCode">
                                <option value="ETB">ETB</option>
                                <option value="USD">USD</option>
                            </InputSelect>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Exchange Rate</label>

                            <InputNumber class="form-control"
                                         @bind-Value="_model.ExchangeRate" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Subtotal</label>

                            <InputNumber class="form-control"
                                         @bind-Value="_model.Subtotal"
                                         @bind-Value:after="CalculateTotal" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Tax Amount</label>

                            <InputNumber class="form-control"
                                         @bind-Value="_model.TaxAmount"
                                         @bind-Value:after="CalculateTotal" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Total Amount</label>

                            <InputNumber class="form-control"
                                         @bind-Value="_model.TotalAmount"
                                         readonly />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Total Amount</label>

                            <InputNumber class="form-control"
                                         @bind-Value="_model.TotalAmount" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Description</label>

                            <InputTextArea class="form-control"
                                           @bind-Value="_model.Description" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">External Reference</label>

                            <InputText class="form-control"
                                       @bind-Value="_model.ExternalReference" />
                        </div>

                    </div>



                </div>

            </div>
        </div>

        <div class="mt-3 d-flex gap-2">

            <button class="btn btn-primary" type="submit">
                Create Invoice
            </button>

            <button class="btn btn-secondary"
                    type="button"
                    @onclick="Back">
                Cancel
            </button>

        </div>

    </EditForm>

</div>

@code {

    private CreateInvoiceRequest _model = new()
    {
        ConstructionSiteId = null,
        ProjectId = null,

        InvoiceDate = DateOnly.FromDateTime(DateTime.Today),
        DueDate = DateOnly.FromDateTime(DateTime.Today.AddDays(30)),

        CurrencyCode = "ETB",
        ExchangeRate = 1m,
        Subtotal = 0,
        TaxAmount = 0,
        TotalAmount = 0
    };

    private List<VendorResponse> _vendors = [];

    protected override async Task OnInitializedAsync()
    {
        _vendors = (await VendorService.GetVendorsAsync()).ToList();
    }

    private void CalculateTotal()
    {
        _model.TotalAmount = _model.Subtotal + _model.TaxAmount;
    }

    private async Task Save()
    {
        var id = await FinanceService.CreateInvoiceAsync(_model);
        Navigation.NavigateTo($"/finance/invoices/{id}");
    }

    private void Back()
    {
        Navigation.NavigateTo("/finance/company/invoices");
    }
}