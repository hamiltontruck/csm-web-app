@page "/finance/company/payments"
@rendermode InteractiveServer

@using CSM.Web.Models.Common
@using CSM.Web.Models.Finance
@using CSM.Web.Services

@inject IFinanceService FinanceService
@inject NavigationManager Navigation

<PageTitle>Company Payments</PageTitle>

<CompanySelector Options="_companyOptions" Value="_companyId" ValueChanged="CompanyChanged" Id="company-finance-selection" />
@if (!string.IsNullOrWhiteSpace(_error)) { <div class="alert alert-danger" role="alert">@_error</div> }
@if (!_companyId.HasValue && !_loading) { <p>Select a company to view its records.</p> }

@if (_loading)
{
    <div class="container py-5 text-center">
        <div class="spinner-border text-success"></div>
    </div>
}
else
{
    <div class="container-fluid py-4">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <button class="btn btn-outline-secondary mb-2"
                        @onclick="Back">
                    ← Finance
                </button>

                <h2 class="mb-0">Company Payments</h2>

                <div class="text-muted">
                    Head Office Payments
                </div>
            </div>

            <WorkspaceAction Route="/finance/payments/create">
                <button class="btn btn-success"
                    @onclick="CreatePayment">
                + New Payment
            </button>
            </WorkspaceAction>

        </div>

        @if (_items.Count == 0)
        {
            <div class="alert alert-info">
                No company payments found.
            </div>
        }
        else
        {
            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>Payment #</th>
                        <th>Date</th>
                        <th>Invoice</th>
                        <th>Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr style="cursor:pointer"
                            @onclick="() => Open(item.Id)">

                            <td>@item.PaymentNumber</td>

                            <td>@item.PaymentDate.ToString("dd MMM yyyy")</td>

                            <td>@item.InvoiceNumber</td>

                            <td>@($"{item.CurrencyCode} {item.Amount:N2}")</td>

                            <td>
                                <span class="badge bg-success">
                                    @item.Status
                                </span>
                            </td>

                        </tr>
                    }
                </tbody>

            </table>
        }

    </div>
}

@code {

    private CompanySelectionOptions _companyOptions = new();
    private Guid? _companyId;
    private string? _error;
    private int _contextVersion;
    private bool _loading = true;

    private List<PaymentResponse> _items = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _companyOptions = await FinanceService.GetPaymentCompanyOptionsAsync();
            await CompanyChanged(_companyOptions.CompanyId);
        }
        catch (Exception ex) { _error = ex.Message; _loading = false; }
    }

    private async Task CompanyChanged(Guid? companyId)
    {
        var version = ++_contextVersion;
        _companyId = companyId;
        _items = [];
        _error = null;
        _loading = companyId.HasValue;
        if (!companyId.HasValue) return;
        try
        {
            var items = await FinanceService.GetCompanyPaymentsAsync(companyId);
            if (version == _contextVersion) _items = items;
        }
        catch (Exception ex) { if (version == _contextVersion) _error = ex.Message; }
        finally { if (version == _contextVersion) _loading = false; }
    }

    private void Back()
    {
        Navigation.NavigateTo("/finance/sites");
    }

    private void Open(Guid id)
    {
        Navigation.NavigateTo($"/finance/payments/{id}");
    }

    private void CreatePayment()
    {
        Navigation.NavigateTo("/finance/payments/create");
    }

}