@page "/finance/company/cost-codes"
@rendermode InteractiveServer

@using System.Text.Json
@using CSM.Web.Models.Finance
@using CSM.Web.Services


@inject IFinanceService FinanceService
@inject IOfflineSyncService OfflineSyncService
@inject NavigationManager Navigation

<PageTitle>Company Cost Codes</PageTitle>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <button class="btn btn-outline-secondary mb-2"
                    @onclick="Back">
                ← Finance
            </button>

            <h2 class="mb-0">Company Cost Codes</h2>

            <div class="text-muted">
                Master cost codes shared across all construction sites
            </div>
        </div>

        <WorkspaceAction Route="/finance/company/cost-codes/create">

            <button class="btn btn-primary"
                @onclick="Create">
            <i class="bi bi-plus-lg"></i>
            New Cost Code
        </button>
            </WorkspaceAction>
    </div>

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else if (_items.Count == 0)
    {
        <div class="alert alert-info">
            No company cost codes found.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Parent</th>
                            <th>Status</th>
                            <th width="180"></th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in _items)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Code</strong>
                                </td>

                                <td>@item.Name</td>

                                <td>@item.ParentCode</td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td>

                                    <WorkspaceAction Route="/finance/company/cost-codes/{id}/edit">

                                        <button class="btn btn-sm btn-outline-primary me-1"
                                            @onclick="() => Edit(item.Id)">
                                        Edit
                                    </button>
            </WorkspaceAction>

                                    <button class="btn btn-sm btn-outline-warning"
                                            @onclick="() => Toggle(item)">
                                        @(item.IsActive ? "Deactivate" : "Activate")
                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            </div>
        </div>
    }

</div>

@code {

    private bool _loading = true;

    private List<CostCodeResponse> _items = new();

    protected override async Task OnInitializedAsync()
    {
        _items = (await FinanceService.GetCostCodesAsync()).ToList();

        _loading = false;
    }

    private void Back()
    {
        Navigation.NavigateTo("/finance/sites");
    }

    private void Create()
    {
        Navigation.NavigateTo("/finance/company/cost-codes/create");
    }

    private void Edit(Guid id)
    {
        Navigation.NavigateTo($"/finance/company/cost-codes/{id}/edit");
    }

    private async Task Toggle(CostCodeResponse item)
    {
        var isActive = !item.IsActive;

        var isOnline =
            await OfflineSyncService.IsOnlineAsync();

        if (isOnline)
        {
            await FinanceService.ChangeCostCodeStatusAsync(
                item.Id,
                isActive);
        }
        else
        {
            var operation =
                new CSM.Web.Models.OfflineSync.OfflineSyncOperation
                {
                    OperationType =
                        CSM.Web.Models.OfflineSync.OfflineSyncOperationType.ChangeStatus,

                    EntityType = "CostCode",

                    EntityId = item.Id.ToString(),

                    PayloadJson =
                        JsonSerializer.Serialize(
                            new
                            {
                                IsActive = isActive
                            })
                };

            await OfflineSyncService.QueueAsync(operation);
        }

        item.IsActive = isActive;
    }

}