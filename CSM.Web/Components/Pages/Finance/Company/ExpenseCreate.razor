@page "/finance/company/expenses/create"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.Finance
@using CSM.Web.Models.Projects
@using CSM.Web.Models.Sites
@using CSM.Web.Models.Procurement
@using CSM.Web.Services

@inject IFinanceService FinanceService
@inject IProjectService ProjectService
@inject IVendorService VendorService
@inject NavigationManager Navigation

<PageTitle>Create Expense</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <button class="btn btn-outline-secondary mb-2"
                    @onclick="Back">
                ← Expenses
            </button>

            <h1 class="mb-1">Create Expense</h1>
            <div class="text-muted">
                Create a company expense record
            </div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-3">Loading expense data...</p>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger">
                @_error
            </div>
        }

        <div class="card border-0 shadow-sm">
            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Expense Number</label>
                        <input class="form-control"
                               @bind="_expenseNumber"
                               placeholder="EXP-0001" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Expense Date</label>
                        <input type="date"
                               class="form-control"
                               @bind="_expenseDate" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Construction Site</label>
                        <select class="form-select"
                                value="@_constructionSiteId"
                                @onchange="OnSiteChanged">

                            <option value="">-- Select Site --</option>

                            @foreach (var site in _sites)
                            {
                                <option value="@site.Id">
                                    @site.SiteCode - @site.Name
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Project</label>
                        <select class="form-select"
                                @bind="_projectId"
                                disabled="@(!_constructionSiteId.HasValue)">

                            <option value="">-- No Project --</option>

                            @foreach (var project in _projects)
                            {
                                <option value="@project.Id">
                                    @project.ProjectCode - @project.Name
                                </option>
                            }
                        </select>

                        @if (!_constructionSiteId.HasValue)
                        {
                            <div class="form-text">
                                Select a construction site to choose a project.
                            </div>
                        }
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Cost Code</label>
                        <select class="form-select"
                                @bind="_costCodeId">

                            <option value="">-- Select Cost Code --</option>

                            @foreach (var costCode in _costCodes)
                            {
                                <option value="@costCode.Id">
                                    @costCode.Code - @costCode.Name
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Vendor</label>
                        <select class="form-select"
                                @bind="_vendorId">

                            <option value="">-- No Vendor --</option>

                            @foreach (var vendor in _vendors.Where(x => x.IsActive))
                            {
                                <option value="@vendor.Id">
                                    @vendor.VendorCode - @vendor.VendorName
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <textarea class="form-control"
                                  rows="3"
                                  @bind="_description"></textarea>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Amount</label>
                        <input type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               @bind="_amount" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Tax Amount</label>
                        <input type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               @bind="_taxAmount" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Currency</label>
                        <input class="form-control"
                               maxlength="3"
                               @bind="_currencyCode" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Exchange Rate</label>
                        <input type="number"
                               step="0.000001"
                               min="0.000001"
                               class="form-control"
                               @bind="_exchangeRate" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Reference Number</label>
                        <input class="form-control"
                               @bind="_referenceNumber" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Receipt Document URL</label>
                        <input class="form-control"
                               @bind="_receiptDocumentUrl" />
                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <button class="btn btn-outline-secondary"
                            @onclick="Back"
                            disabled="@_saving">
                        Cancel
                    </button>

                    <WorkspaceAction Route="/finance/company/expenses/{id}">

                        <button class="btn btn-primary"
                            @onclick="Save"
                            disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Save Expense</span>
                        }
                    </button>
            </WorkspaceAction>
                </div>

            </div>
        </div>
    }

</div>

@code {
    private List<SiteResponse> _sites = new();
    private List<ProjectResponse> _projects = new();
    private List<CostCodeResponse> _costCodes = new();
    private List<VendorResponse> _vendors = new();

    private Guid? _constructionSiteId;
    private Guid? _projectId;
    private Guid? _costCodeId;
    private Guid? _vendorId;

    private string _expenseNumber = string.Empty;
    private DateOnly _expenseDate = DateOnly.FromDateTime(DateTime.Today);
    private string _description = string.Empty;

    private decimal _amount;
    private decimal _taxAmount;

    private string _currencyCode = "ETB";
    private decimal _exchangeRate = 1;

    private string? _referenceNumber;
    private string? _receiptDocumentUrl;

    private bool _loading = true;
    private bool _saving;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _sites = await ProjectService.GetSitesAsync();

            _costCodes =
                (await FinanceService.GetActiveCostCodesAsync())
                .ToList();

            _vendors = await VendorService.GetVendorsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSiteChanged(ChangeEventArgs args)
    {
        _projects.Clear();
        _projectId = null;

        if (!Guid.TryParse(args.Value?.ToString(), out var siteId))
        {
            _constructionSiteId = null;
            return;
        }

        _constructionSiteId = siteId;

        try
        {
            _projects =
                await ProjectService.GetProjectsBySiteAsync(siteId);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task Save()
    {
        _error = null;



        if (!_costCodeId.HasValue)
        {
            _error = "Cost code is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_expenseNumber))
        {
            _error = "Expense number is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_description))
        {
            _error = "Description is required.";
            return;
        }

        if (_amount < 0)
        {
            _error = "Amount cannot be negative.";
            return;
        }

        if (_taxAmount < 0)
        {
            _error = "Tax amount cannot be negative.";
            return;
        }

        if (_exchangeRate <= 0)
        {
            _error = "Exchange rate must be greater than zero.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_currencyCode) ||
            _currencyCode.Trim().Length != 3)
        {
            _error = "Currency code must contain exactly 3 characters.";
            return;
        }

        _saving = true;

        try
        {
            var request = new CreateExpenseRequest(
                _constructionSiteId,
                _projectId,
                _costCodeId.Value,
                _vendorId,
                _expenseNumber.Trim(),
                _expenseDate,
                _description.Trim(),
                _amount,
                _taxAmount,
                _currencyCode.Trim().ToUpperInvariant(),
                _exchangeRate,
                string.IsNullOrWhiteSpace(_referenceNumber)
                    ? null
                    : _referenceNumber.Trim(),
                string.IsNullOrWhiteSpace(_receiptDocumentUrl)
                    ? null
                    : _receiptDocumentUrl.Trim());

            var id =
                await FinanceService.CreateExpenseAsync(request);

            Navigation.NavigateTo(
                $"/finance/company/expenses/{id}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void Back()
    {
        Navigation.NavigateTo("/finance/company/expenses");
    }
}