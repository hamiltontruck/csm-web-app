@page "/finance/company/expenses"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.Finance
@using CSM.Web.Services

@inject IFinanceService FinanceService
@inject NavigationManager Navigation

<PageTitle>Company Expenses</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <button class="btn btn-outline-secondary mb-2"
                    @onclick="Back">
                ← Finance
            </button>

            <h1 class="mb-1">Company Expenses</h1>
            <div class="text-muted">
                Company-wide expense records
            </div>
        </div>

        <WorkspaceAction Route="/finance/company/expenses/create">

            <button class="btn btn-primary"
                @onclick="CreateExpense">
            <i class="bi bi-plus-lg me-1"></i>
            New Expense
        </button>
            </WorkspaceAction>
    </div>

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-3">Loading expenses...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">
            @_error
        </div>
    }
    else if (_expenses.Count == 0)
    {
        <div class="alert alert-info">
            No expenses found.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead>
                            <tr>
                                <th>Expense No.</th>
                                <th>Date</th>
                                <th>Description</th>
                                <th>Amount</th>
                                <th>Tax</th>
                                <th>Currency</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var expense in _expenses)
                            {
                                <tr>
                                    <td>@expense.ExpenseNumber</td>

                                    <td>
                                        @expense.ExpenseDate.ToString("yyyy-MM-dd")
                                    </td>

                                    <td>@expense.Description</td>

                                    <td>
                                        @expense.Amount.ToString("N2")
                                    </td>

                                    <td>
                                        @expense.TaxAmount.ToString("N2")
                                    </td>

                                    <td>@expense.CurrencyCode</td>

                                    <td>
                                        <span class="badge @GetStatusClass(expense.Status)">
                                            @expense.Status
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <WorkspaceAction Route="/finance/company/expenses/{id}">
                                            <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => OpenExpense(expense.Id)">
                                            View
                                        </button>
            </WorkspaceAction>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

            </div>
        </div>
    }

</div>

@code {
    private List<ExpenseResponse> _expenses = new();

    private bool _loading = true;
    private bool _loaded;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
            return;

        _loaded = true;

        try
        {
            _expenses = await FinanceService.GetExpensesAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }

        StateHasChanged();
    }

    private void Back()
    {
        Navigation.NavigateTo("/finance/sites");
    }

    private void CreateExpense()
    {
        Navigation.NavigateTo("/finance/company/expenses/create");
    }

    private void OpenExpense(Guid id)
    {
        Navigation.NavigateTo(
            $"/finance/company/expenses/{id}");
    }

    private static string GetStatusClass(string status)
    {
        return status switch
        {
            "Draft" => "bg-secondary",
            "Submitted" => "bg-warning text-dark",
            "Approved" => "bg-success",
            "Rejected" => "bg-danger",
            "Paid" => "bg-primary",
            "Cancelled" => "bg-dark",
            _ => "bg-secondary"
        };
    }
}