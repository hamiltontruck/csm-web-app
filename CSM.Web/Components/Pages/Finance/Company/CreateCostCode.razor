@page "/finance/company/cost-codes/create"
@rendermode InteractiveServer

@using System.Text.Json
@using Microsoft.JSInterop
@using CSM.Web.Models.Finance
@using CSM.Web.Services

@inject IFinanceService FinanceService
@inject IOfflineSyncService OfflineSyncService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>New Cost Code</PageTitle>

<div class="container py-4">

    <button class="btn btn-outline-secondary mb-3"
            @onclick="Back">
        ← Cost Codes
    </button>

    <h2 class="mb-4">New Company Cost Code</h2>

    <EditForm Model="_model" OnValidSubmit="Save">

        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="card shadow-sm border-0">
            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label">Code</label>

                    <InputText class="form-control"
                               @bind-Value="_model.Code" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Name</label>

                    <InputText class="form-control"
                               @bind-Value="_model.Name" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Parent Cost Code
                    </label>

                    <InputSelect class="form-select"
                                 @bind-Value="_model.ParentCostCodeId">

                        <option value="">None</option>

                        @foreach (var item in _parents)
                        {
                            <option value="@item.Id">
                                @item.Code - @item.Name
                            </option>
                        }

                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Description
                    </label>

                    <InputTextArea class="form-control"
                                   @bind-Value="_model.Description" />
                </div>

            </div>
        </div>

        <div class="mt-3 d-flex gap-2">

            <button class="btn btn-primary" type="submit">
                Save
            </button>

            <button class="btn btn-secondary"
                    type="button"
                    @onclick="Back">
                Cancel
            </button>

        </div>

    </EditForm>

</div>

@code {

    private readonly CreateCostCodeResponse _model = new();

    private List<CostCodeResponse> _parents = [];

    protected override async Task OnInitializedAsync()
    {
        _parents = (await FinanceService.GetActiveCostCodesAsync()).ToList();
    }

    private async Task QueueCostCodeInBrowserAsync()
    {
        await JSRuntime.InvokeVoidAsync(
            "csmOfflineSync.queueCostCodeCreate",
            new
            {
                code = _model.Code,
                name = _model.Name,
                description = _model.Description,
                parentCostCodeId = _model.ParentCostCodeId,
                constructionSiteId = (Guid?)null
            });
    }

    private async Task Save()
    {
        var isOnline =
            await OfflineSyncService.IsOnlineAsync();

        if (isOnline)
        {
            await FinanceService.CreateCostCodeAsync(_model);
        }
        else
        {
            await QueueCostCodeInBrowserAsync();
        }

        Navigation.NavigateTo(
            "/finance/company/cost-codes");
    }

    private void Back()
    {
        Navigation.NavigateTo("/finance/company/cost-codes");
    }

}