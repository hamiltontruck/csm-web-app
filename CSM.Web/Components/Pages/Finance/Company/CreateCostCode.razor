@page "/finance/company/cost-codes/create"
@rendermode InteractiveServer

@using System.Text.Json
@using Microsoft.JSInterop
@using CSM.Web.Models.Finance
@using CSM.Web.Services

@inject IFinanceService FinanceService
@inject IOfflineSyncService OfflineSyncService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject IExecutiveDashboardService DashboardService
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage SessionStorage

<PageTitle>New Cost Code</PageTitle>

<div class="container py-4">

    <button class="btn btn-outline-secondary mb-3"
            @onclick="Back">
        ← Cost Codes
    </button>

    <h2 class="mb-4">New Company Cost Code</h2>

    <EditForm Model="_model" OnValidSubmit="Save">

        <DataAnnotationsValidator />
        <ValidationSummary />

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }
        @if (_canSelectCompany)
        {
            <div class="mb-3">
                <label for="cost-code-company" class="form-label">Company</label>
                <select id="cost-code-company" class="form-select" @bind="_model.CompanyId"
                        @bind:after="CompanyChanged" disabled="@_saving">
                    <option value="">Select a company</option>
                    @foreach (var company in _companies)
                    {
                        <option value="@company.Id">@company.Name</option>
                    }
                </select>
            </div>
        }

        <div class="card shadow-sm border-0">
            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label">Code</label>

                    <InputText class="form-control"
                               @bind-Value="_model.Code" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Name</label>

                    <InputText class="form-control"
                               @bind-Value="_model.Name" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Parent Cost Code
                    </label>

                    <InputSelect class="form-select"
                                 @bind-Value="_model.ParentCostCodeId">

                        <option value="">None</option>

                        @foreach (var item in _parents)
                        {
                            <option value="@item.Id">
                                @item.Code - @item.Name
                            </option>
                        }

                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Description
                    </label>

                    <InputTextArea class="form-control"
                                   @bind-Value="_model.Description" />
                </div>

            </div>
        </div>

        <div class="mt-3 d-flex gap-2">

            <button class="btn btn-primary" type="submit" disabled="@(_initializing || _saving)">
                @(_saving ? "Saving..." : "Save")
            </button>

            <button class="btn btn-secondary"
                    type="button"
                    @onclick="Back">
                Cancel
            </button>

        </div>

    </EditForm>

</div>

@code {

    private readonly CreateCostCodeResponse _model = new();

    private List<CostCodeResponse> _parents = [];

    private List<CostCodeResponse> _allParents = [];
    private IReadOnlyList<CSM.Web.Models.Dashboard.DashboardCompany> _companies = [];
    private bool _initializing = true;
    private bool _saving;
    private bool _canSelectCompany;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var roles = await SessionStorage.GetAsync<List<string>>("roles");
            _canSelectCompany = roles.Success && roles.Value?.Contains("SuperAdmin") == true;
            if (!_canSelectCompany)
                _model.CompanyId = await AuthService.GetCurrentCompanyIdAsync();
            if (_canSelectCompany || !_model.CompanyId.HasValue || _model.CompanyId == Guid.Empty)
            {
                _companies = await DashboardService.GetCompaniesAsync();
                _canSelectCompany = true;
                if (_companies.Count == 1) _model.CompanyId = _companies[0].Id;
            }
            _allParents = (await FinanceService.GetActiveCostCodesAsync()).ToList();
            CompanyChanged();
        }
        catch (Exception ex)
        {
            _error = $"Unable to load cost code options. {ex.Message}";
        }
        finally
        {
            _initializing = false;
            StateHasChanged();
        }
    }

    private void CompanyChanged()
    {
        _model.ParentCostCodeId = null;
        _parents = _allParents.Where(x => x.CompanyId == _model.CompanyId).ToList();
    }

    private async Task QueueCostCodeInBrowserAsync()
    {
        await JSRuntime.InvokeVoidAsync(
            "csmOfflineSync.queueCostCodeCreate",
            new
            {
                companyId = _model.CompanyId,
                code = _model.Code,
                name = _model.Name,
                description = _model.Description,
                parentCostCodeId = _model.ParentCostCodeId,
                constructionSiteId = (Guid?)null
            });
    }

    private async Task Save()
    {
        if (_initializing || _saving) return;
        _error = null;
        if (!_model.CompanyId.HasValue || _model.CompanyId == Guid.Empty)
        {
            _error = "Select a company before creating a cost code.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_model.Code) || string.IsNullOrWhiteSpace(_model.Name))
        {
            _error = "Cost code and name are required.";
            return;
        }

        _saving = true;
        try
        {
            if (await OfflineSyncService.IsOnlineAsync())
                await FinanceService.CreateCostCodeAsync(_model);
            else
                await QueueCostCodeInBrowserAsync();

            Navigation.NavigateTo("/finance/company/cost-codes");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void Back()
    {
        Navigation.NavigateTo("/finance/company/cost-codes");
    }

}