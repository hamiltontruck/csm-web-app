@page "/finance/petty-cash/account/{AccountId:guid}/transactions"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.Finance
@using CSM.Web.Services

@inject IFinanceService FinanceService
@inject NavigationManager Navigation

<PageTitle>Petty Cash Transactions</PageTitle>

<div class="container-fluid py-4">

    <button class="btn btn-outline-secondary mb-3"
            @onclick="Back">
        <i class="bi bi-arrow-left"></i> Back
    </button>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3>Petty Cash Transactions</h3>
            <div class="text-muted">
                Account: @_account?.AccountCode - @_account?.AccountName
            </div>
        </div>

        <WorkspaceAction Route="/finance/petty-cash/account/{AccountId}/transactions/create">
            <button class="btn btn-primary"
                @onclick="Create">
            <i class="bi bi-plus-lg"></i> New Transaction
        </button>
            </WorkspaceAction>
    </div>

    @if (_loading)
    {
        <p>Loading transactions...</p>
    }
    else if (_items.Count == 0)
    {
        <div class="alert alert-info">
            No transactions found for this petty cash account.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Reference</th>
                        <th>Description</th>
                        <th>Cost Code</th>
                        <th>Amount</th>
                        <th>Balance Before</th>
                        <th>Balance After</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                @foreach (var item in _items)
                {
                    <tr>
                        <td>
                            @item.TransactionDateUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td>
                            @if (item.TransactionType.Equals(
                                "CashIn",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-success">
                                    Cash In
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Cash Out
                                </span>
                            }
                        </td>

                        <td>@item.ReferenceNumber</td>

                        <td>@item.Description</td>

                        <td>
                            @(string.IsNullOrWhiteSpace(item.CostCodeName)
                                ? "-"
                                : item.CostCodeName)
                        </td>

                        <td>@item.Amount.ToString("N2")</td>

                        <td>@item.BalanceBefore.ToString("N2")</td>

                        <td>@item.BalanceAfter.ToString("N2")</td>

                        <td>
                            @if (item.IsApproved)
                            {
                                <span class="badge bg-success">
                                    Approved
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid AccountId { get; set; }

    private PettyCashAccountResponse? _account;
    private List<PettyCashTransactionResponse> _items = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _account = await FinanceService.GetPettyCashAccountAsync(AccountId);

        _items = await FinanceService
            .GetPettyCashTransactionsAsync(AccountId);

        _loading = false;
    }

    private void Create()
    {
        Navigation.NavigateTo(
            $"/finance/petty-cash/account/{AccountId}/transactions/create");
    }

    private void Back()
    {
        Navigation.NavigateTo("/finance/petty-cash");
    }
}