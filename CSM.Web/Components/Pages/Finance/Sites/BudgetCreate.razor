@page "/finance/sites/{SiteId:guid}/budgets/create"
@rendermode InteractiveServer

@using CSM.Web.Models.Finance
@using CSM.Web.Models.Projects
@using CSM.Web.Services

@inject IFinanceService FinanceService
@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>New Budget</PageTitle>

<h3 class="mb-4">New Budget</h3>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}
<EditForm Model="_model" OnValidSubmit="Save">
    <fieldset disabled="@(!_ready || _saving)">
    <DataAnnotationsValidator/>

    <div class="row g-3">

        <div class="col-md-4">
            <label class="form-label">Budget No</label>
            <InputText class="form-control"
                       @bind-Value="_model.BudgetNumber"/>
        </div>

        <div class="col-md-8">
            <label class="form-label">Budget Name</label>
            <InputText class="form-control"
                       @bind-Value="_model.Name"/>
        </div>

        <div class="col-md-6">
            <label class="form-label">Project</label>

            <InputSelect class="form-select"
                         @bind-Value="_model.ProjectId">
                <option value="">-- Optional --</option>

                @foreach (var p in _projects)
                {
                    <option value="@p.Id">@p.ProjectCode - @p.Name</option>
                }
            </InputSelect>
        </div>

        <div class="col-md-6">
            <label class="form-label">Currency</label>

            <InputText class="form-control"
                       @bind-Value="_model.CurrencyCode"/>
        </div>

        <div class="col-md-6">
            <label class="form-label">Total Budget</label>

            <InputNumber class="form-control"
                         @bind-Value="_model.TotalAmount"/>
        </div>

        <div class="col-md-3">
            <label class="form-label">Effective From</label>

            <InputDate class="form-control"
                       @bind-Value="_model.EffectiveFrom"/>
        </div>

        <div class="col-md-3">
            <label class="form-label">Effective To</label>

            <InputDate class="form-control"
                       @bind-Value="_model.EffectiveTo"/>
        </div>

        <div class="col-12">
            <label class="form-label">Description</label>

            <InputTextArea class="form-control"
                           @bind-Value="_model.Description"/>
        </div>

    </div>

    <div class="mt-4 d-flex gap-2">
        <button class="btn btn-primary" type="submit">
            Create Budget
        </button>

        <button class="btn btn-outline-secondary"
                type="button"
                @onclick="Back">
            Cancel
        </button>
    </div>
    </fieldset>
</EditForm>

@code {
    [CascadingParameter] private WorkspaceAccess FormAccess { get; set; } = WorkspaceAccess.None;

    [Parameter] public Guid SiteId { get; set; }

    private readonly CreateBudgetModel _model = new();

    private List<ProjectResponse> _projects = new();
    private bool _ready, _saving;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _model.ConstructionSiteId = SiteId;
        try
        {
            _projects = FormAccess.NeedsFinanceFormOptions
                ? (await FinanceService.GetSiteFormOptionsAsync(SiteId, "budget")).Projects
                : await ProjectService.GetProjectsBySiteAsync(SiteId);
            _ready = true;
        }
        catch { _error = "Unable to load budget options. Reload this page to try again."; }
    }

    private async Task Save()
    {
        if (!_ready || _saving) return;
        _saving = true;
        _error = null;
        try
        {
            await FinanceService.CreateBudgetAsync(_model);
            Navigation.NavigateTo($"/finance/sites/{SiteId}/budgets");
        }
        catch (HttpRequestException ex) { _error = ex.Message; }
        catch { _error = "Unable to save this budget. Check the fields and try again."; }
        finally { _saving = false; }
    }

    private void Back()
        => Navigation.NavigateTo($"/finance/sites/{SiteId}/budgets");
}