@page "/finance/sites/{SiteId:guid}/budgets/{Id:guid}/edit"
@page "/finance/company/budgets/{Id:guid}/edit"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.Finance
@using CSM.Web.Services

@inject IFinanceService FinanceService
@inject NavigationManager Navigation

<PageTitle>Edit Budget</PageTitle>

<h3 class="mb-4">Edit Budget</h3>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger">@_error</div>
}
else if (_loading)
{
    <p>Loading budget...</p>
}
else
{
    <EditForm Model="_model" OnValidSubmit="Save">
        <DataAnnotationsValidator/>

        <div class="row g-3">

            <div class="col-md-8">
                <label class="form-label">Budget Name</label>
                <InputText class="form-control"
                           @bind-Value="_model.Name"/>
            </div>

            <div class="col-md-4">
                <label class="form-label">Currency</label>
                <InputText class="form-control"
                           @bind-Value="_model.CurrencyCode"/>
            </div>

            <div class="col-md-6">
                <label class="form-label">Total Amount</label>
                <InputNumber class="form-control"
                             @bind-Value="_model.TotalAmount"/>
            </div>

            <div class="col-md-3">
                <label class="form-label">Effective From</label>
                <InputDate class="form-control"
                           @bind-Value="_model.EffectiveFrom"/>
            </div>

            <div class="col-md-3">
                <label class="form-label">Effective To</label>
                <InputDate class="form-control"
                           @bind-Value="_model.EffectiveTo"/>
            </div>

            <div class="col-12">
                <label class="form-label">Description</label>
                <InputTextArea class="form-control"
                               @bind-Value="_model.Description"/>
            </div>

        </div>

        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-primary" type="submit" disabled="@_saving">
                Save Changes
            </button>

            <button class="btn btn-outline-secondary"
                    type="button"
                    @onclick="Back" disabled="@_saving">
                Cancel
            </button>
        </div>
    </EditForm>
}

@code {
    [Parameter] public Guid SiteId { get; set; }
    [Parameter] public Guid Id { get; set; }

    private readonly UpdateBudgetModel _model = new();

    private Guid? _budgetSiteId;
    private string DetailsPath => _budgetSiteId.HasValue
        ? $"/finance/sites/{_budgetSiteId.Value}/budgets/{Id}"
        : $"/finance/company/budgets/{Id}";

    private Guid? _requestedBudgetId;
    private Guid? _loadedBudgetId;
    private long _loadVersion;
    private bool _saving;
    private bool _loading = true;
    private string? _error;

    protected override void OnParametersSet()
    {
        if (_requestedBudgetId != Id)
        {
            _loading = true;
            _loadedBudgetId = null;
            _error = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_requestedBudgetId == Id) return;
        var requestedId = Id;
        _requestedBudgetId = requestedId;
        var version = ++_loadVersion;
        try
        {
            var budget = await FinanceService.GetBudgetAsync(requestedId);
            if (version != _loadVersion || Id != requestedId) return;
            _budgetSiteId = budget.ConstructionSiteId;
            _model.Name = budget.Name;
            _model.Description = budget.Description;
            _model.TotalAmount = budget.TotalAmount;
            _model.CurrencyCode = budget.CurrencyCode;
            _model.EffectiveFrom = budget.EffectiveFrom;
            _model.EffectiveTo = budget.EffectiveTo;
            _loadedBudgetId = requestedId;
        }
        catch (Exception ex)
        {
            if (version == _loadVersion && Id == requestedId) _error = ex.Message;
        }
        finally
        {
            if (version == _loadVersion && Id == requestedId)
            {
                _loading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task Save()
    {
        if (_saving || _loading || _loadedBudgetId != Id) return;
        _saving = true;
        var savedId = Id;
        var returnPath = DetailsPath;
        var version = _loadVersion;
        var request = new UpdateBudgetModel
        {
            Name = _model.Name,
            Description = _model.Description,
            TotalAmount = _model.TotalAmount,
            CurrencyCode = _model.CurrencyCode,
            EffectiveFrom = _model.EffectiveFrom,
            EffectiveTo = _model.EffectiveTo
        };
        try
        {
            await FinanceService.UpdateBudgetAsync(savedId, request);
            if (version == _loadVersion && Id == savedId) Navigation.NavigateTo(returnPath);
        }
        catch (Exception ex)
        {
            if (version == _loadVersion && Id == savedId) _error = ex.Message;
        }
        finally { _saving = false; }
    }

    private void Back()
    {
        Navigation.NavigateTo(DetailsPath);
    }
}
