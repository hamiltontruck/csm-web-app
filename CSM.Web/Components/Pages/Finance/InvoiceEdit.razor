@page "/finance/invoices/{Id:guid}/edit"
@page "/finance/sites/{SiteId:guid}/invoices/{Id:guid}/edit"

@namespace CSM.Web.Components.Pages.Finance
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.Finance
@using CSM.Web.Models.Projects
@using CSM.Web.Models.Procurement
@using CSM.Web.Services

@inject IFinanceService FinanceService
@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>Edit Invoice</PageTitle>

@if (_loading)
{
    <div class="container py-5 text-center">
        <div class="spinner-border text-primary"></div>
        <p class="mt-3">Loading invoice...</p>
    </div>
}
else if (_loadedInvoiceId != Id)
{
    <div class="alert alert-danger" role="alert">@_error</div>
    <button class="btn btn-outline-secondary" type="button" disabled="@_saving"
                        @onclick="Back">Back</button>
}
else
{
    <div class="container-fluid py-4">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-start mb-4">

            <div>
                <button class="btn btn-outline-secondary mb-3"
                        @onclick="Back">
                    ← Invoice Details
                </button>

                <h2 class="mb-1">Edit Invoice</h2>

                <div class="text-muted">
                    @_invoice.InvoiceNumber
                </div>
            </div>

        </div>

        <EditForm Model="_invoice" OnValidSubmit="Save">

            <DataAnnotationsValidator />
            <ValidationSummary />

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger">@_error</div>
            }

            <div class="card border-0 shadow-sm">
                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">Invoice Number</label>

                            <InputText class="form-control"
                                       @bind-Value="_invoice.InvoiceNumber" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Project</label>

                            <InputSelect class="form-select"
                                         @bind-Value="_invoice.ProjectId">

                                <option value="@Guid.Empty">-- Select Project --</option>

                                @foreach (var project in _projects)
                                {
                                    <option value="@project.Id">@project.Name</option>
                                }

                            </InputSelect>
                        </div>

                       <div class="col-md-6">
                           <label class="form-label">Vendor *</label>

                           <InputSelect TValue="Guid?"
                                        class="form-select"
                                        @bind-Value="_invoice.VendorId">

                               <option value="@((Guid?)null)">-- Select Vendor --</option>

                               @foreach (var vendor in _vendors)
                               {
                                   <option value="@vendor.Id">
                                       @($"{vendor.VendorCode} - {vendor.Name}")
                                   </option>
                               }

                           </InputSelect>
                       </div>

                        <div class="col-md-6">
                            <label class="form-label">Invoice Type</label>

                            <InputSelect TValue="int"
                                         class="form-select"
                                         @bind-Value="_invoice.Type">
                                <option value="2">Vendor Bill</option>
                                <option value="1">Client Invoice</option>
                            </InputSelect>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Currency</label>

                            <InputSelect class="form-select"
                                         @bind-Value="_invoice.CurrencyCode">
                                <option value="ETB">ETB</option>
                                <option value="USD">USD</option>
                            </InputSelect>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Exchange Rate</label>

                            <InputNumber TValue="decimal"
                                         class="form-control"
                                         @bind-Value="_invoice.ExchangeRate" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Invoice Date</label>

                            <InputDate class="form-control"
                                       @bind-Value="_invoice.InvoiceDate" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Due Date</label>

                            <InputDate class="form-control"
                                       @bind-Value="_invoice.DueDate" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Subtotal</label>

                            <InputNumber TValue="decimal"
                                         class="form-control"
                                         @bind-Value="_invoice.Subtotal"
                                         @bind-Value:after="Recalculate" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Tax</label>

                            <InputNumber TValue="decimal"
                                         class="form-control"
                                         @bind-Value="_invoice.TaxAmount"
                                         @bind-Value:after="Recalculate" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Total</label>

                            <input class="form-control"
                                   value="@_invoice.TotalAmount.ToString("N2")"
                                   readonly />
                        </div>

                    </div>

                </div>
            </div>

            <div class="mt-4 d-flex gap-2">

                <button class="btn btn-primary" type="submit" disabled="@_saving">
                    Save Changes
                </button>

                <button class="btn btn-outline-secondary"
                        type="button"
                        @onclick="Back">
                    Cancel
                </button>

            </div>

        </EditForm>

    </div>
}

@code {
    [CascadingParameter] private WorkspaceAccess FormAccess { get; set; } = WorkspaceAccess.None;

    [Parameter] public Guid? SiteId { get; set; }
    [Parameter] public Guid Id { get; set; }

    private UpdateInvoiceRequest _invoice = new();
    private List<ProjectResponse> _projects = new();
    private List<InvoiceVendorOption> _vendors = new();
    private bool _loading = true, _saving;
    private string? _error;
    private Guid? _loadedInvoiceId;
    private int _loadVersion;

    protected override async Task OnParametersSetAsync()
    {
        var requestId = Id;
        var version = ++_loadVersion;
        _loading = true;
        _saving = false;
        _loadedInvoiceId = null;
        _error = null;

        try
        {
            var data = await FinanceService.GetInvoiceAsync(requestId);
            if (!IsCurrent(requestId, version)) return;
            if (data is null) throw new InvalidOperationException("Invoice not found.");

            var vendors = (await FinanceService.GetInvoiceVendorOptionsAsync(requestId)).ToList();
            var projects = data.ConstructionSiteId.HasValue
                ? FormAccess.IsSiteFinanceOfficer
                    ? (await FinanceService.GetSiteFormOptionsAsync(data.ConstructionSiteId.Value, "invoice")).Projects
                    : await ProjectService.GetProjectsBySiteAsync(data.ConstructionSiteId.Value)
                : new List<ProjectResponse>();
            if (!IsCurrent(requestId, version)) return;

            _invoice = new UpdateInvoiceRequest
            {
                InvoiceNumber = data.InvoiceNumber,
                ConstructionSiteId = data.ConstructionSiteId,
                ProjectId = data.ProjectId,
                VendorId = data.VendorId,
                InvoiceDate = DateOnly.FromDateTime(data.InvoiceDate),
                DueDate = data.DueDate is null ? null : DateOnly.FromDateTime(data.DueDate.Value),
                CurrencyCode = data.CurrencyCode,
                ExchangeRate = data.ExchangeRate,
                Type = data.InvoiceType == "ClientInvoice" ? 1 : 2,
                Subtotal = data.Subtotal,
                TaxAmount = data.TaxAmount,
                TotalAmount = data.TotalAmount,
                Description = data.Description,
                ExternalReference = data.ExternalReference
            };
            _vendors = vendors;
            _projects = projects;
            _loadedInvoiceId = requestId;
        }
        catch (Exception ex)
        {
            if (IsCurrent(requestId, version)) _error = ex.Message;
        }
        finally
        {
            if (IsCurrent(requestId, version)) _loading = false;
        }
    }

    private bool IsCurrent(Guid requestId, int version) =>
        Id == requestId && _loadVersion == version;

    private void Recalculate() =>
        _invoice.TotalAmount = _invoice.Subtotal + _invoice.TaxAmount;

    private string DetailsPath => (_loadedInvoiceId == Id ? _invoice.ConstructionSiteId : SiteId) is Guid site
        ? $"/finance/sites/{site}/invoices/{Id}"
        : $"/finance/invoices/{Id}";

    private async Task Save()
    {
        if (_loading || _loadedInvoiceId != Id || _saving) return;
        if (_invoice.ConstructionSiteId.HasValue &&
            (!_invoice.ProjectId.HasValue || _invoice.ProjectId == Guid.Empty))
        {
            _error = "Please select a project.";
            return;
        }
        if (_invoice.Type == 2 && _invoice.VendorId is null)
        {
            _error = "Please select a vendor.";
            return;
        }

        Recalculate();
        var requestId = Id;
        var version = _loadVersion;
        var returnPath = DetailsPath;
        var request = new UpdateInvoiceRequest
        {
            InvoiceNumber = _invoice.InvoiceNumber,
            ConstructionSiteId = _invoice.ConstructionSiteId,
            ProjectId = _invoice.ProjectId,
            VendorId = _invoice.VendorId,
            Type = _invoice.Type,
            InvoiceDate = _invoice.InvoiceDate,
            DueDate = _invoice.DueDate,
            CurrencyCode = _invoice.CurrencyCode,
            ExchangeRate = _invoice.ExchangeRate,
            Subtotal = _invoice.Subtotal,
            TaxAmount = _invoice.TaxAmount,
            TotalAmount = _invoice.TotalAmount,
            Description = _invoice.Description,
            ExternalReference = _invoice.ExternalReference
        };
        _saving = true;
        _error = null;
        try
        {
            await FinanceService.UpdateInvoiceAsync(requestId, request);
            if (IsCurrent(requestId, version)) Navigation.NavigateTo(returnPath);
        }
        catch (Exception ex)
        {
            if (IsCurrent(requestId, version)) _error = ex.Message;
        }
        finally
        {
            if (IsCurrent(requestId, version)) _saving = false;
        }
    }

    private void Back() => Navigation.NavigateTo(DetailsPath);
}
