@page "/finance/invoices/{Id:guid}"
@page "/finance/sites/{siteId:guid}/invoices/{Id:guid}"
@namespace CSM.Web.Components.Pages.Finance
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.Finance
@using CSM.Web.Services

@inject IFinanceService FinanceService
@inject IVendorService VendorService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Invoice Details</PageTitle>

@if (_loading)
{
    <div class="container py-5 text-center">
        <div class="spinner-border text-primary"></div>
        <p class="mt-3">Loading invoice...</p>
    </div>
}
else if (_invoice is null)
{
    <div class="container py-4">
        <div class="alert alert-danger">
            Invoice not found.
        </div>
    </div>
}
else
{
    <div class="container-fluid py-4">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-start mb-4">

            <div>
                <button class="btn btn-outline-secondary mb-3"
                        @onclick="Back">
                    ← Invoices
                </button>

                <h2 class="mb-1">@_invoice.InvoiceNumber</h2>

                <div class="text-muted">
                    @_invoice.InvoiceType
                </div>
            </div>



            <div class="d-flex gap-2">
                <WorkspaceAction Route="{InvoiceBase}/lines/create">
                    <button class="btn btn-success"
                        @onclick="AddLine">
                    + Add Line
                </button>
            </WorkspaceAction>

                <WorkspaceAction Route="/finance/sites/{SiteId.Value}/invoices/{_invoice.Id}/payments/create">

                    <button class="btn btn-success"
                        @onclick="RecordPayment">
                    <i class="bi bi-wallet2"></i> Record Payment
                </button>
            </WorkspaceAction>

                <WorkspaceAction Route="{InvoiceBase}/edit">

                    <button class="btn btn-primary"
                        @onclick="EditInvoice">
                    Edit Invoice
                </button>
            </WorkspaceAction>

                @if (_invoice.Status == "Draft")
                {
                    <button class="btn btn-warning"
                            @onclick="IssueInvoice">
                        Issue Invoice
                    </button>
                }

                @if (_invoice.Status == "Draft" || _invoice.Status == "Issued")
                {
                    <button class="btn btn-danger"
                            @onclick="CancelInvoice">
                        Cancel Invoice
                    </button>
                }
            </div>

        </div>

        <!-- KPI -->
        <div class="row g-3 mb-4">

            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted small">Status</div>
                        <h5>@_invoice.Status</h5>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted small">Vendor / Client</div>
                        <h6>@(_vendorName == "" ? "-" : _vendorName)</h6>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted small">Invoice Date</div>
                        <strong>@_invoice.InvoiceDate.ToString("dd MMM yyyy")</strong>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted small">Due Date</div>
                        <strong>@(_invoice.DueDate?.ToString("dd MMM yyyy") ?? "-")</strong>
                    </div>
                </div>
            </div>

        </div>

        <!-- Amount Summary -->
        <div class="row g-3 mb-4">

            <div class="col-md-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="text-muted small">Total Amount</div>
                        <h3 class="text-primary">
                            @_invoice.CurrencyCode @_invoice.TotalAmount.ToString("N2")
                        </h3>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="text-muted small">Paid Amount</div>
                        <h3 class="text-success">
                            @_invoice.CurrencyCode @_invoice.PaidAmount.ToString("N2")
                        </h3>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="text-muted">Outstanding</div>

                        <h2 class="text-danger">
                            @_invoice.CurrencyCode @((_invoice.TotalAmount - _invoice.PaidAmount).ToString("N2"))
                        </h2>
                    </div>
                </div>
            </div>

        </div>

        <!-- Placeholder -->
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-white">
                <h5 class="mb-0">Invoice Lines</h5>
            </div>

            <div class="card-body p-0">
                @if (_lines.Count == 0)
                {
                    <div class="text-center p-4 text-muted">
                        No invoice lines added.
                    </div>
                }
                else
                {
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th class="text-end">Qty</th>
                                <th>Unit</th>
                                <th class="text-end">Unit Price</th>
                                <th class="text-end">Total</th>
                                <th class="text-center" width="140">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in _lines)
                            {
                                <tr>
                                    <td>@line.Description</td>

                                    <td class="text-end">
                                        @line.Quantity.ToString("N2")
                                    </td>

                                    <td>@line.UnitOfMeasure</td>

                                    <td class="text-end">
                                        @_invoice.CurrencyCode @line.UnitPrice.ToString("N2")
                                    </td>

                                    <td class="text-end fw-semibold">
                                        @_invoice.CurrencyCode @line.LineTotal.ToString("N2")
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <WorkspaceAction Route="/finance/sites/{SiteId.Value}/invoices/{Id}/lines/{lineId}/edit">
                                                <button class="btn btn-outline-primary"
                                                    @onclick="() => EditLine(line.Id)">
                                                Edit
                                            </button>
            </WorkspaceAction>

                                             <button class="btn btn-outline-dark"
                                                     @onclick="PrintInvoice">
                                                 <i class="bi bi-printer"></i> Print
                                             </button>

                                            <button class="btn btn-outline-danger"
                                                    @onclick="() => DeleteLine(line.Id)">
                                                Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="card shadow-sm mt-4">
            <div class="card-header fw-bold">
                Payment History
            </div>

            @if (_invoice.Payments.Count == 0)
            {
                <div class="card-body text-center text-muted">
                    No payments recorded.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Payment No.</th>
                                <th>Method</th>
                                <th>Status</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var payment in _invoice.Payments)
                            {
                                <tr style="cursor:pointer"
                                    @onclick="() => OpenPayment(payment.Id)">

                                    <td>@payment.PaymentDate.ToString("dd MMM yyyy")</td>

                                    <td class="fw-semibold">
                                        @payment.PaymentNumber
                                    </td>

                                    <td>@payment.PaymentMethod</td>

                                    <td>
                                        @switch (payment.Status)
                                        {
                                            case "Pending":
                                                <span class="badge bg-warning text-dark">Pending</span>
                                                break;

                                            case "Completed":
                                                <span class="badge bg-success">Completed</span>
                                                break;

                                            case "Reversed":
                                                <span class="badge bg-dark">Reversed</span>
                                                break;

                                            default:
                                                <span class="badge bg-secondary">@payment.Status</span>
                                                break;
                                        }
                                    </td>

                                    <td class="text-end fw-semibold">
                                        @payment.CurrencyCode @payment.Amount.ToString("N2")
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>
}

@code {

    [Parameter]
        public Guid Id { get; set; }

        [Parameter]
        public Guid? SiteId { get; set; }

        private InvoiceResponse? _invoice;
        private List<InvoiceLineResponse> _lines = new();

        private bool _loading = true;
        private bool _loaded;
        private string? _error;
        private string _vendorName = "";

        private decimal Outstanding =>
            _invoice is null ? 0 : _invoice.TotalAmount - _invoice.PaidAmount;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
            return;

        _loaded = true;

        try
        {
            _invoice = await FinanceService.GetInvoiceAsync(Id);
            _lines = await FinanceService.GetInvoiceLinesAsync(Id);

            if (_invoice?.VendorId != null)
            {
                var vendors = await VendorService.GetVendorsAsync();

                _vendorName = vendors
                    .FirstOrDefault(v => v.Id == _invoice.VendorId)?
                    .Name ?? "";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }

        StateHasChanged();
    }

    private string InvoiceBase =>
        SiteId.HasValue
            ? $"/finance/sites/{SiteId.Value}/invoices/{Id}"
            : $"/finance/invoices/{Id}";

    private void AddLine()
    {
        Navigation.NavigateTo($"{InvoiceBase}/lines/create");
    }

    private void EditLine(Guid lineId)
    {
        if (SiteId.HasValue)
            Navigation.NavigateTo($"/finance/sites/{SiteId.Value}/invoices/{Id}/lines/{lineId}/edit");
        else
            Navigation.NavigateTo($"/finance/invoices/{Id}/lines/{lineId}/edit");
    }

    private void EditInvoice()
    {
        Navigation.NavigateTo($"{InvoiceBase}/edit");
    }

    private async Task PrintInvoice()
    {
        var pdf = await FinanceService.DownloadInvoicePdfAsync(Id);

        await JS.InvokeVoidAsync(
            "downloadPdf",
            $"Invoice-{_invoice?.InvoiceNumber ?? "Invoice"}.pdf",
            Convert.ToBase64String(pdf));
    }

    private void RecordPayment()
    {
        if (_invoice is null)
            return;

        if (SiteId.HasValue)
        {
            Console.WriteLine($"Navigate URL = /finance/payments/create?invoiceId={_invoice.Id}");
            Navigation.NavigateTo(
                $"/finance/sites/{SiteId.Value}/invoices/{_invoice.Id}/payments/create");
        }
        else
        {
            Navigation.NavigateTo(
                $"/finance/payments/create?invoiceId={_invoice.Id}");
        }
    }

    private void OpenPayment(Guid paymentId)
    {
        if (SiteId.HasValue)
            Navigation.NavigateTo($"/finance/sites/{SiteId.Value}/payments/{paymentId}");
        else
            Navigation.NavigateTo($"/finance/payments/{paymentId}");
    }

    private async Task IssueInvoice()
    {
        await FinanceService.IssueInvoiceAsync(Id);
        _invoice = await FinanceService.GetInvoiceAsync(Id);
        StateHasChanged();
    }

    private async Task CancelInvoice()
    {
        await FinanceService.CancelInvoiceAsync(Id);
        _invoice = await FinanceService.GetInvoiceAsync(Id);
        StateHasChanged();
    }

    private async Task DeleteLine(Guid lineId)
    {
        await FinanceService.DeleteInvoiceLineAsync(lineId);

        _invoice = await FinanceService.GetInvoiceAsync(Id);
        _lines = await FinanceService.GetInvoiceLinesAsync(Id);

        StateHasChanged();
    }

    private void Back()
    {
        if (SiteId.HasValue)
            Navigation.NavigateTo($"/finance/sites/{SiteId.Value}/invoices");
        else
            Navigation.NavigateTo("/finance/company/invoices");
    }
}