@page "/finance/payments/create"
@page "/finance/sites/{SiteId:guid}/payments/create"
@page "/finance/sites/{SiteId:guid}/invoices/{InvoiceId:guid}/payments/create"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.Finance
@using CSM.Web.Models.Procurement
@using CSM.Web.Models.HRM
@using CSM.Web.Services
@using Microsoft.AspNetCore.Components

@inject IFinanceService FinanceService
@inject IPayrollService PayrollService
@inject NavigationManager Navigation

<PageTitle>Record Payment</PageTitle>

@if (_loading)
{
    <div class="container py-5 text-center">
        <div class="spinner-border text-primary"></div>
        <p class="mt-3">Loading payment information...</p>
    </div>
}
else
{
    <div class="container py-4">

        <button class="btn btn-outline-secondary mb-3"
                disabled="@_saving"
                @onclick="Back">
            ← Invoice Details
        </button>

        <h2>Record Payment</h2>
        <p class="text-muted mb-4">@_invoiceNumber</p>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }

        <EditForm Model="_payment" OnValidSubmit="Save">
            <DataAnnotationsValidator />

            <div class="card shadow-sm mb-4">
                <div class="card-header fw-bold">
                    Payment Information
                </div>

                <div class="card-body">
                    <div class="row g-3">

                        <div class="col-md-4">
                            <label class="form-label">Payment Source</label>

                            <InputSelect class="form-select"
                                         disabled="@_saving"
                                         @bind-Value="_paymentSource"
                                         @bind-Value:after="PaymentSourceChanged">
                                @if (_canUsePayroll || InvoiceId.HasValue)
                                {
                                    <option value="Invoice">Invoice</option>
                                }
                                @if (_canUsePayroll)
                                {
                                    <option value="Payroll">Payroll</option>
                                }
                                @if (!InvoiceId.HasValue && SiteId.HasValue)
                                {
                                    <option value="Direct">Direct site payment</option>
                                }
                            </InputSelect>
                        </div>

                        @if (_paymentSource == "Payroll")
                        {
                            <div class="col-md-8">
                                <label class="form-label">Approved Payroll</label>

                                <InputSelect class="form-select"
                                             @bind-Value="_selectedPayrollId"
                                             @bind-Value:after="PayrollChanged">

                                    <option value="">-- Select approved payroll --</option>

                                    @foreach (var payroll in _approvedPayrolls)
                                    {
                                        <option value="@payroll.Id">
                                            @payroll.EmployeeNumber -
                                            @payroll.EmployeeName -
                                            @payroll.PeriodStart.ToString("yyyy-MM-dd") to
                                            @payroll.PeriodEnd.ToString("yyyy-MM-dd") -
                                            @payroll.CurrencyCode
                                            @payroll.NetPay.ToString("N2")
                                        </option>
                                    }
                                </InputSelect>
                            </div>

                            @if (_selectedPayroll is not null)
                            {
                                <div class="col-12">
                                    <div class="alert alert-info mb-0">
                                        <strong>@_selectedPayroll.EmployeeName</strong>
                                        (@_selectedPayroll.EmployeeNumber)

                                        <br />

                                        Payroll Period:
                                        @_selectedPayroll.PeriodStart.ToString("yyyy-MM-dd")
                                        –
                                        @_selectedPayroll.PeriodEnd.ToString("yyyy-MM-dd")

                                        <br />

                                        Gross Pay:
                                        @_selectedPayroll.CurrencyCode
                                        @_selectedPayroll.GrossPay.ToString("N2")

                                        <br />

                                        Net Pay:
                                        @_selectedPayroll.CurrencyCode
                                        @_selectedPayroll.NetPay.ToString("N2")

                                        <br />

                                        Status: @_selectedPayroll.Status
                                    </div>
                                </div>
                            }
                        }

                        @if (_paymentSource == "Invoice")
                        {
                            <div class="col-md-6">
                                <label class="form-label">Vendor</label>
                                <InputText class="form-control"
                                           @bind-Value="_vendorName"
                                           disabled />
                            </div>
                        }

                        <div class="col-md-3">
                            <label class="form-label">Direction</label>

                            <InputSelect TValue="int"
                                         class="form-select"
                                         @bind-Value="_payment.Direction">

                                <option value="1">Incoming</option>
                                <option value="2">Outgoing</option>

                            </InputSelect>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Currency</label>
                            <InputText class="form-control"
                                       @bind-Value="_payment.CurrencyCode"
                                       disabled="@(_paymentSource != "Direct")" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Payment Number *</label>
                            <InputText class="form-control"
                                       placeholder="Enter payment number"
                                       @bind-Value="_paymentNumber" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Payment Date</label>
                            <InputDate class="form-control"
                                       @bind-Value="_payment.PaymentDate" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Amount</label>
                            <InputNumber class="form-control"
                                         @bind-Value="_payment.Amount" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Method</label>
                            <InputSelect class="form-select"
                                         @bind-Value="_payment.PaymentMethod">
                                <option>Cash</option>
                                <option>Bank Transfer</option>
                                <option>Cheque</option>
                                <option>Mobile Money</option>
                            </InputSelect>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Reference Number</label>
                            <InputText class="form-control"
                                       @bind-Value="_payment.ReferenceNumber" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Exchange Rate</label>
                            <InputNumber class="form-control"
                                         @bind-Value="_payment.ExchangeRate" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Notes</label>
                            <InputTextArea class="form-control"
                                           rows="3"
                                           @bind-Value="_payment.Notes"
                                   @oninput="e => _payment.Notes = e.Value?.ToString() ?? string.Empty" />
                        </div>

                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-success" type="submit" disabled="@(!_ready || _saving)">
                    Save Payment
                </button>

                <button class="btn btn-secondary"
                        type="button"
                        disabled="@_saving"
                @onclick="Back">
                    Cancel
                </button>
            </div>

        </EditForm>

    </div>
}

@code {
    [CascadingParameter] private WorkspaceAccess FormAccess { get; set; } = WorkspaceAccess.None;

    [Parameter] public Guid? SiteId { get; set; }
    [Parameter, SupplyParameterFromQuery] public Guid? InvoiceId { get; set; }

    private CreatePaymentRequest _payment = new();
    private InvoiceResponse? _invoice;
    private string _invoiceNumber = "", _vendorName = "", _paymentNumber = "";
    private string _paymentSource = "Invoice";
    private IReadOnlyCollection<PayrollResponse> _approvedPayrolls = [];
    private Guid? _selectedPayrollId;
    private PayrollResponse? _selectedPayroll;
    private string? _error;
    private bool _loading = true, _ready, _saving;
    private int _contextVersion;
    private bool _canUsePayroll = true;

    protected override async Task OnParametersSetAsync()
    {
        var version = ++_contextVersion;
        _loading = true;
        _ready = _saving = false;
        _error = null;
        _invoice = null;
        _invoiceNumber = _vendorName = _paymentNumber = "";
        _selectedPayrollId = null;
        _selectedPayroll = null;
        _approvedPayrolls = [];
        _payment = NewPayment();

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("invoiceId", out var value) && Guid.TryParse(value.ToString(), out var id))
            InvoiceId = id;

        try
        {
            _canUsePayroll = !FormAccess.IsIn("FinanceOfficer");
            if (FormAccess.IsIn("FinanceOfficer"))
            {
                var capability = await FinanceService.GetActionCapabilitiesAsync("payment");
                if (version != _contextVersion) return;
                _canUsePayroll = capability.CanUsePayroll;
            }
            _paymentSource = InvoiceId.HasValue ? "Invoice" : _canUsePayroll ? "Payroll" : "Direct";
            if (InvoiceId.HasValue) await LoadInvoice(version);
            else if (_paymentSource == "Direct") await LoadDirectSite(version);
            else await LoadApprovedPayrolls(version);
        }
        catch (Exception ex)
        {
            if (version == _contextVersion) _error = ex.Message;
        }
        finally
        {
            if (version == _contextVersion) _loading = false;
        }
    }

    private CreatePaymentRequest NewPayment() => new()
    {
        PaymentDate = DateOnly.FromDateTime(DateTime.Today),
        ExchangeRate = 1,
        Direction = 2,
        ConstructionSiteId = SiteId,
        PaymentMethod = "Cash"
    };

    private async Task LoadInvoice(int version)
    {
        if (!InvoiceId.HasValue) throw new InvalidOperationException("Open an invoice to record its payment.");
        var invoiceId = InvoiceId.Value;
        var invoice = await FinanceService.GetInvoiceAsync(invoiceId)
            ?? throw new InvalidOperationException("Invoice not found.");
        var vendorName = "";
        if (invoice.VendorId.HasValue)
        {
            var vendors = await FinanceService.GetInvoiceVendorOptionsAsync(invoice.Id);
            vendorName = vendors.FirstOrDefault(v => v.Id == invoice.VendorId)?.Name ?? "";
        }
        if (version != _contextVersion) return;

        _invoice = invoice;
        _invoiceNumber = invoice.InvoiceNumber;
        _vendorName = vendorName;
        _payment = NewPayment();
        _payment.InvoiceId = invoice.Id;
        _payment.ProjectId = invoice.ProjectId;
        _payment.VendorId = invoice.VendorId;
        _payment.CurrencyCode = invoice.CurrencyCode;
        _payment.ExchangeRate = invoice.ExchangeRate;
        _payment.Amount = invoice.TotalAmount - invoice.PaidAmount;
        _payment.Direction = invoice.InvoiceType == "ClientInvoice" ? 1 : 2;
        _payment.ConstructionSiteId = invoice.ConstructionSiteId;
        _ready = true;
    }

    private async Task LoadDirectSite(int version)
    {
        if (!SiteId.HasValue) throw new InvalidOperationException("Select a finance site to record its payment.");
        var options = await FinanceService.GetSiteFormOptionsAsync(SiteId.Value, "payment");
        if (version != _contextVersion) return;
        _invoiceNumber = options.SiteName;
        _payment.ConstructionSiteId = options.SiteId;
        _ready = true;
    }

    private async Task LoadApprovedPayrolls(int version)
    {
        if (!_canUsePayroll) throw new InvalidOperationException("Payroll payments require separate payroll authority.");
        var payrolls = await PayrollService.GetAllAsync();
        if (version != _contextVersion) return;
        _approvedPayrolls = payrolls
            .Where(x => string.Equals(x.Status, "Approved", StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(x => x.PeriodStart)
            .ThenBy(x => x.EmployeeNumber)
            .ToArray();
        _ready = true;
    }

    private async Task PaymentSourceChanged()
    {
        if (_saving) return;
        var version = ++_contextVersion;
        _error = null;
        _ready = false;
        _selectedPayrollId = null;
        _selectedPayroll = null;
        _payment = NewPayment();
        _vendorName = _invoiceNumber = "";
        try
        {
            if (_paymentSource == "Invoice") await LoadInvoice(version);
            else if (_paymentSource == "Direct") await LoadDirectSite(version);
            else await LoadApprovedPayrolls(version);
        }
        catch (Exception ex)
        {
            if (version == _contextVersion) _error = ex.Message;
        }
    }

    private Task PayrollChanged()
    {
        _selectedPayroll = _selectedPayrollId.HasValue
            ? _approvedPayrolls.FirstOrDefault(x => x.Id == _selectedPayrollId.Value)
            : null;
        _payment.PayrollRecordId = _selectedPayroll?.Id;
        _payment.InvoiceId = _payment.VendorId = _payment.ProjectId = null;
        _payment.Direction = 2;
        _payment.Amount = _selectedPayroll?.NetPay ?? 0;
        if (_selectedPayroll is not null) _payment.CurrencyCode = _selectedPayroll.CurrencyCode;
        return Task.CompletedTask;
    }

    private async Task Save()
    {
        if (_loading || !_ready || _saving) return;
        _error = null;
        if ((_paymentSource == "Payroll" && !_canUsePayroll) || (_paymentSource == "Direct" && !SiteId.HasValue))
        {
            _error = "Open an assigned finance site to record a payment.";
            return;
        }
        if (_paymentSource == "Payroll" && !_payment.PayrollRecordId.HasValue)
        {
            _error = "Approved payroll must be selected.";
            return;
        }
        if (_paymentSource == "Invoice" &&
            (!InvoiceId.HasValue || _payment.InvoiceId != InvoiceId || _invoice?.Id != InvoiceId))
        {
            _error = "Open an invoice to record its payment.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_paymentNumber))
        {
            _error = "Payment Number is required.";
            return;
        }
        if (_payment.Amount <= 0)
        {
            _error = "Amount must be greater than zero.";
            return;
        }

        var version = _contextVersion;
        var request = new CreatePaymentRequest
        {
            ConstructionSiteId = _payment.ConstructionSiteId,
            ProjectId = _payment.ProjectId,
            InvoiceId = _payment.InvoiceId,
            VendorId = _payment.VendorId,
            PayrollRecordId = _payment.PayrollRecordId,
            PaymentNumber = _paymentNumber.Trim(),
            PaymentDate = _payment.PaymentDate,
            Direction = _payment.Direction,
            Amount = _payment.Amount,
            CurrencyCode = _payment.CurrencyCode,
            ExchangeRate = _payment.ExchangeRate,
            PaymentMethod = _payment.PaymentMethod,
            ReferenceNumber = _payment.ReferenceNumber,
            Notes = _payment.Notes
        };
        _saving = true;
        try
        {
            var paymentId = await FinanceService.CreatePaymentAsync(request);
            if (version != _contextVersion) return;
            Navigation.NavigateTo(request.ConstructionSiteId is Guid site
                ? $"/finance/sites/{site}/payments/{paymentId}"
                : $"/finance/payments/{paymentId}");
        }
        catch (Exception ex)
        {
            if (version == _contextVersion) _error = ex.Message;
        }
        finally
        {
            if (version == _contextVersion) _saving = false;
        }
    }

    private void Back()
    {
        var siteId = _invoice is not null ? _invoice.ConstructionSiteId : SiteId;
        if (InvoiceId.HasValue)
        {
            Navigation.NavigateTo(siteId is Guid site
                ? $"/finance/sites/{site}/invoices/{InvoiceId.Value}"
                : $"/finance/invoices/{InvoiceId.Value}");
            return;
        }
        Navigation.NavigateTo(siteId is Guid paymentSite
            ? $"/finance/sites/{paymentSite}/payments"
            : "/finance/company/payments");
    }
}
