@page "/finance/petty-cash/create"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using CSM.Web.Models.Finance
@using CSM.Web.Models.Sites
@using CSM.Web.Services

@inject IFinanceService FinanceService
@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>New Petty Cash Account</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <button class="btn btn-outline-secondary mb-2"
                    @onclick="Back">
                <i class="bi bi-arrow-left"></i> Back
            </button>

            <h3>New Petty Cash Account</h3>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
        @if (!_ready)
        {
            <button type="button" class="btn btn-outline-secondary mb-3" @onclick="LoadOptionsAsync" disabled="@_loading">Retry loading sites</button>
        }
    }
    @if (_loading)
    {
        <p>Loading construction sites...</p>
    }
    else
    {
        <EditForm Model="_form" OnValidSubmit="Save">
            <fieldset disabled="@(!_ready || _saving)">

            <DataAnnotationsValidator />

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label">Construction Site</label>

                    <select class="form-select"
                            @bind="_form.ConstructionSiteId">

                        <option value="">@(_requiresSite ? "-- Select assigned site --" : "-- Company Level --")</option>

                        @foreach (var site in _sites)
                        {
                            <option value="@site.Id">
                                @site.SiteCode - @site.Name
                            </option>
                        }

                    </select>

                    <div class="form-text">
                        @(_requiresSite ? "Choose an assigned construction site." : "Leave as Company Level for a company-wide petty cash account.")
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Account Code</label>

                    <InputText class="form-control"
                               @bind-Value="_form.AccountCode" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Opening Balance</label>

                  <InputNumber TValue="decimal"
                               class="form-control"
                               @bind-Value="_form.OpeningBalance" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Account Name</label>

                    <InputText class="form-control"
                               @bind-Value="_form.AccountName" />
                </div>

            </div>

            <div class="mt-4 d-flex gap-2">

                <button class="btn btn-primary"
                        type="submit">
                    Create Account
                </button>

                <button class="btn btn-outline-secondary"
                        type="button"
                        @onclick="Back">
                    Cancel
                </button>

            </div>

            </fieldset>
        </EditForm>
    }
</div>

@code {
    [CascadingParameter] private WorkspaceAccess FormAccess { get; set; } = WorkspaceAccess.None;



    private List<SiteResponse> _sites = new();



    private bool _loading = true;
    private bool _ready, _saving, _requiresSite;
    private string? _error;

    private sealed class PettyCashAccountForm
    {
        public string AccountCode { get; set; } = string.Empty;
        public string AccountName { get; set; } = string.Empty;
        public decimal OpeningBalance { get; set; }
        public Guid? ConstructionSiteId { get; set; }
    }

    private readonly PettyCashAccountForm _form = new();

    protected override Task OnInitializedAsync() => LoadOptionsAsync();

    private async Task LoadOptionsAsync()
    {
        _loading = true; _ready = false; _error = null;
        try
        {
            _requiresSite = FormAccess.IsIn("FinanceOfficer") &&
                !(await FinanceService.GetActionCapabilitiesAsync("petty-cash")).IncludesCompany;
            _sites = await ProjectService.GetSitesAsync();
            if (_requiresSite && _sites.Count == 1) _form.ConstructionSiteId = _sites[0].Id;
            if (_form.ConstructionSiteId.HasValue && !_sites.Any(x => x.Id == _form.ConstructionSiteId))
                _form.ConstructionSiteId = null;
            _ready = true;
        }
        catch { _error = "Unable to load petty cash options. Retry loading sites."; }
        finally { _loading = false; }
    }

    private async Task Save()
    {
        if (_saving || !_ready) return;
        _error = null;
        if (_requiresSite && (!_form.ConstructionSiteId.HasValue || !_sites.Any(x => x.Id == _form.ConstructionSiteId)))
        {
            _error = "Choose an assigned construction site.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_form.AccountCode) || string.IsNullOrWhiteSpace(_form.AccountName))
        {
            _error = "Enter an account code and account name.";
            return;
        }
        _saving = true;
        try
        {
            var request = new CreatePettyCashAccountRequest(_form.ConstructionSiteId, _form.AccountCode.Trim(), _form.AccountName.Trim(), _form.OpeningBalance);
            await FinanceService.CreatePettyCashAccountAsync(request);
            Back();
        }
        catch { _error = "Unable to create this petty cash account. Check the account code and site, then try again."; }
        finally { _saving = false; }
    }

    private void Back()
    {
        Navigation.NavigateTo(_requiresSite
            ? _form.ConstructionSiteId is Guid site ? $"/finance/petty-cash/site/{site}" : "/finance/sites"
            : "/finance/petty-cash");
    }
}
