@page "/goods-receipts/create/{SiteId:guid}"
@rendermode InteractiveServer


@using CSM.Web.Models.Procurement
@using CSM.Web.Services

@inject IProcurementService ProcurementService
@inject NavigationManager Navigation

<PageTitle>New Goods Receipt</PageTitle>

<h2 class="mb-4">New Goods Receipt</h2>

@if (loading)
{
    <div class="alert alert-info">Loading...</div>
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}
@if (!loading && !loaded)
{
    <button id="retry-goods-receipt" class="btn btn-primary" @onclick="LoadAsync">Retry</button>
}
@if (!loading && loaded)
{
    <EditForm Model="@request"
              OnValidSubmit="@Save"
              FormName="GoodsReceiptCreateForm">

        <fieldset disabled="@saving">
        <DataAnnotationsValidator/>

        <div class="card shadow-sm mb-4">
            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Receipt Number</label>

                        <InputText class="form-control"
                                   @bind-Value="request.ReceiptNumber" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Receipt Date</label>
                        <InputDate class="form-control"
                                   @bind-Value="request.ReceivedAtUtc"/>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Purchase Order</label>

                        <select class="form-select" value="@request.PurchaseOrderId" @onchange="PurchaseOrderChanged">
                            <option value="">-- Select Purchase Order --</option>

                            @foreach (var po in purchaseOrders)
                            {
                                <option value="@po.Id">@po.PurchaseOrderNumber</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Delivery Note</label>
                        <InputText class="form-control"
                                   @bind-Value="request.DeliveryNoteNumber"/>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Vehicle Plate</label>
                        <InputText class="form-control"
                                   @bind-Value="request.VehiclePlateNumber"/>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Remarks</label>
                        <InputTextArea class="form-control"
                                       rows="3"
                                       @bind-Value="request.Remarks"/>
                    </div>

                </div>

            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0">Received Materials</h5>
            </div>

            <div class="card-body">

                @foreach (var line in receiptLines)
                {
                    <div class="row g-3 align-items-end mb-3">

                        <div class="col-md-5">
                            <label class="form-label">Material</label>

                            <input class="form-control"
                                   value="@line.MaterialName"
                                   readonly />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Ordered</label>
                            <input class="form-control"
                                   value="@line.OrderedQuantity"
                                   readonly />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Received Qty</label>
                            <InputNumber TValue="decimal"
                                         class="form-control"
                                         Value="line.ReceivedQuantity"
                                         ValueChanged="@( (decimal v) => UpdateReceived(line, v) )"
                                         ValueExpression="() => line.ReceivedQuantity" />
                        </div>

                    </div>
                }

            </div>

            <div class="card-footer text-end">

                <button type="button"
                        class="btn btn-secondary me-2"
                        @onclick="Cancel">
                    Cancel
                </button>

                <button class="btn btn-success"
                        type="submit" disabled="@(saving || loadingOrder)">
                    @(saving ? "Saving..." : "Save Goods Receipt")
                </button>

            </div>

        </div>

        </fieldset>
    </EditForm>
}

@code {
    [Parameter] public Guid SiteId { get; set; }

    private bool loading = true;





    private List<PurchaseOrderResponse> purchaseOrders = [];
        private List<GoodsReceiptLineRequest> receiptLines = [];

    private CreateGoodsReceiptRequest request = new()
    {
        ReceivedAtUtc = DateTime.UtcNow
    };

    private void UpdateReceived(GoodsReceiptLineRequest line, decimal value)
    {
        line.ReceivedQuantity = value;
        line.AcceptedQuantity = value;
        line.RejectedQuantity = 0;
    }

    private bool loaded, saving, loadingOrder;
    private int selectionVersion;
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        loaded = false;
        errorMessage = null;
        try
        {
            purchaseOrders = (await ProcurementService.GetReceivablePurchaseOrdersAsync())
                .Where(x => x.ConstructionSiteId == SiteId)
                .OrderByDescending(x => x.OrderDate).ToList();
            loaded = true;
        }
        catch (HttpRequestException ex)
        {
            errorMessage = AccessError(ex, "Unable to load purchase orders. Please try again.");
        }
        catch (Exception)
        {
            errorMessage = "Unable to load purchase orders. Please try again.";
        }
        finally
        {
            loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PurchaseOrderChanged(ChangeEventArgs e)
    {
        if (saving) return;
        var version = ++selectionVersion;
        receiptLines.Clear();
        errorMessage = null;
        request.PurchaseOrderId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : Guid.Empty;
        if (request.PurchaseOrderId == Guid.Empty)
        {
            loadingOrder = false;
            return;
        }
        var poId = request.PurchaseOrderId;
        loadingOrder = true;
        try
        {
            var po = await ProcurementService.GetPurchaseOrderAsync(poId);
            if (version != selectionVersion) return;
            if (po is null || po.Id != poId || po.ConstructionSiteId != SiteId)
            {
                errorMessage = "The selected purchase order is unavailable for this site.";
                return;
            }
            receiptLines = po.Lines.Select(line => new GoodsReceiptLineRequest
            {
                PurchaseOrderLineId = line.Id,
                MaterialId = line.MaterialId,
                MaterialName = line.MaterialName,
                OrderedQuantity = line.OrderedQuantity
            }).ToList();
        }
        catch (HttpRequestException ex)
        {
            if (version == selectionVersion)
                errorMessage = AccessError(ex, "Unable to load purchase order details. Select the purchase order again to retry.");
        }
        catch (Exception)
        {
            if (version == selectionVersion)
                errorMessage = "Unable to load purchase order details. Select the purchase order again to retry.";
        }
        finally
        {
            if (version == selectionVersion) loadingOrder = false;
        }
    }

    private static string AccessError(HttpRequestException ex, string fallback) => ex.StatusCode switch
    {
        System.Net.HttpStatusCode.Unauthorized => "Your session has expired. Please sign in again.",
        System.Net.HttpStatusCode.Forbidden => "You do not have permission to record goods receipts.",
        _ => fallback
    };

    private async Task Save()
    {
        if (saving || loading || loadingOrder || !loaded) return;
        errorMessage = null;
        request.ConstructionSiteId = SiteId;
        request.Lines = receiptLines.Where(x => x.ReceivedQuantity > 0).ToList();
        if (request.PurchaseOrderId == Guid.Empty)
        {
            errorMessage = "Select a Purchase Order first.";
            return;
        }
        if (request.Lines.Count == 0)
        {
            errorMessage = "Enter at least one received quantity.";
            return;
        }
        saving = true;
        try
        {
            await ProcurementService.CreateGoodsReceiptAsync(request);
            Navigation.NavigateTo($"/goods-receipts/site/{SiteId}", true);
        }
        catch (GoodsReceiptValidationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException ex)
        {
            errorMessage = AccessError(ex, ex.StatusCode == System.Net.HttpStatusCode.BadRequest
                ? "Unable to save receipt. Check the receipt details and try again."
                : "Unable to save receipt. Check the receipts list before trying again.");
        }
        catch (Exception)
        {
            errorMessage = "Unable to save receipt. Check the receipts list before trying again.";
        }
        finally { saving = false; }
    }

    private void Cancel() => Navigation.NavigateTo($"/goods-receipts/site/{SiteId}");
}
