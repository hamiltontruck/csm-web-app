@page "/projects/{ProjectId:guid}/daily-progress/create"
@rendermode InteractiveServer

@using CSM.Web.Models.Projects
@using CSM.Web.Services
@using CSM.Web.Models.Equipment

@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>Daily Progress</PageTitle>

<div class="container py-4">

    <button class="btn btn-outline-secondary mb-3"
            @onclick="Back">
        ← Task Details
    </button>

    <h2>Daily Progress Entry</h2>
    <p class="text-muted">
        Record today's work completed on site.
    </p>

    <EditForm Model="_log" OnValidSubmit="Save">

        <DataAnnotationsValidator/>

        <div class="card shadow-sm">

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Work Date</label>

                        <InputDate class="form-control"
                                   @bind-Value="_log.LogDate"/>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Overall Progress (%)</label>

                        <InputNumber class="form-control"
                                     @bind-Value="_log.ProgressPercentage"/>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Labour Count</label>

                        <InputNumber class="form-control"
                                     @bind-Value="_log.LabourCount"/>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Work Performed</label>

                        <InputTextArea class="form-control"
                                       rows="4"
                                       @bind-Value="_log.WorkDescription"/>
                    </div>

                </div>

                <hr class="my-4"/>

                <!-- Equipment Section -->
                <div class="d-flex justify-content-between align-items-center mb-3">

                    <h5 class="mb-0">Equipment Used</h5>

                    <button type="button"
                            class="btn btn-sm btn-outline-primary"
                            @onclick="AddEquipment">
                        + Add Equipment
                    </button>

                </div>

                @if (_equipment.Count == 0)
                {
                    <div class="alert alert-light border text-center">
                        No equipment added.
                    </div>
                }

                @foreach (var item in _equipment)
                {
                    <div class="border rounded p-3 mb-3 bg-light">

                        <div class="row g-2">

                            <div class="col-md-5">
                                <label class="form-label">Equipment</label>

                                <InputSelect class="form-select"
                                             @bind-Value="item.EquipmentId">

                                    <option value="">Select equipment</option>

                                    @foreach (var eq in _equipmentList)
                                    {
                                        <option value="@eq.Id">
                                            @eq.EquipmentCode - @eq.Name
                                        </option>
                                    }

                                </InputSelect>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Hours Used</label>

                                <InputNumber class="form-control"
                                             @bind-Value="item.HoursUsed"/>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Operator</label>

                                <InputText class="form-control"
                                           @bind-Value="item.OperatorName"/>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Remarks</label>

                                <InputText class="form-control"
                                           @bind-Value="item.Remarks"/>
                            </div>

                            <div class="col-12 text-end">
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        @onclick="() => RemoveEquipment(item)">
                                    Remove
                                </button>
                            </div>

                        </div>

                    </div>
                }

                <hr class="my-4"/>

                <div>
                    <label class="form-label">General Remarks</label>

                    <InputTextArea class="form-control"
                                   rows="3"
                                   @bind-Value="_log.Remarks"/>
                </div>

            </div>

        </div>

        <div class="mt-3 text-end">
            <button class="btn btn-success">
                Save Daily Progress
            </button>
        </div>

    </EditForm>

</div>

@code {

    [Parameter] public Guid ProjectId { get; set; }

    [SupplyParameterFromQuery]
    public Guid TaskId { get; set; }

    private CreateDailyProgressRequest _log = new();

    private List<EquipmentEntryModel> _equipment = new();
    private List<EquipmentSummary> _equipmentList = new();

    protected override async Task OnInitializedAsync()
    {
        _log.ProjectId = ProjectId;
        _log.TaskId = TaskId;
        _log.LogDate = DateOnly.FromDateTime(DateTime.Today);

        _equipmentList = await ProjectService.GetEquipmentAsync();
    }

    void AddEquipment()
    {
        _equipment.Add(new EquipmentEntryModel());
    }

    void RemoveEquipment(EquipmentEntryModel item)
    {
        _equipment.Remove(item);
    }

    async Task Save()
    {
        // Create or get today's daily log
        var logId = await ProjectService.GetOrCreateDailyLogAsync(_log);

        // Create task progress entry
        var taskEntry = await ProjectService.CreateTaskProgressEntryAsync(
            new CreateDailyProgressTaskEntryRequest
            {
                DailyProgressLogId = logId,
                WorkTaskId = TaskId,
                ProgressPercentage = _log.ProgressPercentage,
                LabourCount = _log.LabourCount,
                EquipmentHours = _equipment.Sum(x => x.HoursUsed),
                WorkCompleted = _log.WorkDescription,
                Remarks = _log.Remarks
            });

        // Save each equipment record
        foreach (var machine in _equipment)
        {
            machine.EquipmentName = _equipmentList
                .FirstOrDefault(x => x.Id == machine.EquipmentId)?.Name ?? "";

            await ProjectService.AddEquipmentEntryAsync(
                new CreateEquipmentEntryRequest
                {
                    DailyProgressTaskEntryId = taskEntry.Id,
                    EquipmentId = machine.EquipmentId,
                    EquipmentName = machine.EquipmentName,
                    HoursUsed = machine.HoursUsed,
                    OperatorName = machine.OperatorName,
                    Remarks = machine.Remarks
                });
        }

        Navigation.NavigateTo(
            $"/projects/{ProjectId}/tasks/{TaskId}",
            true);
    }

    void Back()
    {
        Navigation.NavigateTo($"/projects/{ProjectId}/tasks/{TaskId}");
    }
}