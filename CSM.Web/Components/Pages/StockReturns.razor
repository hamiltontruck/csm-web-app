@page "/stock-returns"
@rendermode InteractiveServer

@using CSM.Web.Models.Sites
@using CSM.Web.Services

@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>Stock Returns</PageTitle>

@if (loading)
{
    <div class="container py-4">
        <h4>Loading construction sites...</h4>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="container py-4">
        <div class="alert alert-danger" role="alert">@errorMessage</div>
        <button id="retry-stock-return-sites" class="btn btn-primary" @onclick="LoadAsync">Retry</button>
        <button class="btn btn-outline-secondary ms-2" @onclick="GoBack">Back</button>
    </div>
}
else
{
    <div class="container py-4">

        <button class="btn btn-outline-secondary mb-3"
                @onclick="GoBack">
            <i class="bi bi-arrow-left"></i> Back
        </button>

        <h2>Stock Returns</h2>

        <div class="text-muted mb-4">
            Select a construction site to manage returned materials.
        </div>

        @foreach (var site in sites)
        {
            <div class="card shadow-sm mb-3"
                 style="cursor:pointer"
                 @onclick="() => OpenSite(site.Id)">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <div class="fw-bold fs-5">
                            @site.SiteCode - @site.Name
                        </div>

                        <div class="text-muted">
                            Construction Site
                        </div>
                    </div>

                    <i class="bi bi-chevron-right fs-4"></i>

                </div>
            </div>
        }

    </div>
}

@code {
    private List<SiteResponse> sites = [];
    private bool loading = true;
    private bool loaded;

    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded) return;
        loaded = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        errorMessage = null;
        try
        {
            sites = await ProjectService.GetSitesAsync();
        }
        catch (Exception)
        {
            errorMessage = "Unable to load stock return sites. Please try again.";
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    void OpenSite(Guid siteId)
        => Navigation.NavigateTo($"/stock-returns/site/{siteId}");

    void GoBack()
        => Navigation.NavigateTo("/stock-items");
}