@page "/equipment/assignments/create/{SiteId:guid}"
@using CSM.Web.Models.Equipment
@using CSM.Web.Models.Sites
@using CSM.Web.Services

@inject IEquipmentService EquipmentService
@inject IProjectService ProjectService
@inject NavigationManager Navigation

<PageTitle>New Equipment Assignment</PageTitle>

<div class="container py-4">

    <div class="d-flex align-items-center mb-4">
        <button class="btn btn-outline-secondary me-3"
                @onclick="GoBack">
            ← Back
        </button>

        <h2 class="mb-0">New Equipment Assignment</h2>
    </div>

    @if (loading)
    {
        <p>Loading assignment form...</p>
    }
    else if (!canManage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
        @if (signInRequired)
        {
            <a id="equipment-assignment-create-sign-in" class="btn btn-primary" href="@SignInUrl">Sign in</a>
        }
        else if (canRetry)
        {
            <button id="retry-equipment-assignment-create" class="btn btn-primary" @onclick="LoadAsync">Retry</button>
        }
    }
    else
    {
    <EditForm Model="model"
              OnValidSubmit="Save"
              FormName="EquipmentAssignmentCreate">

        <DataAnnotationsValidator />
        <ValidationSummary />
        @if (!string.IsNullOrWhiteSpace(saveError))
        {
            <div class="alert alert-danger" role="alert">@saveError</div>
            @if (signInRequired)
            {
                <a class="btn btn-outline-primary" href="@SignInUrl">Sign in</a>
            }
        }

        <div class="card shadow-sm">
            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label">Equipment</label>

                    <InputSelect class="form-select"
                                 @bind-Value="model.EquipmentId">
                        <option value="">-- Select Equipment --</option>

                        @foreach (var eq in equipment)
                        {
                            <option value="@eq.Id">
                                @eq.EquipmentCode - @eq.Name
                            </option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label class="form-label">Construction Site</label>

                    <InputSelect class="form-select"
                                 @bind-Value="model.ConstructionSiteId"
                                 disabled>
                        @foreach (var site in sites)
                        {
                            <option value="@site.Id">
                                @site.Name
                            </option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label class="form-label">Assignment Date</label>

                    <InputDate class="form-control"
                               @bind-Value="model.AssignedAtUtc" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Meter Reading at Assignment</label>

                    <InputNumber class="form-control"
                                 @bind-Value="model.MeterReadingAtAssignment" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Remarks</label>

                    <InputTextArea class="form-control"
                                   @bind-Value="model.Remarks" />
                </div>

            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary" disabled="@(saving || saveBlocked)">
                @(saving ? "Saving..." : "Save Assignment")
            </button>
        </div>

    </EditForm>
    }

</div>

@code {

    [Parameter]
    public Guid SiteId { get; set; }
    private CreateEquipmentAssignmentRequest model = new()
    {
        AssignedAtUtc = DateTime.UtcNow.Date
    };

    private List<EquipmentResponse> equipment = [];
    private List<SiteResponse> sites = [];

    private bool saving;
    private bool saveBlocked;
    private string? saveError;
    private bool loading = true;
    private bool canManage;
    private bool canRetry = true;
    private bool signInRequired;
    private string? errorMessage;
    private string SignInUrl => "/login?returnUrl=" +
        Uri.EscapeDataString($"/equipment/assignments/create/{SiteId}");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        canManage = false;
        canRetry = true;
        signInRequired = false;
        errorMessage = null;
        equipment = [];
        sites = [];
        try
        {
            // Verify the assignment endpoint before loading or displaying creation data.
            _ = await EquipmentService.GetAssignmentsAsync();
            equipment = await EquipmentService.GetEquipmentAsync();
            sites = await ProjectService.GetSitesAsync();
            model.ConstructionSiteId = SiteId;
            canManage = true;
        }
        catch (HttpRequestException ex)
        {
            signInRequired = ex.StatusCode == System.Net.HttpStatusCode.Unauthorized;
            canRetry = ex.StatusCode is not (System.Net.HttpStatusCode.Unauthorized
                or System.Net.HttpStatusCode.Forbidden);
            errorMessage = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Your session is missing or has expired. Please sign in again.",
                System.Net.HttpStatusCode.Forbidden => "You do not have permission to create equipment assignments.",
                _ => "Unable to load assignment form. Please try again."
            };
        }
        catch (Exception)
        {
            errorMessage = "Unable to load assignment form. Please try again.";
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task Save()
    {
        if (!canManage || saving || saveBlocked) return;
        saving = true;
        saveError = null;
        try
        {
            await EquipmentService.CreateAssignmentAsync(model);
            Navigation.NavigateTo($"/equipment/assignments/site/{SiteId}");
        }
        catch (HttpRequestException ex)
        {
            signInRequired = ex.StatusCode == System.Net.HttpStatusCode.Unauthorized;
            saveBlocked = ex.StatusCode is System.Net.HttpStatusCode.Unauthorized
                or System.Net.HttpStatusCode.Forbidden;
            saveError = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Your session is missing or has expired. Please sign in again.",
                System.Net.HttpStatusCode.Forbidden => "You do not have permission to create equipment assignments.",
                System.Net.HttpStatusCode.BadRequest => "Unable to save assignment. Check the assignment details and try again.",
                _ => "Unable to save assignment. Check the assignments list before trying again."
            };
        }
        catch (Exception)
        {
            saveError = "Unable to save assignment. Check the assignments list before trying again.";
        }
        finally
        {
            saving = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo($"/equipment/assignments/site/{SiteId}");
    }

}

