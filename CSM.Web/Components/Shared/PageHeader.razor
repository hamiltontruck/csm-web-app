<header class="csm-page-header">
    <div class="csm-page-header-copy">
        @if (!string.IsNullOrWhiteSpace(Eyebrow))
        {
            <p class="csm-page-header-eyebrow">@Eyebrow</p>
        }

        <h1 class="csm-page-header-title">@Title</h1>

        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="csm-page-header-description">@Description</p>
        }
    </div>

    @if (Actions is not null)
    {
        <div class="csm-page-header-actions">
            @Actions
        </div>
    }
</header>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? Eyebrow { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }
}
