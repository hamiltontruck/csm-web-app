# Paste the Neon PostgreSQL connection string privately; never commit your real value.
CSM_DATABASE_URL=Host=ep-example.eu-central-1.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=replace-me;SSL Mode=Require;Channel Binding=Require
CSM_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CSM_BOOTSTRAP_EMAIL=admin@example.com
CSM_BOOTSTRAP_PASSWORD=replace-with-a-private-strong-password
CSM_WEB_ORIGIN=http://localhost:8080
CSM_API_BASE_URL=http://api:8080/api/
CSM_PUBLIC_API_BASE_URL=http://localhost:5065/api/
